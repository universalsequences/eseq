; Pin Matrix panel. GENERATED by scripts/gen_pin_matrix_fx.py from
; scripts/gen_pin_matrix_fx_ui.lisp.in — edit those, not this file.
;
; The matrix is one `matrix` widget over {rows}x{cols} scalar pin params
; (effects cannot bind tensor-params yet). Click an empty hole to push a
; full pin in, drag a pin up/down to set its strength (the resistor colour),
; double-click to pull it. Right-click offers clear.

(def pinmx-cols {cols})
(def pinmx-pin-names (list {pin_names}))

(def pinmx-accent () (eseq.effects.custom-ui-lego/ui-accent-blue))

(def pinmx-col-label (text span)
  (box :width (* span {col_w}) :height 0.34 :padding 0 :h-align :center
    (label text :font-size 6.6 :height 0.34 :padding 0 :v-align :center :color :dim :bg :transparent)))

(def pinmx-row-label (text)
  (box :width 3.0 :height {row_h} :padding 0 :v-align :center
    (label text :font-size 6.6 :width 3.0 :height {row_h} :padding 0 :v-align :center :color :dim :bg :transparent)))

; Everything, including the 224 pin lookups, lives inside the subtree so a
; section-select rebuild of the panel reuses the matrix instead of redoing it.
(def pinmx-matrix ()
  (subtree :key (str "pinmx-matrix-" (eseq.effects.custom-ui-runtime/custom-ui-scope-name))
    (let ((scope (eseq.effects.custom-ui-runtime/custom-ui-current-scope))
          (pins (map (lambda (n) (eseq.effects.custom-ui-runtime/custom-ui-current-param n)) pinmx-pin-names)))
      (if (nth pins 0)
        (v-stack :width :fill :height :fill :gap 0.0 :align :start
          (h-stack :gap 0.0 :align :start :height 0.34
            (box :width 3.0 :height 0.34 :padding 0
              (label "PINS" :font-size 6.4 :height 0.34 :padding 0 :color (pinmx-accent) :bg :transparent))
{col_labels_top})
          (h-stack :gap 0.0 :align :start :height 0.34
            (box :width 3.0 :height 0.34)
{col_labels_bottom})
          (box :width :fill :flex 1)
          (h-stack :gap 0.0 :align :end :height {matrix_h}
            (v-stack :width 3.0 :height {matrix_h} :gap 0.0 :align :start
{row_labels})
            (matrix :rows {rows} :cols {cols}
              :value (map (lambda (p) (eseq.effects.custom-ui-runtime/custom-ui-param-binding p)) pins)
              :min 0 :max 1 :default 0
              :control :circle
              :fill (pinmx-accent)
              :width {matrix_w} :height {matrix_h}
              :on-cell-press (lambda (r c)
                (let ((p (nth pins (+ (* r pinmx-cols) c))))
                  (if (< (eseq.effects.custom-ui-runtime/custom-ui-param-value p) 0.02)
                    (eseq.effects.custom-ui-runtime/custom-ui-set-param-in-scope scope p 1)
                    false)))
              :on-cell-change (lambda (r c v)
                (eseq.effects.custom-ui-runtime/custom-ui-set-param-in-scope scope
                  (nth pins (+ (* r pinmx-cols) c)) v)))))
        (label "missing: pin params" :font-size 8 :color :red :bg :transparent)))))

(def pinmx-knob (section name title)
  (eseq.effects.custom-ui-lego/ui-lego-knob-s section name title 4.7 (pinmx-accent) 2))

(def pinmx-log-knob (section name title)
  (eseq.effects.custom-ui-lego/ui-lego-log-knob-s section name title 4.7 (pinmx-accent) 3))

(defeffect-ui
  (h-stack :width :fill :gap 0.35 :align :stretch
    ; The device body is taller than the lego full height, so the matrix
    ; panel uses that extra room.
    (eseq.effects.custom-ui-lego/ui-lego-panel-width-s {panel_w} {panel_h} 0 :instrument-group-bg
      (pinmx-matrix))
    (eseq.effects.custom-ui-lego/ui-lego-column-2
      (eseq.effects.custom-ui-lego/ui-control-block-medium-s "OSCILLATORS" (pinmx-accent) 1
        (h-stack :gap 0.32 :align :start
          (pinmx-knob 1 "osc1_oct" "osc1")
          (pinmx-knob 1 "osc2_oct" "osc2")
          (pinmx-knob 1 "osc2_shape" "shape")
          (pinmx-knob 1 "osc3_oct" "osc3")))
      (eseq.effects.custom-ui-lego/ui-control-block-medium-s "FILTER / NOISE" (pinmx-accent) 2
        (h-stack :gap 0.32 :align :start
          (pinmx-knob 2 "filt_oct" "freq")
          (pinmx-knob 2 "filt_res" "res")
          (pinmx-knob 2 "filt_drive" "drive")
          (pinmx-knob 2 "noise_col" "colour"))))
    (eseq.effects.custom-ui-lego/ui-lego-column-2
      (eseq.effects.custom-ui-lego/ui-control-block-medium-s "SERGE FOLD / FREQ SHIFT" (pinmx-accent) 3
        (h-stack :gap 0.32 :align :start
          (pinmx-knob 3 "fold_amt" "fold")
          (pinmx-knob 3 "fold_sym" "sym")
          (pinmx-knob 3 "shift" "shift")
          (pinmx-knob 3 "mix" "mix")))
      (eseq.effects.custom-ui-lego/ui-control-block-medium-s "ENV FOLLOWER" (pinmx-accent) 4
        (h-stack :gap 0.32 :align :start
          (eseq.effects.custom-ui-lego/ui-lego-log-knob-s 4 "env_att" "att" 4.7 (pinmx-accent) 1)
          (pinmx-log-knob 4 "env_rel" "rel")
          (pinmx-knob 4 "env_gain" "gain")
          (pinmx-knob 4 "trap_thresh" "trig"))))
    (eseq.effects.custom-ui-lego/ui-lego-column-2
      (eseq.effects.custom-ui-lego/ui-control-block-medium-s "TRAPEZOID" (pinmx-accent) 5
        (h-stack :gap 0.32 :align :start
          (pinmx-log-knob 5 "trap_att" "attack")
          (pinmx-knob 5 "trap_on" "on")
          (pinmx-log-knob 5 "trap_dec" "decay")
          (pinmx-knob 5 "trap_off" "off")))
      (eseq.effects.custom-ui-lego/ui-control-block-medium-s "VCA / SPRING / OUT" (pinmx-accent) 6
        (h-stack :gap 0.2 :align :start
          (eseq.effects.custom-ui-lego/ui-lego-knob-s 6 "trap_mode" "1-shot" 4.3 (pinmx-accent) 0)
          (eseq.effects.custom-ui-lego/ui-lego-knob-s 6 "vca_init" "vca" 4.3 (pinmx-accent) 2)
          (eseq.effects.custom-ui-lego/ui-lego-knob-s 6 "spring_decay" "spring" 4.3 (pinmx-accent) 2)
          (eseq.effects.custom-ui-lego/ui-lego-knob-s 6 "spring_disp" "boing" 4.3 (pinmx-accent) 2)
          (eseq.effects.custom-ui-lego/ui-lego-knob-s 6 "level" "level" 4.3 (pinmx-accent) 2))))))

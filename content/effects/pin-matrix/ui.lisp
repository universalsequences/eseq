(def pinmx-accent () (eseq.effects.custom-ui-lego/ui-accent-blue))

(def pinmx-col-label (text span)
  (box :width (* span 1.6429) :height 0.34 :padding 0 :h-align :center
    (label text :font-size 6.6 :height 0.34 :padding 0 :v-align :center :color :dim :bg :transparent)))

(def pinmx-row-label (text)
  (box :width 3.0 :height 0.5563 :padding 0 :v-align :center
    (label text :font-size 6.6 :width 3.0 :height 0.5563 :padding 0 :v-align :center :color :dim :bg :transparent)))

; Everything, including the 224 pin lookups, lives inside the subtree so a
; section-select rebuild of the panel reuses the matrix instead of redoing it.
(def pinmx-matrix ()
  (subtree :key (str "pinmx-matrix-" (eseq.effects.custom-ui-runtime/custom-ui-scope-name))
    (let ((scope (eseq.effects.custom-ui-runtime/custom-ui-current-scope))
          (pins (map (lambda (n) (eseq.effects.custom-ui-runtime/custom-ui-current-param n)) pinmx-pin-names)))
      (if (nth pins 0)
        (v-stack :width :fill :height :fill :gap 0.0 :align :start
          (h-stack :gap 0.0 :align :start :height 0.34
            (box :width 3.0 :height 0.34 :padding 0
              (label "PINS" :font-size 6.4 :height 0.34 :padding 0 :color (pinmx-accent) :bg :transparent))
            (pinmx-col-label "OUT" 2)
            (pinmx-col-label "FILT" 2)
            (pinmx-col-label "RING" 2)
            (pinmx-col-label "FOLD" 2)
            (pinmx-col-label "SHIFT" 2)
            (pinmx-col-label "IN" 2)
            (pinmx-col-label "OSC" 2))
          (h-stack :gap 0.0 :align :start :height 0.34
            (box :width 3.0 :height 0.34)
            (pinmx-col-label "L" 1)
            (pinmx-col-label "R" 1)
            (pinmx-col-label "in" 1)
            (pinmx-col-label "frq" 1)
            (pinmx-col-label "A" 1)
            (pinmx-col-label "B" 1)
            (pinmx-col-label "in" 1)
            (pinmx-col-label "amt" 1)
            (pinmx-col-label "in" 1)
            (pinmx-col-label "frq" 1)
            (pinmx-col-label "vca" 1)
            (pinmx-col-label "spr" 1)
            (pinmx-col-label "1" 1)
            (pinmx-col-label "2" 1))
          (box :width :fill :flex 1)
          (h-stack :gap 0.0 :align :end :height 8.9
            (v-stack :width 3.0 :height 8.9 :gap 0.0 :align :start
              (pinmx-row-label "IN L")
              (pinmx-row-label "IN R")
              (pinmx-row-label "OSC 1")
              (pinmx-row-label "OSC 2")
              (pinmx-row-label "OSC 3")
              (pinmx-row-label "S&H")
              (pinmx-row-label "NOISE")
              (pinmx-row-label "FILTER")
              (pinmx-row-label "RING")
              (pinmx-row-label "FOLD")
              (pinmx-row-label "SHIFT +")
              (pinmx-row-label "SHIFT -")
              (pinmx-row-label "ENV FOL")
              (pinmx-row-label "TRAP")
              (pinmx-row-label "VCA")
              (pinmx-row-label "SPRING"))
            (matrix :rows 16 :cols 14
              :value (map (lambda (p) (eseq.effects.custom-ui-runtime/custom-ui-param-binding p)) pins)
              :min 0 :max 1 :default 0
              :control :circle
              :fill (pinmx-accent)
              :width 23.0 :height 8.9
              :on-cell-press (lambda (r c)
                (let ((p (nth pins (+ (* r pinmx-cols) c))))
                  (if (< (eseq.effects.custom-ui-runtime/custom-ui-param-value p) 0.02)
                    (eseq.effects.custom-ui-runtime/custom-ui-set-param-in-scope scope p 1)
                    false)))
              :on-cell-change (lambda (r c v)
                (eseq.effects.custom-ui-runtime/custom-ui-set-param-in-scope scope
                  (nth pins (+ (* r pinmx-cols) c)) v)))))
        (label "missing: pin params" :font-size 8 :color :red :bg :transparent)))))

(def pinmx-knob (section name title)
  (eseq.effects.custom-ui-lego/ui-lego-knob-s section name title 4.7 (pinmx-accent) 2))

(def pinmx-log-knob (section name title)
  (eseq.effects.custom-ui-lego/ui-lego-log-knob-s section name title 4.7 (pinmx-accent) 3))

(defeffect-ui
  (h-stack :width :fill :gap 0.35 :align :stretch
    ; The device body is taller than the lego full height, so the matrix
    ; panel uses that extra room.
    (eseq.effects.custom-ui-lego/ui-lego-panel-width-s 27.0 10.14 0 :instrument-group-bg
      (pinmx-matrix))
    (eseq.effects.custom-ui-lego/ui-lego-column-2
      (eseq.effects.custom-ui-lego/ui-control-block-medium-s "OSCILLATORS" (pinmx-accent) 1
        (h-stack :gap 0.32 :align :start

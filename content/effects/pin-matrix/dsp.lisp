; ── generators ──
(def f1 (clip (* 20 (pow 2 (+ m_osc1_oct (* 4 dst_o1cv)))) 0.01 18000))
(def ph1 (phasor f1))
(def osc1 (sin (* ph1 twopi)))

(def f2 (clip (* 20 (pow 2 (+ m_osc2_oct (* 4 dst_o2cv)))) 0.01 18000))
(def ph2 (phasor f2))
(def s2 (clip m_osc2_shape 0.01 0.99))
(def osc2 (- (* 2 (gswitch (lt ph2 s2) (/ ph2 s2) (/ (- 1 ph2) (- 1 s2)))) 1))

(def ph3 (phasor (* 20 (pow 2 m_osc3_oct))))
(def osc3 (triangle ph3))
(make-history ph3_prev)
(def wrap3 (lt ph3 (read-history ph3_prev)))
(write-history ph3_prev ph3)
(def raw_noise (noise))
(def sh (- (* 2 (latch raw_noise wrap3)) 1))
(def noise_sig (svf (- (* 2 raw_noise) 1) (* 20 (pow 2 (+ 5 (* 4.8 m_noise_col)))) 0.5 0))

; ── processors ──
(def cutoff (clip (* 20 (pow 2 (+ m_filt_oct (* 5 dst_fcv)))) 20 18000))
(def filt (tanh (vcs3-filter dst_filt cutoff m_filt_res (+ 1 (* 4 m_filt_drive)))))

(def ring (tanh (* 2 dst_ringa dst_ringb)))

(def fold (serge-fold dst_fold (clip (+ m_fold_amt dst_foldcv) 0 1) m_fold_sym))

(def sh_amt (clip (+ m_shift dst_shcv) -1 1))
(def sh_hz (* (sign sh_amt) (- (pow 5001 (abs sh_amt)) 1)))
(def sh_ph (* (phasor (abs sh_hz)) twopi))
(def sh_c (cos sh_ph))
(def sh_s (* (sign sh_hz) (sin sh_ph)))
(def hi (hilbert-i dst_shift))
(def hq (hilbert-q dst_shift))
(def shup (+ (* hi sh_c) (* hq sh_s)))
(def shdn (- (* hi sh_c) (* hq sh_s)))

(def envf (clip (* m_env_gain (follower (* 0.5 (+ in_l in_r)) (* 0.001 m_env_att) m_env_rel)) 0 1))

(def trap (trapezoid m_trap_att m_trap_on m_trap_dec m_trap_off m_trap_mode (gt envf m_trap_thresh)))
(def vca (tanh (* dst_vca (clip (+ m_vca_init trap) 0 1.5))))

(def spring_in (svf dst_spring 5000 0.7 0))
(def spring (tanh (* 2.2 (+ (spring-loop spring_in 37 m_spring_decay m_spring_disp)
                            (spring-loop spring_in 51 (* 0.94 m_spring_decay) (* 0.9 m_spring_disp))))))

(write-history h_osc1 osc1)
(write-history h_osc2 osc2)
(write-history h_osc3 osc3)
(write-history h_sh sh)
(write-history h_noise noise_sig)
(write-history h_filt filt)
(write-history h_ring ring)
(write-history h_fold fold)
(write-history h_shup shup)
(write-history h_shdn shdn)
(write-history h_env envf)
(write-history h_trap trap)
(write-history h_vca vca)
(write-history h_spring spring)

; ── outputs: DC-blocked, soft-limited, dry/wet ──
(def wet_l (tanh (* m_level (biquad dst_outl 12 0.707 1 1))))
(def wet_r (tanh (* m_level (biquad dst_outr 12 0.707 1 1))))
(out (+ (* in_l (- 1 m_mix)) (* wet_l m_mix)) 1 @name left)
(out (+ (* in_r (- 1 m_mix)) (* wet_r m_mix)) 2 @name right)

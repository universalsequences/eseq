(param fenv @min -5000 @max 5000)
(param frelease @min 0 @max 3000 @default 100)
(param fsus @min 0 @max 1 @default 0.5)
(param gain @default 0.5 @min 0 @max 1 @mod true @mod-mode additive)
(param noisegain @min 0 @max 1 @default 0)
(param oscmix @min 0 @max 1 @default 0.5)
(param release @group amp @env amp-env @role release @default 180 @min 1 @max 5000 @unit ms)

(param width @min 0.1 @max 0.8 @default 0l5)

(def gate (in 1 @name gate))
(def pitch (in 2 @name pitch))
(def velocity (in 3 @name velocity))
(def trigger (in 4 @name trigger))

(def adsr-2 (adsrexp gate trigger fatk fdec fsus frelease 0.5 4))
(def env (adsrexp gate trigger attack decay sustain release 0.5 4))
(def floor-2 (floor semitone))
(def mul-2-2-2 (* adsr-2 fenv))
(def noise-2 (noise))
(def phasor-2 (phasor lforate))
(def scale-2 (scale noise-2 0 1 -1 1))
(def mul-2 (* noisegain scale-2))
(def triangle-2 (triangle lforate))
(def mul (* triangle-2 lfoenv))
(def pitch-transpose-2 (pitch-transpose pitch mul))
(def pitch-transpose-2-2 (pitch-transpose pitch-transpose-2 (+ detune floor-2)))
(def sub1-2 (sub1 pitch-transpose-2 width shape))
(def sub1-3 (sub1 pitch-transpose-2-2 width shape))
(def mix-2 (mix sub1-2 sub1-3 oscmix))
(def mul-0 (* (+ mix-2 mul-2) env velocity (mod gain)))
(def value 1)
(def value-2 0)
(def biquad-2 (biquad mul-0 (+ cut mul-2-2-2) res value value-2))
(def mul-2-2 (* biquad-2 drive))

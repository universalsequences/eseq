(use-defmacro pitch-transpose)

(def mod1 (in 6 @name mod1 @modulator 1))
(def mod2 (in 7 @name mod2 @modulator 2))
(def mod3 (in 8 @name mod3 @modulator 3))
(def mod4 (in 9 @name mod4 @modulator 4))

(defmacro sub1 (input1 input2 input3)
  (def phasor-2 (phasor input1))
  (def polyblep_pulse-2 (polyblep_pulse phasor-2 input2 input1))
  (def polyblep_saw-2 (polyblep_saw phasor-2 input1))
  (def mix-2 (mix polyblep_saw-2 polyblep_pulse-2 input3))
  mix-2)

(param attack @group amp @env amp-env @role attack @default 5 @min 0 @max 1000 @unit ms)
(param lforate @min 0.2 @max 5 @default 1)
(param lfoenv @min -1 @max 1 @default 0)
(param cut @min 50 @max 10000 @default 100)
(param decay @group amp @env amp-env @role decay @default 120 @min 1 @max 2000 @unit ms)
(param detune @min -0.5 @max 0.5)
(param drive @min 1 @max 10)

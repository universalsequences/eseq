(def x1_n (* white_scale (gt x1_g_t 0) (nstream nz_u c_x1_m)))
(def x1_h (svf-hp x1_n (hitg c_x1_hp) onset))
(def x1_l (svf-lp x1_h (hitg c_x1_lp) onset 1.414213562))
(def x1_sig (* x1_env (+ x1_h (* c_x1_lpon (- x1_l x1_h)))))
(def X1i (* c_x1_in x1_sig))
(def X1o (* (- 1 c_x1_in) x1_sig))
(def x2_t (max 0 (- age (+ (* (- 1 c_x2_anc) hit_s) x2_st0))))
(def x2_er (- 1 (exp (* (- x2_t) c_x2_rr))))
(def x2_rmp (clip (* x2_t x2_irl) 0 1))
(def x2_R (+ (* (- 1 c_x2_rp) (+ x2_er (* c_x2_sq (- (* x2_er x2_er) x2_er)))) (* c_x2_rp x2_rmp x2_rmp)))
(def x2_env (* x2_g (vpow c_x2_vel) (- 1 (* c_x2_anc (- 1 c_cut_on))) x2_R (exp (* (- (max 0 (- x2_t x2_ds))) x2_dr))))
(def x2_n (* white_scale (gt x2_g_t 0) (nstream nz_u c_x2_m)))
(def x2_h (svf-hp x2_n (hitg c_x2_hp) onset))
(def x2_sig (* x2_env x2_h))
(def X2i (* c_x2_in x2_sig))
(def X2o (* (- 1 c_x2_in) x2_sig))
(def x3_t (max 0 (- age (+ (* (- 1 c_x3_anc) hit_s) x3_st0))))
(def x3_er (- 1 (exp (* (- x3_t) c_x3_rr))))
(def x3_rmp (clip (* x3_t x3_irl) 0 1))
(def x3_R (+ (* (- 1 c_x3_rp) (+ x3_er (* c_x3_sq (- (* x3_er x3_er) x3_er)))) (* c_x3_rp x3_rmp x3_rmp)))
(def x3_env (* x3_g (vpow c_x3_vel) (- 1 (* c_x3_anc (- 1 c_cut_on))) x3_R (exp (* (- (max 0 (- x3_t x3_ds))) x3_dr))))
(def x3_n (* white_scale (gt x3_g_t 0) (nstream nz_u c_x3_m)))
(def x3_h (svf-hp x3_n (hitg c_x3_hp) onset))
(def g_x3l (hitg c_x3_lp))
(def x3_l (svf-lp x3_h g_x3l onset 1.414213562))
(def x3_ll (+ x3_l (* c_x3_lp2 (- (svf-lp x3_l g_x3l onset 1.414213562) x3_l))))
(def x3_sig (* x3_env (+ x3_h (* c_x3_lpon (- x3_ll x3_h)))))
(def X3i (* c_x3_in x3_sig))
(def X3o (* (- 1 c_x3_in) x3_sig))
(def x4_t (max 0 (- age (+ (* (- 1 c_x4_anc) hit_s) x4_st0))))
(def x4_er (- 1 (exp (* (- x4_t) c_x4_rr))))
(def x4_rmp (clip (* x4_t x4_irl) 0 1))
(def x4_R (+ (* (- 1 c_x4_rp) (+ x4_er (* c_x4_sq (- (* x4_er x4_er) x4_er)))) (* c_x4_rp x4_rmp x4_rmp)))
(def x4_env (* x4_g (vpow c_x4_vel) (- 1 (* c_x4_anc (- 1 c_cut_on))) x4_R (exp (* (- (max 0 (- x4_t x4_ds))) x4_dr))))
(def x4_n (* (gt x4_g_t 0) (+ (* (- 1 c_x4_src) white_scale (nstream nz_u c_x4_m)) (* c_x4_src kn_imp))))
(def x4_h (svf-hp x4_n (hitg c_x4_hp) onset))
(def g_x4l (hitg (* c_x4_lp (+ 1 (* c_x4_src (- kn_lpj 1))))))
(def x4_l (svf-lp x4_h g_x4l onset 1.414213562))
(def x4_ll (+ x4_l (* c_x4_lp2 (- (svf-lp x4_l g_x4l onset 1.414213562) x4_l))))
(def x4_sig (* x4_env (+ x4_h (* c_x4_lpon (- x4_ll x4_h)))))
(def X4i (* c_x4_in x4_sig))
(def X4o (* (- 1 c_x4_in) x4_sig))
;; ---- the hat (Decay / Pedal level laws) ----
(def hat (* dcomp ped_g (+ metal_m tick_sig X1i X2i X3i X4i)))
;; ---- record bed (not transposed): bleed sine, rumble, hiss + crackle; the pedal closes it ----
(def bed_env (exp (* (- age) rate_bed)))
;; bleed sine phase accumulated per sample (a frequency change mid-hit bends, never jumps)
(make-history bph_h)
(def bph_p (gswitch onset 0 (read-history bph_h)))
(def bph_n (+ bph_p (* (- 1 onset) (/ c_bleed_hz samplerate))))
(def bph (- bph_n (floor bph_n)))
(write-history bph_h bph)
(def bleed_sig (* bleed_g (- 1 (exp (* age -500))) (exp (* (- age) rate_bleed))
  (sin (* twopi bph))))
(def bleed_out (* bleed_sig (+ (- 1 c_bcut) (* c_bcut cut_g))))
(def rum_sig (* rum_g (- 1 (exp (* age -300))) (exp (* (- age) rate_rum))
  (svf-lp (svf-lp (* white_scale (nstream nz_u 1645.1971)) g_rum onset 1.414213562) g_rum onset 1.414213562)))
(def ck_on (lt (+ 0.5 (* 0.288675 (nstream nz_u 2255.8354))) crackle_p))
(def hs_in (+ (* hiss_g (- 1 (exp (* age -5000))) white_scale (nstream nz_u 2056.981)) (* crackle_g ck_on 2.3 (nstream nz_u 2223.094))))
(def hiss_sig (svf-lp (svf-hp hs_in g_hiss_lo onset) g_hiss_hi onset 1.414213562))
(def source (* vel (+ (* cut_g hat) X1o X2o X3o X4o (* bed_env (+ bleed_out rum_sig hiss_sig)))))
;; ---- recording chain (not transposed) ----
(def driven (+ source (* drive_amt (- (/ (tanh (* drive0 source)) drive0) source))))
(make-history sh_ph)
(make-history sh_val)
(def sh_p (gswitch onset 1 (+ (read-history sh_ph) sh_inc)))
(def sh_take (gte sh_p 1))
(def sh_hold (gswitch sh_take driven (read-history sh_val)))
(write-history sh_ph (- sh_p (* sh_take (floor sh_p))))
(write-history sh_val sh_hold)
(def crushed (* (floor (+ (* sh_hold q_steps) 0.5)) q_inv))
(def rec0 (svf-lp crushed g_rec1 onset kk_rec1))
(def rec1 (+ rec0 (* knee_on_s (- (svf-lp rec0 g_knee onset 1.847759065) rec0))))
(def p_abs (abs rec1))
(def pk_span (* 0.25 c_pk_th))
(def rec2 (gswitch (gt p_abs c_pk_th) (* (gswitch (gt rec1 0) 1 -1) (+ c_pk_th (* pk_span (tanh (/ (- p_abs c_pk_th) pk_span))))) rec1))
(def edged0 (svf-ell rec2 (* g_edge 1.00320785) onset 0.0363884065 0.783029767))
(def edged1 (svf-ell edged0 (* g_edge 0.93758462) onset 0.153909711 0.580418901))
(def edged2 (svf-ell edged1 (* g_edge 0.75480269) onset 0.465579732 0.219488652))
(def edged3 (svf-ell edged2 (* g_edge 0.42384067) onset 1.4248911 0.0106186209))
(def edged (+ rec2 (* edge_mix (- edged3 rec2))))
;; codec floor (the pre-edge signal above the edge) + ULTRA (post-edge noise), one HP4 at the edge
(def ult_in (* vel u_g (- 1 (exp (* age -5000))) (exp (* (- age) rate_u)) white_scale (nstream nz_u 2648.4456)))
(def codec_sig (svf-hp (svf-hp (+ (* codec_g rec2) ult_in) g_edge onset) g_edge onset))
(def fu (clip (/ (- age (- end_s fade_s)) fade_s) 0 1))
(def fade (- 1 (* fu fu (- 3 (* 2 fu)))))
(def out0 (* played lvl fade (+ edged codec_sig)))
;; per-slot safety limiter: exact identity below |x| = 0.9
(def o_abs (abs out0))
(gswitch (gt o_abs 0.9) (* (gswitch (gt out0 0) 1 -1) (+ 0.9 (* 0.1 (tanh (* 10 (- o_abs 0.9)))))) out0))
(def (onset onset_a onset_b gain_a gain_b) (hat-gate-release trigger gate release_v))
;; ================= per voice (shared by both slots) =================
;; NOTE TRANSPOSE: rho = tune * (pitch / C4)^keytrack. Bank coefficients at EVENT rate, held.
;; |log ratio| < 1e-5 snaps to exactly C4 (the host computes 440 * 2^(-9/12) in f32: 1 ulp off)
(def lpr (log (clip (/ pitch 261.6255653) 0.25 4)))
(def lprs (* lpr (gt (abs lpr) 0.00001)))
(def rho_now (* tune_v (exp (* keytrack_v lprs))))
(def rho (latch rho_now onset))
(def rho_e (event-hold rho_now onset))
;; mode decay rate x rho^q: q = 1 (constant-Q) above C4, the per-hat column q_low below (fix pass,
;; CRITIQUE 7: with q = 1 a noise-like hat's partials outlive its fixed envelopes when transposed down)
(def rho_q (gswitch (lt rho_e 1) (exp (* c_q_low (log (max rho_e 0.000001)))) rho_e))
(def rho_qs (gswitch (lt rho 1) (exp (* c_q_low (log (max rho 0.000001)))) rho))
;; energy normaliser: resonator power ~ 1 / decay rate
(def rho_nrm (sqrt rho_qs))
;; voice age (the test_freeze hash of the shared wobble stream)
(make-history vage_h)
(def vage (gswitch onset 0 (min (* 8 samplerate) (+ 1 (read-history vage_h)))))
(write-history vage_h vage)
(def glide_k (- 1 (exp (/ -1 (* 0.002 samplerate)))))
(def tick_g (glide tick_g_t onset))
(def bleed_g (glide bleed_g_t onset))
(def rum_g (glide rum_g_t onset))
(def hiss_g (glide hiss_g_t onset))
(def codec_g (glide codec_g_t onset))
(def u_g (glide u_g_t onset))
(def lvl (glide lvl_t onset))
(def hit_s (glide hit_s_t onset))
(def rate_rise (glide rate_rise_t onset))
(def rate_f1 (glide rate_f1_t onset))
(def rate_f2 (glide rate_f2_t onset))
(def rate_f3 (glide rate_f3_t onset))
(def rate_srise (glide rate_srise_t onset))
(def rate_s1 (glide rate_s1_t onset))
(def rate_s2 (glide rate_s2_t onset))
(def rate_s3 (glide rate_s3_t onset))
(def edge_mix (glide edge_mix_t onset))
(def x1_g (glide x1_g_t onset))
(def x2_g (glide x2_g_t onset))
(def x3_g (glide x3_g_t onset))
(def x4_g (glide x4_g_t onset))
(def mhp_on_s (glide c_mhp_on onset))
(def mlp_on_s (glide c_mlp_on onset))
(def knee_on_s (glide c_knee_on onset))
(def tlp_on_s (glide c_tlp_on onset))
(def vfz (* vage 0.6180339887))
(def v_u (gswitch freeze_on (- vfz (floor vfz)) (noise)))
;; group P: r(rho) e^(i rho w), constant-Q (decay rate x rho), computed on the onset, held
(def Pex (* Psig (- rho_q 1)))
(def Prr (* Pr0 (- 1 (* Pex (- 1 (* Pex (- 0.5 (* Pex 0.16666667))))))))
(def Pth (* Pw0 rho_e))
(def PEce (* Prr (cos Pth)))
(def PEse (* Prr (sin Pth)))
(make-tensor-history Pec_h @shape [88])
(make-tensor-history Pes_h @shape [88])
(def PEc (gswitch onset PEce (read-tensor-history Pec_h)))
(def PEs (gswitch onset PEse (read-tensor-history Pes_h)))
(write-tensor-history Pec_h PEc)
(write-tensor-history Pes_h PEs)
;; Nyquist guard at the transposed frequency and the sqrt(rho) normaliser (per sample)
(def Pgd (* rho_nrm (clip (- 15.3333333 (* Pfn33 rho)) 0 1)))
;; group S: r(rho) e^(i rho w), constant-Q (decay rate x rho), computed on the onset, held
(def Sex (* Ssig (- rho_q 1)))
(def Srr (* Sr0 (- 1 (* Sex (- 1 (* Sex (- 0.5 (* Sex 0.16666667))))))))
(def Sth (* Sw0 rho_e))
(def SEce (* Srr (cos Sth)))
(def SEse (* Srr (sin Sth)))
(make-tensor-history Sec_h @shape [52])
(make-tensor-history Ses_h @shape [52])
(def SEc (gswitch onset SEce (read-tensor-history Sec_h)))
(def SEs (gswitch onset SEse (read-tensor-history Ses_h)))
(write-tensor-history Sec_h SEc)
(write-tensor-history Ses_h SEs)
;; Nyquist guard at the transposed frequency and the sqrt(rho) normaliser (per sample)
(def Sgd (* rho_nrm (clip (- 15.3333333 (* Sfn33 rho)) 0 1)))
;; partial motion (P only): a unit-variance one-pole of each slot's own stream, shared per voice
(def Phl (* v_u (* Pms 1.7320508)))
(def Pfw (* 3.4641016 (- (- Phl (floor Phl)) 0.5)))
(make-tensor-history Pfl_h @shape [88])
(def Pflp (+ (* (read-tensor-history Pfl_h) (- 1 onset)) (* onset (* Pfw fl_inv))))
(def Pfln (+ Pflp (* fl_k (- Pfw Pflp))))
(write-tensor-history Pfl_h Pfln)
(def Pdw (* rho (clip (* Pwbk Pfln fl_norm) -0.5 0.5)))
(def Pd2 (* Pdw Pdw))
(def Pwh (- 1 (* 0.5 Pd2)))
(def Pws (* Pdw (- 1 (* 0.16666667 Pd2))))
(def PEc2 (- (* PEc Pwh) (* PEs Pws)))
(def PEs2 (+ (* PEs Pwh) (* PEc Pws)))
(def hit_a (hat-hit onset_a velocity))
(def hit_b (hat-hit onset_b velocity))
(def mixed (+ (* hit_a gain_a) (* hit_b gain_b)))
(out mixed 1 @name left)
(out mixed 2 @name right)
;; A drum may never see note-off (gate-off tracks), so the amp flag must not
;; depend on the gate: the voice is done once its output has fallen below
;; -100 dBFS, which follows any decay, release or ring.
(use-defmacro voice-amp)
(out (voice-amp 0 mixed mixed) 3 @name amp @amp true)

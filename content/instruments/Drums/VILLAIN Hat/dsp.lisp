;; VILLAIN Hat retrigger + gate RELEASE (a copy of the idea of the shared
;; tools/hat-retrigger.lisp, which is not edited). Two independent hit slots.
;; RETRIGGER (unchanged family standard): the OUTGOING slot fades with the 808
;; exponential crossfade, -60 dB at 5 ms; the INCOMING slot is at full gain from
;; its onset sample with its state zeroed on that sample.
;; RELEASE (new, replaces the per-hat choke): the step's duration arrives as the
;; gate. When the gate FALLS (end of the note's dur, or a rack choke = an early
;; note-off) both slots enter a release stage whose gain is the C1 curve
;;     g(t) = (1 + t/tau) e^(-t/tau),   tau = Release / 9.233413 (-60 dB at Release)
;; which starts with zero slope (no click even on a low bleed sine). It only
;; multiplies the hat (<= 1, non-increasing), so it can never lengthen a hit.
;; A slot's release resets ONLY on its own onset: a retrigger during a release
;; starts the new hit at full level; the release belongs to the outgoing slot.
;; dur 0: when the gate is already low on a slot's onset sample (the host's
;; gate-off landed on the note-on frame) that slot releases from its onset.
;; Release >= 1999.5 ms = HOLD: the gate is ignored (the per-hat behaviour).
;; Recurrence (tau in samples, a = e^(-1/tau)): e <- a e, h <- a (h + e / tau),
;; g = e + h; before a release e = 1, h = 0. The gain returned is the value
;; BEFORE the update, so every fade starts from the ongoing gain.
(defmacro hat-retrigger-gain (target)
  (make-history gain_h)
  (def previous_gain (read-history gain_h))
  (def coefficient (exp (/ -6.9077553 (* samplerate 0.005))))
  (def next_gain (gswitch target 1 (* coefficient previous_gain)))
  (write-history gain_h next_gain)
  (gswitch target 1 previous_gain))

(defmacro hat-release-gain (slot_onset start_on_onset rel_start rel_a rel_itau)
  (make-history rel_on_h)
  (make-history rel_e_h)
  (make-history rel_h_h)
  (def releasing (gswitch slot_onset start_on_onset (max (read-history rel_on_h) rel_start)))
  (write-history rel_on_h releasing)
  (def prev_e (gswitch slot_onset 1 (read-history rel_e_h)))
  (def prev_h (gswitch slot_onset 0 (read-history rel_h_h)))
  (def next_e (gswitch releasing (* rel_a prev_e) prev_e))
  (def next_h (gswitch releasing (* rel_a (+ prev_h (* prev_e rel_itau))) prev_h))
  (write-history rel_e_h next_e)
  (write-history rel_h_h next_h)
  (+ prev_e prev_h))

(defmacro hat-gate-release (trigger gate release_ms)
  (make-history previous_trigger)
  (make-history previous_gate)
  (def trigger_high (gt trigger 0.5))
  (def gate_high (gt gate 0.5))
  (def onset (max (* trigger_high (lte (read-history previous_trigger) 0.5))
    (* gate_high (lte (read-history previous_gate) 0.5))))
  (def gate_fall (* (- 1 gate_high) (gt (read-history previous_gate) 0.5)))
  (write-history previous_trigger trigger_high)
  (write-history previous_gate gate_high)
  (make-history selector_h)
  (def previous_selector (read-history selector_h))
  (def slot (gswitch onset (- 1 previous_selector) previous_selector))
  (write-history selector_h slot)
  (def target_a (lt slot 0.5))
  (def target_b (- 1 target_a))
  (def onset_a (* onset target_a))
  (def onset_b (* onset target_b))
  (def rel_enable (lt release_ms 1999.5))
  (def rel_start (* gate_fall rel_enable (- 1 onset)))
  (def rel_at_onset (* (- 1 gate_high) rel_enable))
  (def rel_tau (* samplerate 0.001 (clip release_ms 5 2000) 0.10830231))
  (def rel_a (exp (/ -1 rel_tau)))
  (def rel_itau (/ 1 rel_tau))
  (def gain_a (* (hat-retrigger-gain target_a) (hat-release-gain onset_a rel_at_onset rel_start rel_a rel_itau)))
  (def gain_b (* (hat-retrigger-gain target_b) (hat-release-gain onset_b rel_at_onset rel_start rel_a rel_itau)))
  (tuple onset onset_a onset_b gain_a gain_b))

;; VILLAIN Hat ("VILLAIN HAT"): the 12 source hats in one instrument. Hat A / Hat B pick
;; rows of per-hat tables; Blend interpolates column by column; Exaggerate pushes
;; character columns away from the mean of the 12. The note transposes the hat
;; (C4 = as recorded; the recording medium stays fixed) and the note length
;; releases it (Release; 2000 = Hold). No samples.
;; Generated by research/hats/master/build_master.py from rows.json
;; (+ polish.json). Do not hand-edit: rebuild with the REBUILD line there.
(def gate (in 1 @name gate))
(def pitch (in 2 @name pitch))
(def velocity (in 3 @name velocity))
(def trigger (in 4 @name trigger))
(def clock (in 5 @name clock))
(param hat_a @default 0 @min 0 @max 11)
(param hat_b @default 0 @min 0 @max 11)
(param blend @default 0 @min 0 @max 1)
(param exaggerate @default 0 @min -1 @max 1)
(param release @default 40 @min 5 @max 2000 @unit ms)
(param keytrack @default 1 @min 0 @max 1)
(param tune @default 1 @min 0.5 @max 2)
(param decay @default 1 @min 0.25 @max 4)
(param pedal @default 0 @min 0 @max 1)
(param metal @default 0 @min -24 @max 6 @unit dB)
(param ring @default 1 @min 0.25 @max 1.5)
(param tick @default 1 @min 0 @max 4)
(param sizzle @default 1 @min 0 @max 4)
(param motion @default 1 @min 0 @max 3)
(param tone @default 0 @min -1 @max 1)
(param grit @default 0 @min 0 @max 1)
(param codec @default 1 @min 0 @max 2)
(param record @default 1 @min 0 @max 4)
(param drive @default 1 @min 0.5 @max 4)
(param length @default 1 @min 0.25 @max 4)
(param level @default 1 @min 0 @max 2)
(param test_freeze @default 0 @min 0 @max 1)
;; TPT state-variable filters, state zeroed on the onset (fresh every hit)
(defmacro svf-lp (x gk onset kk)
  (make-history s1)
  (make-history s2)
  (def ic1 (gswitch onset 0 (read-history s1)))
  (def ic2 (gswitch onset 0 (read-history s2)))
  (def a1 (/ 1 (+ 1 (* gk (+ gk kk)))))
  (def a2 (* gk a1))
  (def a3 (* gk a2))
  (def v3 (- x ic2))
  (def v1 (+ (* a1 ic1) (* a2 v3)))
  (def v2 (+ ic2 (* a2 ic1) (* a3 v3)))
  (write-history s1 (- (* 2 v1) ic1))
  (write-history s2 (- (* 2 v2) ic2))
  v2)
(defmacro svf-hp (x gk onset)
  (make-history s1)
  (make-history s2)
  (def ic1 (gswitch onset 0 (read-history s1)))
  (def ic2 (gswitch onset 0 (read-history s2)))
  (def a1 (/ 1 (+ 1 (* gk (+ gk 1.414213562)))))
  (def a2 (* gk a1))
  (def a3 (* gk a2))
  (def v3 (- x ic2))
  (def v1 (+ (* a1 ic1) (* a2 v3)))
  (def v2 (+ ic2 (* a2 ic1) (* a3 v3)))
  (write-history s1 (- (* 2 v1) ic1))
  (write-history s2 (- (* 2 v2) ic2))
  (- x (* 1.414213562 v1) v2))
;; one Butterworth split: x + glo (x - hp) + ghp hp + gbp bp
(defmacro svf-split (x gk onset glo ghp gbp)
  (make-history s1)
  (make-history s2)
  (def ic1 (gswitch onset 0 (read-history s1)))
  (def ic2 (gswitch onset 0 (read-history s2)))
  (def a1 (/ 1 (+ 1 (* gk (+ gk 1.414213562)))))
  (def a2 (* gk a1))
  (def a3 (* gk a2))
  (def v3 (- x ic2))
  (def v1 (+ (* a1 ic1) (* a2 v3)))
  (def v2 (+ ic2 (* a2 ic1) (* a3 v3)))
  (write-history s1 (- (* 2 v1) ic1))
  (write-history s2 (- (* 2 v2) ic2))
  (def hp (- x (* 1.414213562 v1) v2))
  (+ x (* glo (- x hp)) (* ghp hp) (* gbp v1)))
(defmacro svf-ell (x gk onset kk ir)
  (make-history s1)
  (make-history s2)
  (def ic1 (gswitch onset 0 (read-history s1)))
  (def ic2 (gswitch onset 0 (read-history s2)))
  (def a1 (/ 1 (+ 1 (* gk (+ gk kk)))))
  (def a2 (* gk a1))
  (def a3 (* gk a2))
  (def v3 (- x ic2))
  (def v1 (+ (* a1 ic1) (* a2 v3)))
  (def v2 (+ ic2 (* a2 ic1) (* a3 v3)))
  (write-history s1 (- (* 2 v1) ic1))
  (write-history s2 (- (* 2 v2) ic2))
  (+ v2 (* ir (- x (* kk v1) v2))))
;; tan(pi f / sr) by its [5/4] Pade form (plain arithmetic, clamped at 0.46 sr)
(defmacro svf-g (hz)
  (def x (/ (* pi (clip hz 10 (* 0.46 samplerate))) samplerate))
  (def x2 (* x x))
  (/ (* x (+ 945 (* x2 (+ -105 x2)))) (+ 945 (* x2 (+ -420 (* 15 x2))))))
;; energy (s) of (1 - e^(-t/r)) e^(-t/d), r and d in ms
(defmacro env-energy (r d) (* 0.001 (+ (* 0.5 d) (/ -2 (+ (/ 1 r) (/ 2 d))) (/ 0.5 (+ (/ 1 r) (/ 1 d))))))
;; one hashed white stream (unit variance) from a single uniform draw u
(defmacro nstream (u m) (* 3.4641016 (- (- (* u m) (floor (* u m))) 0.5)))
;; fix pass (CRITIQUE 8): the block-rate direct gains glide (one-pole, 2 ms) instead of stepping under
;; a knob move on a ringing hit; they SNAP to the target on every onset, so a hit whose knobs do not
;; move is bit-exact (in steady state the one-pole sits exactly on its target)
(defmacro glide (target onset)
  (make-history gl_h)
  (def gl_prev (gswitch onset 0 (read-history gl_h)))
  (def gl_v (gswitch onset target (+ gl_prev (* glide_k (- target gl_prev)))))
  (write-history gl_h gl_v)
  gl_v)
;; block-rate (clipped) knobs
(def hat_a_v (clip hat_a 0 11))
(def hat_b_v (clip hat_b 0 11))
(def blend_v (clip blend 0 1))
(def exaggerate_v (clip exaggerate -1 1))
(def release_v (clip release 5 2000))
(def keytrack_v (clip keytrack 0 1))
(def tune_v (clip tune 0.5 2))
(def decay_v (clip decay 0.25 4))
(def pedal_v (clip pedal 0 1))
(def metal_v (clip metal -24 6))
(def ring_v (clip ring 0.25 1.5))
(def tick_v (clip tick 0 4))
(def sizzle_v (clip sizzle 0 4))
(def motion_v (clip motion 0 3))
(def tone_v (clip tone -1 1))
(def grit_v (clip grit 0 1))
(def codec_v (clip codec 0 2))
(def record_v (clip record 0 4))
(def drive_v (clip drive 0.5 4))
(def length_v (clip length 0.25 4))
(def level_v (clip level 0 2))
(def test_freeze_v (clip test_freeze 0 1))
(def kiA (floor (+ hat_a_v 0.5)))
(def kiB (floor (+ hat_b_v 0.5)))
(def bl blend_v)
(def ex exaggerate_v)
(def exP (max ex 0))
(def exE (- ex (* 0.5 (min ex 0))))
(def freeze_on (gt test_freeze_v 0.5))

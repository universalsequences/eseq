(def e-tw (+ (* (peek LS-WARP e-row 0) (max 0 (- 1 (abs (- e-x 0))))) (* (peek LS-WARP e-row 1) (max 0 (- 1 (abs (- e-x 1))))) (* (peek LS-WARP e-row 2) (max 0 (- 1 (abs (- e-x 2))))) (* (peek LS-WARP e-row 3) (max 0 (- 1 (abs (- e-x 3))))) (* (peek LS-WARP e-row 4) (max 0 (- 1 (abs (- e-x 4))))) (* (peek LS-WARP e-row 5) (max 0 (- 1 (abs (- e-x 5))))) (* (peek LS-WARP e-row 6) (max 0 (- 1 (abs (- e-x 6))))) (* (peek LS-WARP e-row 7) (max 0 (- 1 (abs (- e-x 7))))) (* (peek LS-WARP e-row 8) (max 0 (- 1 (abs (- e-x 8))))) (* (peek LS-WARP e-row 9) (max 0 (- 1 (abs (- e-x 9))))) (* (peek LS-WARP e-row 10) (max 0 (- 1 (abs (- e-x 10)))))))
(def e-tau (+ e-t (* e-even (- e-tw e-t))))
(def e-z1 (event-hold (clip (+ (* (- 1 e-tau) (peek LS-CODE e-a 0)) (* e-tau (peek LS-CODE e-b 0)) (mod z1)) -3 3) hit))
(def e-z2 (event-hold (clip (+ (* (- 1 e-tau) (peek LS-CODE e-a 1)) (* e-tau (peek LS-CODE e-b 1)) (mod z2)) -3 3) hit))
(def e-z3 (event-hold (clip (+ (* (- 1 e-tau) (peek LS-CODE e-a 2)) (* e-tau (peek LS-CODE e-b 2)) (mod z3)) -3 3) hit))
(def e-z4 (event-hold (clip (+ (* (- 1 e-tau) (peek LS-CODE e-a 3)) (* e-tau (peek LS-CODE e-b 3)) (mod z4)) -3 3) hit))
(def e-vel (event-hold (clip velocity 0.4 1) hit))
(def e-tune (event-hold tune hit))
(def e-decay (event-hold decay hit))

(def l1-W (tensor @shape [5 128] @file "w1.json"))
(def l1-b (tensor @shape [1 128] @file "b1.json"))
(def l2-W (tensor @shape [128 128] @file "w2.json"))
(def l2-b (tensor @shape [1 128] @file "b2.json"))
(def l3-W (tensor @shape [128 360] @file "w3.json"))
(def l3-b (tensor @shape [1 360] @file "b3.json"))
(def onehot0 (tensor @shape [1 5] @data [1 0 0 0 0]))
(def onehot1 (tensor @shape [1 5] @data [0 1 0 0 0]))
(def onehot2 (tensor @shape [1 5] @data [0 0 1 0 0]))
(def onehot3 (tensor @shape [1 5] @data [0 0 0 1 0]))
(def onehot4 (tensor @shape [1 5] @data [0 0 0 0 1]))
(def dec-x (+ (* e-z1 onehot0) (* e-z2 onehot1) (* e-z3 onehot2) (* e-z4 onehot3) (* e-vel onehot4)))
(def dec-h1 (tanh (+ (matmul dec-x l1-W) l1-b)))
(def dec-h2 (tanh (+ (matmul dec-h1 l2-W) l2-b)))
(def dec-u (+ (matmul dec-h2 l3-W) l3-b))

;; squash each output segment into its bounded physical range
(def raw-mode_freq (exp (+ 1.3862943611198906 (* 8.699514748210191 (sigmoid (shrink dec-u @ranges [0:1,0:32]))))))
(def raw-mode_amp (exp (+ -13.815510557964274 (* 16.11809565095832 (sigmoid (shrink dec-u @ranges [0:1,32:64]))))))
(def raw-mode_decay (exp (+ -6.214608098422191 (* 8.699514748210191 (sigmoid (shrink dec-u @ranges [0:1,64:96]))))))
(def raw-mode_rise (exp (+ -11.512925464970229 (* 10.308952660644293 (sigmoid (shrink dec-u @ranges [0:1,96:128]))))))
(def raw-mode_t0 (exp (+ -13.815510557964274 (* 13.304684934198283 (sigmoid (shrink dec-u @ranges [0:1,128:160]))))))
(def raw-mode_phase (* 3.141592653589793 (tanh (shrink dec-u @ranges [0:1,160:192]))))
(def raw-mode_glide (+ -0.9 (* 3.6999999999999997 (sigmoid (shrink dec-u @ranges [0:1,192:224])))))
(def raw-mode_gtau (exp (+ -8.111728083308073 (* 6.907755278982137 (sigmoid (shrink dec-u @ranges [0:1,224:256]))))))
(def raw-band_amp (exp (+ -11.512925464970229 (* 12.89921982609012 (sigmoid (shrink dec-u @ranges [0:1,256:272]))))))
(def raw-band_d1 (exp (+ -6.214608098422191 (* 5.298317366548036 (sigmoid (shrink dec-u @ranges [0:1,272:288]))))))
(def raw-band_tail (+ 0.0 (* 1.0 (sigmoid (shrink dec-u @ranges [0:1,288:304])))))
(def raw-band_d2 (exp (+ -3.912023005428146 (* 4.605170185988091 (sigmoid (shrink dec-u @ranges [0:1,304:320]))))))
(def raw-band_couple (exp (+ -11.512925464970229 (* 14.508657738524219 (sigmoid (shrink dec-u @ranges [0:1,320:336]))))))
(def raw-noise_rise (exp (+ -9.903487552536127 (* 6.907755278982137 (sigmoid (sum (shrink dec-u @ranges [0:1,336:337])))))))
(def raw-noise_onset (+ 0.0 (* 0.05 (sigmoid (sum (shrink dec-u @ranges [0:1,337:338]))))))
(def raw-pre (+ 0.0 (* 0.035 (sigmoid (sum (shrink dec-u @ranges [0:1,338:339]))))))
(def raw-drive (exp (+ 0.0 (* 1.791759469228055 (sigmoid (sum (shrink dec-u @ranges [0:1,339:340])))))))
(def raw-drive_amt (+ 0.0 (* 1.0 (sigmoid (sum (shrink dec-u @ranges [0:1,340:341]))))))
(def raw-drive_norm (exp (+ -2.3025850929940455 (* 2.995732273553991 (sigmoid (sum (shrink dec-u @ranges [0:1,341:342])))))))
(def raw-gain (exp (+ -2.995732273553991 (* 5.075173815233827 (sigmoid (sum (shrink dec-u @ranges [0:1,342:343])))))))
(def raw-len (exp (+ -2.5257286443082556 (* 3.218875824868201 (sigmoid (sum (shrink dec-u @ranges [0:1,343:344])))))))
(def raw-fade (exp (+ -5.298317366548036 (* 2.7725887222397807 (sigmoid (sum (shrink dec-u @ranges [0:1,344:345])))))))
(def raw-fade_curve (+ 0.0 (* 1.0 (sigmoid (sum (shrink dec-u @ranges [0:1,345:346]))))))
(def raw-gh_depth (+ 0.0 (* 1.0 (sigmoid (sum (shrink dec-u @ranges [0:1,346:347]))))))
(def raw-gh_time (exp (+ -3.506557897319982 (* 4.199705077879927 (sigmoid (sum (shrink dec-u @ranges [0:1,347:348])))))))
(def raw-gh_fall (exp (+ -6.907755278982137 (* 5.298317366548036 (sigmoid (sum (shrink dec-u @ranges [0:1,348:349])))))))
(def raw-gd_depth (+ 0.0 (* 1.0 (sigmoid (sum (shrink dec-u @ranges [0:1,349:350]))))))
(def raw-gd_time (exp (+ -3.506557897319982 (* 4.199705077879927 (sigmoid (sum (shrink dec-u @ranges [0:1,350:351])))))))
(def raw-gd_fall (exp (+ -6.907755278982137 (* 5.298317366548036 (sigmoid (sum (shrink dec-u @ranges [0:1,351:352])))))))
(def raw-gate_noise (+ 0.0 (* 1.0 (sigmoid (sum (shrink dec-u @ranges [0:1,352:353]))))))
(def raw-clip_ceil (exp (+ -2.995732273553991 (* 4.382026634673881 (sigmoid (sum (shrink dec-u @ranges [0:1,353:354])))))))
(def raw-clip_mix (+ 0.0 (* 1.0 (sigmoid (sum (shrink dec-u @ranges [0:1,354:355]))))))
(def raw-wire_thr (exp (+ -5.521460917862246 (* 4.31748811353631 (sigmoid (sum (shrink dec-u @ranges [0:1,355:356])))))))
(def raw-wire_level (exp (+ -6.907755278982137 (* 10.596634733096073 (sigmoid (sum (shrink dec-u @ranges [0:1,356:357])))))))
(def raw-wire_lo (exp (+ 5.0106352940962555 (* 3.5065578973199827 (sigmoid (sum (shrink dec-u @ranges [0:1,357:358])))))))
(def raw-wire_hi (exp (+ 7.090076835776092 (* 2.5902671654458267 (sigmoid (sum (shrink dec-u @ranges [0:1,358:359])))))))
(def raw-wire_k (exp (+ -2.120263536200091 (* 2.8134107167600364 (sigmoid (sum (shrink dec-u @ranges [0:1,359:360])))))))

;; post-decoder performance controls (still on the event clock)
;; note tracking: trained at C4 (261.6256 Hz), so C4 is exact; like VILLAIN, clipped to +-2 octaves
(def e-note (event-hold (clip (/ pitch 261.6255653) 0.25 4) hit))
(def e-ratio (* e-note (exp (* e-tune 0.057762265046662105))))
(def ev-f (* raw-mode_freq e-ratio))
(def ev-sh (* ev-f raw-mode_glide))
(def ev-nyq (clip (/ (- (* 0.48 samplerate) (+ ev-f (max ev-sh 0))) (* 0.08 samplerate)) 0 1))
(def ev-amp (* raw-mode_amp ev-nyq))
(def ev-idec (/ 1 (* raw-mode_decay e-decay)))
(def ev-irise (/ 1 raw-mode_rise))
(def ev-phc (* raw-mode_phase 0.15915494309189535))
(def ev-itau (/ 1 raw-mode_gtau))
(def ev-shtau (* ev-sh raw-mode_gtau))
(def ev-bid1 (/ 1 (* raw-band_d1 e-decay)))
(def ev-bid2 (/ 1 (* raw-band_d2 e-decay)))
(def ev-bfast (* raw-band_amp (- 1 raw-band_tail)))
(def ev-bslow (* raw-band_amp raw-band_tail))

;; ---- back to audio rate ----------------------------------------------------
(def m-f (latch ev-f hit))
(def m-amp (latch ev-amp hit))
(def m-idec (latch ev-idec hit))
(def m-irise (latch ev-irise hit))
(def m-t0 (latch raw-mode_t0 hit))
(def m-phc (latch ev-phc hit))
(def m-itau (latch ev-itau hit))
(def m-shtau (latch ev-shtau hit))
(def b-id1 (latch ev-bid1 hit))
(def b-id2 (latch ev-bid2 hit))
(def b-fast (latch ev-bfast hit))
(def b-slow (latch ev-bslow hit))
(def b-couple (latch raw-band_couple hit))
(def g-nirise (event-latch (/ 1 raw-noise_rise) hit))
(def g-nonset (event-latch raw-noise_onset hit))
(def g-pre (event-latch raw-pre hit))
(def g-dv (event-latch raw-drive hit))
(def g-damt (event-latch raw-drive_amt hit))
(def g-dnorm (event-latch raw-drive_norm hit))
(def g-gain (event-latch raw-gain hit))
(def g-fstart (event-latch (- raw-len raw-fade) hit))
(def g-ifade (event-latch (/ 1 raw-fade) hit))
(def g-fcurve (event-latch raw-fade_curve hit))
(def g-ghd (event-latch raw-gh_depth hit))
(def g-ght (event-latch raw-gh_time hit))
(def g-ghif (event-latch (/ 1 raw-gh_fall) hit))
(def g-gdd (event-latch raw-gd_depth hit))
(def g-gdt (event-latch raw-gd_time hit))
(def g-gdif (event-latch (/ 1 raw-gd_fall) hit))
(def g-gnoise (event-latch raw-gate_noise hit))
(def g-cceil (event-latch raw-clip_ceil hit))
(def g-cinv (event-latch (/ 1 raw-clip_ceil) hit))
(def g-cmix (event-latch raw-clip_mix hit))

;; ---- modal bank (closed form, per sample) ----------------------------------
;; t_k = max(0, max(0, T - pre) - t0_k)
;; m_k = amp_k e^(-t idec_k) (1 - e^(-t irise_k)) sin(2 pi (f_k t + sh_k tau_k (1 - e^(-t/tau_k))) + ph_k)
(def head-T (max 0 (- age g-pre)))
;; gates G = 1 - depth * smoothstep((T - time) / fall); GH*GD scale every mode, GD also
;; scales a gate_noise share of the noise layer
(def gh-x (clip (* (- head-T g-ght) g-ghif) 0 1))
(def gate-h (- 1 (* g-ghd gh-x gh-x (- 3 (* 2 gh-x)))))
(def gd-x (clip (* (- head-T g-gdt) g-gdif) 0 1))
(def gate-d (- 1 (* g-gdd gd-x gd-x (- 3 (* 2 gd-x)))))
(def mode-t (max 0 (- head-T m-t0)))
(def mode-env (* m-amp (* gate-h gate-d) (exp (* -1 mode-t m-idec)) (- 1 (exp (* -1 mode-t m-irise)))))
(def mode-cyc (+ (* m-f mode-t) (* m-shtau (- 1 (exp (* -1 mode-t m-itau)))) m-phc))
(def head (sum (* mode-env (sin (* twopi mode-cyc)))))
(def head-e (sqrt (+ (sum (* mode-env mode-env)) 1e-10)))

;; ---- 16-band noise (NOISE_BANDS.md) ----------------------------------------
;; N_b = norm_b * BP_b(BP_b(white)), RBJ constant-0dB-peak band-pass, Q 1.8, DF1
(def band-fc (tensor @shape [1 16] @data [100 141.368126 199.84947 282.52345 399.398106 564.621617 798.194998 1128.39331 1595.18847 2255.08805 3187.97571 4506.78151 6371.15255 9006.77896 12732.7146 18000]))
(def band-w0 (/ (* twopi band-fc) samplerate))
(def band-alpha (/ (sin band-w0) 3.6))
(def band-b0 (/ band-alpha (+ 1 band-alpha)))
(def band-a1 (/ (* -2 (cos band-w0)) (+ 1 band-alpha)))
(def band-a2 (/ (- 1 band-alpha) (+ 1 band-alpha)))
;; unit-RMS normalisation of the cascade, exact at the tabulated rates
(def band-norm (gswitch (lt samplerate 46050) (tensor @shape [1 16] @data [22.4805188 18.9078114 15.9032842 13.3768402 11.2528452 9.46792182 7.96915446 6.71267328 5.66261445 4.79048807 4.07506516 3.50314163 3.07250248 2.80282877 2.78725866 3.66478377])
                 (gswitch (lt samplerate 68100) (tensor @shape [1 16] @data [23.4534094 19.7260102 16.5913414 13.9553787 11.7391681 9.87651332 8.31208291 6.99990359 5.90222694 4.98879155 4.23656462 3.63022883 3.16436225 2.85124948 2.7548739 3.23486918])
                   (gswitch (lt samplerate 92100) (tensor @shape [1 16] @data [31.7916662 26.7386956 22.4889827 18.9149295 15.90927 13.3818732 11.2570757 9.47147584 7.97213679 6.71517034 5.66469609 4.79220845 4.07646226 3.50423402 3.07327805 2.8032005]) (tensor @shape [1 16] @data [33.1676114 27.8959211 23.4622397 19.7334366 16.5975866 13.9606299 11.7435826 9.88022249 8.31519652 7.00251237 5.90440466 4.9905962 4.23803829 3.63139541 3.16521914 2.85173661])))))
;; zero-mean, unit-variance white: dgen (noise) is xorshift32 uniform [0,1)
(def white (* 3.4641016 (- (noise) 0.5)))
(make-history nx1)
(make-history nx2)
(def white-x2 (read-history nx2))
(write-history nx2 (read-history nx1))
(write-history nx1 white)
(make-tensor-history s1y1 @shape [1 16])
(make-tensor-history s1y2 @shape [1 16])
(make-tensor-history s2y1 @shape [1 16])
(make-tensor-history s2y2 @shape [1 16])
(def s1-1 (read-tensor-history s1y1))
(def s1-2 (read-tensor-history s1y2))
(def s2-1 (read-tensor-history s2y1))
(def s2-2 (read-tensor-history s2y2))
(def stage1 (- (* band-b0 (- white white-x2)) (+ (* band-a1 s1-1) (* band-a2 s1-2))))
(def stage2 (- (* band-b0 (- stage1 s1-2)) (+ (* band-a1 s2-1) (* band-a2 s2-2))))
(write-tensor-history s1y2 s1-1)
(write-tensor-history s1y1 stage1)
(write-tensor-history s2y2 s2-1)
(write-tensor-history s2y1 stage2)
(def bands (* band-norm stage2))
;; env_b = (1 - e^(-t/rise)) (A_b ((1-L_b) e^(-t/d1_b) + L_b e^(-t/d2_b))) + C_b E(t),
;; t = max(0, T - onset), E = head amplitude-envelope RMS (wire coupling)
(def noise-t (max 0 (- age g-nonset)))
(def noise-att (- 1 (exp (* -1 noise-t g-nirise))))
(def band-env (+ (* noise-att (+ (* b-fast (exp (* -1 noise-t b-id1))) (* b-slow (exp (* -1 noise-t b-id2)))))
                 (* b-couple head-e)))
(def noise-out (* (- 1 (* g-gnoise (- 1 gate-d))) (sum (* band-env bands))))

;; ---- drive, length fade, declick, output -----------------------------------
;; wire knobs on the hit's event clock (decoder outputs / fixed family constants)
(def ev-w-drive 1.2)
(def ev-w-gap (* raw-wire_thr ev-w-drive))
(def ev-w-hz 620.0)
(def ev-w-t60 1.0)
(def ev-w-level raw-wire_level)
(def ev-w-lo raw-wire_lo)
(def ev-w-hi raw-wire_hi)
(def ev-w-k raw-wire_k)
;; ---- snare wires (E5): 2 detuned 2-mode strands, one-sided contact (VILLAIN / Modal Snare) ----
;; z = 0.06 drive head; per strand w = w1 + w2/2 (damped 2-poles at hz and 2.41 hz, T60 t60 / 0.4 t60 ms),
;; ov = clip(z - w - 0.06 gap, 0, 0.02); push = ov (1 + 0.8 min(1000 ov, 1)) kicks both poles;
;; contact = sum ov -> two leaky DC blockers -> x60 level -> SVF HP lo -> SVF LP hi (damping k).
(def w-det (tensor @shape [1 2] @data [0.951 1.062]))
(def ev-w-r1 (exp (/ -6.9077553 (* samplerate 0.001 ev-w-t60))))
(def ev-w-r2 (exp (/ -6.9077553 (* samplerate 0.0004 ev-w-t60))))
(def ev-w-wc1 (* twopi (/ (clip ev-w-hz 20 (* 0.2 samplerate)) samplerate)))
(def ev-w-wc2 (* twopi (/ (clip (* 2.41 ev-w-hz) 20 (* 0.3 samplerate)) samplerate)))
(def w-c1 (latch (* 2 ev-w-r1 (cos (* ev-w-wc1 w-det))) hit))
(def w-c2 (latch (* 2 ev-w-r2 (cos (* ev-w-wc2 w-det))) hit))
(def w-q1 (event-latch (* ev-w-r1 ev-w-r1) hit))
(def w-q2 (event-latch (* ev-w-r2 ev-w-r2) hit))
(def w-zk (event-latch (* 0.06 ev-w-drive) hit))
(def w-gv (event-latch (* 0.06 ev-w-gap) hit))
(def w-lv (event-latch (* 60 ev-w-level) hit))
(def w-glo (event-latch (wire-svf-g ev-w-lo) hit))
(def w-ghi (event-latch (wire-svf-g ev-w-hi) hit))
(def w-k (event-latch ev-w-k hit))
(def w-z (* w-zk head))
(make-tensor-history wy1 @shape [1 2])
(make-tensor-history wy2 @shape [1 2])
(make-tensor-history wu1 @shape [1 2])
(make-tensor-history wu2 @shape [1 2])
(def w-y1 (read-tensor-history wy1))
(def w-y2 (read-tensor-history wy2))
(def w-u1 (read-tensor-history wu1))
(def w-u2 (read-tensor-history wu2))
(def w-m1 (- (* w-c1 w-y1) (* w-q1 w-y2)))
(def w-m2 (- (* w-c2 w-u1) (* w-q2 w-u2)))
(def w-ov (min (max (- w-z w-m1 (* 0.5 w-m2) w-gv) 0) 0.02))
(def w-push (* w-ov (+ 1 (* 0.8 (min (* w-ov 1000) 1)))))
(write-tensor-history wy2 w-y1)
(write-tensor-history wy1 (+ w-m1 (* w-push 0.769)))
(write-tensor-history wu2 w-u1)
(write-tensor-history wu1 (+ w-m2 (* w-push 0.4615)))
(def w-app (sum w-ov))
(make-history wcm1)
(make-history wcm2)
(def w-cp1 (read-history wcm1))
(def w-cl1 (+ w-cp1 (* 0.1 (- w-app w-cp1))))
(write-history wcm1 w-cl1)
(def w-ca (- w-app w-cl1))
(def w-cp2 (read-history wcm2))
(def w-cl2 (+ w-cp2 (* 0.1 (- w-ca w-cp2))))
(write-history wcm2 w-cl2)
(def wire-raw (* w-lv (- w-ca w-cl2)))
(def wire-out (wire-svf-lp (wire-svf-hp wire-raw w-glo 1.414213562) w-ghi w-k))

(def dry (+ head noise-out wire-out))
(def driven0 (+ dry (* g-damt (- (* (tanh (* dry g-dv)) g-dnorm) dry))))
(def clip-u (* driven0 g-cinv))
(def clip-u2 (* clip-u clip-u))
(def driven (+ driven0 (* g-cmix (- (* g-cceil (/ clip-u (sqrt (sqrt (+ 1 (* clip-u2 clip-u2)))))) driven0))))
(def fade-x (clip (* (- age g-fstart) g-ifade) 0 1))
(def fade-1 (- 1 (* fade-x fade-x (- 3 (* 2 fade-x)))))
(def fade-2 (* fade-1 fade-1))
(def fade (+ (* fade-1 (- 1 g-fcurve)) (* fade-2 fade-2 g-fcurve)))
(def shaped (* driven fade g-gain))
;; On a retrigger the previous hit is cut; carry its last output sample and let
;; it fall over ~1 ms so the cut never steps.
(make-history last-out)
(make-history carry-h)
(def carry (gswitch hit (read-history last-out) (* (read-history carry-h) (exp (/ -1000 samplerate)))))
(write-history carry-h carry)
;; Velocity: the decoder was trained at velocities 0.4/0.7/1.0 only, so its input is clamped to
;; [0.4, 1] (timbre as trained) and a plain gain v/0.4 carries the level below 0.4 (VILLAIN's slope there).
(def vel-gain (event-hold (min 1 (/ (clip velocity 0 1) 0.4)) hit))
(def voice-out (* (+ shaped carry) level vel-gain))
(write-history last-out (+ shaped carry))
(out voice-out 1 @name audio)
(use-defmacro voice-amp)
(out (voice-amp 0 voice-out voice-out) 2 @name amp @amp true)

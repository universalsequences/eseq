;; Latent Snare A/B (E6) -- GENERATED by e6/build_instrument.py from e7/Latent Snare (E2 gen_dsp.py + E5 wire_block(2)).
;; Snare A, Snare B, Blend = the straight line z = (1-tau) z_A + tau z_B in the decoder's latent space, tau =
;; a per-pair perceptual arc-length warp of blend (even = 1) so equal blend steps sound like equal steps;
;; z1..z4 are offsets on top (knob units). Decoder weights: E6 path fine-tune (exact at the 32 snares).
;; (e5/wire_splice.py wire_block(2)); wire knobs = decoder outputs 355-359, drive/hz/t60 fixed 1.2/620/1.0.
;;
;; A 5->128->128->360 tanh MLP decoder maps (z1..z4, velocity) to the physical
;; parameters of a 32-mode closed-form modal bank, a 16-band filtered-noise layer
;; and the output stage. The decoder runs ONLY on the onset frame of each hit:
;; its inputs are sampled with (event-hold x hit), so the matmuls and squashes
;; are scheduled on the hit event clock, and results come back to audio rate
;; through a final (latch .. hit) (tensors) or (event-latch .. hit) (scalars).
;; Per sample: the closed-form bank (3 exp + 1 sin per mode, NEON), 16 x 2 RBJ
;; band-pass biquads on one white-noise source, closed-form envelopes, drive, fade.
;; The numpy twin is reference_render.py; decoder contract: decoder_layout.json.
;;
;; Weights: w1/b1/w2/b2/w3/b3.json next to this file, {"shape":[r,c],"data":[...]}
;; ROW-MAJOR (numpy C order), y = x[1,in] @ W[in,out] + b (see REPORT.md).

(def gate (in 1 @name gate))
(def pitch (in 2 @name pitch))
(def velocity (in 3 @name velocity))
(def trigger (in 4 @name trigger))
(def clock (in 5 @name clock))
(def mod1 (in 6 @name mod1 @modulator 1))
(def mod2 (in 7 @name mod2 @modulator 2))
(def mod3 (in 8 @name mod3 @modulator 3))
(def mod4 (in 9 @name mod4 @modulator 4))
(param snare_a @default 0 @min 0 @max 31)
(param snare_b @default 0 @min 0 @max 31)
(param blend @default 0 @min 0 @max 1 @mod true @mod-mode additive)
(param even @default 1 @min 0 @max 1)
(param z1 @default 0 @min -3 @max 3 @mod true @mod-mode additive)
(param z2 @default 0 @min -3 @max 3 @mod true @mod-mode additive)
(param z3 @default 0 @min -3 @max 3 @mod true @mod-mode additive)
(param z4 @default 0 @min -3 @max 3 @mod true @mod-mode additive)
(param tune @default 0 @min -24 @max 24 @unit st)
(param decay @default 1 @min 0.25 @max 2)
(param level @default 0.5 @min 0 @max 2)

(defmacro onset-of (trig)
  (make-history previous)
  (def high (gt trig 0.5))
  (def rising (* high (lte (read-history previous) 0.5)))
  (write-history previous high)
  rising)

;; Seconds since the last onset (0 on the onset frame). Returns 0 before the
;; first hit and after a 30 s cap; at T=0 every envelope's (1 - e^(-T/rise))
;; factor is 0, so a frozen T can never leave a DC offset.
(defmacro hit-age (onset)
  (make-history elapsed)
  (make-history armed)
  (def played (max onset (read-history armed)))
  (write-history armed played)
  (def samples (gswitch onset 0 (min (* 30 samplerate) (+ 1 (read-history elapsed)))))
  (write-history elapsed samples)
  (def alive (* played (lt samples (* 30 samplerate))))
  (* alive (/ samples samplerate)))

;; TPT state-variable filter steps (VILLAIN svf-lp / svf-hp, no onset reset) + Pade prewarp
(defmacro wire-svf-g (hz)
  (def x (/ (* pi (clip hz 10 (* 0.33 samplerate))) samplerate))
  (/ (* x (- 15 (* x x))) (- 15 (* 6 x x))))
(defmacro wire-svf-lp (x gk kk)
  (make-history s1)
  (make-history s2)
  (def ic1 (read-history s1))
  (def ic2 (read-history s2))
  (def a1 (/ 1 (+ 1 (* gk (+ gk kk)))))
  (def a2 (* gk a1))
  (def a3 (* gk a2))
  (def v3 (- x ic2))
  (def v1 (+ (* a1 ic1) (* a2 v3)))
  (def v2 (+ ic2 (* a2 ic1) (* a3 v3)))
  (write-history s1 (- (* 2 v1) ic1))
  (write-history s2 (- (* 2 v2) ic2))
  v2)
(defmacro wire-svf-hp (x gk kk)
  (make-history s1)
  (make-history s2)
  (def ic1 (read-history s1))
  (def ic2 (read-history s2))
  (def a1 (/ 1 (+ 1 (* gk (+ gk kk)))))
  (def a2 (* gk a1))
  (def a3 (* gk a2))
  (def v3 (- x ic2))
  (def v1 (+ (* a1 ic1) (* a2 v3)))
  (def v2 (+ ic2 (* a2 ic1) (* a3 v3)))
  (write-history s1 (- (* 2 v1) ic1))
  (write-history s2 (- (* 2 v2) ic2))
  (- x (* kk v1) v2))

(def hit (onset-of trigger))
(def age (hit-age hit))


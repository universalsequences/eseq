;; Compact performance surface. DSP voicing and presets remain intact.
;; Graphics show named analytic mechanisms, not rendered audio.
(defsynth-ui
  (eseq.effects.drum-surface/panel "DIGI HAT"
    (list
      (list "Play" (list "tune" "Tune" 1 nil) (list "dec" "Decay" 0 nil))
      (list "Machine" (list "humanize" "Humanize" 2 nil) (list "level" "Level" 2 nil))
      (list "Filter" (list "fltf" "Freq" 0 nil) (list "fltw" "Width" 0 nil))
      (list "Color" (list "dist" "Distortion" 2 nil) (list "srr" "Crush" 2 nil)))
    (list
      (dict :title "Play" :controls (lambda () (list (list "engine" "Engine" 0 '("TRX-HH" "EFM-HH" "PI-HH")) (list "sustain" "Sustain" 2 nil) (list "release" "Release" 0 nil) (list "tune" "Tune" 1 nil) (list "dec" "Decay" 0 nil) (list "humanize" "Humanize" 2 nil) (list "level" "Level" 2 nil)))
        :visual (lambda () (eseq.effects.drum-surface/dsr-envelope (eseq.effects.drum-surface/bind "dec"))))
      (dict :title "Machine" :controls (lambda () (if (= (eseq.effects.drum-surface/value "engine") 1) (list (list "gap" "Gap" 2 nil) (list "mtal" "Metal" 2 nil) (list "hpf" "Hpf" 0 nil) (list "lpf" "Lpf" 0 nil)) (if (= (eseq.effects.drum-surface/value "engine") 2) (list (list "ptch" "Pitch" 1 nil) (list "trem" "Trem" 2 nil) (list "tfrq" "Trem rate" 0 nil) (list "mod_amt" "FM depth" 2 nil) (list "mfrq" "FM freq" 0 nil) (list "mdec" "FM decay" 0 nil) (list "fb" "Feedback" 2 nil)) (list (list "ptch" "Pitch" 1 nil) (list "clsn" "Collision" 2 nil) (list "ring" "Ring" 2 nil) (list "ag" "Air" 2 nil) (list "au" "Damping" 2 nil) (list "br" "Body" 2 nil) (list "clos" "Closed" 0 nil)))))
        :visual (lambda () (if (= (eseq.effects.drum-surface/value "engine") 1) (eseq.effects.drum-surface/envelope "Low band" (eseq.effects.drum-surface/bind "dec") "High band" (* 0.55 (eseq.effects.drum-surface/value "dec")) "dec" "dec") (if (= (eseq.effects.drum-surface/value "engine") 2) (eseq.effects.drum-surface/envelope "Amplitude" (eseq.effects.drum-surface/bind "dec") "FM depth" (eseq.effects.drum-surface/bind "mdec") "dec" "mdec") (eseq.effects.drum-surface/envelope "First mode" (* (eseq.effects.drum-surface/value "dec") (- 1 (* (/ (eseq.effects.drum-surface/value "clos") 127) 0.85)) (+ 0.20 (* (eseq.effects.drum-surface/value "ring") 1.3))) "Excitation" (eseq.effects.drum-surface/bind "dec") "dec" "dec")))))
      (dict :title "Filter" :controls (lambda () (list (list "fltf" "Freq" 0 nil) (list "fltw" "Width" 0 nil) (list "fltq" "Filter Q" 2 nil) (list "eqf" "EQ freq" 0 nil) (list "eqg" "EQ gain" 1 nil)))
        :visual (lambda () (if (= (eseq.effects.drum-surface/value "engine") 1) (eseq.effects.drum-surface/envelope "Low band" (eseq.effects.drum-surface/bind "dec") "High band" (* 0.55 (eseq.effects.drum-surface/value "dec")) "dec" "dec") (if (= (eseq.effects.drum-surface/value "engine") 2) (eseq.effects.drum-surface/envelope "Amplitude" (eseq.effects.drum-surface/bind "dec") "FM depth" (eseq.effects.drum-surface/bind "mdec") "dec" "mdec") (eseq.effects.drum-surface/envelope "First mode" (* (eseq.effects.drum-surface/value "dec") (- 1 (* (/ (eseq.effects.drum-surface/value "clos") 127) 0.85)) (+ 0.20 (* (eseq.effects.drum-surface/value "ring") 1.3))) "Excitation" (eseq.effects.drum-surface/bind "dec") "dec" "dec")))))
      (dict :title "Color" :controls (lambda () (list (list "dist" "Distortion" 2 nil) (list "srr" "Crush" 2 nil) (list "amd" "AM depth" 2 nil) (list "amf" "AM rate" 0 nil)))
        :visual (lambda () (if (= (eseq.effects.drum-surface/value "engine") 1) (eseq.effects.drum-surface/envelope "Low band" (eseq.effects.drum-surface/bind "dec") "High band" (* 0.55 (eseq.effects.drum-surface/value "dec")) "dec" "dec") (if (= (eseq.effects.drum-surface/value "engine") 2) (eseq.effects.drum-surface/envelope "Amplitude" (eseq.effects.drum-surface/bind "dec") "FM depth" (eseq.effects.drum-surface/bind "mdec") "dec" "mdec") (eseq.effects.drum-surface/envelope "First mode" (* (eseq.effects.drum-surface/value "dec") (- 1 (* (/ (eseq.effects.drum-surface/value "clos") 127) 0.85)) (+ 0.20 (* (eseq.effects.drum-surface/value "ring") 1.3))) "Excitation" (eseq.effects.drum-surface/bind "dec") "dec" "dec"))))))))

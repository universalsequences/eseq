(def g-follow (clip follow 0 1))
;; level follow: each slot / band may only FALL from its strike level toward the level decoded
;; at z(t) (follow 0 = strike levels kept, 1 = down to z(t)'s); a morph never adds energy
(def m-c (exp (* g-follow (min (- m-lr m-lamA) 0))))
(def n-fc (exp (* g-follow (min (- n-lfr n-lfA) 0))))
(def n-sc (exp (* g-follow (min (- n-lsr n-lsA) 0))))
;; morph position at audio rate (gate / length crossfade): exactly 0 on the hit
(def g-w (* (clip amount 0 1) (exp (* (exp (* (clip curve -1 1) 1.3862943611198906))
                                     (log (max (clip (/ age (* (clip morph 1 10000) 0.001)) 0 1) 1e-9))))))

;; ---- time bases, gates -----------------------------------------------------
(def T (mix age (* age g-tuning) p-samp))
(def fmul (mix g-tuning 1 p-samp))
(def tstep (/ (mix 1 g-tuning p-samp) samplerate))
(def Tw-e (exp (/ (- 0 T) p-wtau)))
(def Tw (+ T (* p-wk g-bendE p-wtau (- 1 Tw-e))))
(def dTw (* tstep (+ 1 (* p-wk g-bendE Tw-e))))
;; START and END gate envelopes, crossfaded by w(t), never re-opening
(def GA-A (kick-gate age A-holdA A-relA A-gA_wexp A-gA_wrat A-gA_wss A-gA_pe A-gA_tmix A-tailA A-gA_floor))
(def GB-A (kick-gate age A-holdB A-relB A-gB_wexp 0 A-gB_wss A-gB_pe 0 A-tailB 0))
(def GA-B (kick-gate age B-holdA B-relA B-gA_wexp B-gA_wrat B-gA_wss B-gA_pe B-gA_tmix B-tailA B-gA_floor))
(def GB-B (kick-gate age B-holdB B-relB B-gB_wexp 0 B-gB_wss B-gB_pe 0 B-tailB 0))
(make-history GA-h)
(def GA (gswitch hit (mix GA-A GA-B g-w) (min (mix GA-A GA-B g-w) (read-history GA-h))))
(write-history GA-h GA)
(make-history GB-h)
(def GB (gswitch hit (mix GB-A GB-B g-w) (min (mix GB-A GB-B g-w) (read-history GB-h))))
(write-history GB-h GB)

;; ---- 24-slot modal bank, VILLAIN drop law (second drop on slots 0..3) + morph corrections ----
(def mt (max 0 (- T m-t0)))
(def mtw (max 0 (- Tw m-t0)))
(def mse (exp (* (- 0 mtw) m-itau)))
(def mse2 (exp (* (- 0 mtw) m-itau2)))
(def mhz2 (* m-sh2 mse2))
(def mph2 (* m-sh2tau2 (- 1 mse2)))
(def mhz (* fmul (+ m-f (* m-sh mse) mhz2)))
;; instantaneous slot frequency at z(t): the drop law with ramped f / depths, latched time constants
(def mhz-r (* fmul (+ m-fr (* m-shr mse) (* m-sh2r mse2))))
;; phase correction (cycles, wrapped): integral of (hz(t) - hz_A(t)) over the slot's warped time
(make-tensor-history mCp @shape [1 24])
(def m-Cp-adv (+ (read-tensor-history mCp) (* (gt mtw 0) dTw (- mhz-r mhz))))
(def m-Cp (gswitch hit 0 (- m-Cp-adv (floor m-Cp-adv))))
(write-tensor-history mCp m-Cp)
;; decay correction (log domain): Ld = integral of (idec(t) - idec_A) dt once the slot has started
(make-tensor-history mLd @shape [1 24])
(def m-Ld (gswitch hit 0 (+ (read-tensor-history mLd) (* (gt mt 0) tstep (- L-idec m-idec)))))
(write-tensor-history mLd m-Ld)
(def mg (* m-amp (exp (- (* (- 0 mt) m-idec) m-Ld)) (- 1 (exp (* (- 0 mt) m-irise)))
          (clip (/ (- (* 0.48 samplerate) mhz-r) (* 0.08 samplerate)) 0 1)
          (- 1 (* m-mga (- 1 GA))) (- 1 (* m-mgb (- 1 GB))) m-c))
(def mm (* mg (sin (+ (* twopi fmul (+ (* m-f mtw) (* m-sh m-tau (- 1 mse)) mph2)) m-ph (* twopi m-Cp)))))
(def bank (sum mm))
(def bank-msm (sum (* m-msm mm)))
(def bank-dc (sum (* m-msm mg mg)))
(def bank-esq (sum (* mg mg)))

;; ---- transients (ticks / pulses): the strike, latched -----------------------
(def xt (max 0 (- T x-t0)))
(def xse (exp (* (- 0 xt) x-itau)))
(def xm (* x-amp (exp (* (- 0 xt) x-idec)) (- 1 (exp (* (- 0 xt) x-irise))) (- 1 (* x-mgb (- 1 GB)))
          (sin (+ (* twopi fmul (+ (* x-f xt) (* x-sh x-tau (- 1 xse)))) x-ph))))
(def trans (sum xm))
(def trans-msm (sum (* x-msm xm)))
(def modal (+ bank trans))

;; ---- growl (one gliding clipped sine, 35 Hz) --------------------------------
(def gr-shift (max -31.5 (* g-bendE p-gr_dl)))
(def gr-settle (exp (/ (- 0 T) p-gr_tau)))
(def gr-ph (+ (* twopi fmul (+ (* 35 T) (* gr-shift p-gr_tau (- 1 gr-settle)))) p-gr_off))
(def gr-hz (* fmul (+ 35 (* gr-shift gr-settle))))
(def gr-aud (clip (/ (- (* 0.02 samplerate) gr-hz) (* 0.008 samplerate)) 0 1))
(def gr-sin (sin gr-ph))
(def gr-wave (- (clip gr-sin -1 p-gr_clip) (+ p-gr_a (* p-gr_b gr-sin))))
(def gr-env (* (+ (* 0.5 (exp (/ (- 0 T) (* g-decay p-gr_d1)))) (* 0.5 (exp (/ (- 0 T) (* g-decay p-gr_d2)))))
              (- 1 (exp (/ (- 0 T) (* g-attack 0.004))))))
(def growl (* g-body g-growl p-gr_amp gr-aud gr-env gr-wave))

;; ---- burst ------------------------------------------------------------------
(def bu-dt (- (mix age (* age g-tuning) p-bu_samp) p-bu_tc))
(def bu-z (/ bu-dt p-bu_w))
(def bu-g (exp (* -0.5 (min 60 (* bu-z bu-z)))))
(def bu-h (- 0.5 (* 0.5 (cos (* twopi (clip bu-z 0 1))))))
(def burst (* g-tickE p-bu_amp (mix bu-g bu-h p-bu_hann) (sin (+ (* twopi p-bu_f bu-dt) p-bu_off))))

(def bank-all (+ modal growl burst))
(def bank-sh (+ bank-msm trans-msm (* p-bu_sm burst)))

;; ---- body shaper, bark, 18 Hz body HP ---------------------------------------
(def xin (* g-vpreE bank-sh))
(def xcl (clip xin (- 0 p-sh_ecl) p-sh_ecl))
(def sh-even (* g-shape (- (* xcl xcl (+ p-sh_ec (* xcl (+ p-sh_p3 (* xcl (+ p-sh_p4 (* xcl p-sh_p5)))))))
                           (* p-sh_ec p-sh_ed g-vpreE g-vpreE 0.5 bank-dc))))
(def sh-odd (* g-shape p-sh_oc (- (* p-sh_ow (tanh (/ xin p-sh_ow))) xin)))
(def sh-y0 (+ xin sh-even sh-odd))
(def sh-y1 (mix sh-y0 (* (sign sh-y0) (rat-side (abs sh-y0) (/ 1 (max 0.000001 (* p-sh_rg g-shape))) 4)) p-sh_rk))
(def sat-gain (max 0.01 (* p-sat_g (mix 1 g-shape p-sat_on))))
(def sat-ref (tanh p-sat_b))
(def sat-norm (/ 0.8 (- (tanh (+ (* 0.8 sat-gain) p-sat_b)) sat-ref)))
(def shaped (mix sh-y1 (* sat-norm (- (tanh (+ (* sat-gain sh-y1) p-sat_b)) sat-ref)) p-sat_on))
(def bark (* g-shape p-bk_amt (sqrt g-vel) (clip (/ (- T p-bk_del) 0.012) 0 1)
            (biquad (tanh (+ (* 8 bank-all) 0.3)) 300 0.707 1 1)))
(def body-raw (+ (* g-vpreE (+ (- bank-all bank-sh) bark)) shaped))
(make-history bh_s1)
(make-history bh_s2)
(def bh-g (tan (/ (* 3.14159265358979 18) samplerate)))
(def bh-a1 (/ 1 (+ 1 (* bh-g (+ bh-g 1.414213562)))))
(def bh-a2 (* bh-g bh-a1))
(def bh-a3 (* bh-g bh-a2))
(def bh-ic1 (gswitch hit 0 (read-history bh_s1)))
(def bh-ic2 (gswitch hit 0 (read-history bh_s2)))
(def bh-v3 (- body-raw bh-ic2))
(def bh-v1 (+ (* bh-a1 bh-ic1) (* bh-a2 bh-v3)))
(def bh-v2 (+ bh-ic2 (* bh-a2 bh-ic1) (* bh-a3 bh-v3)))
(write-history bh_s1 (- (* 2 bh-v1) bh-ic1))
(write-history bh_s2 (- (* 2 bh-v2) bh-ic2))
(def body (mix body-raw (- body-raw (* 1.414213562 bh-v1) bh-v2) p-bhp_on))

;; ---- 18-band noise (+2 silent dummies for 4-wide SIMD) + hum on ONE xorshift white ----
(def u0 (noise))
(def white (* 3.4641016 (- u0 0.5)))
(def band-fc (tensor @shape [1 20] @data [50 70.6871936 99.9335867 141.280496 199.734435 282.373334 399.20357 564.371601 797.876892 1127.99357 1594.69399 2254.48886 3187.2698 4505.98315 6370.30607 9005.98117 12732.1507 18000 1000 1000]))
(def band-w0 (/ (* twopi band-fc) samplerate))
(def band-alpha (/ (sin band-w0) 3.6))
(def band-b0 (/ band-alpha (+ 1 band-alpha)))
(def band-a1 (/ (* -2 (cos band-w0)) (+ 1 band-alpha)))
(def band-a2 (/ (- 1 band-alpha) (+ 1 band-alpha)))
(def band-norm (gswitch (lt samplerate 46050) (tensor @shape [1 20] @data [31.7916662 26.7381035 22.4879868 18.9136732 15.9078614 13.3803927 11.2555824 9.47001226 7.9707332 6.71384825 5.66347149 4.79109518 4.075476 3.5033986 3.07263929 2.80287245 2.78723294 3.66478377 1 1])
                 (gswitch (lt samplerate 68100) (tensor @shape [1 20] @data [33.1676114 27.8953034 23.4612007 19.7321259 16.5961169 13.9590853 11.7420243 9.87869501 8.31373115 7.00113113 5.90312354 4.9894284 4.23699798 3.63050326 3.16451342 2.85130674 2.75486488 3.23486918 1 1])
                   (gswitch (lt samplerate 92100) (tensor @shape [1 20] @data [44.9599972 37.8130386 31.8022282 26.7469863 22.4954573 18.9199557 15.9131444 13.3848346 11.259316 9.47314879 7.97336515 6.71605189 5.6653085 4.79261336 4.07670888 3.50436258 3.07332369 2.8032005 1 1]) (tensor @shape [1 20] @data [46.9059023 39.4496081 33.1786305 27.9045707 23.4689946 19.7386804 16.6016289 13.9637198 11.7459203 9.88196847 8.31647895 7.00343336 5.90504534 4.99102094 4.23829843 3.6315327 3.16526957 2.85173661 1 1])))))
(make-history nx1)
(make-history nx2)
(def white-x2 (read-history nx2))
(write-history nx2 (read-history nx1))
(write-history nx1 white)
(make-tensor-history s1y1 @shape [1 20])
(make-tensor-history s1y2 @shape [1 20])
(make-tensor-history s2y1 @shape [1 20])
(make-tensor-history s2y2 @shape [1 20])
(def s1-1 (read-tensor-history s1y1))
(def s1-2 (read-tensor-history s1y2))
(def s2-1 (read-tensor-history s2y1))
(def s2-2 (read-tensor-history s2y2))
(def stage1 (- (* band-b0 (- white white-x2)) (+ (* band-a1 s1-1) (* band-a2 s1-2))))
(def stage2 (- (* band-b0 (- stage1 s1-2)) (+ (* band-a1 s2-1) (* band-a2 s2-2))))
(write-tensor-history s1y2 s1-1)
(write-tensor-history s1y1 stage1)
(write-tensor-history s2y2 s2-1)
(write-tensor-history s2y1 stage2)
(def bands (* band-norm stage2))
(def n-t (max 0 (- (mix age (* age g-tuning) p-nsamp) p-noise_onset)))
(def n-att (- 1 (exp (/ (- 0 n-t) p-noise_rise))))
(def n-gate (* (vpow GA p-noise_ga) (vpow GB p-noise_gb)))
(def c-gate (vpow GA p-couple_ga))
;; band decay corrections like the slots': the fast stage is e^-(u^q) with u = integral of 1/d1(t) dt
;; (u = t / d1 on a static hit), the slow stage e^-(t/d2 + Ls)
(make-history nt-h)
(def n-dt (gswitch hit 0 (- n-t (read-history nt-h))))
(write-history nt-h n-t)
(make-tensor-history nLf @shape [1 20])
(make-tensor-history nLs @shape [1 20])
(def n-Lf (gswitch hit 0 (+ (read-tensor-history nLf) (* n-dt (- L-id1 n-id1)))))
(def n-Ls (gswitch hit 0 (+ (read-tensor-history nLs) (* n-dt (- L-id2 n-id2)))))
(write-tensor-history nLf n-Lf)
(write-tensor-history nLs n-Ls)
(def band-env (+ (* n-gate n-att (+ (* n-fast (exp (- 0 (exp (* p-noise_q (log (max (+ (* n-t n-id1) n-Lf) 0.000000000000000000000000000001)))))) n-fc) (* n-slow (exp (- (* (- 0 n-t) n-id2) n-Ls)) n-sc)))
                 (* c-gate n-cpl (sqrt (+ bank-esq 0.0000000001)))))
(def hum-nz (biquad (* (- (* u0 2) 1) (sqrt (/ samplerate 16000))) 12 0.707 1 0))
(def hum-s (sin (* twopi g-tuning 92 age)))
(def hum (* g-hvel (- 1 (exp (/ (- 0 age) 0.1))) (exp (/ (- 0 age) 0.22)) (+ hum-s (* p-hum_h2 (- 1 (* 2 hum-s hum-s)))) hum-nz))
(def tex (* g-vpreE g-vtexE (+ (* g-nvel (sum (* band-env bands))) (* n-gate hum))))
(def source (+ body (* (- 1 p-np) tex)))

;; ---- recording chain ----------------------------------------------------------
(def ceil-p g-ceil)
(def ceil-n (* ceil-p p-cneg))
(def cx (+ source p-coff))
(def c-up (gte cx 0))
(def c-mag (abs cx))
(def c-cs (mix ceil-n ceil-p c-up))
(def c-ka (mix p-kan p-kap c-up))
(def c-kb (mix p-kbn p-kbp c-up))
(def c-side (mix (knee-side c-mag (* c-ka c-cs) (max 0.000001 (* c-kb c-cs))) (rat-side c-mag c-cs p-kn) p-kr))
(def clipped (- (* (- (* 2 c-up) 1) c-side) p-coff))
(def recorded (mix (* g-dry source) clipped g-cmix))
(make-history dc_x)
(make-history dc_y)
(def dc-r (- 1 (/ (* 6.283185307 p-dc_hz) samplerate)))
(def dc-px (gswitch hit 0 (read-history dc_x)))
(def dc-py (gswitch hit 0 (read-history dc_y)))
(def dcd (+ (- recorded dc-px) (* dc-r dc-py)))
(write-history dc_x recorded)
(write-history dc_y dcd)
(def rl1 (reset-lp2 dcd p-rl_hz p-rl_q1 hit))
(def rl2 (reset-lp2 rl1 p-rl_hz p-rl_q2 hit))
(def rec-lp (mix dcd (mix rl1 rl2 p-rl_two) p-rl_mix))
(def with-post (+ rec-lp (* p-np tex)))
(def split (min (* 180 (mix 1 g-tuning p-dr_track)) (* 0.2 samplerate)))
(def upper (biquad with-post split 0.707 1 1))
(def colour (biquad (* (/ (- g-drive 1) 4) (- (/ (tanh (* g-drive upper)) (sqrt g-drive)) upper)) split 0.707 1 1))
(def limited (+ with-post colour))

;; output envelope (length fade x out gate) per side, crossfaded, never re-opening
(def outenv-A (* (- 1 (smooth01 (/ (- (mix age (* age g-tuning) A-fd_samp) (- A-len A-fade)) A-fade))) (vpow GA-A A-oA_e)))
(def outenv-B (* (- 1 (smooth01 (/ (- (mix age (* age g-tuning) B-fd_samp) (- B-len B-fade)) B-fade))) (vpow GA-B B-oA_e)))
(make-history outenv-h)
(def outenv (gswitch hit (mix outenv-A outenv-B g-w) (min (mix outenv-A outenv-B g-w) (read-history outenv-h))))
(write-history outenv-h outenv)
(def out0 (clip (* level g-lvlA outenv limited) (- 0 p-out_clip) p-out_clip))
;; a retrigger cuts the previous hit: carry its last sample and let it fall over ~1 ms
(make-history last-out)
(make-history carry-h)
(def carry (gswitch hit (read-history last-out) (* (read-history carry-h) (exp (/ -1000 samplerate)))))
(write-history carry-h carry)
(def voice-out (+ (* alive out0) carry))
(write-history last-out voice-out)
(out voice-out 1 @name left)
(out voice-out 2 @name right)
(use-defmacro voice-amp)
(out (voice-amp 0 voice-out voice-out) 3 @name amp @amp true)

;; ---- helpers -------------------------------------------------------------
;; powers come from a small fixed set, picked by a block-rate index (no exp/log):
;;   velocity powers  VP index 1..8 = 0 .25 .5 .75 1 1.5 1.75 2
;;   shape powers     XP index 1..4 = 1 2 4 8
;;   gate powers      GP index 1..3 = 0 .5 1
(defmacro xpow (x pi)
  (def xp2 (* x x))
  (def xp4 (* xp2 xp2))
  (selector pi x xp2 xp4 (* xp4 xp4)))
(defmacro gpow (g pi) (selector pi 1 (sqrt (max g 0)) g))
(defmacro smooth01 (x) (* (clip x 0 1) (clip x 0 1) (- 3 (* 2 (clip x 0 1)))))
(defmacro kick-gate (T hold rel wexp wrat wss p tmix tail floor_g)
  (def gx (max 0 (- T hold)))
  (def x (/ gx rel))
  (def xp (xpow x p))
  (def shaped (+ (* wexp (exp (- xp))) (* wrat (/ 1 (+ 1 xp))) (* wss (- 1 (smooth01 x)))))
  (def g (mix shaped (exp (/ (- gx) tail)) tmix))
  (+ floor_g (* (- 1 floor_g) g)))
(defmacro knee-side (m k w) (+ (min m k) (* w (tanh (/ (max 0 (- m k)) w)))))
;; x / (1 + (x/c)^n)^(1/n): the sqrt-sqrt style soft clip several kicks use
(defmacro rat-side (m c n) (* m (exp (/ (- 0 (log (+ 1 (exp (* n (log (max (/ m c) 0.000000001))))))) n))))
(defmacro reset-lp2 (x cut q reset)
  (make-history s1)
  (make-history s2)
  (def kk (tan (/ (* 3.14159265 (min cut (* 0.45 samplerate))) samplerate)))
  (def nn (/ 1 (+ 1 (/ kk q) (* kk kk))))
  (def b0 (* kk kk nn))
  (def a1 (* 2 (- (* kk kk) 1) nn))
  (def a2 (* (+ (- 1 (/ kk q)) (* kk kk)) nn))
  (def keep (- 1 reset))
  (def z1 (* keep (read-history s1)))
  (def z2 (* keep (read-history s2)))
  (def y (+ (* b0 x) z1))
  (write-history s1 (+ (* 2 b0 x) (- z2 (* a1 y))))
  (write-history s2 (- (* b0 x) (* a2 y)))
  y)
(defmacro band2 (x hp qh lp ql)
  (biquad (biquad x (min hp (* 0.45 samplerate)) qh 1 1) (min lp (* 0.45 samplerate)) ql 1 0))
;; two biquads with table-driven modes (0 LP, 1 HP, 2 BP) and per-stage bypass
(defmacro bandx (x f1 q1 m1 u1 f2 q2 m2 u2)
  (def b1 (mix x (biquad x (min f1 (* 0.45 samplerate)) q1 1 m1) u1))
  (mix b1 (biquad b1 (min f2 (* 0.45 samplerate)) q2 1 m2) u2))
(defmacro layer-env (Tn del rise lin hold p dec floor_e)
  (def lt (max 0 (- Tn del)))
  (def dxx (/ (max 0 (- lt hold)) dec))
  (* (gt Tn del) (mix (- 1 (exp (/ (- lt) rise))) (min 1 (/ lt rise)) lin) (+ floor_e (exp (- (xpow dxx p))))))


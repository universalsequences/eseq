  (def air_env (layer-env Tn c_air_del c_air_rise c_air_lin c_air_hold c_air_p (* c_air_dec air_t) c_air_floor))
  (def room_env (layer-env Tn c_room_del c_room_rise c_room_lin c_room_hold c_room_p (* c_room_dec room_t) c_room_floor))
  (def click_env (layer-env Tn c_click_del c_click_rise c_click_lin c_click_hold c_click_p (* c_click_dec click_t) c_click_floor))
  (def aux_env (layer-env Tn c_aux_del c_aux_rise c_aux_lin c_aux_hold c_aux_p c_aux_dec c_aux_floor))
  (def hum_s (sin (* twopi tuning c_hu_hz age)))
  (def hum_env (* hum_v c_hu_amt (- 1 (exp (/ (- age) c_hu_rise))) (exp (/ (- age) c_hu_ms))
    (+ hum_s (* c_hu_h2 (- 1 (* 2 hum_s hum_s))))))
  (def g_env (* (smooth01 (/ (- T c_gt_del) c_gt_ramp)) (exp (/ (- (max 0 (- age c_gt_del))) c_gt_dec))
    (gpow GA c_gt_ga)))
  (def air_gain (* air_v c_air_amt (velp c_air_nv) (gpow GA c_air_ga) (gpow GB c_air_gb)))
  (def room_gain (* room_v c_room_amt (velp c_room_nv) (gpow GA c_room_ga) (gpow GB c_room_gb)))
  (def click_gain (* click_v c_click_amt (velp c_click_nv) (gpow GA c_click_ga) (gpow GB c_click_gb)))
  (def aux_gain (* floor_v c_aux_amt (velp c_aux_nv) (gpow GA c_aux_ga) (gpow GB c_aux_gb)))
  (def Tf (mix age (* age tuning) c_fd_samp))
  (def fade_s (min (* 0.9 len_s) (max c_fd_s (* c_fd_frac len_s))))
  (def fu (smooth01 (/ (- Tf (- len_s fade_s)) fade_s)))
  (def out_gate (* (gpow GA c_oA) (gpow GB c_oB)))
  ;; block barrier: an independent stateful node here closes the vectorized
  ;; (4-frame) block above; without it the next stateful consumer of the bank
  ;; gets fused in and demotes the whole bank to a scalar loop (~2x CPU).
  (make-history barrier)
  (write-history barrier (+ 1 (read-history barrier)))
  (def air_sig (* air_gain air_env air_band))
  (def room_sig (* room_gain room_env room_band))
  (def click_sig (* click_gain click_env click_band))

  ;; grit: body-driven noise (AM by body, |body|, or body slew) or S&H error
  (make-history g_prev)
  (def g_der (* (- (read-history g_prev) bank_all) (/ samplerate (* twopi c_gt_derhz tuning))))
  (write-history g_prev bank_all)
  (make-history sh_phase)
  (def sh_next (+ (gswitch onset 0 (read-history sh_phase)) (/ (min (* c_gt_shhz tuning) (* 0.45 samplerate)) samplerate)))
  (def sh_wrap (gte sh_next 1))
  (write-history sh_phase (- sh_next sh_wrap))
  (def sh_held (latch bank_all (max sh_wrap onset)))
  (def g_src (mix (mix bank_all (abs bank_all) c_gt_abs) (* 4 (max 0 g_der) (max 0 g_der)) c_gt_der))
  (def grit_sig (* grit_v c_gt_amt g_env
    (biquad (+ (* c_gt_sh (- sh_held bank_all)) (* c_gt_am g_src g_band)) c_gt_post 0.707 1 1)))

  (def bark (* shape_v c_bk_amt v05 (clip (/ (- T c_bk_del) c_bk_ramp) 0 1)
    (biquad (tanh (+ (* c_bk_g bank_all) c_bk_b)) c_bk_hp 0.707 1 1)))
  (def body_raw (+ (* vpreE (- bank_all bank_sh)) shaped (* vpreE bark)))
  (make-history bh_s1)
  (make-history bh_s2)
  (def bh_g (tan (/ (* 3.14159265358979 c_bhp_hz) samplerate)))
  (def bh_a1 (/ 1 (+ 1 (* bh_g (+ bh_g 1.414213562)))))
  (def bh_a2 (* bh_g bh_a1))
  (def bh_a3 (* bh_g bh_a2))
  (def bh_ic1 (gswitch onset 0 (read-history bh_s1)))
  (def bh_ic2 (gswitch onset 0 (read-history bh_s2)))
  (def bh_v3 (- body_raw bh_ic2))
  (def bh_v1 (+ (* bh_a1 bh_ic1) (* bh_a2 bh_v3)))
  (def bh_v2 (+ bh_ic2 (* bh_a2 bh_ic1) (* bh_a3 bh_v3)))
  (write-history bh_s1 (- (* 2 bh_v1) bh_ic1))
  (write-history bh_s2 (- (* 2 bh_v2) bh_ic2))
  (def body_sig (mix body_raw (- body_raw (* 1.414213562 bh_v1) bh_v2) c_bhp_on))

  ;; per-voice: pulse (filters this voice's click envelope), delayed crackle band, hum
  (def pulse (* c_pu_amt click_v (bandx click_env (* c_pu_hp click_c) c_pu_qh c_pu_m1 1 (* c_pu_lp click_c) c_pu_ql 0 c_pu_u2)))
  (def crk_own (* c_cr_own (clip (/ (- age c_cr_del) c_cr_ramp) 0 1) crk_band))
  (def hum_sig (* hum_env hum_nz))

  (def aux_sig (* aux_gain (+ (* aux_env aux_band) hum_sig crk_own pulse)))
  (def texture (+ air_sig room_sig click_sig aux_sig))
  (def source (+ body_sig (* vpreE (+ grit_sig (* vtexE (- 1 c_np) texture)))))

  ;; ---- recording chain ---------------------------------------------------
  (def ceil_p (* c_ceil ceiling_v))
  (def ceil_n (* ceil_p c_cneg))
  (def cx (+ source c_coff))
  (def c_up (gte cx 0))
  (def c_mag (abs cx))
  (def c_cs (mix ceil_n ceil_p c_up))
  (def c_ka (mix c_kan c_kap c_up))
  (def c_kb (mix c_kbn c_kbp c_up))
  (def c_side (mix (knee-side c_mag (* c_ka c_cs) (max 0.000001 (* c_kb c_cs))) (rat-side c_mag c_cs c_kn) c_kr))
  (def clipped (- (* (- (* 2 c_up) 1) c_side) c_coff))
  (def recorded (mix (* c_dry source) clipped (* c_cmix clip_v)))
  (make-history dc_x)
  (make-history dc_y)
  (def dc_r (- 1 (/ (* 6.283185307 c_dc_hz) samplerate)))
  (def dc_px (gswitch onset 0 (read-history dc_x)))
  (def dc_py (gswitch onset 0 (read-history dc_y)))
  (def dcd (+ (- recorded dc_px) (* dc_r dc_py)))
  (write-history dc_x recorded)
  (write-history dc_y dcd)
  (def rl1 (reset-lp2 dcd c_rl_hz c_rl_q1 onset))
  (def rl2 (reset-lp2 rl1 c_rl_hz c_rl_q2 onset))
  (def rec_lp (mix dcd (mix rl1 rl2 c_rl_two) c_rl_mix))
  (def with_post (+ rec_lp (* vpreE vtexE c_np texture)))
  (def split (min (* c_dr_hz (mix 1 tuning c_dr_track)) (* 0.2 samplerate)))
  (def upper (biquad with_post split 0.707 1 1))
  (def amount (/ (- drive_v 1) 4))
  (def saturated (/ (tanh (* drive_v upper)) (sqrt drive_v)))
  (def colour (biquad (* amount (- saturated upper)) split 0.707 1 1))
  (def limited (+ with_post colour))
  (def output (* played vpostE c_lvl level_v (- 1 fu) out_gate limited))
  (clip output (- c_out_clip) c_out_clip))

;; ---- noise: ONE white draw is shared by both hit slots; each slot filters it
;; into its bands with the coefficients of the kick it was triggered with,
;; then its own envelope and gain. The first hit hears the originals' stream.
(def u0 (noise))
(def white (* (- (* u0 2) 1) (sqrt (/ samplerate 16000))))
(def air_c (clip air_tone 0.25 4))
(def room_c (clip room_tone 0.25 4))
(def click_c (clip click_tone 0.25 4))

(def (trigger_a trigger_b gain_a gain_b) (kick-retrigger trigger gate))
(def hit_a (kick-hit trigger_a pitch velocity))
(def hit_b (kick-hit trigger_b pitch velocity))
(def mixed (+ (* hit_a gain_a) (* hit_b gain_b)))
(out mixed 1 @name left)
(out mixed 2 @name right)
;; A drum may never see note-off (gate-off tracks), so the amp flag must not
;; depend on the gate: the voice is done once its output has fallen below
;; -100 dBFS, which follows any decay, release or ring.
(use-defmacro voice-amp)
(out (voice-amp 0 mixed mixed) 3 @name amp @amp true)

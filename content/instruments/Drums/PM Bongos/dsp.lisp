(defmacro bongo-smooth (target ms)
  (make-history previous)
  (make-history ready)
  (def pole (exp (/ -1 (* 0.001 ms samplerate))))
  (def value (gswitch (read-history ready) (mix target (read-history previous) pole) target))
  (write-history previous value)
  (write-history ready 1)
  value)

(defmacro bongo-pole (signal pole)
  (make-history previous)
  (def value (mix signal (read-history previous) pole))
  (write-history previous value)
  value)

;; Coefficients latch on every strike as well as each periodic control tick;
;; a periodic-only hop would miss the start of an off-grid hand strike.
(def control_tick (eq (accum 1 0 0 16) 0))
(defmacro bongo-hold (value tick) (event-hold value tick))
(defmacro bongo-audio (value tick) (latch value tick))

(make-history last_gate)
(make-history elapsed)
(def held (gt gate 0.5))
(def onset (max (gt trigger 0.5) (* held (lte (read-history last_gate) 0.5))))
(write-history last_gate held)
(def update_tick (max control_tick onset))
;; Integer sample age since the key's first strike (bounded, no float drift).
(def age (gswitch onset 0 (min 1000000 (+ 1 (read-history elapsed)))))
(write-history elapsed age)

(def hit_velocity (latch (clip velocity 0 1) onset))
(def key_note (+ 69 (* 12 (/ (log (/ (clip pitch 8.1758 12543.85) 440)) (log 2)))))
(def key_offset (round (- key_note 60)))
(def key_octave (floor (/ key_offset 12)))
(def row (latch (- key_offset (* 12 key_octave)) onset))
(def octave (latch (clip key_octave -3 3) onset))
;; Vector coefficients only run on event clocks: every input they read is
;; event-held, so the scheduler evaluates them on the coefficient tick (or the
;; contact frame), never per sample.
(def mode_indices (iota 32))
(def tick_row (bongo-hold row update_tick))
(def row_indices (+ mode_indices (* tick_row 32)))

;; Contact events of the gesture (flams, finger bounces). Flam scales the
;; measured spacing; flam level scales every event after the first. Unused
;; event slots carry zero residue and zero skin noise.
(def flam_scale (latch (clip (mod flam) 0 3) onset))
(def flam_gain (latch (clip (mod flam_level) 0 1.5) onset))
(defmacro strike-pulse (strike)
  (eq age (round (* (peek delay_table (+ (* row 3) strike)) flam_scale samplerate))))
(def pulse0 onset)
(def pulse1 (strike-pulse 1))
(def pulse2 (strike-pulse 2))
(def strike_event (gt (+ pulse0 pulse1 pulse2) 0))
(def strike_row (bongo-hold row strike_event))
(defmacro strike-indices (strike) (+ mode_indices (* (+ (* strike_row 3) strike) 32)))

;; Tension glide: a hard slap briefly stretches the head. Recomputed on the
;; 16-sample coefficient clock, never per sample.
(def glide_env (exp (/ (- age) (* 0.028 samplerate))))
(def bend (+ 1 (* 0.03 (clip (mod glide) 0 1) hit_velocity hit_velocity glide_env)))
(def transpose (pow 2 (+ octave (/ (bongo-smooth (clip (mod tune) -12 12) 8) 12))))
(def table_hz (gather frequency_table row_indices))
(def strike_hz (* (gather frequency_table (+ mode_indices (* strike_row 32))) (bongo-hold transpose strike_event)))
(def frequencies (* table_hz (bongo-hold (* transpose bend) update_tick)))
(def omega (* twopi (/ (min frequencies (* 0.48 samplerate)) samplerate)))
(def rotation_cos (cos omega))
(def rotation_sin (sin omega))

;; Hand contact. The identified residues are the modes' responses to the
;; recorded hands. A shorter or longer live contact (hardness, and softer
;; hits when Vel > timbre is up) multiplies each mode by the exact complex
;; response ratio of normalized two-pole contact forces, live/reference,
;; evaluated only on the frames where a contact event fires.
(def reference_pole (exp (/ -1 (* 0.00025 samplerate))))
(def contact_tau (* 0.00025

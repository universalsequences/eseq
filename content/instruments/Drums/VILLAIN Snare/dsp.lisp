;; VILLAIN Snare: Master Snare 2 plus macros along the principal
;; components of the 32 snares (pc1, pc2: head modes; pc3: chain), in standard
;; deviations of the family; 0 = Master Snare 2 exactly. Release (5..2000 ms,
;; 2000 = Hold = Master Snare 2 exactly) fades each hit when its note ends
;; (the step dur is the gate). TRANSFORMED by
;; research/snares/master/build_pca.py. Do not edit.
;;
;; Master Snare 2: the Master Snare with its stroke delay times isolated
;; so the snare tables hoist to block rate. TRANSFORMED from the installed
;; Master Snare by research/snares/master/build_master2.py.
;; Do not edit.
;;
;; Master Snare: blend and exaggerate across the 32 source snare fits.
;; GENERATED by research/snares/master/build_master.py. Do not edit.
;;
;; Every snare's tonal head is refitted into the SAME 26 role slots (3 low,
;; fundamental, partner, 14 body, 7 ring) with a decomposition whose modes do
;; not cancel, and its chain is mapped onto one canonical chain (strands, crack,
;; tick, buzz, room, hiss, crackle, 4 generic noise layers, 4 stroke taps, drum
;; and head gates, drive/clip, SP sampler, record filters, limiters). Snare A
;; and Snare B are rows of one per-snare table; Blend interpolates them column
;; by column (parts only one snare has fade in with that snare's own timing and
;; band), Exaggerate pushes the result away from the mean of all 32.

;; VILLAIN Snare retrigger + gate RELEASE (the VILLAIN Hat design,
;; research/hats/master/hat-gate-release.lisp, applied to the
;; snare; spliced in by build_pca.py in place of the plain kick-retrigger).
;; The macro names keep the kick-retrigger prefix so check_master.py's
;; fresh-state audit still treats them as the retrigger (voice-level) state.
;; RETRIGGER (unchanged family standard): the OUTGOING slot fades with the 808
;; exponential crossfade, -60 dB at 5 ms; the INCOMING slot is at full gain from
;; its onset sample with its state zeroed on that sample.
;; RELEASE: the step's duration arrives as the gate. When the gate FALLS (end of
;; the note's dur, or a rack choke = an early note-off) both slots enter a
;; release stage whose gain is the C1 curve
;;     g(t) = (1 + t/tau) e^(-t/tau),   tau = Release / 9.233413 (-60 dB at Release)
;; which starts with zero slope (no click). It multiplies each slot's whole
;; output (after the recording chain and limiters), is <= 1 and non-increasing,
;; so it can never lengthen a hit.
;; A slot's release resets ONLY on its own onset: a retrigger during a release
;; starts the new hit at full level; the release belongs to the outgoing slot.
;; dur 0: when the gate is already low on a slot's onset sample (the host's
;; gate-off landed on the note-on frame) that slot releases from its onset.
;; Release >= 1999.5 ms = HOLD: the gate is ignored (the pre-Release behaviour,
;; bit-exact: the release gain is exactly 1).
;; Recurrence (tau in samples, a = e^(-1/tau)): e <- a e, h <- a (h + e / tau),
;; g = e + h; before a release e = 1, h = 0. The gain returned is the value
;; BEFORE the update, so every fade starts from the ongoing gain.
(defmacro kick-retrigger-gain (target)
  (make-history gain_h)
  (def previous_gain (read-history gain_h))
  (def coefficient (exp (/ -6.9077553 (* samplerate 0.005))))
  (def next_gain (gswitch target 1 (* coefficient previous_gain)))
  (write-history gain_h next_gain)
  (gswitch target 1 previous_gain))

(defmacro kick-retrigger-release-gain (slot_onset start_on_onset rel_start rel_a rel_itau)
  (make-history rel_on_h)
  (make-history rel_e_h)
  (make-history rel_h_h)
  (def releasing (gswitch slot_onset start_on_onset (max (read-history rel_on_h) rel_start)))
  (write-history rel_on_h releasing)
  (def prev_e (gswitch slot_onset 1 (read-history rel_e_h)))
  (def prev_h (gswitch slot_onset 0 (read-history rel_h_h)))
  (def next_e (gswitch releasing (* rel_a prev_e) prev_e))
  (def next_h (gswitch releasing (* rel_a (+ prev_h (* prev_e rel_itau))) prev_h))
  (write-history rel_e_h next_e)
  (write-history rel_h_h next_h)
  (+ prev_e prev_h))

(defmacro kick-retrigger-gate (trigger gate release_ms)
  (make-history previous_trigger)
  (make-history previous_gate)
  (def trigger_high (gt trigger 0.5))
  (def gate_high (gt gate 0.5))
  (def onset (max (* trigger_high (lte (read-history previous_trigger) 0.5))
    (* gate_high (lte (read-history previous_gate) 0.5))))
  (def gate_fall (* (- 1 gate_high) (gt (read-history previous_gate) 0.5)))
  (write-history previous_trigger trigger_high)
  (write-history previous_gate gate_high)
  (make-history selector_h)
  (def previous_selector (read-history selector_h))
  (def slot (gswitch onset (- 1 previous_selector) previous_selector))
  (write-history selector_h slot)
  (def target_a (lt slot 0.5))
  (def target_b (- 1 target_a))
  (def onset_a (* onset target_a))
  (def onset_b (* onset target_b))
  (def rel_enable (lt release_ms 1999.5))
  (def rel_start (* gate_fall rel_enable (- 1 onset)))
  (def rel_at_onset (* (- 1 gate_high) rel_enable))
  (def rel_tau (* samplerate 0.001 (clip release_ms 5 2000) 0.10830231))
  (def rel_a (exp (/ -1 rel_tau)))
  (def rel_itau (/ 1 rel_tau))
  (def gain_a (* (kick-retrigger-gain target_a) (kick-retrigger-release-gain onset_a rel_at_onset rel_start rel_a rel_itau)))
  (def gain_b (* (kick-retrigger-gain target_b) (kick-retrigger-release-gain onset_b rel_at_onset rel_start rel_a rel_itau)))
  (tuple onset_a onset_b gain_a gain_b))

(def gate (in 1 @name gate))
(def pitch (in 2 @name pitch))
(def velocity (in 3 @name velocity))
(def trigger (in 4 @name trigger))
(def clock (in 5 @name clock))

(param snare_a @default 0 @min 0 @max 31)
(param snare_b @default 0 @min 0 @max 31)
(param blend @default 0 @min 0 @max 1)
(param exaggerate @default 0 @min -1 @max 2)
(param pc1 @default 0 @min -3 @max 3)
(param pc2 @default 0 @min -3 @max 3)
(param pc3 @default 0 @min -3 @max 3)
(param tune @default 1 @min 0.5 @max 2)
(param decay @default 1 @min 0.25 @max 3)
(param bend @default 1 @min 0 @max 2)
(param body @default 1 @min 0 @max 2)
(param ring @default 1 @min 0 @max 3)
(param rattle @default 1 @min 0 @max 4)
(param buzz @default 1 @min 0 @max 4)
(param crack @default 1 @min 0 @max 4)
(param room @default 1 @min 0 @max 4)
(param extra @default 1 @min 0 @max 4)
(param strokes @default 1 @min 0 @max 2)
(param hiss @default 1 @min 0 @max 4)
(param dust @default 1 @min 0 @max 4)
(param drive @default 1 @min 0.5 @max 4)
(param grit @default 1 @min 0 @max 2)
(param length @default 1 @min 0.25 @max 4)
(param level @default 1 @min 0 @max 2)
(param release @default 160 @min 5 @max 2000 @unit ms)

;; ---- snare tables (block rate) --------------------------------------------
(def kiA (floor (+ (clip snare_a 0 31) 0.5)))
(def kiB (floor (+ (clip snare_b 0 31) 0.5)))
(def bl (clip blend 0 1))
(def ex (clip exaggerate -1 2))
(def pcm1 (clip pc1 -3 3))
(def pcm2 (clip pc2 -3 3))
(def pcm3 (clip pc3 -3 3))


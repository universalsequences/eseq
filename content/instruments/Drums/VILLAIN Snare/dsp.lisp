  (def buzz_t (max 0 (- T c_buzz_del)))
  (def buzz_env (* (gt T c_buzz_del) (- 1 (exp (/ (- buzz_t) c_buzz_rise)))
    (+ (* (exp (/ (- (max 0 (- buzz_t c_buzz_hold))) (* c_buzz_ms decay_v)))
          (exp (/ (- (max 0 (- buzz_t (* c_buzz_knee decay_v)))) (* c_buzz_late decay_v))))
       (* c_buzz_tail (exp (/ (- buzz_t) (* c_buzz_tail_ms decay_v)))))))
  ;; the noise bed and the strands' contact signal share one (linear) band-pass;
  ;; they are filtered separately so strokes can repeat the bed without the strands
  (def buzz_in (* c_buzz (clip buzz 0 4) (vpow c_buzz_ve) buzz_env (* 1.7320508 white_scale (- (* 2 (noise)) 1))))
  (def g_buzz_hi (hitg c_buzz_hi))
  (def g_buzz_lo (hitg c_buzz_lo))
  (def buzz_b1 (svf-lp (svf-hp buzz_in g_buzz_lo onset 1.414213562) g_buzz_hi onset c_buzz_k))
  (def buzz_bed (mix buzz_b1 (svf-lp buzz_b1 g_buzz_hi onset 1.414213562) c_buzz_steep))
  (def str_b1 (svf-lp (svf-hp strands g_buzz_lo onset 1.414213562) g_buzz_hi onset c_buzz_k))
  (def str_sig (mix str_b1 (svf-lp str_b1 g_buzz_hi onset 1.414213562) c_buzz_steep))
  (def buzz_sig (+ buzz_bed str_sig))

  ;; ---- room -----------------------------------------------------------------
  (def room_env (* (- 1 (exp (/ (- T) c_room_rise)))
    (+ (exp (/ (- T) (* c_room_ms decay_v))) (* c_room2 (exp (/ (- T) (* c_room2_ms decay_v)))))))
  (def g_room_hi (hitg c_room_hi))
  (def room_b1 (svf-lp (svf-hp (* 1.7320508 white_scale (- (* 2 (noise)) 1)) (hitg c_room_lo) onset 1.414213562) g_room_hi onset 1.414213562))
  (def room_sig (* c_room (clip room 0 4) (vpow c_room_ve) room_env
    (mix room_b1 (svf-lp room_b1 g_room_hi onset 1.414213562) c_room_steep)))

  ;; ---- generic noise layers -------------------------------------------------
  (def x1_Tc (mix age T c_x1_clk))
  (def x1_env (env-std x1_Tc c_x1_del c_x1_rise c_x1_hold (* c_x1_ms (dsc c_x1_dsc)) c_x1_end c_x1_endw))
  (def x1_hp (svf-hp (* 1.7320508 white_scale (- (* 2 (noise)) 1)) (hitg c_x1_lo) onset 1.414213562))
  (def x1_lp (svf-lp x1_hp (hitg c_x1_hi) onset c_x1_k))
  (def x1_sig (* c_x1 (clip extra 0 4) (vpow c_x1_ve) x1_env (mix x1_lp x1_hp c_x1_open)))
  (def x2_Tc (mix age T c_x2_clk))
  (def x2_env (env-std x2_Tc c_x2_del c_x2_rise c_x2_hold (* c_x2_ms (dsc c_x2_dsc)) c_x2_end c_x2_endw))
  (def x2_hp (svf-hp (* 1.7320508 white_scale (- (* 2 (noise)) 1)) (hitg c_x2_lo) onset 1.414213562))
  (def x2_lp (svf-lp x2_hp (hitg c_x2_hi) onset c_x2_k))
  (def x2_sig (* c_x2 (clip extra 0 4) (vpow c_x2_ve) x2_env (mix x2_lp x2_hp c_x2_open)))
  (def x3_Tc (mix age T c_x3_clk))
  (def x3_env (env-std x3_Tc c_x3_del c_x3_rise c_x3_hold (* c_x3_ms (dsc c_x3_dsc)) c_x3_end c_x3_endw))
  (def x3_hp (svf-hp (* 1.7320508 white_scale (- (* 2 (noise)) 1)) (hitg c_x3_lo) onset 1.414213562))
  (def x3_lp (svf-lp x3_hp (hitg c_x3_hi) onset c_x3_k))
  (def x3_sig (* c_x3 (clip extra 0 4) (vpow c_x3_ve) x3_env (mix x3_lp x3_hp c_x3_open)))
  (def x4_Tc (mix age T c_x4_clk))
  (def x4_env (env-std x4_Tc c_x4_del c_x4_rise c_x4_hold (* c_x4_ms (dsc c_x4_dsc)) c_x4_end c_x4_endw))
  (def x4_hp (svf-hp (* 1.7320508 white_scale (- (* 2 (noise)) 1)) (hitg c_x4_lo) onset 1.414213562))
  (def x4_lp (svf-lp x4_hp (hitg c_x4_hi) onset c_x4_k))
  (def x4_sig (* c_x4 (clip extra 0 4) (vpow c_x4_ve) x4_env (mix x4_lp x4_hp c_x4_open)))

  ;; ---- hiss floor and record dust (raw clock, never gated) ------------------
  (def g_hiss_hi (hitg c_hiss_hi))
  (def hiss_hp (svf-hp (* 1.7320508 white_scale (- (* 2 (noise)) 1)) (hitg c_hiss_lo) onset 1.414213562))
  (def hiss_l1 (svf-lp hiss_hp g_hiss_hi onset 1.414213562))
  (def hiss_l2 (mix hiss_l1 (svf-lp hiss_l1 g_hiss_hi onset 1.414213562) c_hiss_steep))
  (def hiss_sig (* c_hiss (clip hiss 0 4) (vpow c_hiss_ve)
    (exp (/ (- age) c_hiss_ms)) (exp (* -0.115129255 c_hiss_fall age)) (mix hiss_l2 hiss_hp c_hiss_open)))
  (def ck_on (lt (noise) (/ c_crackle_rate samplerate)))
  (def crackle_sig (* c_crackle (clip dust 0 4) vel (svf-hp (* ck_on 4 (- (* 2 (noise)) 1)) (hitg c_crackle_hz) onset 1.414213562)))

  ;; ---- drum, strokes, source ---------------------------------------------------
  (def layers_main (+ (* (gm c_crack_gd) crack_sig) (* (gm c_tick_gd) tick_sig) (* (gm c_buzz_gd) buzz_sig)
    (* (gm c_room_gd) room_sig) (* (gm c_x1_gd) x1_sig) (* (gm c_x2_gd) x2_sig) (* (gm c_x3_gd) x3_sig) (* (gm c_x4_gd) x4_sig)))
  (def drum_raw (+ head_g layers_main))
  (def gd_close (* c_gd_dark (smooth01 (/ (- T c_gd_ms) c_gd_fall))))
  (def drum (mix drum_raw (svf-lp drum_raw (hitg c_gd_dark_hz) onset 1.414213562) gd_close))
  (def st_win_env (exp (/ (- age) c_st_win)))
  (def crack_bus (+ (* (gm c_crack_gd) crack_sig) (* (gm c_tick_gd) tick_sig)))
  (def bus_c (* c_st_crack crack_bus st_win_env))
  (def bus_r (* (+ (* c_st_head (+ head_g (* (gm c_buzz_gd) str_sig))) (* c_st_buzz (gm c_buzz_gd) buzz_bed)
    (* (gm c_room_gd) room_sig)) st_win_env))
  (def sd1_raw (latch (clip (floor (* c_s1_ms samplerate)) 1 8000) onset))
  (make-history sd1_hr)
  (make-history sd1_hc)
  (write-history sd1_hr sd1_raw)
  (write-history sd1_hc sd1_raw)
  (def sd1 (max 1 (gswitch onset 0 (read-history sd1_hr))))
  (def sd1c (max 1 (gswitch onset 0 (read-history sd1_hc))))
  (def st1 (* c_s1 (gte age_samples sd1) (+ (delay bus_r sd1 @max-delay 8192) (* c_s1_acc (delay bus_c sd1c @max-delay 16384)))))
  (def sd2_raw (latch (clip (floor (* c_s2_ms samplerate)) 1 8000) onset))
  (make-history sd2_hr)
  (make-history sd2_hc)
  (write-history sd2_hr sd2_raw)
  (write-history sd2_hc sd2_raw)
  (def sd2 (max 1 (gswitch onset 0 (read-history sd2_hr))))
  (def sd2c (max 1 (gswitch onset 0 (read-history sd2_hc))))
  (def st2 (* c_s2 (gte age_samples sd2) (+ (delay bus_r sd2 @max-delay 8192) (* c_s2_acc (delay bus_c sd2c @max-delay 16384)))))
  (def sd3_raw (latch (clip (floor (* c_s3_ms samplerate)) 1 8000) onset))
  (make-history sd3_hr)
  (make-history sd3_hc)
  (write-history sd3_hr sd3_raw)
  (write-history sd3_hc sd3_raw)
  (def sd3 (max 1 (gswitch onset 0 (read-history sd3_hr))))
  (def sd3c (max 1 (gswitch onset 0 (read-history sd3_hc))))
  (def st3 (* c_s3 (gte age_samples sd3) (+ (delay bus_r sd3 @max-delay 8192) (* c_s3_acc (delay bus_c sd3c @max-delay 16384)))))
  (def sd4_raw (latch (clip (floor (* c_s4_ms samplerate)) 1 8000) onset))
  (make-history sd4_hr)
  (make-history sd4_hc)
  (write-history sd4_hr sd4_raw)
  (write-history sd4_hc sd4_raw)
  (def sd4 (max 1 (gswitch onset 0 (read-history sd4_hr))))
  (def sd4c (max 1 (gswitch onset 0 (read-history sd4_hc))))
  (def st4 (* c_s4 (gte age_samples sd4) (+ (delay bus_r sd4 @max-delay 8192) (* c_s4_acc (delay bus_c sd4c @max-delay 16384)))))
  (def strokes_sig (* (clip strokes 0 2) (+ st1 st2 st3 st4)))
  (def onset_ramp (- 0.5 (* 0.5 (cos (* pi (clip (/ age c_on_ms) 0 1))))))
  (def source (* onset_ramp (vpow (- 0 c_vin))
    (+ drum strokes_sig (* (- 1 c_hiss_post) hiss_sig) (* (gm c_crackle_gd) crackle_sig))))

  ;; ---- recording chain ----------------------------------------------------------
  (def driven (+ source (* d_amt (- (* (tanh (* dv source)) d_norm) source))))
  (def ceil_e (latch (* c_ceil (- 1 (* c_clip_vel (- 1 (max vel 0.02))))) onset))
  (def ceil_inv (latch (/ 1 (max 0.001 (* c_ceil (- 1 (* c_clip_vel (- 1 (max vel 0.02))))))) onset))
  (def pre_sh (mix (clipper driven ceil_e ceil_inv) driven c_clip_post))
  ;; SP-style sampler: zero-order hold at spr (phase reset on the onset), then
  ;; rounding to bits_e (quantiser optionally follows velocity)
  (make-history sh_ph)
  (make-history sh_val)
  (def sh_p (gswitch onset 1 (+ (read-history sh_ph) (/ spr samplerate))))
  (def sh_take (gte sh_p 1))
  (def sh_frac (- sh_p (* sh_take (floor sh_p))))
  (def sh_hold (gswitch sh_take pre_sh (read-history sh_val)))
  (write-history sh_ph sh_frac)
  (write-history sh_val sh_hold)
  (def q_steps (latch (exp (- (* 0.693147181 (- bits_e 1)) (* c_qv (log vel_e)))) onset))
  ;; separate reciprocal latch (DGenLisp: a latched value used as multiplier and divisor compiled to 0)
  (def q_inv (latch (exp (- (* c_qv (log vel_e)) (* 0.693147181 (- bits_e 1)))) onset))
  (def crushed_z (* (floor (+ (* sh_hold q_steps) 0.5)) q_inv))
  ;; interpolating variant (SP 13): fractional-delay the input to the sampling
  ;; instant, quantise at the take, and read linearly between the last two takes
  (make-history sh_x1)
  (make-history sh_v0)
  (make-history sh_v1)
  (def sh_xp (gswitch onset 0 (read-history sh_x1)))
  (write-history sh_x1 pre_sh)
  (def sh_d (min 1 (* sh_frac (/ samplerate spr))))
  (def sh_q (* (floor (+ (* (- pre_sh (* sh_d (- pre_sh sh_xp))) q_steps) 0.5)) q_inv))
  (def sh_c0 (gswitch onset 0 (read-history sh_v0)))
  (def sh_c1 (gswitch onset 0 (read-history sh_v1)))
  (def sh_n0 (gswitch sh_take sh_q sh_c0))
  (def sh_n1 (gswitch sh_take sh_c0 sh_c1))
  (write-history sh_v0 sh_n0)
  (write-history sh_v1 sh_n1)
  (def crushed (mix crushed_z (+ sh_n1 (* sh_frac (- sh_n0 sh_n1))) c_sh_lin))
  (def rec1 (svf-lp crushed (hitg c_rec_hz) onset c_rec_k))
  (def rec2 (mix rec1 (svf-lp rec1 (hitg c_rec2_hz) onset c_rec2_k) c_rec2))
  (def g_low (hitg c_lowcut))
  (def rec_lc (mix rec2 (svf-hp (svf-hp rec2 g_low onset 1.414213562) g_low onset 1.414213562) c_lowcut_on))
  (def rec_c (mix rec_lc (clipper rec_lc ceil_e ceil_inv) c_clip_post))
  (def recorded (+ rec_c (* c_hiss_post hiss_sig)))
  (def fu (smooth01 (/ (- age (- len_s fade_s)) fade_s)))
  (def fade1 (- 1 fu))
  (def fade2 (* fade1 fade1))
  (def fade (mix fade1 (* fade2 fade2) c_fade_curve))
  (def out0 (* played lvl fade (vpow c_vout) recorded))
  (def ol_u (/ out0 c_ol_c))
  (def ol_u2 (* ol_u ol_u))
  (def ol_u4 (* ol_u2 ol_u2))
  (def ol_k (* c_ol_c (/ ol_u (sqrt (sqrt (sqrt (+ 1 (* ol_u4 ol_u4))))))))
  (def output (clip (mix out0 ol_k c_ol_k8) (- 0 c_ol_hard) c_ol_hard))
  output)

(def release_v (clip release 5 2000))
(def (trigger_a trigger_b gain_a gain_b) (kick-retrigger-gate trigger gate release_v))
(def hit_a (snare-hit trigger_a pitch velocity))
(def hit_b (snare-hit trigger_b pitch velocity))
(def mixed (clip (+ (* hit_a gain_a) (* hit_b gain_b)) (- 0 c_mix_clip) c_mix_clip))
(out mixed 1 @name left)
(out mixed 2 @name right)
;; A drum may never see note-off (gate-off tracks), so the amp flag must not
;; depend on the gate: the voice is done once its output has fallen below
;; -100 dBFS, which follows any decay, release or ring.
(use-defmacro voice-amp)
(out (voice-amp 0 mixed mixed) 3 @name amp @amp true)

;; TPT state-variable filter steps (bilinear, prewarped); state zeroed on the onset.
(defmacro svf-lp (x gk onset kk)
  (make-history s1)
  (make-history s2)
  (def ic1 (gswitch onset 0 (read-history s1)))
  (def ic2 (gswitch onset 0 (read-history s2)))
  (def a1 (/ 1 (+ 1 (* gk (+ gk kk)))))
  (def a2 (* gk a1))
  (def a3 (* gk a2))
  (def v3 (- x ic2))
  (def v1 (+ (* a1 ic1) (* a2 v3)))
  (def v2 (+ ic2 (* a2 ic1) (* a3 v3)))
  (write-history s1 (- (* 2 v1) ic1))
  (write-history s2 (- (* 2 v2) ic2))
  v2)
(defmacro svf-hp (x gk onset kk)
  (make-history s1)
  (make-history s2)
  (def ic1 (gswitch onset 0 (read-history s1)))
  (def ic2 (gswitch onset 0 (read-history s2)))
  (def a1 (/ 1 (+ 1 (* gk (+ gk kk)))))
  (def a2 (* gk a1))
  (def a3 (* gk a2))
  (def v3 (- x ic2))
  (def v1 (+ (* a1 ic1) (* a2 v3)))
  (def v2 (+ ic2 (* a2 ic1) (* a3 v3)))
  (write-history s1 (- (* 2 v1) ic1))
  (write-history s2 (- (* 2 v2) ic2))
  (- x (* kk v1) v2))
;; tan(pi f / sr) by its (3,2) Pade form, cutoff capped at 0.33 sr.
(defmacro svf-g (hz)
  (def x (/ (* pi (clip hz 10 (* 0.33 samplerate))) samplerate))
  (/ (* x (- 15 (* x x))) (- 15 (* 6 x x))))
(defmacro smooth01 (x) (* (clip x 0 1) (clip x 0 1) (- 3 (* 2 (clip x 0 1)))))
;; one snare strand (Modal Snare contact model), returns the overlap
(defmacro strand (z k1 k2 r1 r2 gapv onset)
  (make-history h1)
  (make-history h2)
  (make-history h3)
  (make-history h4)
  (def y1 (gswitch onset 0 (read-history h1)))
  (def y2 (gswitch onset 0 (read-history h2)))
  (def u1 (gswitch onset 0 (read-history h3)))
  (def u2 (gswitch onset 0 (read-history h4)))
  (def w1 (- (* 2 r1 k1 y1) (* r1 r1 y2)))
  (def w2 (- (* 2 r2 k2 u1) (* r2 r2 u2)))
  (def w (+ w1 (* 0.5 w2)))
  (def ov (min (max (- (- z w) gapv) 0) 0.02))
  (def push (* ov (+ 1 (* 0.8 (min (* ov 1000) 1)))))
  (write-history h2 y1)
  (write-history h1 (+ w1 (* push 0.769)))
  (write-history h4 u1)
  (write-history h3 (+ w2 (* push 0.4615)))
  ov)
;; the canonical clipper: knee p=4 (with p=2 / p=8 / hard mixes) against a dry
;; path that is either scaled or tanh-limited
(defmacro clipper (x ceil_e ceil_inv)
  (def ku (* x ceil_inv))
  (def ku2 (* ku ku))
  (def ku4 (* ku2 ku2))
  (def kn4 (* ceil_e (/ ku (sqrt (sqrt (+ 1 ku4))))))
  (def kn2 (* ceil_e (/ ku (sqrt (+ 1 ku2)))))
  (def kn8 (* ceil_e (/ ku (sqrt (sqrt (sqrt (+ 1 (* ku4 ku4))))))))
  (def khd (* ceil_e (clip ku -1 1)))
  (def kn (mix (mix (mix kn4 kn2 c_k2) kn8 c_k8) khd c_khard))
  (def dryp (mix (* c_dry x) (* ceil_e (tanh ku)) c_dry_tanh))
  (mix dryp kn c_clip_mix))

(defmacro snare-hit (onset pitch velocity)
  (make-history elapsed)
  (make-history armed)
  (def played (max onset (read-history armed)))
  (write-history armed played)
  (def age_samples (gswitch onset 0 (min (* 8 samplerate) (+ 1 (read-history elapsed)))))
  (write-history elapsed age_samples)
  (def age (/ age_samples samplerate))
  (def vel (latch (clip velocity 0 1) onset))
  ;; velocity curves straight from the latched velocity: an event-hold here was
  ;; miscompiled inside fused 4-frame blocks (DGenLisp v0.1.28), silently scaling
  ;; whole layers by a stale lane value
  (def vel_e (max vel 0.0001))
  (def vel_on (gt vel 0))
  (defmacro vpow (e) (* vel_on (exp (* e (log vel_e)))))
  (defmacro hitg (hz) (latch (svf-g hz) onset))
  (def note (* 2 (clip (latch (/ pitch 440) onset) 0.25 4)))
  (def tune_v (clip (latch tune onset) 0.5 2))
  (def decay_v (clip (latch decay onset) 0.25 3))
  (def bend_v (clip (latch bend onset) 0 2))
  (def inv_dec (/ 1 decay_v))
  (def tuning (* note tune_v))
  (def T (max 0 (- age c_pre)))
  (def white_scale (sqrt (/ samplerate 48000)))
  (defmacro white () (* 1.7320508 white_scale (- (* 2 (noise)) 1)))
  (defmacro dsc (w) (+ 1 (* w (- decay_v 1))))
  (defmacro env-std (Tc del rise hold dec endt endw)
    (def et (max 0 (- Tc del)))
    (* (gt Tc del) (- 1 (exp (/ (- et) rise))) (exp (/ (- (max 0 (- et hold))) dec))
       (- 1 (smooth01 (/ (- Tc endt) endw)))))
  ;; gates on the main-strike clock: D = drum, H = head
  (def gd_sagg (exp (* 0.115129255 c_gd_sag (clip (/ (- T c_gd_sag_ms) (max 0.001 (- c_gd_ms c_gd_sag_ms))) 0 1))))
  (def GD (+ (- 1 c_gd_depth) (* c_gd_depth gd_sagg (- 1 (smooth01 (/ (- T c_gd_ms) c_gd_fall))))))
  (def GH (- 1 (* c_gh_depth (smooth01 (/ (- T c_gh_ms) c_gh_fall)))))
  (defmacro gm (w) (- 1 (* w (- 1 GD))))

  ;; ---- head: 26 role slots (unrolled) --------------------------------------
  (def t0 (max 0 (- T b0_t0)))
  (def sh0 (max (* -0.9 b0_f) (* bend_v b0_gf)))
  (def se0 (exp (* (- 0 t0) b0_itau)))
  (def hz0 (* tuning (+ b0_f (* sh0 se0))))
  (def m0 (* b0_amp (exp (* (- 0 t0) b0_idec inv_dec)) (- 1 (exp (* (- 0 t0) b0_irise))) (clip (/ (- (* 0.48 samplerate) hz0) (* 0.08 samplerate)) 0 1) (sin (+ (* twopi tuning (+ (* b0_f t0) (* sh0 b0_tau (- 1 se0)))) b0_ph))))
  (def t1 (max 0 (- T b1_t0)))
  (def sh1 (max (* -0.9 b1_f) (* bend_v b1_gf)))

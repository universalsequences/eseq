(def mod1 (in 6 @name mod1 @modulator 1))
(def mod2 (in 7 @name mod2 @modulator 2))
(def mod3 (in 8 @name mod3 @modulator 3))
(def mod4 (in 9 @name mod4 @modulator 4))

(defmacro sax-bore (freq breath stiffness brightness noise_amt)
  (make-history bore)
  (make-history dc_x)
  (make-history dc_y)
  (make-history refl_lp)
  (def clip-0 (clip stiffness 0.1 1.2))
  (def max-0 (max freq 20))
  (def n0-7 0.7)
  (def n0-8 0.8)
  (def n0-85 0.85)
  (def n0-95 -0.95)
  (def n0-995 0.995)
  (def mul-2 (* n0-995 (read-history dc_y)))
  (def n1 1)
  (def n1-1 1)
  (def n1-2 1)
  (def div-0 (/ samplerate max-0))
  (def noise-0 (noise))
  (def sub-0 (- n1 brightness))
  (def damp (clip sub-0 0.05 0.95))
  (def sub-1 (- n1-1 damp))
  (def lp_phase_delay (/ damp sub-1))
  (def sub-2 (- div-0 n1-2 lp_phase_delay))
  (def delay_samps (clip sub-2 2 4000))
  (def delayed (delay (read-history bore) delay_samps))
  (def lp (mix delayed (read-history refl_lp) damp))
  (def refl (* n0-95 lp))
  (def turb (* noise-0 noise_amt breath))
  (def add-0 (+ n0-85 turb))
  (def mouth (* breath add-0))
  (def pdiff (- mouth refl))
  (def mul-0 (* clip-0 pdiff))
  (def sub-3 (- n0-7 mul-0))
  (def reed (clip sub-3 -1 1))
  (def mul-1 (* pdiff reed))
  (def bore_in (+ refl mul-1))
  (def sub-4 (- bore_in (read-history dc_x)))
  (def dcb (+ sub-4 mul-2))
  (def mul-3 (* n0-8 dcb))
  (def return (tanh mul-3))
  (write-history bore bore_in)
  (write-history dc_x bore_in)
  (write-history dc_y dcb)
  (write-history refl_lp lp)
  return)

(defmacro sax-mini-verb (input decay damp_hz mix_amt)
  (make-history ap)
  (make-history c1)
  (make-history c2)
  (make-history c3)
  (make-history c4)
  (def clip-0 (clip mix_amt 0 1))
  (def cut (clip damp_hz 400 12000))
  (def g (clip decay 0 0.92))
  (def mul-0 (* (read-history c1) g))
  (def add-0 (+ input mul-0))
  (def d1 (delay add-0 1123))
  (def mul-1 (* (read-history c2) g))
  (def add-1 (+ input mul-1))
  (def d2 (delay add-1 1499))
  (def mul-2 (* (read-history c3) g))
  (def add-2 (+ input mul-2))
  (def d3 (delay add-2 1801))
  (def mul-3 (* (read-history c4) g))
  (def add-3 (+ input mul-3))
  (def d4 (delay add-3 2251))
  (def add-4 (+ d1 d2 d3 d4))
  (def mul-4 (* (read-history ap) 0.5))
  (def n0-25 0.25)
  (def combsum (* n0-25 add-4))
  (def ap_in (+ combsum mul-4))
  (def ap_del (delay ap_in 347))
  (def mul-5 (* ap_in -0.5))
  (def add-5 (+ mul-5 ap_del))
  (def mul-6 (* combsum 0))
  (def svf-0 (svf d1 cut 0.7 0))
  (def svf-1 (svf d2 cut 0.7 0))
  (def svf-2 (svf d3 cut 0.7 0))
  (def svf-3 (svf d4 cut 0.7 0))
  (def wet (svf add-5 220 0.7 1))
  (def wet_hp (- wet 0))
  (def add-6 (+ wet_hp mul-6))
  (def verb (- add-6 0))
  (def tanh-0 (tanh verb))
  (def return (mix input tanh-0 clip-0))
  (write-history ap ap_del)
  (write-history c1 svf-0)
  (write-history c2 svf-1)
  (write-history c3 svf-2)
  (write-history c4 svf-3)
  return)

(defmacro sax-smooth (target ms)
  (make-history previous)
  (make-history ready)
  (def coefficient (exp (/ -1 (* 0.001 ms samplerate))))
  (def value (gswitch (read-history ready) (mix target (read-history previous) coefficient) target))
  (write-history previous value)
  (write-history ready 1)
  value)

;; Split waveguide / reed scattering model. The excitation position changes
;; the even/odd harmonic balance; this is a hybrid waveguide, not an exact cone.
(defmacro sax-split-bore (freq mouth slope aperture position loss)
  (make-history forward)
  (make-history backward)
  (make-history filtered)
  (make-history dc_x)
  (make-history dc_y)
  (def f (clip freq 20 4000))
  (def damp (clip loss 0.02 0.85))
  (def omega (/ (* twopi f) samplerate))
  (def phase (/ (atan (/ (* damp (sin omega)) (- 1 (* damp (cos omega))))) omega))
  (def period (- (/ samplerate f) phase 2))
  (def pos (clip position 0.04 0.5))
  (def returning (delay (read-history forward) (max 2 (* (- 1 pos) period))))
  (def low (mix returning (read-history filtered) damp))
  (def bell (* -0.96 low))
  (def neck (delay (read-history backward) (max 2 (* pos period))))
  (def bore_pressure (- bell neck))
  (def delta (- mouth bore_pressure))
  (def reflection (clip (+ aperture (* slope delta)) -1 1))
  (def outgoing (- mouth (* delta reflection) bell))
  (def dc (+ (- bore_pressure (read-history dc_x)) (* (exp (/ (* -20 twopi) samplerate)) (read-history dc_y))))
  (write-history forward outgoing)
  (write-history backward bell)
  (write-history filtered low)
  (write-history dc_x bore_pressure)
  (write-history dc_y dc)
  dc)

(defmacro sax-expression (gate trigger rate depth delay_ms breath_depth growl_hz growl_depth)
  (make-history age)
  (make-history last_gate)
  (def onset (max trigger (* (gt gate 0.5) (lte (read-history last_gate) 0.5))))
  (def elapsed (gswitch onset 0 (min 60 (+ (read-history age) (/ 1 samplerate)))))
  (def fade (clip (/ (- elapsed (* delay_ms 0.001)) 0.15) 0 1))
  (def wave (* fade (sin (* twopi (phasor rate)))))
  (def ratio (pow 2 (/ (* depth wave) 1200)))
  (def growl (sin (* twopi (phasor growl_hz))))
  (def pressure_motion (* (+ 1 (* wave breath_depth)) (+ 1 (* growl growl_depth))))
  (write-history age elapsed)
  (write-history last_gate gate)
  (tuple ratio pressure_motion))

(param attack @group amp @env amp-env @role attack @default 5 @min 0 @max 1000 @unit ms)
(param stiffness @min 0 @max 1 @default 0.8 @mod true @mod-mode additive)
(param brightness @min 0 @max 1 @mod-mode additive @mod true)
(param brnoise @min 0 @max 1 @mod-mode additive @mod true)
(param decay @group amp @env amp-env @role decay @default 120 @min 1 @max 2000 @unit ms)
(param gain @default 0.5 @min 0 @max 1 @mod true @mod-mode additive)
(param release @group amp @env amp-env @role release @default 180 @min 1 @max 5000 @unit ms)
(param sustain @group amp @env amp-env @role sustain @default 0.8 @min 0 @max 1)

(param acoustic @group bore @default 0 @min 0 @max 1 @mod true @mod-mode additive)
(param pressure @group reed @default 0.8 @min 0 @max 1.2 @mod true @mod-mode additive)
(param reed @group reed @default 0.3 @min 0.1 @max 0.7 @mod true @mod-mode additive)
(param closure @group reed @default 0.7 @min 0.3 @max 0.9 @mod true @mod-mode additive)
(param blow_pos @group bore @default 0.2 @min 0.04 @max 0.5 @mod true @mod-mode additive)
(param damping @group bore @default 0.25 @min 0.02 @max 0.85 @mod true @mod-mode additive)
(param air @group reed @default 0.015 @min 0 @max 0.3 @mod true @mod-mode additive)
(param bell_hz @group bore @default 9000 @min 600 @max 16000 @unit Hz @mod true @mod-mode additive)
(param body @group color @default 0 @min 0 @max 0.9 @mod true @mod-mode additive)
(param body_hz @group color @default 750 @min 200 @max 5000 @unit Hz @mod true @mod-mode additive)
(param body_q @group color @default 2.5 @min 0.5 @max 6 @mod true @mod-mode additive)
(param growl @group expression @default 0 @min 0 @max 0.5 @mod true @mod-mode additive)
(param growl_hz @group expression @default 80 @min 15 @max 250 @unit Hz @mod true @mod-mode additive)
(param vib_cent @group expression @default 0 @min 0 @max 100 @unit cents @mod true @mod-mode additive)
(param vib_hz @group expression @default 5.5 @min 0.1 @max 12 @unit Hz @mod true @mod-mode additive)
(param vib_wait @group expression @default 180 @min 0 @max 2000 @unit ms)
(param vib_air @group expression @default 0.035 @min 0 @max 0.3 @mod true @mod-mode additive)
(param vel_blow @group reed @default 0.2 @min 0 @max 1)

(def gate (in 1 @name gate))
(def pitch (in 2 @name pitch))
(def velocity (in 3 @name velocity))
(def trigger (in 4 @name trigger))
(def clock (in 5 @name clock))

(def env (adsr gate trigger attack decay sustain release))
(def mod-2 (mod stiffness))
(def mod-3 (mod brightness))
(def mod-4 (mod brnoise))
(def sax-bore-2 (sax-bore pitch env mod-2 mod-3 mod-4))
(def model (sax-smooth (clip (mod acoustic) 0 1) 10))
(def mouth_level (sax-smooth (clip (mod pressure) 0 1.2) 8))
(def slope (sax-smooth (clip (mod reed) 0.1 0.7) 5))
(def aperture (sax-smooth (clip (mod closure) 0.3 0.9) 5))
(def position (sax-smooth (clip (mod blow_pos) 0.04 0.5) 8))
(def loss (sax-smooth (clip (mod damping) 0.02 0.85) 5))
(def (pitch_motion breath_motion) (sax-expression gate trigger
  (clip (mod vib_hz) 0.1 12) (clip (mod vib_cent) 0 100) vib_wait
  (clip (mod vib_air) 0 0.3) (clip (mod growl_hz) 15 250) (clip (mod growl) 0 0.5)))
(def breath_air (svf (noise) 4000 0.7 0))
(def blowing (* env mouth_level (mix 1 (clip velocity 0 1) vel_blow)
  breath_motion (+ 1 (* (clip (mod air) 0 0.3) breath_air))))
(def acoustic_bore (sax-split-bore (* pitch pitch_motion) blowing slope aperture position loss))
(def bell_tone (svf acoustic_bore (min (* samplerate 0.4) (clip (mod bell_hz) 600 16000)) 0.7 0))
;; A passive output formant models spectral coloration separately from the
;; reed/bore feedback. Unity peak gain keeps color sweeps from adding energy.
(def color_q (clip (mod body_q) 0.5 6))
(def color_band (/ (svf bell_tone (clip (mod body_hz) 200 5000) color_q 1) color_q))
(def colored (mix bell_tone color_band (clip (mod body) 0 0.9)))
(def tone (mix sax-bore-2 (* 0.5 colored (clip velocity 0 1)) model))
(out (* tone 2 (clip (mod gain) 0 1)) 1 @name audio)

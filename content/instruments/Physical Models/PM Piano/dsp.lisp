  (def s (piano-audio (* radius (sin omega))))
  (def real_next (+ (- (* c x) (* s y)) (* force (piano-audio weight))))
  (def imag_next (+ (* s x) (* c y)))
  (write-tensor-history real_h real_next)
  (write-tensor-history imag_h imag_next)
  (sum imag_next))


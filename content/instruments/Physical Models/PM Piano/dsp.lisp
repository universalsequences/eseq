(def register_balance (mix 1 (peek balance_table note_row) (clip (mod balance) 0 1)))
(def output_gain (* (piano-smooth (* (clip (mod gain) 0 1) register_balance) 5) tremolo_gain))
(def drive_v (piano-smooth (clip (mod drive) 0 1) 5))
(def cutoff (min (clip (mod tone_hz) 500 20000) (* samplerate 0.43)))
(defmacro piano-output (signal pan_gain)
  (def clean (svf signal cutoff 0.707 0))
  (def shaped (mix clean (/ (tanh (* clean (+ 1 (* drive_v 12)))) (+ 1 (* drive_v 3))) drive_v))
  (* shaped output_gain pan_gain))
(out (piano-output (+ brightened string_side) (sqrt (- 1 pan_value))) 1)
(out (piano-output (- brightened string_side) (sqrt (+ 1 pan_value))) 2)

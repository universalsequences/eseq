(def velocity_gain (/ hit_velocity (max 0.6 strength)))
(def key_note (+ 69 (* 12 (/ (log (/ (clip pitch 32.703196 8372.018) 440)) (log 2)))))
(def row (gamelan-hold (gamelan-row (+ key_note (gamelan-smooth (clip (mod register) -24 24) 8))) update_tick))
(def row_low (floor row))
(def row_high (min 6 (+ row_low 1)))

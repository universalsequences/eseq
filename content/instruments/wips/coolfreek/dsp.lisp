(defmacro schroeder_allpass (input delay_samples g)
  (make-history fb)
  (def delayed (delay (read-history fb) delay_samples))
  (def w (+ input (* g delayed)))
  (write-history fb w)
  (- delayed (* g w)))
(defmacro fbk-delay (input delay_time feedback damp_freq wet_level)
  (make-history fb_hist)
  (def fb_signal (read-history fb_hist))
  (def filtered (svf fb_signal damp_freq 0.707 0.0))
  (def injected (+ input (* filtered feedback)))
  (def del_out (delay injected delay_time))
  (write-history fb_hist del_out)
  (mix input del_out wet_level))

  (def (pos pos_before) (rg-tick-interp cpos tick bstart active 0))
  (def (dc dc_before) (rg-tick-interp dcomp tick bstart active 0))
  (def (fir_damp_next fir_damp) (rg-tick-interp dcoef tick bstart active 0))
  (def (fir_br_next fir_br) (rg-tick-interp bright tick bstart active 0))

  (def (o2 a2) (rg-string-plain rg_line2 (* sym sym_in) bstart sym sf2 sr2 dly2 cp2 dc2 br2 g2 h2 dcm2))
  (def (fq3 lfo3) (rg-sym-state (rg-note-to-freq n3) glide (rg-cos-coef (* 0.23 (/ 24 samplerate))) bstart sym))
  (def (sf3 sr3 dly3 cp3 dc3 br3 g3 h3 dcm3 nf3)

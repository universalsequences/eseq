  (def (o5 a5) (rg-string-plain rg_line5 (* sym sym_in) bstart sym sf5 sr5 dly5 cp5 dc5 br5 g5 h5 dcm5))
  (def (fq6 lfo6) (rg-sym-state (rg-note-to-freq n6) glide (rg-cos-coef (* 0.171 (/ 24 samplerate))) bstart sym))

  (write-history h_seg (gswitch bstart seg seg_prev))
  (write-history h_ph (gswitch bstart (+ ph inc) ph_prev))
  (write-history h_sv (gswitch bstart sv (read-history h_sv)))
  (write-history h_val (gswitch bstart value (read-history h_val)))
  (rg-hold value bstart))

; Disastrous Peace voice. tonic/chord/brightness/damping/position are
; block-latched; strum is the block's strum flag; fx 0..5 the FX type.
(defmacro rg-peace (bstart bphase strum tonic chord brightness damping position fx)
  ; ---- chord acquisition: the chord follows STRUCTURE except during the
  ; strum block and the 2 blocks after it
  (make-history h_acq)
  (make-history h_chord)
  (def acq (gswitch strum 2 (max (- (read-history h_acq) 1) 0)))
  (def busy (max strum (gt (read-history h_acq) 0)))
  (def gchord (gswitch busy (read-history h_chord) chord))
  (write-history h_acq (gswitch bstart acq (read-history h_acq)))
  (write-history h_chord (gswitch bstart gchord (read-history h_chord)))
  (def ch (rg-hold gchord bstart))
  ; ---- envelope (ProcessEnvelopes)
  (def attack (gswitch (lt damping 0.5) 0 (* (- damping 0.5) 2)))
  (def period (/ samplerate 24))
  (def attack_rate (/ 1 (* (rg-semi-ratio (* attack 96)) 0.005 period)))
  (def decay_rate (/ 1 (* (rg-semi-ratio (* damping 84)) 0.18 period)))
  (def drone (min (gswitch (lt damping 0.98) 0 (* (- damping 0.98) 55)) 1))
  (def env (ss-envelope strum attack_rate decay_rate bstart))
  (def env_v (+ env (* (- 1 env) drone)))
  ; ---- ComputeRegistration(env * 0.25, brightness)
  (def reg (* brightness 9.999))
  (def ri (floor reg))
  (def rf (- reg ri))
  (def ra0 (peek rg_ss_registrations (+ (* ri 6) 0) 0))
  (def rb0 (peek rg_ss_registrations (+ (* ri 6) 6) 0))
  (def rr0 (+ ra0 (* (- rb0 ra0) rf)))
  (def ra1 (peek rg_ss_registrations (+ (* ri 6) 1) 0))
  (def rb1 (peek rg_ss_registrations (+ (* ri 6) 7) 0))
  (def rr1 (+ ra1 (* (- rb1 ra1) rf)))
  (def ra2 (peek rg_ss_registrations (+ (* ri 6) 2) 0))
  (def rb2 (peek rg_ss_registrations (+ (* ri 6) 8) 0))
  (def rr2 (+ ra2 (* (- rb2 ra2) rf)))
  (def ra3 (peek rg_ss_registrations (+ (* ri 6) 3) 0))
  (def rb3 (peek rg_ss_registrations (+ (* ri 6) 9) 0))
  (def rr3 (+ ra3 (* (- rb3 ra3) rf)))
  (def ra4 (peek rg_ss_registrations (+ (* ri 6) 4) 0))
  (def rb4 (peek rg_ss_registrations (+ (* ri 6) 10) 0))
  (def rr4 (+ ra4 (* (- rb4 ra4) rf)))
  (def ra5 (peek rg_ss_registrations (+ (* ri 6) 5) 0))
  (def rb5 (peek rg_ss_registrations (+ (* ri 6) 11) 0))
  (def rr5 (+ ra5 (* (- rb5 ra5) rf)))
  (def rtotal (+ rr0 rr1 rr2 rr3 rr4 rr5))
  (def rgain (/ (* env_v 0.25) rtotal))
  (def h0 (* rgain rr0))
  (def h1 (* rgain rr1))
  (def h2 (* rgain rr2))
  (def h3 (* rgain rr3))
  (def h4 (* rgain rr4))
  (def h5 (* rgain rr5))
  ; ---- the 8 chord notes
  (def cn0 (peek rg_ss_chords (+ (* ch 8) 0) 0))
  (def am0 (gswitch (* (gte cn0 0) (lte cn0 17)) 1 0.7))
  (def v0 (ss-voice (rg-note-to-freq (+ tonic cn0)) am0 h0 h1 h2 h3 h4 h5 bstart bphase))
  (def cn1 (peek rg_ss_chords (+ (* ch 8) 1) 0))
  (def am1 (gswitch (* (gte cn1 0) (lte cn1 17)) 1 0.7))
  (def v1 (ss-voice (rg-note-to-freq (+ tonic cn1)) am1 h0 h1 h2 h3 h4 h5 bstart bphase))
  (def cn2 (peek rg_ss_chords (+ (* ch 8) 2) 0))
  (def am2 (gswitch (* (gte cn2 0) (lte cn2 17)) 1 0.7))
  (def v2 (ss-voice (rg-note-to-freq (+ tonic cn2)) am2 h0 h1 h2 h3 h4 h5 bstart bphase))
  (def cn3 (peek rg_ss_chords (+ (* ch 8) 3) 0))
  (def am3 (gswitch (* (gte cn3 0) (lte cn3 17)) 1 0.7))
  (def v3 (ss-voice (rg-note-to-freq (+ tonic cn3)) am3 h0 h1 h2 h3 h4 h5 bstart bphase))
  (def cn4 (peek rg_ss_chords (+ (* ch 8) 4) 0))
  (def am4 (gswitch (* (gte cn4 0) (lte cn4 17)) 1 0.7))
  (def v4 (ss-voice (rg-note-to-freq (+ tonic cn4)) am4 h0 h1 h2 h3 h4 h5 bstart bphase))
  (def cn5 (peek rg_ss_chords (+ (* ch 8) 5) 0))
  (def am5 (gswitch (* (gte cn5 0) (lte cn5 17)) 1 0.7))
  (def v5 (ss-voice (rg-note-to-freq (+ tonic cn5)) am5 h0 h1 h2 h3 h4 h5 bstart bphase))
  (def cn6 (peek rg_ss_chords (+ (* ch 8) 6) 0))
  (def am6 (gswitch (* (gte cn6 0) (lte cn6 17)) 1 0.7))
  (def v6 (ss-voice (rg-note-to-freq (+ tonic cn6)) am6 h0 h1 h2 h3 h4 h5 bstart bphase))
  (def cn7 (peek rg_ss_chords (+ (* ch 8) 7) 0))
  (def am7 (gswitch (* (gte cn7 0) (lte cn7 17)) 1 0.7))
  (def v7 (ss-voice (rg-note-to-freq (+ tonic cn7)) am7 h0 h1 h2 h3 h4 h5 bstart bphase))
  (def odd (+ v1 v3 v5 v7))
  (def even (+ v0 v2 v4 v6))
  ; ---- formant filters (FX_FORMANT, FX_FORMANT_2)
  (def formant (+ (eq fx 0) (eq fx 3)))
  (def shift (gswitch (eq fx 0) 1 1.1))
  (def fr (gswitch (eq fx 0) 0.04 0.1))
  (def vowel (* position 3.999))
  (def vi (floor vowel))
  (def vf (- vowel vi))
  (def fin (+ odd even))
  (def fa0 (peek rg_ss_formants (+ (* vi 3) 0) 0))
  (def fb0 (peek rg_ss_formants (+ (* vi 3) 3) 0))
  (def ff0 (/ (* (+ fa0 (* (- fb0 fa0) vf)) shift) samplerate))
  (def (fl0 fbp0 fh0) (rg-svf (* formant fin) (rg-tan-dirty ff0) fr))
  (def fa1 (peek rg_ss_formants (+ (* vi 3) 1) 0))
  (def fb1 (peek rg_ss_formants (+ (* vi 3) 4) 0))
  (def ff1 (/ (* (+ fa1 (* (- fb1 fa1) vf)) shift) samplerate))
  (def (fl1 fbp1 fh1) (rg-svf (* formant fin) (rg-tan-dirty ff1) fr))
  (def fa2 (peek rg_ss_formants (+ (* vi 3) 2) 0))
  (def fb2 (peek rg_ss_formants (+ (* vi 3) 5) 0))
  (def ff2 (/ (* (+ fa2 (* (- fb2 fa2) vf)) shift) samplerate))
  (def (fl2 fbp2 fh2) (rg-svf (* formant fin) (rg-tan-dirty ff2) fr))
  (def f_out (+ (* fbp0 0.1) (* fbp1 0.25) (* fbp2 0.4)))
  (def f_aux (+ (* fbp0 0.4) (* fbp1 0.25) (* fbp2 0.1)))
  (tuple (gswitch formant f_out odd) (gswitch formant f_aux even)))

; ======================================================================
; Effects (rings/dsp/fx): the Griesinger reverb used by model 5 and by
; Disastrous Peace, and Disastrous Peace's chorus and ensemble. They run on
; FxEngine's 16-bit delay memory, emulated by `fx-store` on every write.
; Delay lengths and LFO rates are the module's 48 kHz values scaled to the
; host sample rate.
; ======================================================================

(def fx_lut_sine fm_lut_sine)

; Delay memory, sized for sample rates up to 96 kHz. One write counter per
; effect; `peek` wraps its index to each line's size and interpolates.
(def rv_ap1 (tensor @shape [512]))
(def rv_ap2 (tensor @shape [512]))
(def rv_ap3 (tensor @shape [1024]))
(def rv_ap4 (tensor @shape [2048]))
(def rv_dap1a (tensor @shape [8192]))
(def rv_dap1b (tensor @shape [8192]))
(def rv_del1 (tensor @shape [16384]))
(def rv_dap2a (tensor @shape [8192]))
(def rv_dap2b (tensor @shape [8192]))
(def rv_del2 (tensor @shape [16384]))
(def fx_line_l (tensor @shape [4096]))
(def fx_line_r (tensor @shape [4096]))

; Sample counter for an effect's delay lines. It wraps at 16384, a multiple
; of every line size, small enough to keep fractional read positions
; precise in float.
(defmacro fx-counter ()
  (make-history h)
  (def c (read-history h))
  (write-history h (% (+ c 1) 16384))
  c)

; FxEngine allpass on an L-sample line written at counter c: read the tail
; (L - 1 samples back), store x + g * tail (as int16), return
; tail - g * (x + g * tail).
(defmacro fx-allpass (buf c x len g)
  (def r (peek buf (- c (- (* len (/ samplerate 48000)) 1))))
  (def w (+ x (* r g)))
  (seq (poke buf c (fx-store w))
       (+ (* w (- g)) r)))

; Reverb::Process (rings/dsp/fx/reverb.h). Returns (left right).
(defmacro rg-reverb (l r amount krt gain klp)
  (make-history h_lp1)
  (make-history h_lp2)
  (def c (fx-counter))
  (def sr_scale (/ samplerate 48000))
  (def kap 0.625)
  (def lfo1 (fx-lfo 0.5))
  (def lfo2 (fx-lfo 0.3))
  (def ap_a (fx-allpass rv_ap1 c (* (+ l r) gain) 150 kap))
  (def ap_b (fx-allpass rv_ap2 c ap_a 214 kap))
  (def ap_c (fx-allpass rv_ap3 c ap_b 319 kap))
  (def apout (fx-allpass rv_ap4 c ap_c 527 kap))
  ; loop half 1: apout + del2 (written last sample and before) -> lp ->
  ; 2 allpasses -> del1
  (def d2 (peek rv_del2 (- c (* (+ 6261 (* 50 lfo2)) sr_scale))))
  (def lp1 (+ (read-history h_lp1) (* klp (- (+ apout (* d2 krt)) (read-history h_lp1)))))
  (write-history h_lp1 lp1)
  (def w1 (fx-allpass rv_dap1b c (fx-allpass rv_dap1a c lp1 2182 (- kap)) 2690 kap))
  ; loop half 2: apout + del1 (including this sample's write) -> lp ->
  ; 2 allpasses -> del2
  (def d1 (seq (poke rv_del1 c (fx-store w1))
               (peek rv_del1 (- c (* (+ 4460 (* 40 lfo1)) sr_scale)))))
  (def lp2 (+ (read-history h_lp2) (* klp (- (+ apout (* d1 krt)) (read-history h_lp2)))))
  (write-history h_lp2 lp2)
  (def w2 (fx-allpass rv_dap2b c (fx-allpass rv_dap2a c lp2 2525 kap) 2197 (- kap)))
  (def out_r (seq (poke rv_del2 c (fx-store w2))
                  (+ r (* (- (* 2 w2) r) amount))))
  (tuple (+ l (* (- (* 2 w1) l) amount)) out_r))

; stmlib Interpolate(lut_sine, phase, 4096) (`peek` interpolates).
(defmacro fx-sine (phase)
  (peek fx_lut_sine (* phase 4096) 0))

; LFO phase in [0, 1), `inc` per 48 kHz sample.
(defmacro fx-phase (inc)
  (make-history h)
  (def p (rg-wrap (+ (read-history h) (* inc (/ 48000 samplerate)))))
  (write-history h p)
  p)

; Disastrous Peace's Chorus (rings/dsp/fx/chorus.h, `chorus` = 1) or
; Ensemble (rings/dsp/fx/ensemble.h, `chorus` = 0) on shared delay lines:
; the chorus writes (l + r) / 2 to the left line and reads it 4 times, the
; ensemble writes l and r and reads them 6 times. Returns (left right).
(defmacro rg-modfx (l r chorus amount depth)
  (def c (fx-counter))
  (def sr_scale (/ samplerate 48000))
  (def dry (- 1 (* amount 0.5)))
  ; chorus LFOs (interpolated lut_sine)
  (def cp1 (fx-phase 0.00000417))
  (def cp2 (fx-phase 0.000005417))
  (def cdp (* depth 384))
  (def c_t1 (+ (* (fx-sine cp1) cdp) 1200))
  (def c_t2 (+ (* (fx-sine cp2) cdp) 800))
  (def c_t3 (+ (* (fx-sine (+ cp1 0.25)) cdp) 800))
  (def c_t4 (+ (* (fx-sine (+ cp2 0.25)) cdp) 1200))
  ; ensemble LFOs (lut_sine without interpolation)
  (def ep1 (fx-phase 0.0000157))
  (def ep2 (fx-phase 0.000137))
  (def phi1 (floor (* ep1 4096)))
  (def phi2 (floor (* ep2 4096)))
  (def ea (* depth 128))
  (def eb (* depth 12.8))
  (def e_m1 (+ 1024 (* (peek fx_lut_sine phi1 0) ea) (* (peek fx_lut_sine phi2 0) eb)))
  (def e_m2 (+ 1024 (* (peek fx_lut_sine (% (+ phi1 1365) 4096) 0) ea) (* (peek fx_lut_sine (% (+ phi2 1365) 4096) 0) eb)))
  (def e_m3 (+ 1024 (* (peek fx_lut_sine (% (+ phi1 2730) 4096) 0) ea) (* (peek fx_lut_sine (% (+ phi2 2730) 4096) 0) eb)))
  ; read slots: wet_l = s1 + s2 + s3, wet_r = s4 + s5 + s6
  (def t1 (gswitch chorus c_t1 e_m1))
  (def t2 (gswitch chorus c_t2 e_m2))
  (def t4 (gswitch chorus c_t3 e_m1))
  (def t5 (gswitch chorus c_t4 e_m2))
  (def xl (fx-store (gswitch chorus (+ (* l 0.5) (* r 0.5)) l)))
  (def xr (fx-store r))
  (def wl (seq (poke fx_line_l c xl)
               (poke fx_line_r c xr)
               (+ (* (gswitch chorus 0.5 0.33)
                     (+ (peek fx_line_l (- c (* t1 sr_scale))) (peek fx_line_l (- c (* t2 sr_scale)))))
                  (* (- 1 chorus) 0.33 (peek fx_line_r (- c (* e_m3 sr_scale)))))))
  (def wr (+ (* 0.5 chorus (+ (peek fx_line_l (- c (* t4 sr_scale))) (peek fx_line_l (- c (* t5 sr_scale)))))
             (* (- 1 chorus) 0.33 (+ (peek fx_line_r (- c (* e_m1 sr_scale))) (peek fx_line_r (- c (* e_m2 sr_scale)))
                                     (peek fx_line_l (- c (* e_m3 sr_scale)))))))
  (tuple (+ (* wl amount) (* l dry)) (+ (* wr amount) (* r dry))))

; ======================================================================
; voice (rings/rings.cc FillBuffer, cv_scaler.cc, strummer.h, part.cc
; Process at polyphony 1): block clock, strum, controls, model selection,
; effects, limiter and outputs
; ======================================================================

(defmacro db-amp (db)
  (exp (* 0.1151292546 db)))

; ---- block clock (kMaxBlockSize = 24) ----
(make-history h_bp)
(def bphase (read-history h_bp))
(write-history h_bp (% (+ bphase 1) 24))
(def bstart (eq bphase 0))

(def m (clip (round model) 0 11))

; ---- strum: the note's gate edge, plus retrigger pulses, once per block,
; then Strummer's 10 ms inhibit ----
(def gate_hi (gt gate 0.5))
(make-history h_pending)
(def pending (max (read-history h_pending) (gt trigger 0.5)))
(write-history h_pending (gswitch bstart 0 pending))
(make-history h_prev_gate)
(def g_prev (read-history h_prev_gate))
(write-history h_prev_gate (gswitch bstart gate_hi g_prev))
(def strum_raw (max pending (* gate_hi (- 1 g_prev))))
(make-history h_inh)
(def inh (read-history h_inh))
(def strum_now (* strum_raw (eq inh 0)))
(def inh_new (gswitch (gt inh 0) (- inh 1) (* strum_now (floor (* 0.01 (/ samplerate 24))))))
(write-history h_inh (gswitch bstart inh_new inh))
(def strum (latch strum_now bstart))
(def strum_h (rg-hold strum_now bstart))
(def vel (latch (clip velocity 0 1) (* bstart strum_now)))

; ---- controls, read once per block ----
(def midi (+ 69 (* 17.312340491 (log (/ (max pitch 1) 440))) (mod tune)))
(def tonic (latch midi bstart))
(def f0 (rg-note-to-freq tonic))
(def structure_b (latch (clip (mod structure) 0 0.9995) bstart))
(def brightness_b (latch (clip (mod brightness) 0 1) bstart))
(def damping_b (latch (clip (mod damping) 0 1) bstart))
(def position_b (latch (clip (mod position) 0 1) bstart))
; the same values as plain sample-and-holds, for the block-gated models
(def tonic_h (rg-hold midi bstart))
(def f0_h (rg-note-to-freq tonic_h))
(def structure_h (rg-hold (clip (mod structure) 0 0.9995) bstart))
(def brightness_h (rg-hold (clip (mod brightness) 0 1) bstart))
(def damping_h (rg-hold (clip (mod damping) 0 1) bstart))
(def position_h (rg-hold (clip (mod position) 0 1) bstart))

; ---- chord: STRUCTURE x 10 with CvScaler's hysteresis ----
(make-history h_chord)
(def chord_prev (read-history h_chord))
(def chord_cv (* structure_b 10))
(def chord_new (clip (floor (+ chord_cv (gswitch (gt (- chord_cv chord_prev) 0) -0.1 0.1) 0.5)) 0 10))
(write-history h_chord (gswitch bstart chord_new chord_prev))
(def chord (latch chord_new bstart))
(def chord_h (rg-hold chord_new bstart))

; ---- models (only the selected one runs, except the string loops) ----
(def u0 (noise))
(def u1 (rg-wrap (* (rg-noise-tap (rg-noise-tap (rg-noise-tap u0))) 4093.7)))
(def (mo ma) (block-gate (eq m 0) (rg-modal bstart bphase strum_h f0_h structure_h brightness_h damping_h position_h)))
(def (fo fa) (block-gate (eq m 3) (rg-fm bstart bphase strum_h f0_h structure_h brightness_h damping_h position_h)))
(def (so sa) (rg-strings bstart strum m f0 tonic chord structure_b brightness_b damping_b position_b u0 u1))
(def (po pa) (block-gate (gte m 6) (rg-peace bstart bphase strum_h tonic_h chord_h brightness_h damping_h position_h (- m 6))))

; ---- effects ----
(def is5 (eq m 5))
(def part_l (+ mo fo so))
(def part_r (+ ma fa sa))
; model 5: odd/even crossfeed by POSITION before the reverb
(def x5_l (+ (* part_l position_b) (* (- 1 position_b) part_r)))
(def x5_r (+ (* part_r position_b) (* (- 1 position_b) part_l)))
(def dp_rev (+ (eq m 8) (eq m 11)))
(def rv_on (max is5 dp_rev))
(def rv_amount (gswitch is5 (+ 0.1 (* damping_b 0.5)) (* position_b 0.5)))
(def rv_time (gswitch is5 (+ 0.35 (* 0.63 damping_b))
                      (gswitch (eq m 8) (+ 0.5 (* 0.49 position_b)) (+ 0.3 (* 0.6 position_b)))))
(def rv_lp (gswitch is5 (+ 0.3 (* 0.6 brightness_b)) (gswitch (eq m 8) 0.3 0.6)))
(def (rv_l rv_r) (rg-reverb (* rv_on (gswitch is5 x5_l po)) (* rv_on (gswitch is5 x5_r pa))
                            rv_amount rv_time 0.2 rv_lp))
(def is_ch (eq m 7))
(def is_en (eq m 10))
(def mod_on (max is_ch is_en))
(def (mf_l mf_r) (rg-modfx (* mod_on po) (* mod_on pa) is_ch
                           (gswitch is_ch position_b (* position_b (- 2 position_b)))
                           (gswitch is_ch (+ 0.15 (* 0.5 position_b)) (+ 0.2 (* 0.8 position_b position_b)))))

; ---- outputs before the limiter (the module's OUT / AUX) ----
(def sel (+ m 1))
(def pre_l (selector sel part_l part_l part_l part_l part_l rv_l po mf_l rv_l po mf_l rv_l))
(def pre_r (selector sel part_r part_r part_r part_r part_r (- rv_r) (- pa) (- mf_r) (- rv_r) (- pa) (- mf_r) (- rv_r)))

; ---- Limiter (part.cc model_gains_; the string synth uses 1) ----
(def lim_gain (selector sel 1.4 1 1.4 0.7 1 1.4 1 1 1 1 1 1))
(def l_pre (* pre_l lim_gain))
(def r_pre (* pre_r lim_gain))
(def peak (rg-slope (max (abs l_pre) (abs r_pre) (abs (- r_pre l_pre))) 0.05 0.00002 0.5))
(def lim (gswitch (lte peak 1) 0.8 (/ 0.8 peak)))
(def odd (clip (rg-soft-limit (* l_pre lim)) -1 1))
(def even (clip (rg-soft-limit (* r_pre lim)) -1 1))

; ---- spread, level ----
(def sp (clip (mod spread) 0 1))
(def ka (* 0.5 (+ 1 sp)))
(def kb (* 0.5 (- 1 sp)))
(def out_level (* (db-amp (clip (mod level_db) -60 12)) vel))
(def voice_left (* (+ (* odd ka) (* even kb)) out_level))
(def voice_right (* (+ (* even ka) (* odd kb)) out_level))
(out voice_left 1 @name left)
(out voice_right 2 @name right)
(use-defmacro voice-amp)
(use-defmacro release-window)
(out (voice-amp (release-window gate 30) voice_left voice_right) 3 @name amp @amp true)

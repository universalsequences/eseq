(def (lp1_3 z2_3 z3_3) (df-biquad-step lp0_3 0.6013448869 z2_2 z3_2))
(def (lp2_3 z4_3 z5_3) (df-biquad-step lp1_3 0.8999762231 z4_2 z5_2))
(def (lp3_3 z6_3 z7_3) (df-biquad-step lp2_3 2.5629154477 z6_2 z7_2))
(def p_c_4 (wrap (+ p_c_3 (/ f_c (* 4 samplerate))) 0 1))
(def p_a_4 (wrap (+ p_a_3 (/ f_a (* 4 samplerate))) 0 1))
(def p_b1_4 (wrap (+ p_b1_3 (/ f_b1 (* 4 samplerate))) 0 1))
(def p_b2_4 (wrap (+ p_b2_3 (/ f_b2 (* 4 samplerate))) 0 1))
(def (x_4 y_4 raw_a_4 raw_b1_4 raw_b2_4) (df-step alg p_c_4 p_a_4 p_b1_4 p_b2_4 f_c f_a f_b1 f_b2 g_c g_a g_b1 g_b2 env_a env_b ctl_a_depth ctl_b_depth ctl_harmonics ctl_feedback raw_a_3 raw_b1_3 raw_b2_3))
(def mixed_4 (mix x_4 y_4 ctl_mix_xy))
(def (lp0_4 z0_4 z1_4) (df-biquad-step mixed_4 0.5097955791 z0_3 z1_3))
(def (lp1_4 z2_4 z3_4) (df-biquad-step lp0_4 0.6013448869 z2_3 z3_3))
(def (lp2_4 z4_4 z5_4) (df-biquad-step lp1_4 0.8999762231 z4_3 z5_3))
(def (lp3_4 z6_4 z7_4) (df-biquad-step lp2_4 2.5629154477 z6_3 z7_3))
(write-history phase_c p_c_4)
(write-history phase_a p_a_4)
(write-history phase_b1 p_b1_4)
(write-history phase_b2 p_b2_4)
(write-history feedback_a raw_a_4)
(write-history feedback_b1 raw_b1_4)
(write-history feedback_b2 raw_b2_4)
(write-history decim_0 z0_4)
(write-history decim_1 z1_4)
(write-history decim_2 z2_4)
(write-history decim_3 z3_4)
(write-history decim_4 z4_4)
(write-history decim_5 z5_4)
(write-history decim_6 z6_4)
(write-history decim_7 z7_4)

(def source (* .4 routing-gain lp3_4 (df-db (df-smooth (clip (mod source_db) -36 12) reset))))
(def cutoff_hz (clip (* (df-smooth (clip (mod cutoff) 20 16000) reset)
  (pow (/ (max pitch 1) 261.6256) (clip (mod keytrack) 0 1))
  (pow 2 (* env_filter (clip (mod filter_depth) -8 8)))) 20 (min 16000 (* samplerate .36))))
(def filtered (drift-filter-morph source cutoff_hz
  (df-smooth (clip (mod resonance) 0 1) reset)
  (df-smooth (clip (mod highpass) 20 (min 12000 (* samplerate .36))) reset) (df-smooth (clip filter_type 0 1) reset)))
(def vel (+ 1 (* (- velocity 1) (clip (mod velocity_amount) 0 1))))
(def signal (* (clip filtered -.875 .875) env_amp vel (df-db (df-smooth (clip (mod volume_db) -48 6) reset))))
(def pan_value (df-smooth (clip (mod pan) -1 1) reset))
(out (* signal (sqrt (* .5 (- 1 pan_value)))) 1 @name left)
(out (* signal (sqrt (* .5 (+ 1 pan_value)))) 2 @name right)

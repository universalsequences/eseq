  (def pi4 (additive-pre am_i4 (additive-gain 4 center_i slope bumps) bstart))
  (def pi5 (additive-pre am_i5 (additive-gain 5 center_i slope bumps) bstart))
  (def pi6 (additive-pre am_i6 (additive-gain 6 center_i slope bumps) bstart))
  (def pi7 (additive-pre am_i7 (additive-gain 7 center_i slope bumps) bstart))

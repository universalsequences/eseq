; ======================================================================
; String machine engine (plaits/dsp/engine2/string_machine_engine.cc):
; 4 divide-down voices (ChordBank chord, no inversion) split L/R, two
; NaiveSvf low-passes, cross-mix, Ensemble chorus.
; Requires engines/chordbank.lisp (cb-* helpers) loaded first.
; ======================================================================
(def strmach_lut_sine (tensor @shape [641 1] @file "data/lut_sine.json"))
; registrations[11][6], index row * 6 + k.
(def strmach_reg (tensor @shape [66 1] @data [1 0 0 0 0 0  0.5 0 0.5 0 0 0  0.4 0 0.2 0 0.4 0  0.3 0 0 0.3 0 0.4  0.3 0 0 0 0 0.7  0.2 0 0 0.2 0 0.6  0 0.2 0.1 0 0.2 0.5  0 0.3 0 0.3 0 0.4  0 0.4 0 0.3 0 0.3  0 0.5 0 0.5 0 0  0 1 0 0 0 0]))

(defmacro strmach-reg-at (ri rf k)
  (def a (peek strmach_reg (+ (* ri 6) k) 0))
  (def b (peek strmach_reg (+ (* ri 6) 6 k) 0))
  (+ a (* (- b a) rf)))

; stmlib NaiveSvf, FREQUENCY_DIRTY, low-pass output; f = 2 pi min(fc, 0.158).
(defmacro strmach-naive-lp (in f damp)
  (make-history h_lp)
  (make-history h_bp)
  (def bp0 (read-history h_bp))
  (def lp (+ (read-history h_lp) (* f bp0)))
  (def hp (- in (* bp0 damp) lp))
  (def bp (+ bp0 (* f hp)))
  (write-history h_lp lp)
  (write-history h_bp bp)
  lp)

; uint32 LFO phase kept exactly as (hi, lo) 16-bit halves; returns hi after
; adding inc_hi * 65536 + inc_lo per sample.
(defmacro strmach-phase32 (inc_hi inc_lo)
  (make-history h_hi)
  (make-history h_lo)
  (def lo1 (+ (read-history h_lo) inc_lo))
  (def c (gte lo1 65536))
  (def lo (- lo1 (* c 65536)))
  (def hi1 (+ (read-history h_hi) inc_hi c))
  (def hi (- hi1 (* (gte hi1 65536) 65536)))
  (write-history h_lo lo)
  (write-history h_hi hi)
  (tuple hi lo))

; SineRaw(phase + (off_hi, off_lo)): lut_sine[(phase + off) >> 23].
(defmacro strmach-sine-raw (hi lo off_hi off_lo)
  (def c (gte (+ lo off_lo) 65536))
  (def h1 (+ hi off_hi c))
  (def h (- h1 (* (gte h1 65536) 65536)))
  (peek strmach_lut_sine (floor (* h 0.0078125)) 0))

; plaits Ensemble (FxEngine<1024, FORMAT_32_BIT>, two 511-sample lines).
; Split for block-gate: the LFO delay times and the six delay taps run
; after the gate.
(defmacro strmach-ensemble-times (depth)
  (def (p1h p1l) (strmach-phase32 1 1753))
  (def (p2h p2l) (strmach-phase32 9 156))
  (def slow_0 (strmach-sine-raw p1h p1l 0 0))
  (def slow_120 (strmach-sine-raw p1h p1l 21626 57671))
  (def slow_240 (strmach-sine-raw p1h p1l 43253 49807))
  (def fast_0 (strmach-sine-raw p2h p2l 0 0))
  (def fast_120 (strmach-sine-raw p2h p2l 21626 57671))
  (def fast_240 (strmach-sine-raw p2h p2l 43253 49807))
  (def a (* depth 160))
  (def b (* depth 16))
  (def d1 (+ 192 (* slow_0 a) (* fast_0 b)))
  (def d2 (+ 192 (* slow_120 a) (* fast_120 b)))
  (def d3 (+ 192 (* slow_240 a) (* fast_240 b)))
  (tuple d1 d2 d3))

(defmacro strmach-ensemble (left right amount d1 d2 d3)
  (def dry (- 1 (* amount 0.5)))
  (def l1 (delay left d1 @max-delay 512))
  (def l2 (delay left d2 @max-delay 512))
  (def l3 (delay left d3 @max-delay 512))
  (def r1 (delay right d1 @max-delay 512))
  (def r2 (delay right d2 @max-delay 512))
  (def r3 (delay right d3 @max-delay 512))
  (def wet_l (+ (* l1 0.33) (* l2 0.33) (* r3 0.33)))
  (def wet_r (+ (* r1 0.33) (* r2 0.33) (* l3 0.33)))
  (tuple (+ (* wet_l amount) (* left dry)) (+ (* wet_r amount) (* right dry))))

(defmacro strmach-voices (bstart note timbre morph harmonics bphase)
  (def morph_lp (cb-block-pole morph 0.1 bstart))
  (def chord (cb-chord-index harmonics bstart))
  (def reg (* (max morph_lp 0) 9.999))
  (def ri (floor reg))
  (def rf (- reg ri))
  (def h0 (strmach-reg-at ri rf 0))
  (def h1 (strmach-reg-at ri rf 1))
  (def h2 (strmach-reg-at ri rf 2))
  (def h3 (strmach-reg-at ri rf 3))
  (def h4 (strmach-reg-at ri rf 4))
  (def h5 (strmach-reg-at ri rf 5))
  (def f0 (* (pl-note-to-freq note) 0.998))
  (def nf0 (* f0 (peek cb_ratios (* chord 4) 0)))
  (def nf1 (* f0 (peek cb_ratios (+ (* chord 4) 1) 0)))
  (def nf2 (* f0 (peek cb_ratios (+ (* chord 4) 2) 0)))
  (def nf3 (* f0 (peek cb_ratios (+ (* chord 4) 3) 0)))
  (def v0 (cb-string-synth nf0 h0 h1 h2 h3 h4 h5 (* 0.25 (clip (- 4 (* nf0 32)) 0 1)) 1 bstart bphase))
  (def v1 (cb-string-synth nf1 h0 h1 h2 h3 h4 h5 (* 0.25 (clip (- 4 (* nf1 32)) 0 1)) 1 bstart bphase))
  (def v2 (cb-string-synth nf2 h0 h1 h2 h3 h4 h5 (* 0.25 (clip (- 4 (* nf2 32)) 0 1)) 1 bstart bphase))
  (def v3 (cb-string-synth nf3 h0 h1 h2 h3 h4 h5 (* 0.25 (clip (- 4 (* nf3 32)) 0 1)) 1 bstart bphase))
  (def cutoff (* 2.2 f0 (pl-semi-ratio (* 120 timbre))))
  (def l (strmach-naive-lp (+ v0 v2) (* twopi (min cutoff 0.158)) 1))
  (def r (strmach-naive-lp (+ v1 v3) (* twopi (min (* cutoff 1.5) 0.158)) 1))
  (def mo (+ (* 0.66 l) (* 0.33 r)))
  (def ma (+ (* 0.66 r) (* 0.33 l)))
  (tuple mo ma))

(defmacro plaits-strmach (bstart bphase rise high patched note timbre morph harmonics accent active)
  (def (mo ma) (block-gate active (strmach-voices bstart note timbre morph harmonics bphase)))
  ; A delay time may not come out of a block-gate, so the ensemble LFOs run
  ; ungated.
  (def (d1 d2 d3) (strmach-ensemble-times (+ 0.35 (* 0.65 timbre))))
  (def (l r) (strmach-ensemble mo ma (* (abs (- timbre 0.5)) 2) d1 d2 d3))
  (tuple (* active l) (* active r)))

; ======================================================================
; Chiptune engine (plaits/dsp/engine2/chiptune_engine.cc).
; Trigger patched ("clocked"): each rising edge clocks an arpeggiator over
;   the sorted notes of the chord (HARMONICS); TIMBRE picks the pattern
;   (up/down/up-down/random x 1/2/4 octaves); one SuperSquare voice on OUT.
; Unpatched: 5 SuperSquare voices play the chord inversion set by TIMBRE.
; AUX: NES triangle bass at f0 / 2 (x arpeggiator octave when clocked).
; MORPH: SuperSquare shape. Extra arg env_shape = ChiptuneEngine
; set_envelope_shape value (2 = NO_ENVELOPE).
; already_enveloped = patched (the C++ sets it to `clocked`).
; ======================================================================

; Chord bank (generated by tools/chip_tables.py): unsorted ratios,
; Sort()ed ratios (folded into one octave), and note counts per chord.
(def chip_ratios (tensor @shape [44 1] @data [1.0 1.0004513263702393 1.9986467361450195 2.0 1.0 1.4983071088790894 1.498983383178711 2.0 1.0 1.3348398208618164 1.4983071088790894 2.0 1.0 1.1892070770263672 1.4983071088790894 2.0 1.0 1.1892070770263672 1.4983071088790894 1.7817974090576172 1.0 1.1892070770263672 1.7817974090576172 2.2449240684509277 1.0 1.1892070770263672 1.7817974090576172 2.669679641723633 1.0 1.1224620342254639 1.6817928552627563 2.5198421478271484 1.0 1.2599210739135742 1.8877485990524292 2.2449240684509277 1.0 1.2599210739135742 1.4983071088790894 1.8877485990524292 1.0 1.2599210739135742 1.4983071088790894 2.0]))
(def chip_sorted (tensor @shape [44 1] @data [1.0 1.0004513263702393 1.9986467361450195 2.0 1.0 1.4983071088790894 1.498983383178711 2.0 1.0 1.3348398208618164 1.4983071088790894 2.0 1.0 1.1892070770263672 1.4983071088790894 2.0 1.0 1.1892070770263672 1.4983071088790894 1.7817974090576172 1.0 1.1224620342254639 1.1892070770263672 1.7817974090576172 1.0 1.1892070770263672 1.3348398208618164 1.7817974090576172 1.0 1.1224620342254639 1.2599210739135742 1.6817928552627563 1.0 1.1224620342254639 1.2599210739135742 1.8877485990524292 1.0 1.2599210739135742 1.4983071088790894 1.8877485990524292 1.0 1.2599210739135742 1.4983071088790894 2.0]))
(def chip_counts (tensor @shape [11 1] @data [1.0 2.0 3.0 3.0 4.0 4.0 4.0 4.0 4.0 4.0 3.0]))

; Exact stmlib ParameterInterpolator with `called` gating and an initial
; state `init` (see bd-pi in bd.lisp).
(defmacro chip-pi (target bstart called init)
  (make-history h_v)
  (make-history h_inc)
  (make-history h_started)
  (def v0 (gswitch (read-history h_started) (read-history h_v) init))
  (write-history h_started 1)
  (def inc (gswitch bstart (/ (- target v0) 12) (read-history h_inc)))
  (write-history h_inc inc)
  (def v (+ v0 (* called inc)))
  (write-history h_v v)
  v)

; stmlib HysteresisQuantizer2 (non-symmetric), state updated when en = 1.
(defmacro chip-hq (value n hyst en)
  (make-history h_q)
  (def qp (read-history h_q))
  (def v (- (* value n) 0.5))
  (def x (+ v (* (gswitch (gt v qp) -1 1) hyst) 0.5))
  (def q (gswitch en (clip (pl-trunc x) 0 (- n 1)) qp))
  (write-history h_q q)
  q)

; plaits SuperSquareOscillator (hard-synced square); state advances when en.
(defmacro chip-supersquare (frequency shape bstart en)
  (make-history h_mp)
  (make-history h_sp)
  (make-history h_next)
  (make-history h_high)
  (def mf_t (min frequency 0.25))
  (def sf_t (min (* frequency (gswitch (lt shape 0.5) (+ 0.51 (* 0.98 shape))
                                       (+ 1 (* 16 (- shape 0.5) (- shape 0.5)))))
                 0.25))
  (def mf (max (chip-pi mf_t bstart en 0) 0.0000001))
  (def sf (max (chip-pi sf_t bstart en 0.01) 0.0000001))
  (def high0 (read-history h_high))
  (def sp0 (read-history h_sp))
  (def mp1 (+ (read-history h_mp) mf))
  (def reset (gte mp1 1))
  (def mp (- mp1 reset))
  (def rt (/ mp mf))
  (def spr0 (+ sp0 (* (- 1 rt) sf)))
  (def wr (gte spr0 1))
  (def spr (- spr0 wr))
  (def tdr (max wr (* (- 1 high0) (gte spr 0.5))))
  (def rval (* reset (gte spr 0.5)))
  (def sp1 (+ sp0 sf))
  (def enter (max (- 1 reset) tdr))
  (def a_on (* enter (- 1 high0) (gte sp1 0.5)))
  (def ta (/ (- sp1 0.5) sf))
  (def high_a (max high0 a_on))
  (def b_on (* enter high_a (gte sp1 1)))
  (def sp2 (- sp1 b_on))
  (def tb (/ sp2 sf))
  (def high_b (* high_a (- 1 b_on)))
  (def sp (gswitch reset (* rt sf) sp2))
  (def high (* high_b (- 1 reset)))
  (def this_s (+ (read-history h_next)
                 (- (* rval (pl-this-blep rt)))
                 (* a_on (pl-this-blep ta))
                 (- (* b_on (pl-this-blep tb)))))
  (def next_s (+ (- (* rval (pl-next-blep rt)))
                 (* a_on (pl-next-blep ta))
                 (- (* b_on (pl-next-blep tb)))
                 (gte sp 0.5)))
  (write-history h_mp (gswitch en mp (read-history h_mp)))
  (write-history h_sp (gswitch en sp sp0))
  (write-history h_high (gswitch en high high0))
  (write-history h_next (gswitch en next_s (read-history h_next)))
  (- (* 2 this_s) 1))

; plaits NESTriangleOscillator<5> (32 steps).
(defmacro chip-nes-triangle (frequency bstart)
  (make-history h_ph)
  (make-history h_step)
  (make-history h_desc)   ; 1 - ascending_
  (make-history h_next)
  (def f (max (chip-pi (min frequency 0.25) bstart 1 0.001) 0.0000001))
  (def ph1 (+ (read-history h_ph) f))
  (def fade (clip (* (- f (/ 0.5 32)) 64) 0 1))
  (def nes_gain (- 1 fade))
  (def tri_gain (* fade 15))
  (def top (* (- 1 (read-history h_desc)) (gte ph1 0.5)))
  (def d_top (* 4 f tri_gain))
  (def t_top (/ (- ph1 0.5) f))
  (def ns0 (floor (* ph1 32)))
  (def changed (abs (sign (- ns0 (read-history h_step)))))
  (def wrap (* changed (gte ns0 32)))
  (def ph (- ph1 wrap))
  (def ns (- ns0 (* 32 wrap)))
  (def disc (* changed nes_gain (gswitch (lt ns 16) 1 -1)
               (abs (sign ns)) (abs (sign (- ns 16)))))
  (def t_step (/ (- (* ph 32) ns) (* f 32)))
  (def t_bot (/ ph f))
  (def this_s (+ (read-history h_next)
                 (- (* top d_top (pl-this-integrated-blep t_top)))
                 (* disc (pl-this-blep t_step))
                 (* wrap d_top (pl-this-integrated-blep t_bot))))
  (def next_s (+ (- (* top d_top (pl-next-integrated-blep t_top)))
                 (* disc (pl-next-blep t_step))
                 (* wrap d_top (pl-next-integrated-blep t_bot))
                 (* nes_gain (gswitch (lt ns 16) ns (- 31 ns)))
                 (* tri_gain (gswitch (lt ph 0.5) (* 2 ph) (- 2 (* 2 ph))))))
  (write-history h_ph ph)
  (write-history h_step ns)
  (write-history h_desc (gswitch wrap 0 (max (read-history h_desc) top)))
  (write-history h_next next_s)
  (- (* this_s (/ 4 30)) 1))

; One pass of the Arpeggiator::Clock "while (!done)" loop.
(defmacro chip-arp-pass (note oct dir done n range updown)
  (def act (- 1 done))
  (def nout (* act (max (gte note n) (lt note 0))))
  (def oct1 (+ oct (* nout dir)))
  (def note1 (gswitch nout (gswitch (gt dir 0) 0 (- n 1)) note))
  (def oout (* act (max (gte oct1 range) (lt oct1 0))))
  (def oct2 (gswitch oout (gswitch (gt dir 0) 0 (- range 1)) oct1))
  (def flip (* oout updown))
  (def dir2 (gswitch flip (- dir) dir))
  (def note2 (gswitch flip (gswitch (gt dir2 0) 1 (- n 2)) note1))
  (def oct3 (gswitch flip (gswitch (gt dir2 0) 0 (- range 1)) oct2))
  (tuple note2 oct3 dir2 (- 1 (* act flip))))

; plaits ChordBank::ComputeChordInversion contribution of chord note i to
; voice v: (tuple ratio amplitude).
(defmacro chip-inv-term (i v chord integral frac nrot rnote)
  (def base (peek chip_ratios (+ (* chord 4) i) 0))
  (def tr (* 0.25 (pow 2 (floor (/ (- (+ 3 integral) i) 4)))))
  (def val (* base tr))
  (def tgt (% (+ (- i nrot) 5) 5))
  (def prv (% (+ tgt 4) 5))
  (def is_r (eq i rnote))
  (def is_lt (lt i rnote))
  (def is_gt (gt i rnote))
  (def at_t (eq tgt v))
  (def at_p (eq prv v))
  (tuple (+ (* at_t (+ is_r is_gt) val) (* at_p (+ (* is_r 2 val) (* is_lt val))))
         (+ (* at_t (+ (* is_r 0.25 (- 1 frac)) (* is_gt 0.25)))
            (* at_p (+ (* is_r 0.25 frac) (* is_lt 0.25))))))

(defmacro chip-inv-voice (v chord integral frac nrot rnote)
  (def (r0 a0) (chip-inv-term 0 v chord integral frac nrot rnote))
  (def (r1 a1) (chip-inv-term 1 v chord integral frac nrot rnote))
  (def (r2 a2) (chip-inv-term 2 v chord integral frac nrot rnote))
  (def (r3 a3) (chip-inv-term 3 v chord integral frac nrot rnote))
  (tuple (+ r0 r1 r2 r3) (+ a0 a1 a2 a3)))

(defmacro plaits-chip (bstart bphase rise high patched note timbre morph harmonics accent env_shape)
  (def nz (noise))   ; per-sample uniform draw (identical (noise) nodes merge)
  (make-history h_note)
  (make-history h_oct)
  (make-history h_down)     ; direction_ = 1 - 2 * down
  (make-history h_sorted)   ; chord index at the last Sort()
  (make-history h_env)      ; envelope_state_
  (make-history h_auxamt)   ; aux_envelope_amount_
  (def f0 (pl-note-to-freq note))
  (def shape (* morph 0.995))
  (def clocked patched)
  (def clk (* bstart rise clocked))
  ; chord / pattern quantizers
  (def chord (chip-hq (* harmonics 1.02) 11 0.075 (gswitch clocked clk bstart)))
  (def pattern (chip-hq timbre 12 0.075 clk))
  (def mode (floor (/ pattern 3)))
  (def range (pow 2 (- pattern (* 3 mode))))
  (def n (peek chip_counts chord 0))
  (def sorted_chord (gswitch clk chord (read-history h_sorted)))
  (write-history h_sorted sorted_chord)
  ; arpeggiator clock
  (def note_p (read-history h_note))
  (def oct_p (read-history h_oct))
  (def dir_p (- 1 (* 2 (read-history h_down))))
  (def trivial (* (eq n 1) (eq range 1)))
  (def is_random (eq mode 3))
  (def dir_s (gswitch (eq mode 0) 1 (gswitch (eq mode 1) -1 dir_p)))
  (def (na oa da done_a) (chip-arp-pass (+ note_p dir_s) oct_p dir_s 0 n range (eq mode 2)))
  (def (nb ob db done_b) (chip-arp-pass na oa da done_a n range (eq mode 2)))
  ; random: uniform over the other (octave, note) pairs
  (def combos (* range n))
  (def cur (+ (* oct_p n) note_p))
  (def cur_ok (* (lt note_p n) (lt oct_p range)))
  (def u_r (pl-noise-tap nz))
  (def k_ok (floor (* u_r (- combos 1))))
  (def idx (gswitch cur_ok (+ k_ok (gte k_ok cur)) (floor (* u_r combos))))
  (def oct_r (floor (/ idx n)))
  (def note_r (- idx (* oct_r n)))
  (def note_c (gswitch trivial 0 (gswitch is_random note_r nb)))
  (def oct_c (gswitch trivial 0 (gswitch is_random oct_r ob)))
  (def dir_c (gswitch (+ trivial is_random) dir_p db))
  (def arp_note (gswitch clk note_c note_p))
  (def arp_oct (gswitch clk oct_c oct_p))
  (write-history h_note arp_note)
  (write-history h_oct arp_oct)
  (write-history h_down (gswitch clk (lt dir_c 0) (read-history h_down)))
  (def octave (pow 2 arp_oct))
  (def note_f0 (* f0 (peek chip_sorted (+ (* sorted_chord 4) (clip arp_note 0 3)) 0) octave))
  ; chord inversion (unclocked)
  (def inversion (* timbre 20))
  (def integral (floor inversion))
  (def frac (- inversion integral))
  (def nrot (floor (/ integral 4)))
  (def rnote (- integral (* 4 nrot)))
  (def (ir0 ia0) (chip-inv-voice 0 chord integral frac nrot rnote))
  (def (ir1 ia1) (chip-inv-voice 1 chord integral frac nrot rnote))
  (def (ir2 ia2) (chip-inv-voice 2 chord integral frac nrot rnote))
  (def (ir3 ia3) (chip-inv-voice 3 chord integral frac nrot rnote))
  (def (ir4 ia4) (chip-inv-voice 4 chord integral frac nrot rnote))
  (def unclocked (- 1 clocked))
  (def v0 (chip-supersquare (gswitch clocked note_f0 (* f0 ir0)) shape bstart 1))
  (def v1 (chip-supersquare (* f0 ir1) shape bstart unclocked))
  (def v2 (chip-supersquare (* f0 ir2) shape bstart unclocked))
  (def v3 (chip-supersquare (* f0 ir3) shape bstart unclocked))
  (def v4 (chip-supersquare (* f0 ir4) shape bstart unclocked))
  (def chord_out (+ (* v0 ia0) (- (* v1 ia1)) (* v2 ia2) (- (* v3 ia3)) (* v4 ia4)))
  (def out0 (gswitch clocked v0 chord_out))
  (def aux0 (chip-nes-triangle (* f0 0.5 (gswitch clocked octave 1)) bstart))
  ; built-in envelope
  (def has_env (gt (abs (- env_shape 2)) 0.0001))
  (def es (abs env_shape))
  (def decay (- 1 (* (/ 2 48000) (pl-semi-ratio (* 60 es)) es)))
  (def amt_t (clip (* env_shape 20) 0 1))
  (def amt (gswitch has_env (+ (read-history h_auxamt) (* 0.01 (- amt_t (read-history h_auxamt))))
                    (read-history h_auxamt)))
  (write-history h_auxamt amt)
  (def env_p (gswitch clk 1 (read-history h_env)))
  (def env (gswitch has_env (* env_p decay) env_p))
  (write-history h_env env)
  (def out (gswitch has_env (* out0 env) out0))
  (def aux (gswitch has_env (* aux0 (+ 1 (* amt (- env 1)))) aux0))
  (tuple out aux))

; ======================================================================
; Virtual analog engine (plaits/dsp/engine/virtual_analog_engine.cc,
; VA_VARIANT 2 as compiled in Plaits):
;   OUT = variable saw (MORPH) on the detuned oscillator + hard-synced
;         variable square (TIMBRE = pw + sync ratio) on the primary.
;   AUX = "monster sync": two hard-synced variable-shape oscillators
;         (primary and detuned), shape from MORPH, sync ratio from TIMBRE,
;         output (aux - primary) * 0.5.
; ======================================================================

; Value of a history that starts at `init` instead of 0 (exact float, no
; offset arithmetic, so phase accumulation rounds like the C++).
(defmacro va-init (h ready init)
  (gswitch (read-history ready) (read-history h) init))

; VariableShapeOscillator::ComputeNaiveSample.
(defmacro va-naive (phase pw su sd tri sq)
  (def below (lt phase pw))
  (def square (- 1 below))
  (def triangle (gswitch below (* phase su) (- 1 (* (- phase pw) sd))))
  (def s1 (+ phase (* (- square phase) sq)))
  (+ s1 (* (- triangle s1) tri)))

; VariableShapeOscillator::Render<enable_sync=true, output_phase=false>.
; mp_init: initial master phase (auxiliary_ starts at 0.25).
(defmacro va-vshape-sync (mf_t sf_t pw_t ws_t mp_init bstart bphase)
  (def mft (min mf_t 0.25))
  (def sft (min sf_t 0.25))
  (def pwt (gswitch (gte sft 0.25) 0.5 (clip pw_t (* sft 2) (- 1 (* 2 sft)))))
  (def mf (pl-interp mft bstart bphase 0))
  (def sf (pl-interp sft bstart bphase 0.01))
  (def pw (pl-interp pwt bstart bphase 0.5))
  (def ws (pl-interp ws_t bstart bphase 0))
  (make-history h_ready)
  (make-history h_mp)
  (make-history h_sp)
  (make-history h_next)
  (make-history h_ppw)
  (make-history h_high)
  (def mp0 (va-init h_mp h_ready mp_init))
  (def ppw (va-init h_ppw h_ready 0.5))
  (def sp0 (read-history h_sp))
  (def high0 (read-history h_high))
  (def this0 (read-history h_next))
  (def sq (* (max (- ws 0.5) 0) 2))
  (def tri (max (- 1 (* ws 2)) 0))
  (def su (/ 1 pw))
  (def sd (/ 1 (- 1 pw)))
  (def tri_step (* (+ su sd) sf tri))
  ; master (sync) oscillator
  (def mp1 (+ mp0 mf))
  (def reset (gte mp1 1))
  (def mp (gswitch reset (- mp1 1) mp1))
  (def rt (gswitch reset (/ mp (max mf 1e-12)) 0))
  (def spr_raw (+ sp0 (* (- 1 rt) sf)))
  (def spr_wrap (gte spr_raw 1))
  (def spr (gswitch spr_wrap (- spr_raw 1) spr_raw))
  (def tdr (* reset (max spr_wrap (* (- 1 high0) (gte spr pw)))))
  (def value (va-naive spr pw su sd tri sq))
  (def this1 (- this0 (* reset value (pl-this-blep rt))))
  (def next1 (- (* reset value (pl-next-blep rt))))
  ; slave oscillator: the transition loop, unrolled (rise, fall, rise)
  (def sp1 (+ sp0 sf))
  (def run (max (- 1 reset) tdr))
  (def a (* run (- 1 high0) (gte sp1 pw)))
  (def ta (/ (- sp1 pw) (+ (- ppw pw) sf)))
  (def this2 (+ this1 (* a (- (* sq (pl-this-blep ta)) (* tri_step (pl-this-integrated-blep ta))))))
  (def next2 (+ next1 (* a (- (* sq (pl-next-blep ta)) (* tri_step (pl-next-integrated-blep ta))))))
  (def high1 (max high0 a))
  (def b (* run high1 (gte sp1 1)))
  (def sp2 (gswitch b (- sp1 1) sp1))
  (def tb (/ sp2 sf))
  (def this3 (- this2 (* b (- (* (- 1 tri) (pl-this-blep tb)) (* tri_step (pl-this-integrated-blep tb))))))
  (def next3 (- next2 (* b (- (* (- 1 tri) (pl-next-blep tb)) (* tri_step (pl-next-integrated-blep tb))))))
  (def high2 (* high1 (- 1 b)))
  (def c (* b (gte sp2 pw)))
  (def tc (/ (- sp2 pw) (+ (- ppw pw) sf)))
  (def this4 (+ this3 (* c (- (* sq (pl-this-blep tc)) (* tri_step (pl-this-integrated-blep tc))))))
  (def next4 (+ next3 (* c (- (* sq (pl-next-blep tc)) (* tri_step (pl-next-integrated-blep tc))))))
  (def high3 (max high2 c))
  (def sp (gswitch reset (* rt sf) sp2))
  (def high (gswitch reset 0 high3))
  (write-history h_mp mp)
  (write-history h_sp sp)
  (write-history h_high high)
  (write-history h_ppw pw)
  (write-history h_ready 1)
  (write-history h_next (+ next4 (va-naive sp pw su sd tri sq)))
  (- (* 2 this4) 1))

; VariableSawOscillator::Render (kVariableSawNotchDepth = 0.2).
(defmacro va-vsaw (f_t pw_t ws_t bstart bphase)
  (def ft (min f_t 0.25))
  (def pwt (gswitch (gte ft 0.25) 0.5 (clip pw_t (* ft 2) (- 1 (* 2 ft)))))
  (def f (pl-interp ft bstart bphase 0.01))
  (def pw (pl-interp pwt bstart bphase 0.5))
  (def ws (pl-interp ws_t bstart bphase 0))
  (make-history h_ready)
  (make-history h_ph)
  (make-history h_next)
  (make-history h_ppw)
  (make-history h_high)
  (def ppw (va-init h_ppw h_ready 0.5))
  (def high0 (read-history h_high))
  (def this0 (read-history h_next))
  (def notch_amount (- 1 ws))
  (def su (/ 1 pw))
  (def sd (/ 1 (- 1 pw)))
  (def tri_step (* (+ su sd) f ws))
  (def ph1 (+ (read-history h_ph) f))
  (def r (* (- 1 high0) (gte ph1 pw)))
  (def fl (* (- 1 r) (gte ph1 1)))
  (def ph (gswitch fl (- ph1 1) ph1))
  (def tr (/ (- ph1 pw) (+ (- ppw pw) f)))
  (def tf (/ ph f))
  (def notch_r (* (- 1.2 pw) notch_amount))
  (def notch_f (* 1.2 notch_amount))
  (def this_sample (+ this0
                      (* r (- (* notch_r (pl-this-blep tr)) (* tri_step (pl-this-integrated-blep tr))))
                      (* -1 fl (- (* notch_f (pl-this-blep tf)) (* tri_step (pl-this-integrated-blep tf))))))
  (def below (lt ph pw))
  (def notch_saw (gswitch below ph 1.2))
  (def triangle (gswitch below (* ph su) (- 1 (* (- ph pw) sd))))
  (def next (+ (* r (- (* notch_r (pl-next-blep tr)) (* tri_step (pl-next-integrated-blep tr))))
               (* -1 fl (- (* notch_f (pl-next-blep tf)) (* tri_step (pl-next-integrated-blep tf))))
               (* notch_saw notch_amount) (* triangle ws)))
  (write-history h_ph ph)
  (write-history h_high (gswitch r 1 (gswitch fl 0 high0)))
  (write-history h_ppw pw)
  (write-history h_ready 1)
  (write-history h_next next)
  (/ (- (* 2 this_sample) 1) 1.2))

; VirtualAnalogEngine::ComputeDetuning: intervals {0 7.01 12.01 19.01 24.01}.
(defmacro va-squash (x)
  (* x x (- 3 (* 2 x))))
(defmacro va-detuning (h)
  (def d0 (clip (- (* 2.05 h) 1.025) -1 1))
  (def sgn (gswitch (lt d0 0) -1 1))
  (def d (* d0 sgn 3.9999))
  (def di (floor d))
  (def df (- d di))
  (def a (selector (+ di 1) 0 7.01 12.01 19.01 24.01))
  (def b (selector (+ di 2) 0 7.01 12.01 19.01 24.01))
  (* (+ a (* (- b a) (va-squash (va-squash df)))) sgn))

(defmacro plaits-va (bstart bphase rise high patched note timbre morph harmonics accent)
  (def sync_amount (* timbre timbre))
  (def detune (va-detuning harmonics))
  (def primary_f (pl-note-to-freq note))
  (def auxiliary_f (pl-note-to-freq (+ note detune)))
  (def primary_sync_f (pl-note-to-freq (+ note (* sync_amount 48))))
  (def auxiliary_sync_f (pl-note-to-freq (+ note detune (* sync_amount 48))))
  (def shape (clip (* morph 1.5) 0 1))
  (def pw (clip (+ 0.5 (* (- morph 0.66) 1.46)) 0.5 0.995))
  ; monster sync -> AUX
  (def p_sig (va-vshape-sync primary_f primary_sync_f pw shape 0 bstart bphase))
  (def a_sig (va-vshape-sync auxiliary_f auxiliary_sync_f pw shape 0.25 bstart bphase))
  (def aux_out (* (- a_sig p_sig) 0.5))
  ; double varishape -> OUT
  (def square_pw (clip (- (* 1.3 timbre) 0.15) 0.005 0.5))
  (def tm (- timbre 0.5))
  (def square_sync_ratio (gswitch (lt timbre 0.5) 0 (* tm tm 4 48)))
  (def square_gain (min (* timbre 8) 1))
  (def saw_pw (clip (* 1.1 (gswitch (lt morph 0.5) (+ morph 0.5) (- 1 (* (- morph 0.5) 2)))) 0.005 1))
  (def saw_shape (clip (- 10 (* 21 morph)) 0 1))
  (def saw_gain (clip (* 8 (- 1 morph)) 0.02 1))
  (def square_sync_f (pl-note-to-freq (+ note square_sync_ratio)))
  (def sq_sig (va-vshape-sync primary_f square_sync_f square_pw 1 0 bstart bphase))
  (def saw_sig (va-vsaw auxiliary_f saw_pw saw_shape bstart bphase))
  (def norm (/ 1 (max square_gain saw_gain)))
  (def sq_g (pl-interp (* square_gain 0.3 norm) bstart bphase 0))
  (def saw_g (pl-interp (* saw_gain 0.5 norm) bstart bphase 0))
  (tuple (+ (* saw_sig saw_g) (* sq_g sq_sig)) aux_out))

; ======================================================================
; Waveshaping engine (plaits/dsp/engine/waveshaping_engine.cc): bandlimited
; slope (pw from MORPH) -> int16 waveshaper bank (HARMONICS) -> wavefolders
; lut_fold (OUT) / lut_fold_2 (AUX, crossfaded from a sine of the triangle).
; ======================================================================
(def ws_lut_fold (tensor @shape [516 1] @file "data/lut_fold.json"))
(def ws_lut_fold_2 (tensor @shape [516 1] @file "data/lut_fold_2.json"))
; lut_ws_inverse_tan, _inverse_sin, _linear, _bump, _double_bump (/ 32768)
(def ws_lut_ws (tensor @shape [257 5] @file "data/lut_ws.json"))

; plaits Oscillator::Render<OSCILLATOR_SHAPE_SLOPE> (no external FM).
; State: phase 0.5, high true, frequency_ 0.001, pw_ 0.5 at Init.
(defmacro ws-slope-osc (freq_t pw_t bstart bphase)
  (def ft (clip freq_t 0.000001 0.25))
  (def pwt (clip pw_t (* ft 2) (- 1 (* 2 ft))))
  (def f (pl-interp ft bstart bphase 0.001))
  (def pw (pl-interp pwt bstart bphase 0.5))
  (make-history h_ph)
  (make-history h_ready)  ; 0 on the first sample: phase starts at 0.5
  (make-history h_low)    ; 1 - high_
  (make-history h_next)
  (def this0 (read-history h_next))
  (def high0 (- 1 (read-history h_low)))
  (def su (/ 1 pw))
  (def sd (/ 1 (- 1 pw)))
  (def d (* (+ su sd) f))
  (def ph1 (+ (gswitch (read-history h_ready) (read-history h_ph) 0.5) f))
  (def below (lt ph1 pw))
  (def edge (abs (- high0 below)))
  (def ta (/ (- ph1 pw) f))
  (def high1 (gswitch edge below high0))
  (def wrap (gte ph1 1))
  (def ph (- ph1 wrap))
  (def tb (/ ph f))
  (def high (gswitch wrap 1 high1))
  (def this_sample (+ this0
                      (* -1 edge d (pl-this-integrated-blep ta))
                      (* wrap d (pl-this-integrated-blep tb))))
  (def next (+ (* -1 edge d (pl-next-integrated-blep ta))
               (* wrap d (pl-next-integrated-blep tb))
               (gswitch high (* ph su) (- 1 (* (- ph pw) sd)))))
  (write-history h_ph ph)
  (write-history h_ready 1)
  (write-history h_low (- 1 high))
  (write-history h_next next)
  (- (* 2 this_sample) 1))

; stmlib InterpolateHermite(table + 1, index, 512).
(defmacro ws-hermite (table index)
  (def x (* index 512))
  (def i (floor x))
  (def fr (- x i))
  (def xm1 (peek table i 0))
  (def x0 (peek table (+ i 1) 0))
  (def x1 (peek table (+ i 2) 0))
  (def x2 (peek table (+ i 3) 0))
  (def c (* (- x1 xm1) 0.5))
  (def v (- x0 x1))
  (def w (+ c v))
  (def a (+ w v (* (- x2 x0) 0.5)))
  (def b_neg (+ w a))
  (+ (* (+ (* (- (* a fr) b_neg) fr) c) fr) x0))

(defmacro ws-tame (f0 harmonics order)
  (def f (* f0 harmonics))
  (def max_f (/ 0.5 order))
  (def m (clip (- 1 (/ (- f max_f) (- 0.5 max_f))) 0 1))
  (* m m m))

(defmacro plaits-ws (bstart bphase rise high patched note timbre morph harmonics accent)
  (def f0 (pl-note-to-freq note))
  (def pw (+ (* morph 0.45) 0.5))
  (def slope_sig (ws-slope-osc f0 pw bstart bphase))
  (def tri_sig (ws-slope-osc f0 0.5 bstart bphase))
  (def slope (+ 3 (* (abs (- morph 0.5)) 5)))
  (def shape_amount (* (abs (- harmonics 0.5)) 2))
  (def shape_att (ws-tame f0 slope 16))
  (def wf_att (ws-tame f0 (* slope (+ 3 (* shape_amount shape_att 5))) 12))
  (def shape_m (pl-interp (+ 0.5 (* (- harmonics 0.5) shape_att)) bstart bphase 0))
  (def wf_gain (pl-interp (+ 0.03 (* 0.46 timbre wf_att)) bstart bphase 0))
  (def og (* timbre (- 2 timbre)))
  (def overtone (pl-interp (* og (- 2 og)) bstart bphase 0))
  (def shape (* shape_m 3.9999))
  (def s_i (pl-trunc shape))
  (def s_f (- shape s_i))
  (def wsx (+ (* 127 slope_sig) 128))
  (def wi_raw (pl-trunc wsx))
  (def w_f (- wsx wi_raw))
  (def wi (- wi_raw (* 256 (floor (/ wi_raw 256)))))
  (def x0 (peek ws_lut_ws wi s_i))
  (def x1 (peek ws_lut_ws (+ wi 1) s_i))
  (def y0 (peek ws_lut_ws wi (+ s_i 1)))
  (def y1 (peek ws_lut_ws (+ wi 1) (+ s_i 1)))
  (def x (+ x0 (* (- x1 x0) w_f)))
  (def y (+ y0 (* (- y1 y0) w_f)))
  (def mix (+ x (* (- y x) s_f)))
  (def index (+ (* mix wf_gain) 0.5))
  (def fold (ws-hermite ws_lut_fold index))
  (def fold_2 (- (ws-hermite ws_lut_fold_2 index)))
  (def sine (sin (* twopi (+ (* tri_sig 0.25) 0.5))))
  (tuple fold (+ sine (* (- fold_2 sine) overtone))))

; ======================================================================
; FM engine (plaits/dsp/engine/fm_engine.cc): 2-op FM with feedback and a
; sub-octave phase-modulated sine on AUX, 4x oversampled.
; ======================================================================
(def lut_fm_quantizer pd_lut_fm_quantizer)

(defmacro fm-sub (mod_f cf amount fb pfb)
  (make-history h_mp)
  (make-history h_cp)
  (make-history h_sp)
  (make-history h_prev)
  (def mfb (gswitch (gt fb 0) (* 0.25 fb fb) 0))
  (def mp0 (read-history h_mp))
  (def cp0 (read-history h_cp))
  (def sp0 (read-history h_sp))
  (def pv0 (read-history h_prev))
  ; oversampled step 1..4
  (def mp1 (pl-wrap (+ mp0 (* mod_f (+ 1 (* pv0 pfb))))))
  (def cp1 (pl-wrap (+ cp0 cf)))
  (def sp1 (pl-wrap (+ sp0 (* cf 0.5))))
  (def m1 (sin (* twopi (+ mp1 (* mfb pv0)))))
  (def c1 (sin (* twopi (+ cp1 (* amount m1)))))
  (def s1 (sin (* twopi (+ sp1 (* amount c1 0.25)))))
  (def pv1 (+ pv0 (* 0.05 (- c1 pv0))))
  (def mp2 (pl-wrap (+ mp1 (* mod_f (+ 1 (* pv1 pfb))))))
  (def cp2 (pl-wrap (+ cp1 cf)))
  (def sp2 (pl-wrap (+ sp1 (* cf 0.5))))
  (def m2 (sin (* twopi (+ mp2 (* mfb pv1)))))
  (def c2 (sin (* twopi (+ cp2 (* amount m2)))))
  (def s2 (sin (* twopi (+ sp2 (* amount c2 0.25)))))
  (def pv2 (+ pv1 (* 0.05 (- c2 pv1))))
  (def mp3 (pl-wrap (+ mp2 (* mod_f (+ 1 (* pv2 pfb))))))
  (def cp3 (pl-wrap (+ cp2 cf)))
  (def sp3 (pl-wrap (+ sp2 (* cf 0.5))))
  (def m3 (sin (* twopi (+ mp3 (* mfb pv2)))))
  (def c3 (sin (* twopi (+ cp3 (* amount m3)))))
  (def s3 (sin (* twopi (+ sp3 (* amount c3 0.25)))))
  (def pv3 (+ pv2 (* 0.05 (- c3 pv2))))
  (def mp4 (pl-wrap (+ mp3 (* mod_f (+ 1 (* pv3 pfb))))))
  (def cp4 (pl-wrap (+ cp3 cf)))
  (def sp4 (pl-wrap (+ sp3 (* cf 0.5))))
  (def m4 (sin (* twopi (+ mp4 (* mfb pv3)))))
  (def c4 (sin (* twopi (+ cp4 (* amount m4)))))
  (def s4 (sin (* twopi (+ sp4 (* amount c4 0.25)))))
  (def pv4 (+ pv3 (* 0.05 (- c4 pv3))))
  (write-history h_mp mp4)
  (write-history h_cp cp4)
  (write-history h_sp sp4)
  (write-history h_prev pv4)
  (tuple (pl-downsample4 c1 c2 c3 c4) (pl-downsample4 s1 s2 s3 s4)))

(defmacro plaits-fm (bstart bphase rise high patched note timbre morph harmonics accent)
  (def n (- note 24))
  (def ratio (pl-lut lut_fm_quantizer harmonics 128))
  (def mod_note (+ n ratio))
  (def target_mf (clip (pl-note-to-freq mod_note) 0 0.5))
  (def taming (clip (- 1 (* (- mod_note 72) 0.025)) 0 1))
  (def a0 (/ 55 samplerate))
  (def cf (pl-interp (pl-note-to-freq n) bstart bphase a0))
  (def mf (pl-interp target_mf bstart bphase a0))
  (def amount (pl-interp (* 2 timbre timbre taming taming) bstart bphase 0))
  (def fb (pl-interp (- (* 2 morph) 1) bstart bphase 0))
  (def pfb (gswitch (lt fb 0) (* 0.5 fb fb) 0))
  (fm-sub mf cf amount fb pfb))

; ======================================================================
; Grain engine (plaits/dsp/engine/grain_engine.cc): two GrainletOscillators
; (formant ratio set by HARMONICS) summed and DC-blocked on OUT, a
; ZOscillator DC-blocked on AUX. (The VOSIM oscillator is commented out in
; the C++ engine and is not used.)
; ======================================================================

; ParameterInterpolator with subsample(): returns (value-after-Next, increment)
; so value_ before Next() = v - inc and subsample(t) = v - inc + inc * t.
(defmacro grain-interp (target bstart bphase)
  (make-history h_prev)
  (make-history h_cur)
  (def prev (gswitch bstart (read-history h_cur) (read-history h_prev)))
  (def cur (gswitch bstart target (read-history h_cur)))
  (write-history h_prev prev)
  (write-history h_cur cur)
  (def inc (/ (- cur prev) 12))
  (tuple (+ prev (* inc (+ bphase 1))) inc))

(defmacro grain-sine (x)
  (sin (* twopi x)))

; GrainletOscillator::Carrier.
(defmacro grain-carrier (phase shape)
  (def s3 (* shape 3))
  (def si (floor s3))
  (def sf (- s3 si))
  (def t (- 1 sf))
  (def t3 (* t t t))
  (def p0 (+ (min (* phase (+ 1 (* t3 15))) 1) 0.75))
  (def bp (+ 0.001 (* 0.499 t3)))
  (def p1 (+ 0.75 (gswitch (lt phase bp)
                           (* phase (/ 0.5 bp))
                           (+ 0.5 (/ (* (- phase bp) 0.5) (- 1 bp))))))
  (def p2 (min (+ 0.25 (* phase (+ 0.5 (* sf sf sf 14.5)))) 0.75))
  (def p (gswitch (lt si 0.5) p0 (gswitch (lt si 1.5) p1 p2)))
  (* (+ (grain-sine p) 1) 0.25))

(defmacro grain-grainlet (cp fp shape bleed)
  (/ (* (grain-carrier cp shape) (+ (grain-sine fp) bleed)) (+ 1 bleed)))

(defmacro grain-grainlet-osc (cf_t ff_t shape_t bleed_t bstart bphase)
  (def (f0 f0_inc) (grain-interp (min cf_t 0.125) bstart bphase))
  (def (f1 f1_inc) (grain-interp (min ff_t 0.25) bstart bphase))
  (def (sh sh_inc) (grain-interp shape_t bstart bphase))
  (def (bl bl_inc) (grain-interp bleed_t bstart bphase))
  (make-history h_cp)
  (make-history h_fp)
  (make-history h_next)
  (def this_sample (read-history h_next))
  (def fp0 (read-history h_fp))
  (def cp1 (+ (read-history h_cp) f0))
  (def reset (gte cp1 1))
  (def cp (- cp1 reset))
  (def rt (gswitch reset (/ cp (max f0 1e-12)) 0))
  (def sh_before (+ (- sh sh_inc) (* sh_inc (- 1 rt))))
  (def bl_before (+ (- bl bl_inc) (* bl_inc (- 1 rt))))
  (def before (grain-grainlet 1 (+ fp0 (* (- 1 rt) f1)) sh_before bl_before))
  (def after (grain-grainlet 0 0 sh bl))
  (def disc (* reset (- after before)))
  (def fp_free (+ fp0 f1))
  (def fp (gswitch reset (* rt f1) (gswitch (gte fp_free 1) (- fp_free 1) fp_free)))
  (write-history h_cp cp)
  (write-history h_fp fp)
  (write-history h_next (+ (* disc (pl-next-blep rt)) (grain-grainlet cp fp sh bl)))
  (+ this_sample (* disc (pl-this-blep rt))))

; ZOscillator::Z.
(defmacro grain-z (c d f shape mode)
  (def ramp0 (* 0.5 (+ 1 (grain-sine (+ (* 0.5 d) 0.25)))))
  (def ps_lo (+ 0.25 (* mode 1.5)))
  (def ps_hi (- 0.7495 (* (- mode 0.33) 0.75)))
  (def lo (lt mode 0.333))
  (def mid (lt mode 0.666))
  (def phase_shift (gswitch lo ps_lo ps_hi))
  (def offset (gswitch lo 1 (gswitch mid (- (grain-sine ps_hi)) 0.001)))
  (def disc (grain-sine (+ f phase_shift)))
  (def low_shape (lt shape 0.5))
  (def s2 (* shape 2))
  (def ramp (gswitch (* low_shape (gte c 0.5)) (* ramp0 s2) ramp0))
  (def contour (gswitch low_shape
                        (+ 1 (* (- (grain-sine (+ c 0.25)) 1) s2))
                        (grain-sine (+ c (* shape 0.5)))))
  (* (- (* ramp (+ offset disc)) offset) contour))

(defmacro grain-z-osc (cf_t ff_t shape_t mode_t bstart bphase)
  (def (f0 f0_inc) (grain-interp (min cf_t 0.125) bstart bphase))
  (def (f1 f1_inc) (grain-interp (min ff_t 0.25) bstart bphase))
  (def (sh sh_inc) (grain-interp shape_t bstart bphase))
  (def (md md_inc) (grain-interp mode_t bstart bphase))
  (make-history h_cp)
  (make-history h_dp)
  (make-history h_fp)
  (make-history h_next)
  (def this_sample (read-history h_next))
  (def fp0 (read-history h_fp))
  (def dp1 (+ (read-history h_dp) (* 2 f0)))
  (def cp1 (+ (read-history h_cp) f0))
  (def reset (gte dp1 1))
  (def dp (- dp1 reset))
  (def rt (gswitch reset (/ dp (max (* 2 f0) 1e-12)) 0))
  (def cp_wrapped (gte cp1 1))
  (def sh_before (+ (- sh sh_inc) (* sh_inc (- 1 rt))))
  (def md_before (+ (- md md_inc) (* md_inc (- 1 rt))))
  (def before (grain-z (gswitch cp_wrapped 1 0.5) 1 (+ fp0 (* (- 1 rt) f1)) sh_before md_before))
  (def after (grain-z (gswitch cp_wrapped 0 0.5) 0 0 sh md))
  (def disc (* reset (- after before)))
  (def fp_free (+ fp0 f1))
  (def fp (gswitch reset (* rt f1) (gswitch (gte fp_free 1) (- fp_free 1) fp_free)))
  (def cp2 (gswitch (* reset (gt cp1 1)) (* dp 0.5) cp1))
  (def cp (gswitch (gte cp2 1) (- cp2 1) cp2))
  (write-history h_cp cp)
  (write-history h_dp dp)
  (write-history h_fp fp)
  (write-history h_next (+ (* disc (pl-next-blep rt)) (grain-z cp dp fp sh md)))
  (+ this_sample (* disc (pl-this-blep rt))))

; OnePole high-pass with a precomputed g (FREQUENCY_DIRTY).
(defmacro grain-hp (in g)
  (make-history h)
  (def lp (/ (+ (* g in) (read-history h)) (+ 1 g)))
  (write-history h (+ (* g (- in lp)) lp))
  (- in lp))

(defmacro plaits-grain (bstart bphase rise high patched note timbre morph harmonics accent)
  (def f0 (pl-note-to-freq note))
  (def f1 (pl-note-to-freq (+ 24 (* 84 timbre))))
  (def ratio (pl-semi-ratio (+ -24 (* 48 harmonics))))
  (def carrier_bleed (gswitch (lt harmonics 0.5) (- 1 (* 2 harmonics)) 0))
  (def bleed (* carrier_bleed (- 2 carrier_bleed)))
  (def carrier_shape (+ 0.33 (* (- morph 0.33) (max (- 1 (* f0 24)) 0))))
  (def g1 (grain-grainlet-osc f0 f1 carrier_shape bleed bstart bphase))
  (def g2 (grain-grainlet-osc f0 (* f1 ratio) carrier_shape bleed bstart bphase))
  (def g (pl-tan-dirty (* 0.3 f0)))
  (def cutoff (pl-note-to-freq (+ note (* 96 timbre))))
  (def z (grain-z-osc f0 cutoff morph harmonics bstart bphase))
  (tuple (grain-hp (+ g1 g2) g) (grain-hp z g)))

; ======================================================================
; Additive engine (plaits/dsp/engine/additive_engine.cc), generated by
; tools/gen_additive.py. OUT = 24 integer harmonics (two 12-partial
; HarmonicOscillator banks), AUX = 8 "organ" harmonics (1 2 3 4 6 8 10 12).
; Per-block UpdateAmplitudes (one-pole 0.001 + in-place normalisation) runs on
; bstart; partial amplitudes are interpolated per sample like
; HarmonicOscillator's ParameterInterpolators. Partials use the same
; Chebyshev recursion as the C++ (driven by 2*sin(phase)).
; ======================================================================

; Raw (un-smoothed) gain of partial i for one UpdateAmplitudes call.
(defmacro additive-gain (i center slope bumps)
  (def order (* (abs (- i center)) slope))
  (def g0 (- 1 order))
  (def g1 (+ g0 (abs g0)))
  (def g2 (* g1 g1 (+ 1 (sin (* twopi (+ 0.25 (* order bumps)))))))
  (def g3 (* g2 g2))
  (* g3 g3))

; One amplitude slot: ONE_POLE(a, gain, 0.001) on bstart, before normalisation.
(defmacro additive-pre (h gain bstart)
  (+ (read-history h) (* 0.001 (- gain (read-history h)))))


(defmacro plaits-additive (bstart bphase rise high patched note timbre morph harmonics accent)
  (def f0 (pl-note-to-freq note))
  (def centroid timbre)
  (def raw_bumps harmonics)
  (def raw_slope (* (- 1 (* 0.6 raw_bumps)) morph))
  (def slope (+ 0.01 (* 1.99 raw_slope raw_slope raw_slope)))
  (def bumps (* 16 raw_bumps raw_bumps))
  (def margin (/ (- (/ 1 slope) 1) (+ 1 bumps)))
  (def center_i (- (* centroid (+ 23 margin)) (* 0.5 margin)))
  (def center_o (- (* centroid (+ 7 margin)) (* 0.5 margin)))
  (make-history am_i0)
  (make-history am_i1)
  (make-history am_i2)
  (make-history am_i3)
  (make-history am_i4)

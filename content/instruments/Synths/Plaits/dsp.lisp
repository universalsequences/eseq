  (def g8 (cb-ginterp g8t bstart bphase 0 live))
  (def g4 (cb-ginterp g4t bstart bphase 0 live))
  (def g2 (cb-ginterp g2t bstart bphase 0 live))
  (def g1 (cb-ginterp g1t bstart bphase 0 live))

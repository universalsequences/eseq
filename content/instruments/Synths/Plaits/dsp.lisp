  (def mf_2 (min (* hm_2 sf_2) 0.499))
  (def m_2 (modal-mode elp mf_2 (+ 1 (* mf_2 q_2)) (* 0.248203203 (- 1 (* mf_2 2)))))
  (def sf_3 (+ sf_2 stiff2))
  (def stiff3 (* stiff2 sk))
  (def hm_3 (+ hm_2 fc))

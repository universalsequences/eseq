  (def a_42 (- (* c_main a_41) a_40))
  (def x_42 (- (* c_aux x_41) x_40))
  (def s_42 (res-mode x g_42 rg_42 h_42 (lt 42 num_modes)))
  (def sc_42 (+ sc_41 (* s_42 (+ a_42 0.5))))

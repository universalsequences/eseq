  (def (rd_3 bo_3) (res-bowed bin (read-history hbper_3) g_3 br_3 bh_3 (lt 3 nwg)))
  (def (rd_4 bo_4) (res-bowed bin (read-history hbper_4) g_4 br_4 bh_4 (lt 4 nwg)))
  (def (rd_5 bo_5) (res-bowed bin (read-history hbper_5) g_5 br_5 bh_5 (lt 5 nwg)))
  (def (rd_6 bo_6) (res-bowed bin (read-history hbper_6) g_6 br_6 bh_6 (lt 6 nwg)))
  (def (rd_7 bo_7) (res-bowed bin (read-history hbper_7) g_7 br_7 bh_7 (lt 7 nwg)))
  (def bow_sum (+ rd_0 rd_1 rd_2 rd_3 rd_4 rd_5 rd_6 rd_7))
  (write-history h_bow (res-bow-table bow_sum bow_strength))
  (def bowed (* 8 (+ (* bo_0 (+ a_0 0.5)) (* bo_1 (+ a_1 0.5)) (* bo_2 (+ a_2 0.5)) (* bo_3 (+ a_3 0.5)) (* bo_4 (+ a_4 0.5)) (* bo_5 (+ a_5 0.5)) (* bo_6 (+ a_6 0.5)) (* bo_7 (+ a_7 0.5)))))

; ======================================================================
; String resonator (elements/dsp/string.cc): an extended Karplus-Strong
; loop with Hermite-interpolated reads, a dispersion all-pass or a curved
; bridge, an FIR + SVF damping filter and a pickup comb read. Voice uses one
; string (STRING model, geometry sets the dispersion) or five tuned to a
; chord (STRINGS model).
; The delay memory is a tensor per string (`line` 8192, `ap` 4096) used as a
; circular buffer of the module's length in host samples (2048 and 1024 at
; 32 kHz), so even its out-of-range reads behave as on the module.
; Inputs: f32 (cycles per 32 kHz sample), dispersion (after set_dispersion),
; brightness, damping, position (block values), in (excitation), u (uniform
; noise). Returns (tuple out aux).
; Host-rate rules: the loop runs at the host rate with the delay in host
; samples, so pitch and decay times hold; the 3-tap FIR in the loop is
; per-sample and gets slightly brighter above 32 kHz.
; ======================================================================
(def str_lut_svf_shift (tensor @shape [257 1] @file "data/lut_svf_shift.json"))

; String::set_dispersion's mapping.
(defmacro str-dispersion (d)
  (gswitch (lt d 0.24) (* (- d 0.24) 4.166)
    (gswitch (gt d 0.26) (* (- d 0.26) 1.35135) 0)))

; Slot of the sample written `k` ticks before the one at slot `c` (mod n).
(defmacro str-slot (c k n)
  (el-imod (- c k) n))

(defmacro el-string (line ap f32 dispersion brightness damping position in u)
  ; The string's block clock: the voice's, plus the first sample the string
  ; ever runs. The voice gates the strings by model, and a gate can open
  ; mid-block; block values read before they are set (zeros) would poison
  ; the loop. (A string that resumes keeps its last values until the next
  ; block, as on the module.)
  (make-history ready)
  (def sbstart (max bstart (- 1 (read-history ready))))
  (def len_s (floor (+ (/ 2048 kr) 0.5)))
  (def len_a (floor (+ (/ 1024 kr) 0.5)))
  (def fh (* f32 kr))
  ; ---- per-block settings
  (def delay_t (el-hold-on (clip (/ 1 fh) 4 (- len_s 4)) sbstart))
  (def src_raw (* delay_t fh))
  (def src_full (el-hold-on (gte src_raw 0.9999) sbstart))
  (def src_ratio (el-hold-on (gswitch src_full 1 src_raw) sbstart))
  (def cpos_t (el-hold-on (- 0.5 (* 0.98 (abs (- position 0.5)))) sbstart))
  (def lf_damping (* damping (- 2 damping)))
  (def rt60 (* 0.07 (el-semi-ratio (* lf_damping 96)) samplerate))
  (def rt_b (max (/ (* -120 delay_t) src_ratio rt60) -127))
  (def dcoef0 (el-semi-ratio rt_b))
  (def bright0 (* brightness brightness))
  (def nf (el-hold-on (el-coef (min (el-semi-ratio (* (- brightness 1) 48)) 0.999999)) sbstart))
  (def dcut0 (min (+ 24 (* damping damping 48) (* brightness brightness 24)) 84))
  (def df0 (min (* fh (el-semi-ratio dcut0)) 0.499))
  (def to_inf (gswitch (gte damping 0.95) (* 20 (- damping 0.95)) 0))
  (def dcoef (el-hold-on (+ dcoef0 (* to_inf (- 1 dcoef0))) sbstart))
  (def fbright (el-hold-on (+ bright0 (* to_inf (- 1 bright0))) sbstart))
  (def df (+ df0 (* to_inf (- 0.4999 df0))))
  (def dcut (+ dcut0 (* to_inf (- 128 dcut0))))
  (def ig (el-hold-on (el-tan-accurate df) sbstart))
  (def ih (el-hold-on (el-svf-h ig 2) sbstart))
  (def dcomp_t (el-hold-on (- 1 (el-lut str_lut_svf_shift dcut 1)) sbstart))
  (make-history h_ph)
  (make-history h_dl)
  (make-history h_dli)
  (make-history h_cp)
  (make-history h_cpi)
  (make-history h_dp)
  (make-history h_dpi)
  (make-history h_dc)
  (make-history h_dci)
  (make-history h_fd)
  (make-history h_fdi)
  (make-history h_fb)
  (make-history h_fbi)
  (make-history h_x1)
  (make-history h_x2)
  (make-history h_dn)
  (make-history h_cb)
  (make-history h_c)
  (make-history h_ca)
  (make-history h_dcx)
  (make-history h_dcy)
  (make-history h_s1)
  (make-history h_s2)
  (make-history h_o0)
  (make-history h_o1)
  (make-history h_a0)
  (make-history h_a1)
  ; ParameterInterpolators: states advance once per tick; increments are
  ; set at the block start from the state reached so far.
  ; (String::Init states, or with `warm_start` the first block's targets)
  (def dl0 (el-rd h_dl ready (gswitch warm_start delay_t (/ 145.454545 kr))))
  (def cp0 (el-rd h_cp ready (* warm_start cpos_t)))
  (def dp0 (el-rd h_dp ready (* warm_start dispersion)))
  (def dc0 (el-rd h_dc ready (* warm_start dcomp_t)))
  (def fd0 (el-rd h_fd ready (* warm_start dcoef)))
  (def fb0 (el-rd h_fb ready (* warm_start fbright)))
  (def dli (gswitch sbstart (/ (- delay_t dl0) blk) (read-history h_dli)))
  (def cpi (gswitch sbstart (/ (- cpos_t cp0) blk) (read-history h_cpi)))
  (def dpi (gswitch sbstart (/ (- dispersion dp0) blk) (read-history h_dpi)))
  (def dci (gswitch sbstart (/ (- dcomp_t dc0) blk) (read-history h_dci)))
  (def fdi (gswitch sbstart (/ (- dcoef fd0) blk) (read-history h_fdi)))
  (def fbi (gswitch sbstart (/ (- fbright fb0) blk) (read-history h_fbi)))
  ; linear-interpolation SRC below the lowest note the line holds
  (def ph0 (gswitch (* sbstart src_full) 1 (read-history h_ph)))
  (def ph1 (+ ph0 src_ratio))
  (def tick (gt ph1 1))
  (def ph (- ph1 tick))
  (def dl (+ dl0 dli))
  (def cp (+ cp0 cpi))
  (def dp (+ dp0 dpi))
  (def dc (+ dc0 dci))
  (def comb_delay (* dl cp))
  (def delay0 (- (* dl dc) 1))
  ; dispersion noise / curved bridge / stretch all-pass
  (def noise (/ (- (* 2 u) 1) (+ 0.2 nf)))
  (def dn (+ (read-history h_dn) (* nf (- noise (read-history h_dn)))))
  (def stretch_point (gswitch (lte dp 0) 0 (* dp (- 2 dp) 0.475)))
  (def na0 (gswitch (gt dp 0.75) (* 4 (- dp 0.75)) 0))
  (def namt (* na0 na0 0.025))
  (def bcurv0 (gswitch (lt dp 0) (- dp) 0))
  (def bcurv (* bcurv0 bcurv0 0.01))
  (def apg (/ (* -0.618 dp) (+ 0.15 (abs dp))))
  (def cb_prev (read-history h_cb))
  (def dly (* delay0 (- (+ 1 (* dn namt)) (* cb_prev bcurv))))
  (def apd (* dly stretch_point))
  (def maind (- dly apd))
  (def use_ap (* (gte apd 4) (gte maind 4)))
  (def rdly (gswitch use_ap maind dly))
  (def c (read-history h_c))
  (def ca (read-history h_ca))
  ; Hermite read, `rdly` ticks back from the slot about to be written
  (def hi (floor rdly))
  (def hf (- rdly hi))
  (def xm1 (peek line (str-slot c (- hi 1) len_s)))
  (def x0 (peek line (str-slot c hi len_s)))
  (def xp1 (peek line (str-slot c (+ hi 1) len_s)))
  (def xp2 (peek line (str-slot c (+ hi 2) len_s)))
  (def hc (* (- xp1 xm1) 0.5))
  (def hv (- x0 xp1))
  (def hw (+ hc hv))
  (def ha (+ hw hv (* (- xp2 x0) 0.5)))
  (def hb (+ hw ha))
  (def herm (+ (* (+ (* (- (* ha hf) hb) hf) hc) hf) x0))
  ; stretch all-pass (integer delay)
  (def ap_read (peek ap (str-slot ca (floor apd) len_a)))
  (def ap_write (+ herm (* apg ap_read)))
  (def s0 (gswitch use_ap (+ (* (- ap_write) apg) ap_read) herm))
  ; DC-blocked copy for the curved bridge's AC blocking
  (def dcy (+ (* (read-history h_dcy) (- 1 (/ 20 samplerate))) s0 (- (read-history h_dcx))))
  (def s1 (+ s0 (* bcurv0 (- dcy s0))))
  (def bv (- (abs s1) 0.025))
  (def cb_new (* (+ (abs bv) bv) (gswitch (gt s1 0) 1 -1.5)))
  ; loop filters: FIR damping, then SVF low-pass (r = 2)
  (def s2 (+ s1 in))
  (def fx1 (read-history h_x1))
  (def fx2 (read-history h_x2))
  (def fir (* fd0 (+ (* (/ (+ 1 fb0) 2) fx1) (* (/ (- 1 fb0) 4) (+ s2 fx2)))))
  (def st1 (read-history h_s1))
  (def st2 (read-history h_s2))
  (def ihp (* (- fir (* 2 st1) (* ig st1) st2) ih))
  (def ibp (+ (* ig ihp) st1))
  (def ilp (+ (* ig ibp) st2))
  ; pickup comb read, after this tick's write
  (def ci (floor comb_delay))
  (def cf (- comb_delay ci))
  ; (DelayLine::Read after Write: integral 0 reads the oldest slot and the
  ; new sample, integral 1 the new sample and the one before.)
  (def ca_s (gswitch (eq ci 0) (peek line (str-slot c -1 len_s))
              (gswitch (eq ci 1) ilp (peek line (str-slot c (- ci 1) len_s)))))
  (def cb_s (gswitch (eq ci 0) ilp (peek line (str-slot c ci len_s))))
  (def aux_new (+ ca_s (* (- cb_s ca_s) cf)))
  (def o0p (read-history h_o0))
  (def o1p (read-history h_o1))
  (def a0p (read-history h_a0))
  (def a1p (read-history h_a1))
  (def o0 (gswitch tick ilp o0p))
  (def o1 (gswitch tick o0p o1p))
  (def a0 (gswitch tick aux_new a0p))
  (def a1 (gswitch tick a0p a1p))
  (def wr (seq (poke line (gswitch tick c (str-slot c -1 len_s)) (gswitch tick ilp (peek line (str-slot c -1 len_s))))
               (poke ap (gswitch (* tick use_ap) ca (str-slot ca -1 len_a)) (gswitch (* tick use_ap) ap_write (peek ap (str-slot ca -1 len_a))))
               0))
  (write-history ready 1)
  (write-history h_ph ph)
  (write-history h_dl (gswitch tick dl dl0))
  (write-history h_cp (gswitch tick cp cp0))
  (write-history h_dp (gswitch tick dp dp0))
  (write-history h_dc (gswitch tick dc dc0))
  (write-history h_fd (gswitch tick (+ fd0 fdi) fd0))
  (write-history h_fb (gswitch tick (+ fb0 fbi) fb0))
  (write-history h_dli dli)
  (write-history h_cpi cpi)
  (write-history h_dpi dpi)
  (write-history h_dci dci)
  (write-history h_fdi fdi)
  (write-history h_fbi fbi)
  (write-history h_x1 (gswitch tick s2 fx1))
  (write-history h_x2 (gswitch tick fx1 fx2))
  (write-history h_dn (gswitch tick dn (read-history h_dn)))
  (write-history h_cb (gswitch tick cb_new cb_prev))
  (write-history h_dcx (gswitch tick s0 (read-history h_dcx)))
  (write-history h_dcy (gswitch tick dcy (read-history h_dcy)))
  (write-history h_s1 (gswitch tick (+ (* ig ihp) ibp) st1))
  (write-history h_s2 (gswitch tick (+ (* ig ibp) ilp) st2))
  (write-history h_o0 o0)
  (write-history h_o1 o1)
  (write-history h_a0 a0)
  (write-history h_a1 a1)
  (write-history h_c (gswitch tick (el-imod (+ c 1) len_s) c))
  (write-history h_ca (gswitch (* tick use_ap) (el-imod (+ ca 1) len_a) ca))
  (tuple (+ wr o1 (* (- o0 o1) ph)) (+ a1 (* (- a0 a1) ph))))

; ======================================================================
; Reverb (elements/dsp/fx/reverb.h): Griesinger/Dattorro topology on the
; module's FxEngine with 16-bit delay memory. Four input all-passes (the
; first smeared by LFO 1), then two loop halves of lowpass + two all-passes
; + a long delay, the second read modulated by LFO 2.
; Inputs: left right (in place in the C++), amount, input_gain, time,
; diffusion, lp (block values). Returns (tuple left right).
; Host-rate rules: line lengths and LFO rates are kept in time; the loop
; low-pass keeps its 32 kHz time constant.
; ======================================================================

; FxEngine LFO: stmlib's approximate cosine recurrence at `hz`, stepped on
; every 32nd sample (when the engine's write pointer is a multiple of 32:
; samples 31, 63, ...). Returns 0..1, starting at its peak.
(defmacro rev-lfo (hz)
  (make-history h_y0)
  (make-history h_y1)
  (make-history h_count)
  (make-history ready)
  (def coef (res-cos-coef (/ (* hz 32) samplerate)))
  (def started (read-history ready))
  (def y0 (gswitch started (read-history h_y0) 0.5))
  (def y1 (gswitch started (read-history h_y1) (* coef 0.25)))
  (def count (+ (read-history h_count) 1))
  (def step (eq (el-imod count 32) 0))
  (def y0n (gswitch step (- (* coef y0) y1) y0))
  (def y1n (gswitch step y0 y1))
  (write-history ready 1)
  (write-history h_count (el-imod count 32))
  (write-history h_y0 y0n)
  (write-history h_y1 y1n)
  (+ y1n 0.5))

; The FxEngine memory: every line in one ring, at the module's bases (each
; line starts one slot past the previous line's end), one write pointer that
; steps back a slot per sample. Line lengths and offsets are kept in time
; (rounded to whole host samples); the ring holds them up to 6x 32 kHz.
; (The same ring as content/effects/Beads/dsp.lisp's FxEngine reverb.)
(def rv_size 131072)
; rv_size slots
(def rv_mem (tensor @shape [131072 1]))
(def rv_k (/ 1 kr))
(defmacro rv-len (n)
  (floor (+ (* n rv_k) 0.5)))
(def rvl_ap1 (rv-len 150))
(def rvl_ap2 (rv-len 214))
(def rvl_ap3 (rv-len 319))
(def rvl_ap4 (rv-len 527))
(def rvl_dap1a (rv-len 2182))
(def rvl_dap1b (rv-len 2690))
(def rvl_del1 (rv-len 4501))
(def rvl_dap2a (rv-len 2525))
(def rvl_dap2b (rv-len 2197))
(def rvb_ap2 (+ rvl_ap1 1))
(def rvb_ap3 (+ rvb_ap2 rvl_ap2 1))
(def rvb_ap4 (+ rvb_ap3 rvl_ap3 1))
(def rvb_dap1a (+ rvb_ap4 rvl_ap4 1))
(def rvb_dap1b (+ rvb_dap1a rvl_dap1a 1))
(def rvb_del1 (+ rvb_dap1b rvl_dap1b 1))
(def rvb_dap2a (+ rvb_del1 rvl_del1 1))
(def rvb_dap2b (+ rvb_dap2a rvl_dap2a 1))
(def rvb_del2 (+ rvb_dap2b rvl_dap2b 1))

; Ring slot `offset` slots past the write pointer (0 <= offset < rv_size).
(defmacro rv-at (wp offset)
  (def j (+ wp offset))
  (gswitch (gte j rv_size) (- j rv_size) j))

; Read: the whole slot `offset` into a line.
(defmacro rv-read (wp base offset)
  (peek rv_mem (rv-at wp (+ base offset)) 0))

; Interpolate: a fractional `offset`, between two wrapped slots.
(defmacro rv-interp (wp base offset)
  (def i (floor offset))
  (def a (rv-read wp base i))
  (+ a (* (- (rv-read wp base (+ i 1)) a) (- offset i))))

; Write (int16 storage).
(defmacro rv-write (wp base offset x)
  (poke rv_mem (rv-at wp (+ base offset)) 0 (el-store16 x)))

; Read(line TAIL, g) then WriteAllPass(line, -g) on accumulator `acc`.
(defmacro rv-allpass (wp acc base len g)
  (def tail (rv-read wp base (- len 1)))
  (def a1 (+ acc (* tail g)))
  (seq (rv-write wp base 0 a1) (+ (* a1 (- g)) tail)))

(defmacro el-reverb (left right amount input_gain time diffusion lp)
  (make-history h_wp)
  (make-history h_lp1)
  (make-history h_lp2)
  (def wp0 (- (read-history h_wp) 1))
  (def wp (gswitch (lt wp0 0) (+ wp0 rv_size) wp0))
  (write-history h_wp wp)
  (def klp (el-hold (el-coef lp)))
  (def kap diffusion)
  (def lfo1 (rev-lfo 0.5))
  (def lfo2 (rev-lfo 0.3))
  ; Smear AP1 inside the loop: read at 10 + 80 lfo1, rewrite at 100.
  (def smear (rv-interp wp 0 (* (+ 10 (* 80 lfo1)) rv_k)))
  ; (seq ... 0) adds nothing; it keeps the write in the graph
  (def smeared (seq (rv-write wp 0 (rv-len 100) smear) 0))
  ; Diffuse through 4 all-passes.
  (def ap_a (rv-allpass wp (+ smeared (* (+ left right) input_gain)) 0 rvl_ap1 kap))
  (def ap_b (rv-allpass wp ap_a rvb_ap2 rvl_ap2 kap))
  (def ap_c (rv-allpass wp ap_b rvb_ap3 rvl_ap3 kap))
  (def apout (rv-allpass wp ap_c rvb_ap4 rvl_ap4 kap))
  ; half 1: apout + del2 (6211 + 100 lfo2 in) -> lp -> 2 all-passes -> del1
  (def d2 (rv-interp wp rvb_del2 (* (+ 6211 (* 100 lfo2)) rv_k)))
  (def lp1 (+ (read-history h_lp1) (* klp (- (+ apout (* d2 time)) (read-history h_lp1)))))
  (write-history h_lp1 lp1)
  (def wet_l (rv-allpass wp (rv-allpass wp lp1 rvb_dap1a rvl_dap1a (- kap)) rvb_dap1b rvl_dap1b kap))
  (def wet_l_w (seq (rv-write wp rvb_del1 0 wet_l) wet_l))
  ; half 2: apout + del1 tail -> lp -> 2 all-passes -> del2
  (def d1 (rv-read wp rvb_del1 (- rvl_del1 1)))
  (def lp2 (+ (read-history h_lp2) (* klp (- (+ apout (* d1 time)) (read-history h_lp2)))))
  (write-history h_lp2 lp2)
  (def wet_r (rv-allpass wp (rv-allpass wp lp2 rvb_dap2a rvl_dap2a kap) rvb_dap2b rvl_dap2b (- kap)))
  (def wet_r_w (seq (rv-write wp rvb_del2 0 wet_r) wet_r))
  (tuple (+ left (* (- (* 2 wet_l_w) left) amount))
         (+ right (* (- (* 2 wet_r_w) right) amount))))

; ======================================================================
; Ominous voice (elements/dsp/ominous_voice.cc), the module's easter egg:
; two FM oscillator pairs (carrier + feedback modulator) rendered 8x
; oversampled and decimated by a 101-tap FIR, each through a multimode SVF,
; a shared envelope VCA and a rotating "spatializer" panner.
; Knob roles: BLOW level / meta / timbre = osc 1 level / ratio / FM amount,
; STRIKE level / meta / timbre = osc 2 level / ratio / FM amount, BOW level
; = osc 2 detune, BOW timbre = feedback, contour = envelope, geometry =
; filter mode + Q, brightness = cut-off, damping = envelope -> filter amount,
; position = rotation speed and distance.
; Pure scalar DSP: the voice runs inside a block-gate, only when selected.
; Inputs: patch values (block), midi (note + modulation), strength, flags.
; Returns (tuple raw center sides).
; Host-rate rules: the oscillators run 8x the host rate with their pitch
; kept; the decimation filters are relative to the oversampled rate; the
; envelope, smoothers, the spatializer's rotation and its "behind" low-pass
; keep their times / cut-off.
; Generated by tools/gen_ominous.py -- edit that, not this file.
; ======================================================================
(def om_lut_sine (tensor @shape [4097 1] @file "data/lut_sine.json"))
(def om_lut_f_high (tensor @shape [256 1] @file "data/lut_midi_to_f_high.json"))
(def om_lut_f_low (tensor @shape [256 1] @file "data/lut_midi_to_f_low.json"))
(def om_lut_fm_quantizer (tensor @shape [129 1] @file "data/lut_fm_frequency_quantizer.json"))
(def om_lut_detune_quantizer (tensor @shape [65 1] @file "data/lut_detune_quantizer.json"))

; lut_midi_to_f_high[] * lut_midi_to_f_low[] after the module's
; 32768 + Clip16(int(midi * 256) - 20480) index (cycles per 32 kHz sample).
(defmacro om-midi-to-f (midi)
  (def p (+ 32768 (clip (- (el-trunc (* midi 256)) 20480) -32768 32767)))
  (def hi (floor (/ p 256)))
  (* (peek om_lut_f_high hi 0) (peek om_lut_f_low (- p (* hi 256)) 0)))

; lut_sine at a phase in cycles (wrapped), linear interpolation (4096).
(defmacro om-sine (phase)
  (def x (* (el-wrap phase) 4096))
  (def i (floor x))
  (def a (peek om_lut_sine i 0))
  (def b (peek om_lut_sine (+ i 1) 0))
  (+ a (* (- b a) (- x i))))

; FmOscillator::SineFm. The phase offset is uint32(fm * 2^31); the float to
; unsigned conversion saturates on the module's ARM core (negative -> 0).
(defmacro om-sine-fm (phase fm)
  (om-sine (+ phase (* 0.5 (clip fm 0 1.9999999)))))

; Block-clocked helpers on this voice's own clock (bstart_o).
(defmacro om-hold (x)
  (el-hold-on x bstart_o))

(defmacro om-interp (target init)
  (make-history h_state)
  (make-history h_inc)
  (make-history h_ready)
  (def st0 (gswitch (* warm_start (- 1 (read-history h_ready))) (- target init) (read-history h_state)))
  (write-history h_ready 1)
  (def inc (gswitch bstart_o (/ (- target init st0) blk) (read-history h_inc)))
  (def st (+ st0 inc))
  (write-history h_inc inc)
  (write-history h_state st)
  (+ init st))

(defmacro om-envelope (rising falling gate_f a dr sustain)
  (make-history ready)
  (make-history h_seg)
  (make-history h_start)
  (make-history h_val)
  (make-history h_ph)
  ; Init: segment_ = num_segments_ (done), everything else 0.
  (def seg0 (el-rd h_seg ready 3))
  (def val0 (read-history h_val))
  (def start0 (read-history h_start))
  (def ph0 (read-history h_ph))
  (def c_r rising)
  (def c_f (* (- 1 rising) falling))
  (def c_p (* (- 1 rising) (- 1 falling) (gte ph0 1)))
  (def seg_next (min (+ seg0 1) 3))
  (def lev_next0 (selector (+ seg_next 1) 0 1 sustain 0))
  (def seg1 (gswitch c_r 0 (gswitch c_f 2 (gswitch c_p seg_next seg0))))
  (def start1 (gswitch c_r (gswitch (eq seg0 3) 0 val0)
                (gswitch c_f val0 (gswitch c_p lev_next0 start0))))
  (def ph1 (gswitch (max c_r (max c_f c_p)) 0 ph0))
  (def done (eq seg1 3))
  (def sustained (* (eq seg1 2) gate_f))
  (def time (selector (+ seg1 1) a dr dr 0))
  (def inc (* (- 1 sustained) (- 1 done) tb (env-lut8 env_lut_increments time)))
  (def t (selector (+ seg1 1) (env-lut8 env_lut_quartic ph1) (env-lut8 env_lut_expo ph1)
                   (env-lut8 env_lut_expo ph1) ph1))
  (def target (selector (+ seg1 2) 0 1 sustain 0 0))
  (def val1 (+ start1 (* (- target start1) t)))
  (def ph2 (+ ph1 inc))
  (write-history ready 1)
  (write-history h_seg (gswitch bstart_o seg1 seg0))
  (write-history h_start (gswitch bstart_o start1 start0))
  (write-history h_val (gswitch bstart_o val1 val0))
  (write-history h_ph (gswitch bstart_o ph2 ph0))
  (gswitch bstart_o val1 val0))

; One FM oscillator (FmOscillator::Process) at 8x, IIR + FIR decimated.
; midi = carrier note (already -36: the 8x rate), ratio / feedback / amount as
; passed by OminousVoice. Returns one host-rate sample.
(defmacro om-osc (midi ratio feedback amount)
  (make-history h_pc)
  (make-history h_pm)
  (make-history h_prev)
  (make-history h_fma)
  (make-history h_fmi)
  (def rq (om-hold (el-lut om_lut_fm_quantizer ratio 128)))
  (def inc_c (om-hold (* kr (om-midi-to-f midi))))
  (def inc_m (om-hold (* kr (om-midi-to-f (+ midi rq)))))
  (def bright (+ midi (* rq 0.75) -60 (* feedback 24)))
  (def att (om-hold (gswitch (lte bright 0) 1 (max (- 1 (* bright bright 0.0015)) 0))))
  ; fm_amount ramps to `amount` over the block's 8 x blk oversampled steps
  (def fm0 (read-history h_fma))
  (def fmi (gswitch bstart_o (/ (- amount fm0) (* 8 blk)) (read-history h_fmi)))
  (write-history h_fmi fmi)
  (def pc0 (read-history h_pc))
  (def pm0 (read-history h_pm))
  (def prev0 (read-history h_prev))
  ; NaiveSvf low-pass (f = 2 sin(pi 0.1), damp 2), chained across the 8 steps
  (make-history h_ilp)
  (make-history h_ibp)
  (def ilp_s (read-history h_ilp))
  (def ibp_s (read-history h_ibp))
  (def fa0 (+ fm0 (* fmi 1)))
  (def fmod0 (om-sine-fm (+ pm0 (* inc_m 1)) (* feedback prev0)))
  (def o0 (om-sine-fm (+ pc0 (* inc_c 1)) (* att fmod0 fa0)))
  (def lp0 (+ ilp_s (* 0.618034 ibp_s)))
  (def bp0 (+ ibp_s (* 0.618034 (- o0 (* ibp_s 2) lp0))))
  (def l0 lp0)
  (def fa1 (+ fm0 (* fmi 2)))
  (def fmod1 (om-sine-fm (+ pm0 (* inc_m 2)) (* feedback o0)))
  (def o1 (om-sine-fm (+ pc0 (* inc_c 2)) (* att fmod1 fa1)))
  (def lp1 (+ lp0 (* 0.618034 bp0)))
  (def bp1 (+ bp0 (* 0.618034 (- o1 (* bp0 2) lp1))))
  (def l1 lp1)
  (def fa2 (+ fm0 (* fmi 3)))
  (def fmod2 (om-sine-fm (+ pm0 (* inc_m 3)) (* feedback o1)))
  (def o2 (om-sine-fm (+ pc0 (* inc_c 3)) (* att fmod2 fa2)))
  (def lp2 (+ lp1 (* 0.618034 bp1)))
  (def bp2 (+ bp1 (* 0.618034 (- o2 (* bp1 2) lp2))))
  (def l2 lp2)
  (def fa3 (+ fm0 (* fmi 4)))
  (def fmod3 (om-sine-fm (+ pm0 (* inc_m 4)) (* feedback o2)))
  (def o3 (om-sine-fm (+ pc0 (* inc_c 4)) (* att fmod3 fa3)))
  (def lp3 (+ lp2 (* 0.618034 bp2)))
  (def bp3 (+ bp2 (* 0.618034 (- o3 (* bp2 2) lp3))))
  (def l3 lp3)
  (def fa4 (+ fm0 (* fmi 5)))
  (def fmod4 (om-sine-fm (+ pm0 (* inc_m 5)) (* feedback o3)))
  (def o4 (om-sine-fm (+ pc0 (* inc_c 5)) (* att fmod4 fa4)))
  (def lp4 (+ lp3 (* 0.618034 bp3)))
  (def bp4 (+ bp3 (* 0.618034 (- o4 (* bp3 2) lp4))))
  (def l4 lp4)
  (def fa5 (+ fm0 (* fmi 6)))
  (def fmod5 (om-sine-fm (+ pm0 (* inc_m 6)) (* feedback o4)))
  (def o5 (om-sine-fm (+ pc0 (* inc_c 6)) (* att fmod5 fa5)))
  (def lp5 (+ lp4 (* 0.618034 bp4)))
  (def bp5 (+ bp4 (* 0.618034 (- o5 (* bp4 2) lp5))))
  (def l5 lp5)
  (def fa6 (+ fm0 (* fmi 7)))
  (def fmod6 (om-sine-fm (+ pm0 (* inc_m 7)) (* feedback o5)))
  (def o6 (om-sine-fm (+ pc0 (* inc_c 7)) (* att fmod6 fa6)))
  (def lp6 (+ lp5 (* 0.618034 bp5)))
  (def bp6 (+ bp5 (* 0.618034 (- o6 (* bp5 2) lp6))))
  (def l6 lp6)
  (def fa7 (+ fm0 (* fmi 8)))
  (def fmod7 (om-sine-fm (+ pm0 (* inc_m 8)) (* feedback o6)))
  (def o7 (om-sine-fm (+ pc0 (* inc_c 8)) (* att fmod7 fa7)))
  (def lp7 (+ lp6 (* 0.618034 bp6)))
  (def bp7 (+ bp6 (* 0.618034 (- o7 (* bp6 2) lp7))))
  (def l7 lp7)
  (write-history h_pc (el-wrap (+ pc0 (* inc_c 8))))
  (write-history h_pm (el-wrap (+ pm0 (* inc_m 8))))
  (write-history h_prev o7)
  (write-history h_ilp lp7)
  (write-history h_ibp bp7)
  (write-history h_fma (+ fm0 (* fmi 8)))
  (def p0 (+ (* 0.001526182555 l0) (* 0.001692922383 l1) (* 0.001685761819 l2) (* 0.001555406705 l3) (* 0.001369688661 l4) (* 0.001212413444 l5) (* 0.001184937535 l6) (* -0.001859272945 l7)))
  (def p1 (+ (* -0.003977161477 l0) (* -0.003555372122 l1) (* -0.002852566234 l2) (* -0.001981709311 l3) (* -0.001054896973 l4) (* -0.000172916131 l5) (* 0.000582212588 l6) (* 0.001157229282 l7)))
  (def p2 (+ (* 0.006166173855 l0) (* 0.004295073578 l1) (* 0.002272758644 l2) (* 0.00031431705 l3) (* -0.001399720214 l4) (* -0.002735861951 l5) (* -0.003616652394 l6) (* -0.004020648315 l7)))
  (def p3 (+ (* -0.00456329049 l0) (* -0.00044593481 l1) (* 0.003133736224 l2) (* 0.005919024408 l3) (* 0.007761247708 l4) (* 0.008614353501 l5) (* 0.008534833653 l6) (* 0.007654982354 l7)))
  (def p4 (+ (* -0.007789574712 l0) (* -0.013838153737 l1) (* -0.017542469537 l2) (* -0.018994127671 l3) (* -0.018456326393 l4) (* -0.016287075604 l5) (* -0.012932060625 l6) (* -0.008867277113 l7)))
  (def p5 (+ (* 0.085030908865 l0) (* 0.074769247024 l1) (* 0.062696232995 l2) (* 0.049530599001 l3) (* 0.036030557729 l4) (* 0.02293616726 l5) (* 0.010920252821 l6) (* 0.00054152364 l7)))
  (def p6 (+ (* 0.062696232995 l0) (* 0.074769247024 l1) (* 0.085030908865 l2) (* 0.092854033134 l3) (* 0.097753623479 l4) (* 0.099422113893 l5) (* 0.097753623479 l6) (* 0.092854033134 l7)))
  (def p7 (+ (* -0.017542469537 l0) (* -0.013838153737 l1) (* -0.007789574712 l2) (* 0.00054152364 l3) (* 0.010920252821 l4) (* 0.02293616726 l5) (* 0.036030557729 l6) (* 0.049530599001 l7)))

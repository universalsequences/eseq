(def op6_ratio_oct (+ (/ (log (max op6_fc 0.5)) ln2) (/ (log (+ 1 (/ (round op6_fine) 100))) ln2)
  (* detune_step (- (round op6_detune) 7))))
(def op6_spread (* car6 (selector (+ ncar6 1) 0 1 -1 2 -2 3) (/ dtun_cents 1200)))
(def op6_fixed_hz (* (pow 10 (+ (% (round op6_coarse) 4) (/ (round op6_fine) 100)))
  (pow 2 (* (max 0 (- (round op6_detune) 7)) 0.000802))))
(def op6_hz (gswitch (round op6_fixed) op6_fixed_hz
  (* pitch_t (pow 2 (+ op6_ratio_oct pitch_mod op6_spread)))))
(def op6_in_bus (peek FZ_OP6_IN alg))
(def op6_out_bus (peek FZ_OP6_OUT alg))
(def op6_add (peek FZ_OP6_ADD alg))

; ---- the algorithm: operators in msfa's order (OP6 first) over two buses and the output
(def bus1_0 0)
(def bus2_0 0)
(def out_0 0)
(def op6_y (fz-op op6_hz fresh op6_gain
  (+ (* (eq op6_in_bus 1) bus1_0) (* (eq op6_in_bus 2) bus2_0)) (* (peek FZ_OP6_FB alg) fb_amt)))
(def bus1_1 (gswitch (eq op6_out_bus 1) (+ (* op6_add bus1_0) op6_y) bus1_0))
(def bus2_1 (gswitch (eq op6_out_bus 2) (+ (* op6_add bus2_0) op6_y) bus2_0))
(def out_1 (gswitch (eq op6_out_bus 0) (+ (* op6_add out_0) op6_y) out_0))
(def op5_y (fz-op op5_hz fresh op5_gain
  (+ (* (eq op5_in_bus 1) bus1_1) (* (eq op5_in_bus 2) bus2_1)) (* (peek FZ_OP5_FB alg) fb_amt)))
(def bus1_2 (gswitch (eq op5_out_bus 1) (+ (* op5_add bus1_1) op5_y) bus1_1))
(def bus2_2 (gswitch (eq op5_out_bus 2) (+ (* op5_add bus2_1) op5_y) bus2_1))
(def out_2 (gswitch (eq op5_out_bus 0) (+ (* op5_add out_1) op5_y) out_1))
(def op4_y (fz-op op4_hz fresh op4_gain
  (+ (* (eq op4_in_bus 1) bus1_2) (* (eq op4_in_bus 2) bus2_2)) (* (peek FZ_OP4_FB alg) fb_amt)))
(def bus1_3 (gswitch (eq op4_out_bus 1) (+ (* op4_add bus1_2) op4_y) bus1_2))
(def bus2_3 (gswitch (eq op4_out_bus 2) (+ (* op4_add bus2_2) op4_y) bus2_2))
(def out_3 (gswitch (eq op4_out_bus 0) (+ (* op4_add out_2) op4_y) out_2))
(def op3_y (fz-op op3_hz fresh op3_gain
  (+ (* (eq op3_in_bus 1) bus1_3) (* (eq op3_in_bus 2) bus2_3)) (* (peek FZ_OP3_FB alg) fb_amt)))
(def bus1_4 (gswitch (eq op3_out_bus 1) (+ (* op3_add bus1_3) op3_y) bus1_3))
(def bus2_4 (gswitch (eq op3_out_bus 2) (+ (* op3_add bus2_3) op3_y) bus2_3))
(def out_4 (gswitch (eq op3_out_bus 0) (+ (* op3_add out_3) op3_y) out_3))
(def op2_y (fz-op op2_hz fresh op2_gain
  (+ (* (eq op2_in_bus 1) bus1_4) (* (eq op2_in_bus 2) bus2_4)) (* (peek FZ_OP2_FB alg) fb_amt)))
(def bus1_5 (gswitch (eq op2_out_bus 1) (+ (* op2_add bus1_4) op2_y) bus1_4))
(def bus2_5 (gswitch (eq op2_out_bus 2) (+ (* op2_add bus2_4) op2_y) bus2_4))
(def out_5 (gswitch (eq op2_out_bus 0) (+ (* op2_add out_4) op2_y) out_4))
(def op1_y (fz-op op1_hz fresh op1_gain
  (+ (* (eq op1_in_bus 1) bus1_5) (* (eq op1_in_bus 2) bus2_5)) (* (peek FZ_OP1_FB alg) fb_amt)))
(def bus1_6 (gswitch (eq op1_out_bus 1) (+ (* op1_add bus1_5) op1_y) bus1_5))
(def bus2_6 (gswitch (eq op1_out_bus 2) (+ (* op1_add bus2_5) op1_y) bus2_5))
(def out_6 (gswitch (eq op1_out_bus 0) (+ (* op1_add out_5) op1_y) out_5))
(write-history fz_alive_h (+ (* car1 op1_gain) (* car2 op2_gain) (* car3 op3_gain) (* car4 op4_gain) (* car5 op5_gain) (* car6 op6_gain)))

; ---- out: msfa's output with Felucca's ~7 Hz DC blocker (FM puts sidebands at 0 Hz)
(make-history fz_dc_h)
(def dc_prev (gswitch fresh 0 (read-history fz_dc_h)))
(def dc_in (- out_6 dc_prev))
(write-history fz_dc_h (+ dc_prev (* dc_in (/ sr_scale 1024))))
; 0.1 sits one full carrier with the other factory synths.
(def voice_out (* dc_in (clip (mod gain) 0 1) 0.1))
(out voice_out 1 @name left)
(out voice_out 2 @name right)
(use-defmacro release-window)
(use-defmacro voice-amp)
(out (voice-amp (release-window gate 50) voice_out voice_out) 3 @name amp @amp true)

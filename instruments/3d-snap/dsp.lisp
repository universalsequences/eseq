(def gate (in 1 @name gate))
(def pitch (in 2 @name pitch))
(def velocity (in 3 @name velocity))
(def trigger (in 4 @name trigger))

(param amp_attack @default 1 @min 1 @max 200 @unit ms)
(param amp_decay @default 1350 @min 20 @max 4000 @unit ms)
(param amp_sustain @default 0 @min 0 @max 1)
(param amp_release @default 180 @min 1 @max 2000 @unit ms)

(param gain @default 0.82 @min 0 @max 2)
(param drive @default 1.65 @min 0.2 @max 8)
(param tuning @default -5 @min -36 @max 36)
(param chaos @default 0.46 @min 0 @max 1)

(param stick_level @default 0.88 @min 0 @max 1.8)
(param rim_level @default 0.52 @min 0 @max 1.8)
(param snap_level @default 0.58 @min 0 @max 1.8)
(param skin_level @default 0.88 @min 0 @max 1.8)
(param brightness @default 0.72 @min 0 @max 1)

(param membrane_level @default 0.90 @min 0 @max 1.8)
(param membrane_tension @default 0.48 @min 0 @max 1)
(param membrane_damping @default 0.34 @min 0 @max 1)
(param shell_level @default 0.54 @min 0 @max 1.8)

(param flam_amount @default 0.72 @min 0 @max 1.8)
(param flam_rate @default 42 @min 8 @max 130 @unit Hz)
(param flam_density @default 0.56 @min 0 @max 1)
(param flam_decay @default 180 @min 20 @max 900 @unit ms)

(param wire_level @default 0.98 @min 0 @max 2)
(param wire_tension @default 0.58 @min 0 @max 1)
(param wire_decay @default 560 @min 40 @max 2400 @unit ms)
(param wire_rattle @default 0.72 @min 0 @max 1)

(param boom_level @default 0.44 @min 0 @max 1.8)
(param air_level @default 0.62 @min 0 @max 1.8)
(param room_level @default 0.58 @min 0 @max 1.8)
(param room_size @default 0.76 @min 0 @max 1)
(param room_tone @default 0.58 @min 0 @max 1)

(param snap_decay @default 28 @min 2 @max 220 @unit ms)
(param body_decay @default 360 @min 20 @max 1800 @unit ms)
(param tail_decay @default 980 @min 80 @max 3600 @unit ms)

(def vel (clip velocity 0 1))
(def tune_mul (pow 2 (/ tuning 12)))
(def tens (clip membrane_tension 0 1))
(def damp (clip membrane_damping 0 1))
(def bright (clip brightness 0 1))
(def chaos_amt (clip chaos 0 1))
(def room_sz (clip room_size 0 1))
(def room_bright (clip room_tone 0 1))

(def base_freq (clip (* pitch tune_mul (+ 0.62 (* tens 0.92))) 55 850))
(def decay_scale (+ 0.25 (* (- 1 damp) 1.85)))

(def amp_env (adsr gate trigger amp_attack amp_decay amp_sustain amp_release))
(def stick_env (adsr gate trigger 1 (max 3 (* snap_decay 0.38)) 0 8))
(def crack_env (adsr gate trigger 1 snap_decay 0 16))
(def skin_env (adsr gate trigger 1 (* body_decay decay_scale 0.38) 0 50))
(def flam_env (adsr gate trigger 1 (* flam_decay decay_scale) 0 80))
(def wire_env (adsr gate trigger 1 (* wire_decay (+ 0.45 (* wire_rattle 1.25))) 0 180))
(def boom_env (adsr gate trigger 2 (* body_decay decay_scale 1.35) 0 140))
(def shell_env (adsr gate trigger 2 (* tail_decay decay_scale 0.62) 0 220))
(def room_env (adsr gate trigger 5 (* tail_decay (+ 0.70 (* room_sz 2.35))) 0 420))

(def m1_freq (clip (* base_freq (+ 1.00 (* chaos_amt -0.035))) 45 9000))
(def m2_freq (clip (* base_freq (+ 1.59 (* chaos_amt 0.23))) 70 11000))
(def m3_freq (clip (* base_freq (+ 2.14 (* chaos_amt -0.18) (* tens 0.14))) 90 12500))
(def m4_freq (clip (* base_freq (+ 2.30 (* chaos_amt 0.37))) 100 13500))
(def m5_freq (clip (* base_freq (+ 2.65 (* chaos_amt -0.28) (* tens 0.24))) 120 14500))
(def m6_freq (clip (* base_freq (+ 3.16 (* chaos_amt 0.51))) 160 15000))
(def m7_freq (clip (* base_freq (+ 4.08 (* chaos_amt 0.76))) 220 15500))

(def p1 (phasor m1_freq))
(def p2 (phasor m2_freq))
(def p3 (phasor m3_freq))
(def p4 (phasor m4_freq))
(def p5 (phasor m5_freq))
(def p6 (phasor m6_freq))
(def p7 (phasor m7_freq))

(def env_m1 (adsr gate trigger 1 (* body_decay decay_scale 1.20) 0 120))
(def env_m2 (adsr gate trigger 1 (* body_decay decay_scale 0.88) 0 95))
(def env_m3 (adsr gate trigger 1 (* body_decay decay_scale 0.72) 0 80))
(def env_m4 (adsr gate trigger 1 (* body_decay decay_scale 0.54) 0 70))
(def env_m5 (adsr gate trigger 1 (* body_decay decay_scale 0.42) 0 62))
(def env_m6 (adsr gate trigger 1 (* body_decay decay_scale 0.30) 0 50))
(def env_m7 (adsr gate trigger 1 (* body_decay decay_scale 0.22) 0 42))

(def membrane_modes
  (+ (* (sin (* p1 twopi)) env_m1 0.72)
     (* (sin (+ (* p2 twopi) 0.61)) env_m2 (+ 0.34 (* chaos_amt 0.10)))
     (* (sin (+ (* p3 twopi) 1.48)) env_m3 (+ 0.24 (* bright 0.14)))
     (* (sin (+ (* p4 twopi) 2.02)) env_m4 (+ 0.18 (* chaos_amt 0.18)))
     (* (sin (+ (* p5 twopi) 2.91)) env_m5 (+ 0.13 (* bright 0.17)))
     (* (sin (+ (* p6 twopi) 3.77)) env_m6 (+ 0.09 (* chaos_amt 0.16)))
     (* (sin (+ (* p7 twopi) 5.12)) env_m7 (+ 0.06 (* bright 0.13)))))

(def raw_noise (noise))

(def stick_tone_freq (clip (+ 2200 (* bright 9000) (* chaos_amt 2100)) 1200 14500))
(def stick_click (svf raw_noise stick_tone_freq 0.85 2))
(def rim_phase (phasor (clip (* base_freq (+ 12 (* bright 18))) 1500 15000)))
(def rim_click (* (sin (* rim_phase twopi)) stick_env rim_level (+ 0.5 (* bright 0.8))))
(def stick (* stick_click stick_env stick_level))

(def snap_noise (svf raw_noise (clip (+ 1600 (* bright 9600)) 800 12000) 2.2 1))
(def snap (* snap_noise crack_env snap_level skin_level))

(def skin_noise (svf raw_noise (clip (* base_freq (+ 3.2 (* tens 5.2) (* bright 4.0))) 320 7600) 1.3 1))
(def skin (* skin_noise skin_env skin_level (+ 0.34 (* bright 0.56))))

(def flam_rate_a (clip flam_rate 8 130))
(def flam_rate_b (clip (* flam_rate (+ 1.41 (* chaos_amt 0.38))) 10 190))
(def flam_rate_c (clip (* flam_rate (+ 2.08 (* tens 0.44) (* chaos_amt 0.28))) 14 240))
(def flam_pa (phasor flam_rate_a))
(def flam_pb (phasor flam_rate_b))
(def flam_pc (phasor flam_rate_c))
(def flam_sharp (+ 7 (* flam_density 62)))
(def flam_pulse_a (pow (max 0 (sin (* flam_pa twopi))) flam_sharp))
(def flam_pulse_b (pow (max 0 (sin (+ (* flam_pb twopi) 1.86))) (+ 6 (* flam_density 48))))
(def flam_pulse_c (pow (max 0 (sin (+ (* flam_pc twopi) 3.24))) (+ 5 (* flam_density 36))))
(def flam_train (* flam_env (+ flam_pulse_a (* flam_pulse_b 0.74) (* flam_pulse_c 0.48))))
(def flam_body (* membrane_modes flam_train (+ 0.42 (* chaos_amt 0.75))))
(def flam_air (* (svf raw_noise (clip (+ 1100 (* bright 9200)) 700 12500) 1.7 1) flam_train))
(def flam (* (+ flam_air flam_body) flam_amount))

(def wire_rate (clip (+ 35 (* wire_tension 140)) 35 175))
(def wire_p1 (phasor wire_rate))
(def wire_p2 (phasor (* wire_rate (+ 1.73 (* chaos_amt 0.27)))))
(def wire_p3 (phasor (* wire_rate (+ 2.61 (* wire_rattle 0.49)))))
(def wire_sharp (+ 4 (* wire_rattle 64)))
(def wire_tick_a (pow (max 0 (sin (* wire_p1 twopi))) wire_sharp))
(def wire_tick_b (pow (max 0 (sin (+ (* wire_p2 twopi) 2.41))) (+ 5 (* wire_rattle 48))))
(def wire_tick_c (pow (max 0 (sin (+ (* wire_p3 twopi) 4.78))) (+ 6 (* wire_rattle 32))))
(def wire_gate (* wire_env (+ 0.24 wire_tick_a (* wire_tick_b 0.55) (* wire_tick_c 0.36))))
(def wire_cut (clip (+ 1900 (* wire_tension 4800) (* bright 3600)) 1200 11500))
(def wire_noise_a (svf raw_noise wire_cut 0.7 2))
(def wire_noise_b (svf raw_noise (clip (+ 3200 (* bright 7600)) 2000 13000) 2.4 1))
(def wire_signal (* (+ (* wire_noise_a 0.72) (* wire_noise_b 0.58) (* membrane_modes 0.18)) wire_gate wire_level))

(def boom_noise (svf raw_noise (clip (+ 90 (* base_freq 0.55)) 55 420) 0.9 0))
(def boom_sine (sin (* (phasor (clip (* base_freq 0.52) 40 360)) twopi)))
(def boom (* (+ (* boom_sine 0.78) (* boom_noise 0.36)) boom_env boom_level))

(def shell_p1 (phasor (clip (* base_freq (+ 0.74 (* chaos_amt 0.12))) 55 1800)))
(def shell_p2 (phasor (clip (* base_freq (+ 1.83 (* tens 0.18) (* chaos_amt 0.22))) 90 3800)))
(def shell_p3 (phasor (clip (* base_freq (+ 3.47 (* chaos_amt 0.65))) 140 7200)))
(def shell_modes
  (* (+ (* (sin (+ (* shell_p1 twopi) 0.22)) 0.44)
        (* (sin (+ (* shell_p2 twopi) 2.16)) 0.30)
        (* (sin (+ (* shell_p3 twopi) 4.62)) 0.18))
     shell_env shell_level))

(def membrane (* membrane_modes membrane_level))
(def air_blast (* (svf raw_noise (clip (+ 700 (* bright 7400)) 400 9800) 0.75 2) crack_env air_level))

(def dry_core (+ stick rim_click snap skin flam wire_signal boom shell_modes membrane air_blast))
(def body_filtered (svf dry_core (clip (+ 3600 (* bright 8200)) 1800 13500) (+ 0.65 (* chaos_amt 1.05)) 0))
(def driven (tanh (* body_filtered drive)))

(def room_f1 (clip (* base_freq (+ 0.42 (* room_sz 0.32))) 45 1400))
(def room_f2 (clip (* base_freq (+ 1.12 (* room_sz 0.84))) 75 3200))
(def room_f3 (clip (* base_freq (+ 2.36 (* room_sz 1.36) (* chaos_amt 0.42))) 120 6200))
(def room_f4 (clip (* base_freq (+ 4.21 (* room_sz 2.10))) 200 9200))
(def rp1 (phasor room_f1))
(def rp2 (phasor room_f2))
(def rp3 (phasor room_f3))
(def rp4 (phasor room_f4))
(def room_modes
  (+ (* (sin (+ (* rp1 twopi) 0.37)) 0.42)
     (* (sin (+ (* rp2 twopi) 1.94)) 0.30)
     (* (sin (+ (* rp3 twopi) 3.48)) 0.22)
     (* (sin (+ (* rp4 twopi) 5.03)) 0.15)))
(def room_air (svf raw_noise (clip (+ 650 (* room_bright 7600)) 320 10500) (+ 0.7 (* room_sz 1.4)) 1))
(def room_body (svf (+ membrane_modes shell_modes wire_signal) (clip (+ 420 (* room_bright 5200)) 220 8000) 0.85 0))
(def room_sig (* (+ (* room_modes 0.84) (* room_air 0.42) (* room_body 0.64)) room_env room_level))

(def pre_out (+ (* driven 0.92) (* room_sig 0.68)))
(def signal (* (tanh (* pre_out 1.08)) amp_env vel gain 0.74))

(out signal 1 @name audio)
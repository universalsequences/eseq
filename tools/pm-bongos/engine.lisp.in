;; PM Bongos / identified hand-drum kit resonator.
;; Generated by tools/pm-bongos/build.py; edit engine.lisp.in, then regenerate.
;; Reference coefficients only: no PCM, recorded phase, or spectral frames.
;; Twelve measured strokes repeat every octave (see ATTRIBUTION.md). The octave
;; starting at MIDI $first_key plays them at the recorded pitch; every other
;; octave transposes the whole kit by whole octaves.

(def gate (in 1 @name gate))
(def pitch (in 2 @name pitch))
(def velocity (in 3 @name velocity))
(def trigger (in 4 @name trigger))
(def clock (in 5 @name clock))
(def mod1 (in 6 @name mod1 @modulator 1))
(def mod2 (in 7 @name mod2 @modulator 2))
(def mod3 (in 8 @name mod3 @modulator 3))
(def mod4 (in 9 @name mod4 @modulator 4))

(param hardness @group hand @default 0.5 @min 0 @max 1 @mod true @mod-mode additive)
(param dynamics @group hand @default 0.5 @min 0 @max 1)
(param flam @group hand @default 1 @min 0 @max 3 @mod true @mod-mode additive)
(param flam_level @group hand @default 1 @min 0 @max 1.5 @mod true @mod-mode additive)
(param tune @group head @default 0 @min -12 @max 12 @unit st @mod true @mod-mode additive)
(param decay @group head @default 1 @min 0.2 @max 3 @mod true @mod-mode additive)
(param muffle @group head @default 0 @min 0 @max 1 @mod true @mod-mode additive)
(param glide @group head @default 0 @min 0 @max 1 @mod true @mod-mode additive)
(param skin @group contact @default 1 @min 0 @max 3 @mod true @mod-mode additive)
(param skin_tone @group contact @default 0 @min -1 @max 1 @mod true @mod-mode additive)
(param width @group output @default 1 @min 0 @max 1.5 @mod true @mod-mode additive)
(param drive @group output @default 0 @min 0 @max 1 @mod true @mod-mode additive)
(param tone_hz @group output @default 16000 @min 1000 @max 20000 @unit Hz @mod true @mod-mode additive)
(param gain @group output @default 1 @min 0 @max 4 @mod true @mod-mode additive)

$tables

(defmacro bongo-smooth (target ms)
  (make-history previous)
  (make-history ready)
  (def pole (exp (/ -1 (* 0.001 ms samplerate))))
  (def value (gswitch (read-history ready) (mix target (read-history previous) pole) target))
  (write-history previous value)
  (write-history ready 1)
  value)

(defmacro bongo-pole (signal pole)
  (make-history previous)
  (def value (mix signal (read-history previous) pole))
  (write-history previous value)
  value)

;; Coefficients latch on every strike as well as each periodic control tick;
;; a periodic-only hop would miss the start of an off-grid hand strike.
(def control_tick (eq (accum 1 0 0 16) 0))
(defmacro bongo-hold (value tick) (event-hold value tick))
(defmacro bongo-audio (value tick) (latch value tick))

(make-history last_gate)
(make-history elapsed)
(def held (gt gate 0.5))
(def onset (max (gt trigger 0.5) (* held (lte (read-history last_gate) 0.5))))
(write-history last_gate held)
(def update_tick (max control_tick onset))
;; Integer sample age since the key's first strike (bounded, no float drift).
(def age (gswitch onset 0 (min 1000000 (+ 1 (read-history elapsed)))))
(write-history elapsed age)

(def hit_velocity (latch (clip velocity 0 1) onset))
(def key_note (+ 69 (* 12 (/ (log (/ (clip pitch 8.1758 12543.85) 440)) (log 2)))))
(def key_offset (round (- key_note $first_key)))
(def key_octave (floor (/ key_offset 12)))
(def row (latch (- key_offset (* 12 key_octave)) onset))
(def octave (latch (clip key_octave $min_octave $max_octave) onset))
;; Vector coefficients only run on event clocks: every input they read is
;; event-held, so the scheduler evaluates them on the coefficient tick (or the
;; contact frame), never per sample.
(def mode_indices (iota $modes))
(def tick_row (bongo-hold row update_tick))
(def row_indices (+ mode_indices (* tick_row $modes)))

;; Contact events of the gesture (flams, finger bounces). Flam scales the
;; measured spacing; flam level scales every event after the first. Unused
;; event slots carry zero residue and zero skin noise.
(def flam_scale (latch (clip (mod flam) 0 3) onset))
(def flam_gain (latch (clip (mod flam_level) 0 1.5) onset))
(defmacro strike-pulse (strike)
  (eq age (round (* (peek delay_table (+ (* row $strikes) strike)) flam_scale samplerate))))
(def pulse0 onset)
(def pulse1 (strike-pulse 1))
(def pulse2 (strike-pulse 2))
(def strike_event (gt (+ pulse0 pulse1 pulse2) 0))
(def strike_row (bongo-hold row strike_event))
(defmacro strike-indices (strike) (+ mode_indices (* (+ (* strike_row $strikes) strike) $modes)))

;; Tension glide: a hard slap briefly stretches the head. Recomputed on the
;; 16-sample coefficient clock, never per sample.
(def glide_env (exp (/ (- age) (* 0.028 samplerate))))
(def bend (+ 1 (* 0.03 (clip (mod glide) 0 1) hit_velocity hit_velocity glide_env)))
(def transpose (pow 2 (+ octave (/ (bongo-smooth (clip (mod tune) -12 12) 8) 12))))
(def table_hz (gather frequency_table row_indices))
(def strike_hz (* (gather frequency_table (+ mode_indices (* strike_row $modes))) (bongo-hold transpose strike_event)))
(def frequencies (* table_hz (bongo-hold (* transpose bend) update_tick)))
(def omega (* twopi (/ (min frequencies (* 0.48 samplerate)) samplerate)))
(def rotation_cos (cos omega))
(def rotation_sin (sin omega))

;; Hand contact. The identified residues are the modes' responses to the
;; recorded hands. A shorter or longer live contact (hardness, and softer
;; hits when Vel > timbre is up) multiplies each mode by the exact complex
;; response ratio of normalized two-pole contact forces, live/reference,
;; evaluated only on the frames where a contact event fires.
(def reference_pole (exp (/ -1 (* $contact_seconds samplerate))))
(def contact_tau (* $contact_seconds
  (pow 2 (* 3 (- 0.5 (clip (mod hardness) 0 1))))
  (+ 1 (* 1.5 (clip dynamics 0 1) (- 1 hit_velocity)))))
(def live_pole (exp (/ -1 (* (bongo-hold contact_tau strike_event) samplerate))))
(def strike_omega (* twopi (/ (min strike_hz (* 0.48 samplerate)) samplerate)))
(def strike_cos (cos strike_omega))
(def strike_sin (sin strike_omega))
(def ref_re (- 1 (* reference_pole strike_cos)))
(def ref_im (* reference_pole strike_sin))
(def live_re (- 1 (* live_pole strike_cos)))
(def live_im (* live_pole strike_sin))
;; (ref / live), then squared for the two poles; guarded as the scheduler
;; zeroes event inputs between events.
(def live_norm (max 0.00000000000000000001 (+ (* live_re live_re) (* live_im live_im))))
(def q_re (/ (+ (* ref_re live_re) (* ref_im live_im)) live_norm))
(def q_im (/ (- (* ref_im live_re) (* ref_re live_im)) live_norm))
(def dc_ratio (/ (* (- 1 live_pole) (- 1 live_pole)) (* (- 1 reference_pole) (- 1 reference_pole))))
(def contact_re (* dc_ratio (- (* q_re q_re) (* q_im q_im))))
(def contact_im (* dc_ratio 2 q_re q_im))
(def band (clip (/ (- (* samplerate 0.47) strike_hz) (* samplerate 0.07)) 0 1))
;; A finite energy budget: a harder hand redistributes, never manufactures,
;; modal energy (squared residues are the energy proxy; modal masses unknown).
(def reference_residue (* (gather magnitude_table (strike-indices 0)) band))
(def contact_gain (+ (* contact_re contact_re) (* contact_im contact_im)))
(def energy_scale (min 1 (sqrt (/ (sum (* reference_residue reference_residue))
  (max 0.00000000000000000001 (sum (* reference_residue reference_residue contact_gain)))))))
;; Each event injects its measured complex residue once, so split head modes
;; keep their recorded relative phase and beat as they did on the record.
(defmacro strike-mix (table)
  (+ (* (bongo-hold pulse0 strike_event) (gather table (strike-indices 0)))
     (* (bongo-hold flam_gain strike_event)
        (+ (* (bongo-hold pulse1 strike_event) (gather table (strike-indices 1)))
           (* (bongo-hold pulse2 strike_event) (gather table (strike-indices 2)))))))
(def event_sin (strike-mix sine_table))
(def event_cos (strike-mix cosine_table))
(def event_scale (* (bongo-hold hit_velocity strike_event) band energy_scale))
(def inject_r (bongo-audio (bongo-hold (* event_scale (- (* event_sin contact_re) (* event_cos contact_im))) strike_event) strike_event))
(def inject_i (bongo-audio (bongo-hold (* event_scale (+ (* event_sin contact_im) (* event_cos contact_re))) strike_event) strike_event))

;; Measured loss per mode; Muffle is a resting hand adding loss that grows
;; with frequency, Decay scales the natural ring.
(def base_hz (peek frequency_table (* tick_row $modes)))
(def decay_scale (bongo-hold (bongo-smooth (clip (mod decay) 0.2 3) 8) update_tick))
(def hand_loss (bongo-hold (* 90 (pow (bongo-smooth (clip (mod muffle) 0 1) 4) 2)) update_tick))
(def rate (+ (/ (gather rate_table row_indices) decay_scale)
  (* hand_loss (sqrt (/ table_hz base_hz)))))

(defmacro bongo-resonator (rotation_cos rotation_sin rate event inject_r inject_i tick)
  (make-tensor-history head_r @shape [$modes])
  (make-tensor-history head_i @shape [$modes])
  (def x (read-tensor-history head_r))
  (def y (read-tensor-history head_i))
  (def radius (exp (/ (- rate) samplerate)))
  (def c (bongo-audio (* radius rotation_cos) tick))
  (def s (bongo-audio (* radius rotation_sin) tick))
  (def next_r (+ (- (* c x) (* s y)) (* event inject_r)))
  (def next_i (+ (* s x) (* c y) (* event inject_i)))
  (write-tensor-history head_r next_r)
  (write-tensor-history head_i next_i)
  next_i)

(def modes (bongo-resonator rotation_cos rotation_sin rate strike_event inject_r inject_i update_tick))
(def stereo (bongo-hold (bongo-smooth (clip (mod width) 0 1.5) 8) update_tick))
(def pans (gather pan_table row_indices))
(def left (sum (* modes (bongo-audio (sqrt (max 0 (+ 1 (* pans stereo)))) update_tick))))
(def right (sum (* modes (bongo-audio (sqrt (max 0 (- 1 (* pans stereo)))) update_tick))))

;; Hand/skin contact measured above the modes: a click that falls ~20 dB in a
;; few milliseconds and a quieter sizzle, excited by the gesture's measured
;; contacts only (finger-bounce re-excitations carry no skin noise).
(def skin_level (latch (clip (mod skin) 0 3) onset))
(defmacro skin-envelope (table decay_table)
  (make-history level)
  (def pole (bongo-audio (exp (/ -1 (* (bongo-hold (peek decay_table row) onset) samplerate))) onset))
  (def kick (+ (* pulse0 (peek table (* row $strikes)))
    (* pulse1 (peek table (+ (* row $strikes) 1)))
    (* pulse2 (peek table (+ (* row $strikes) 2)))))
  (def value (+ (* (read-history level) pole) (* kick hit_velocity skin_level)))
  (write-history level value)
  value)
(def skin_env (+ (skin-envelope click_table click_decay_table) (skin-envelope sizzle_table sizzle_decay_table)))
(def skin_hz (latch (* (peek noise_hz_table row) (pow 2 (+ octave (* 1.5 (clip (mod skin_tone) -1 1))))) onset))
(def skin_noise (svf (* (- (* 2 (noise)) 1) skin_env) (min skin_hz (* 0.45 samplerate)) (peek noise_q_table row) 1))

(def drive_v (bongo-smooth (clip (mod drive) 0 1) 8))
(def cutoff (min (bongo-smooth (clip (mod tone_hz) 1000 20000) 8) (* samplerate 0.43)))
(def output_gain (bongo-smooth (clip (mod gain) 0 4) 8))
(defmacro bongo-output (signal drive_v cutoff gain_v)
  (def driven (mix signal (/ (tanh (* signal (+ 1 (* drive_v 8)))) (+ 1 (* drive_v 2))) drive_v))
  (def filtered (svf driven cutoff 0.707 0))
  (* filtered gain_v))
(def voice_left (bongo-output (+ left skin_noise) drive_v cutoff output_gain))
(def voice_right (bongo-output (+ right skin_noise) drive_v cutoff output_gain))
(out voice_left 1 @name left)
(out voice_right 2 @name right)
;; A drum may never see note-off (gate-off tracks), so the amp flag must not
;; depend on the gate: the voice is done once its output has fallen below
;; -100 dBFS, which follows any decay, release or ring.
(use-defmacro voice-amp)
(out (voice-amp 0 voice_left voice_right) 3 @name amp @amp true)

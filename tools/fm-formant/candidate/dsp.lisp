; FM Formant — integration candidate. Generated by build_instrument.py.
; Native program data lives in motion.json; see the adjacent README.
; Compact finite damped-sine formant. No oversampling or partial loop.
; This primitive returns quadratures and an amplitude bound for a finite
; geometric series. The stable factored denominator is critical near phase 0.
(defmacro ff-one-minus-exp (x)
  (def z (min x 0.01))
  (gswitch (lt x 0.01)
    (* z (+ 1 (* z (+ -0.5 (* z (+ 0.166666666667 (* z -0.041666666667)))))))
    (- 1 (exp (* -1 x)))))

(defmacro ff-series (phase decay count)
  (def n (max count 0))
  (def q (exp (* -1 decay)))
  (def qn (exp (* -1 decay n)))
  (def omq (ff-one-minus-exp decay))
  (def omqn (ff-one-minus-exp (* decay n)))
  (def sh (sin (* 0.5 phase)))
  (def snh (sin (* 0.5 phase n)))
  (def c (+ omq (* 2 q sh sh)))
  (def d (* -1 q (sin phase)))
  (def a (+ omqn (* 2 qn snh snh)))
  (def b (* -1 qn (sin (* phase n))))
  (def den (+ (* omq omq) (* 4 q sh sh)))
  (tuple (/ (+ (* a c) (* b d)) den)
         (/ (- (* b c) (* a d)) den)
         (/ omqn omq)))

; Positive harmonic coefficients exp(-2*a*abs(h*f0-center)/bandwidth).
; Nyquist transition uses two cosine-tapered terminal harmonics. The same
; coefficients define the level bound; PM is a quadrature rotation.
(defmacro ff-profile (phase f0 center bandwidth a pm)
  (def top (/ (* 0.5 samplerate) f0))
  (def h (max 0 (- (floor top) 2)))
  (def k (clip (floor (/ center f0)) 0 h))
  (def decay (/ (* 2 a f0) bandwidth))
  (def (lr li lm) (ff-series (* -1 phase) decay k))
  (def (rr ri rm) (ff-series phase decay (- h k)))
  (def lphase (+ (* k phase) pm))
  (def rphase (+ (* (+ k 1) phase) pm))
  (def la (exp (/ (* -2 a (abs (- (* k f0) center))) bandwidth)))
  (def ra (exp (/ (* -2 a (abs (- (* (+ k 1) f0) center))) bandwidth)))
  (def core (+ (* la (- (* lr (cos lphase)) (* li (sin lphase))))
               (* ra (- (* rr (cos rphase)) (* ri (sin rphase))))))
  (def j1 (+ h 1))
  (def j2 (+ h 2))
  (def w1 (* 0.5 (- 1 (cos (* pi (clip (/ (- top j1) 2) 0 1))))))
  (def w2 (* 0.5 (- 1 (cos (* pi (clip (/ (- top j2) 2) 0 1))))))
  (def t1 (* w1 (exp (/ (* -2 a (abs (- (* j1 f0) center))) bandwidth))))
  (def t2 (* w2 (exp (/ (* -2 a (abs (- (* j2 f0) center))) bandwidth))))
  (tuple (+ core (* t1 (cos (+ (* j1 phase) pm))) (* t2 (cos (+ (* j2 phase) pm))))
         (+ (* la lm) (* ra rm) t1 t2)))

; All three profiles are 0.5 at +/-bandwidth/2 and 1 at center.
; Skirt moves from the broader-tailed mixture toward the single exponential.
(defmacro ff-formant (phase frequency center_hz bandwidth_hz skirt pm)
  (def f0 (clip frequency 10 (* 0.49 samplerate)))
  (def center (clip center_hz 10 (* 0.49 samplerate)))
  (def bandwidth (clip bandwidth_hz 20 8000))
  (def s (clip skirt 0 1))
  (def (x0 m0) (ff-profile phase f0 center bandwidth 0.69314718056 pm))
  (def (x1 m1) (ff-profile phase f0 center bandwidth 1.38629436112 pm))
  (def (x2 m2) (ff-profile phase f0 center bandwidth 0.287682072452 pm))
  (def broad (* 0.5 (- 1 s)))
  (/ (+ (* s x0) (* broad (+ x1 x2)))
     (max 1 (+ (* s m0) (* broad (+ m1 m2))))))

; Shared voice building blocks. Amplitude envelopes use milliseconds, matching
; the published DGen ADSR primitive; frequency depths use octaves.
(defmacro ff-smooth (target reset)
  (make-history previous)
  (def old (read-history previous))
  (def coefficient (- 1 (exp (/ -1 (* 0.002 samplerate)))))
  (def value (gswitch reset target (+ old (* coefficient (- target old)))))
  (write-history previous value)
  value)

(defmacro ff-hz (target reset)
  (exp (ff-smooth (log (max target 0.001)) reset)))

(defmacro ff-phase (frequency reset)
  (make-history previous)
  (def value (gswitch reset 0 (wrap (+ (read-history previous) (/ frequency samplerate)) 0 1)))
  (write-history previous value)
  (* twopi value))

; Wichmann-Hill combined generator. Every integer product is below 2^24,
; so the recurrence remains exact in float32. Distinct explicit seeds give
; independent band streams without depending on compiler-global RNG state.
(defmacro ff-noise (seed reset)
  (make-history x)
  (make-history y)
  (make-history z)
  (def sx (gswitch reset (+ 1 (wrap (* seed 13) 0 30268)) (read-history x)))
  (def sy (gswitch reset (+ 1 (wrap (* seed 17) 0 30306)) (read-history y)))
  (def sz (gswitch reset (+ 1 (wrap (* seed 19) 0 30322)) (read-history z)))
  (def nx (wrap (* 171 sx) 0 30269))
  (def ny (wrap (* 172 sy) 0 30307))
  (def nz (wrap (* 170 sz) 0 30323))
  (write-history x nx)
  (write-history y ny)
  (write-history z nz)
  (- (* 2 (wrap (+ (/ nx 30269) (/ ny 30307) (/ nz 30323)) 0 1)) 1))

; A complex resonator driven by white noise. Pole radius is defined by
; bandwidth in Hz; matched gain bounds its integrated power as width changes.
; This exposes decay bandwidth, not a claim of exact digital -6 dB width.
(defmacro ff-noise-band (source center bandwidth)
  (def radius (exp (/ (* -1 pi bandwidth) samplerate)))
  (def angle (/ (* twopi center) samplerate))
  (def c (* radius (cos angle)))
  (def s (* radius (sin angle)))
  (make-history real)
  (make-history imag)
  (def r (read-history real))
  (def i (read-history imag))
  (def nr (+ (* c r) (* -1 s i) (* (sqrt (- 1 (* radius radius))) source)))
  (def ni (+ (* s r) (* c i)))
  (write-history real nr)
  (write-history imag ni)
  nr)

(defmacro ff-dc (x)
  (make-history previous_x)
  (make-history previous_y)
  (def y (+ (- x (read-history previous_x))
            (* (exp (/ (* -1 twopi 5) samplerate)) (read-history previous_y))))
  (write-history previous_x x)
  (write-history previous_y y)
  y)

(defmacro ff-pan (signal pan)
  (tuple (* signal (cos (* (+ pan 1) 0.25 pi)))
         (* signal (sin (* (+ pan 1) 0.25 pi)))))


; ======================================================================
; Wavetable engine (plaits/dsp/engine/wavetable_engine.cc): 4 banks of 8x8
; integrated waves, trilinear X/Y/Z interpolation, Hermite phase reading,
; differentiated output; AUX is the 5-bit (x32) quantized output.
; Bank 4 (Z = 3) is the default "user" bank: wave i = (w * 101) % 192.
; ======================================================================
(def wt_waves (tensor @shape [132 192] @file "wav_integrated_waves.json"))

; ONE_POLE run once per block (on bstart); holds between blocks.
(defmacro wt-block-pole (in coef bstart)
  (make-history h)
  (def s (read-history h))
  (def v (gswitch bstart (+ s (* coef (- in s))) s))
  (write-history h v)
  v)

; wavetable_engine.cc Clamp(x, amount).
(defmacro wt-clampf (x amount)
  (+ 0.5 (clip (* (- x 0.5) amount) -0.5 0.5)))

; Raw wave index (column of wt_waves) for grid coordinates x, y (0..7) and
; bank z (0..3).
(defmacro wt-wave-index (x y z)
  (def w (+ x (* 8 y)))
  (def v (* w 101))
  (def user (- v (* 192 (floor (/ (+ v 0.5) 192)))))
  (gswitch (gt z 2.5) user (+ w (* 64 z))))

; InterpolateWaveHermite on one wave.
(defmacro wt-hermite (wave pi pf)
  (def xm1 (peek wt_waves pi wave))
  (def x0 (peek wt_waves (+ pi 1) wave))
  (def x1 (peek wt_waves (+ pi 2) wave))
  (def x2 (peek wt_waves (+ pi 3) wave))
  (def c (* (- x1 xm1) 0.5))
  (def v (- x0 x1))
  (def w (+ c v))
  (def a (+ w v (* (- x2 x0) 0.5)))
  (def b_neg (+ w a))
  (+ (* (+ (* (- (* a pf) b_neg) pf) c) pf) x0))

; ParameterInterpolator(&state, target, 12) emulated sample-exactly: the
; state accumulates value += increment like the C++ (init = initial state).
(defmacro wt-pinterp (target bstart init)
  (make-history h_val)
  (make-history h_inc)
  (make-history h_ready)
  (def v_old (gswitch (read-history h_ready) (read-history h_val) init))
  (def inc (gswitch bstart (/ (- target v_old) 12) (read-history h_inc)))
  (def v (+ v_old inc))
  (write-history h_val v)
  (write-history h_inc inc)
  (write-history h_ready 1)
  v)

(defmacro plaits-wavetable (bstart bphase rise high patched note timbre morph harmonics accent)
  ; --- block rate ---
  (def f0b (pl-note-to-freq note))
  (def xp (wt-block-pole (* timbre 6.9999) 0.2 bstart))
  (def yp (wt-block-pole (* morph 6.9999) 0.2 bstart))
  (def zp (wt-block-pole (* harmonics 6.9999) 0.05 bstart))
  (def quant (clip (- zp 3) 0 1))
  (def lp_coef (clip (* 2 f0b (- 4 (* 3 quant))) 0.01 0.1))
  (def xpi (floor xp))
  (def ypi (floor yp))
  (def zpi (floor zp))
  (def xpf (- xp xpi))
  (def ypf (- yp ypi))
  (def zpf (- zp zpi))
  (def xt (+ xpi xpf (* quant (- (wt-clampf xpf 16) xpf))))
  (def yt (+ ypi ypf (* quant (- (wt-clampf ypf 16) ypf))))
  (def zt (+ zpi zpf (* quant (- (wt-clampf zpf 16) zpf))))
  (def xm (wt-pinterp xt bstart 0))
  (def ym (wt-pinterp yt bstart 0))
  (def zm (wt-pinterp zt bstart 0))
  (def f0 (wt-pinterp f0b bstart (/ 55 samplerate)))
  ; --- sample rate ---
  (def gain (* (/ 1 (* (max f0 0.0000001) 131072)) (- 0.95 f0)))
  (def cutoff (min (* 128 f0) 1))
  (def x (pl-one-pole xm lp_coef))
  (def y (pl-one-pole ym lp_coef))
  (def z (pl-one-pole zm lp_coef))
  (def xi (floor x))
  (def yi (floor y))
  (def zi (floor z))
  (def xf (- x xi))
  (def yf (- y yi))
  (def zf (- z zi))
  (make-history h_phase)
  (def phase (pl-wrap (+ (read-history h_phase) f0)))
  (write-history h_phase phase)
  (def p (* phase 128))
  (def pi (floor p))
  (def pf (- p pi))
  (def x1 (+ xi 1))
  (def y1 (+ yi 1))
  (def z0r (gswitch (gte zi 4) (- 7 zi) zi))
  (def z1r (gswitch (gte (+ zi 1) 4) (- 6 zi) (+ zi 1)))
  (def x0y0z0 (wt-hermite (wt-wave-index xi yi z0r) pi pf))
  (def x1y0z0 (wt-hermite (wt-wave-index x1 yi z0r) pi pf))
  (def x0y1z0 (wt-hermite (wt-wave-index xi y1 z0r) pi pf))
  (def x1y1z0 (wt-hermite (wt-wave-index x1 y1 z0r) pi pf))
  (def x0y0z1 (wt-hermite (wt-wave-index xi yi z1r) pi pf))
  (def x1y0z1 (wt-hermite (wt-wave-index x1 yi z1r) pi pf))
  (def x0y1z1 (wt-hermite (wt-wave-index xi y1 z1r) pi pf))
  (def x1y1z1 (wt-hermite (wt-wave-index x1 y1 z1r) pi pf))
  (def xy0z0 (+ x0y0z0 (* (- x1y0z0 x0y0z0) xf)))
  (def xy1z0 (+ x0y1z0 (* (- x1y1z0 x0y1z0) xf)))
  (def xyz0 (+ xy0z0 (* (- xy1z0 xy0z0) yf)))
  (def xy0z1 (+ x0y0z1 (* (- x1y0z1 x0y0z1) xf)))
  (def xy1z1 (+ x0y1z1 (* (- x1y1z1 x0y1z1) xf)))
  (def xyz1 (+ xy0z1 (* (- xy1z1 xy0z1) yf)))
  (def mix (+ xyz0 (* (- xyz1 xyz0) zf)))
  ; Differentiator: ONE_POLE(lp, s - previous, cutoff)
  (def d (pl-one-pole (- mix (pl-noise-tap mix)) cutoff))
  (def o (* d gain))
  (tuple o (/ (pl-trunc (* o 32)) 32)))

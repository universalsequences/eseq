; ======================================================================
; Waveshaping engine (plaits/dsp/engine/waveshaping_engine.cc): bandlimited
; slope (pw from MORPH) -> int16 waveshaper bank (HARMONICS) -> wavefolders
; lut_fold (OUT) / lut_fold_2 (AUX, crossfaded from a sine of the triangle).
; ======================================================================
(def ws_lut_fold (tensor @shape [516 1] @file "lut_fold.json"))
(def ws_lut_fold_2 (tensor @shape [516 1] @file "lut_fold_2.json"))
; lut_ws_inverse_tan, _inverse_sin, _linear, _bump, _double_bump (/ 32768)
(def ws_lut_ws (tensor @shape [257 5] @file "lut_ws.json"))

; plaits Oscillator::Render<OSCILLATOR_SHAPE_SLOPE> (no external FM).
; State: phase 0.5, high true, frequency_ 0.001, pw_ 0.5 at Init.
(defmacro ws-slope-osc (freq_t pw_t bstart bphase)
  (def ft (clip freq_t 0.000001 0.25))
  (def pwt (clip pw_t (* ft 2) (- 1 (* 2 ft))))
  (def f (pl-interp ft bstart bphase 0.001))
  (def pw (pl-interp pwt bstart bphase 0.5))
  (make-history h_ph)
  (make-history h_ready)  ; 0 on the first sample: phase starts at 0.5
  (make-history h_low)    ; 1 - high_
  (make-history h_next)
  (def this0 (read-history h_next))
  (def high0 (- 1 (read-history h_low)))
  (def su (/ 1 pw))
  (def sd (/ 1 (- 1 pw)))
  (def d (* (+ su sd) f))
  (def ph1 (+ (gswitch (read-history h_ready) (read-history h_ph) 0.5) f))
  (def below (lt ph1 pw))
  (def edge (abs (- high0 below)))
  (def ta (/ (- ph1 pw) f))
  (def high1 (gswitch edge below high0))
  (def wrap (gte ph1 1))
  (def ph (- ph1 wrap))
  (def tb (/ ph f))
  (def high (gswitch wrap 1 high1))
  (def this_sample (+ this0
                      (* -1 edge d (pl-this-integrated-blep ta))
                      (* wrap d (pl-this-integrated-blep tb))))
  (def next (+ (* -1 edge d (pl-next-integrated-blep ta))
               (* wrap d (pl-next-integrated-blep tb))
               (gswitch high (* ph su) (- 1 (* (- ph pw) sd)))))
  (write-history h_ph ph)
  (write-history h_ready 1)
  (write-history h_low (- 1 high))
  (write-history h_next next)
  (- (* 2 this_sample) 1))

; stmlib InterpolateHermite(table + 1, index, 512).
(defmacro ws-hermite (table index)
  (def x (* index 512))
  (def i (floor x))
  (def fr (- x i))
  (def xm1 (peek table i 0))
  (def x0 (peek table (+ i 1) 0))
  (def x1 (peek table (+ i 2) 0))
  (def x2 (peek table (+ i 3) 0))
  (def c (* (- x1 xm1) 0.5))
  (def v (- x0 x1))
  (def w (+ c v))
  (def a (+ w v (* (- x2 x0) 0.5)))
  (def b_neg (+ w a))
  (+ (* (+ (* (- (* a fr) b_neg) fr) c) fr) x0))

(defmacro ws-tame (f0 harmonics order)
  (def f (* f0 harmonics))
  (def max_f (/ 0.5 order))
  (def m (clip (- 1 (/ (- f max_f) (- 0.5 max_f))) 0 1))
  (* m m m))

(defmacro plaits-ws (bstart bphase rise high patched note timbre morph harmonics accent)
  (def f0 (pl-note-to-freq note))
  (def pw (+ (* morph 0.45) 0.5))
  (def slope_sig (ws-slope-osc f0 pw bstart bphase))
  (def tri_sig (ws-slope-osc f0 0.5 bstart bphase))
  (def slope (+ 3 (* (abs (- morph 0.5)) 5)))
  (def shape_amount (* (abs (- harmonics 0.5)) 2))
  (def shape_att (ws-tame f0 slope 16))
  (def wf_att (ws-tame f0 (* slope (+ 3 (* shape_amount shape_att 5))) 12))
  (def shape_m (pl-interp (+ 0.5 (* (- harmonics 0.5) shape_att)) bstart bphase 0))
  (def wf_gain (pl-interp (+ 0.03 (* 0.46 timbre wf_att)) bstart bphase 0))
  (def og (* timbre (- 2 timbre)))
  (def overtone (pl-interp (* og (- 2 og)) bstart bphase 0))
  (def shape (* shape_m 3.9999))
  (def s_i (pl-trunc shape))
  (def s_f (- shape s_i))
  (def wsx (+ (* 127 slope_sig) 128))
  (def wi_raw (pl-trunc wsx))
  (def w_f (- wsx wi_raw))
  (def wi (- wi_raw (* 256 (floor (/ wi_raw 256)))))
  (def x0 (peek ws_lut_ws wi s_i))
  (def x1 (peek ws_lut_ws (+ wi 1) s_i))
  (def y0 (peek ws_lut_ws wi (+ s_i 1)))
  (def y1 (peek ws_lut_ws (+ wi 1) (+ s_i 1)))
  (def x (+ x0 (* (- x1 x0) w_f)))
  (def y (+ y0 (* (- y1 y0) w_f)))
  (def mix (+ x (* (- y x) s_f)))
  (def index (+ (* mix wf_gain) 0.5))
  (def fold (ws-hermite ws_lut_fold index))
  (def fold_2 (- (ws-hermite ws_lut_fold_2 index)))
  (def sine (sin (* twopi (+ (* tri_sig 0.25) 0.5))))
  (tuple fold (+ sine (* (- fold_2 sine) overtone))))

; ======================================================================
; FM engine (plaits/dsp/engine/fm_engine.cc): 2-op FM with feedback and a
; sub-octave phase-modulated sine on AUX, 4x oversampled.
; ======================================================================
(def lut_fm_quantizer (tensor @shape [130 1] @file "lut_fm_frequency_quantizer.json"))

(defmacro fm-sub (mod_f cf amount fb pfb)
  (make-history h_mp)
  (make-history h_cp)
  (make-history h_sp)
  (make-history h_prev)
  (def mfb (gswitch (gt fb 0) (* 0.25 fb fb) 0))
  (def mp0 (read-history h_mp))
  (def cp0 (read-history h_cp))
  (def sp0 (read-history h_sp))
  (def pv0 (read-history h_prev))
  ; oversampled step 1..4
  (def mp1 (pl-wrap (+ mp0 (* mod_f (+ 1 (* pv0 pfb))))))
  (def cp1 (pl-wrap (+ cp0 cf)))
  (def sp1 (pl-wrap (+ sp0 (* cf 0.5))))
  (def m1 (sin (* twopi (+ mp1 (* mfb pv0)))))
  (def c1 (sin (* twopi (+ cp1 (* amount m1)))))
  (def s1 (sin (* twopi (+ sp1 (* amount c1 0.25)))))
  (def pv1 (+ pv0 (* 0.05 (- c1 pv0))))
  (def mp2 (pl-wrap (+ mp1 (* mod_f (+ 1 (* pv1 pfb))))))
  (def cp2 (pl-wrap (+ cp1 cf)))
  (def sp2 (pl-wrap (+ sp1 (* cf 0.5))))
  (def m2 (sin (* twopi (+ mp2 (* mfb pv1)))))
  (def c2 (sin (* twopi (+ cp2 (* amount m2)))))
  (def s2 (sin (* twopi (+ sp2 (* amount c2 0.25)))))
  (def pv2 (+ pv1 (* 0.05 (- c2 pv1))))
  (def mp3 (pl-wrap (+ mp2 (* mod_f (+ 1 (* pv2 pfb))))))
  (def cp3 (pl-wrap (+ cp2 cf)))
  (def sp3 (pl-wrap (+ sp2 (* cf 0.5))))
  (def m3 (sin (* twopi (+ mp3 (* mfb pv2)))))
  (def c3 (sin (* twopi (+ cp3 (* amount m3)))))
  (def s3 (sin (* twopi (+ sp3 (* amount c3 0.25)))))
  (def pv3 (+ pv2 (* 0.05 (- c3 pv2))))
  (def mp4 (pl-wrap (+ mp3 (* mod_f (+ 1 (* pv3 pfb))))))
  (def cp4 (pl-wrap (+ cp3 cf)))
  (def sp4 (pl-wrap (+ sp3 (* cf 0.5))))
  (def m4 (sin (* twopi (+ mp4 (* mfb pv3)))))
  (def c4 (sin (* twopi (+ cp4 (* amount m4)))))
  (def s4 (sin (* twopi (+ sp4 (* amount c4 0.25)))))
  (def pv4 (+ pv3 (* 0.05 (- c4 pv3))))
  (write-history h_mp mp4)
  (write-history h_cp cp4)
  (write-history h_sp sp4)
  (write-history h_prev pv4)
  (tuple (pl-downsample4 c1 c2 c3 c4) (pl-downsample4 s1 s2 s3 s4)))

(defmacro plaits-fm (bstart bphase rise high patched note timbre morph harmonics accent)
  (def n (- note 24))
  (def ratio (pl-lut lut_fm_quantizer harmonics 128))
  (def mod_note (+ n ratio))
  (def target_mf (clip (pl-note-to-freq mod_note) 0 0.5))
  (def taming (clip (- 1 (* (- mod_note 72) 0.025)) 0 1))
  (def a0 (/ 55 samplerate))
  (def cf (pl-interp (pl-note-to-freq n) bstart bphase a0))
  (def mf (pl-interp target_mf bstart bphase a0))
  (def amount (pl-interp (* 2 timbre timbre taming taming) bstart bphase 0))
  (def fb (pl-interp (- (* 2 morph) 1) bstart bphase 0))
  (def pfb (gswitch (lt fb 0) (* 0.5 fb fb) 0))
  (fm-sub mf cf amount fb pfb))

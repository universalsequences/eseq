; ======================================================================
; Chiptune engine (plaits/dsp/engine2/chiptune_engine.cc).
; Trigger patched ("clocked"): each rising edge clocks an arpeggiator over
;   the sorted notes of the chord (HARMONICS); TIMBRE picks the pattern
;   (up/down/up-down/random x 1/2/4 octaves); one SuperSquare voice on OUT.
; Unpatched: 5 SuperSquare voices play the chord inversion set by TIMBRE.
; AUX: NES triangle bass at f0 / 2 (x arpeggiator octave when clocked).
; MORPH: SuperSquare shape. Extra arg env_shape = ChiptuneEngine
; set_envelope_shape value (2 = NO_ENVELOPE).
; already_enveloped = patched (the C++ sets it to `clocked`).
; ======================================================================

; Chord bank (generated by tools/chip_tables.py): unsorted ratios,
; Sort()ed ratios (folded into one octave), and note counts per chord.
(def chip_ratios (tensor @shape [44 1] @data [1.0 1.0004513263702393 1.9986467361450195 2.0 1.0 1.4983071088790894 1.498983383178711 2.0 1.0 1.3348398208618164 1.4983071088790894 2.0 1.0 1.1892070770263672 1.4983071088790894 2.0 1.0 1.1892070770263672 1.4983071088790894 1.7817974090576172 1.0 1.1892070770263672 1.7817974090576172 2.2449240684509277 1.0 1.1892070770263672 1.7817974090576172 2.669679641723633 1.0 1.1224620342254639 1.6817928552627563 2.5198421478271484 1.0 1.2599210739135742 1.8877485990524292 2.2449240684509277 1.0 1.2599210739135742 1.4983071088790894 1.8877485990524292 1.0 1.2599210739135742 1.4983071088790894 2.0]))
(def chip_sorted (tensor @shape [44 1] @data [1.0 1.0004513263702393 1.9986467361450195 2.0 1.0 1.4983071088790894 1.498983383178711 2.0 1.0 1.3348398208618164 1.4983071088790894 2.0 1.0 1.1892070770263672 1.4983071088790894 2.0 1.0 1.1892070770263672 1.4983071088790894 1.7817974090576172 1.0 1.1224620342254639 1.1892070770263672 1.7817974090576172 1.0 1.1892070770263672 1.3348398208618164 1.7817974090576172 1.0 1.1224620342254639 1.2599210739135742 1.6817928552627563 1.0 1.1224620342254639 1.2599210739135742 1.8877485990524292 1.0 1.2599210739135742 1.4983071088790894 1.8877485990524292 1.0 1.2599210739135742 1.4983071088790894 2.0]))
(def chip_counts (tensor @shape [11 1] @data [1.0 2.0 3.0 3.0 4.0 4.0 4.0 4.0 4.0 4.0 3.0]))

; Exact stmlib ParameterInterpolator with `called` gating and an initial
; state `init` (see bd-pi in bd.lisp).
(defmacro chip-pi (target bstart called init)
  (make-history h_v)
  (make-history h_inc)
  (make-history h_started)
  (def v0 (gswitch (read-history h_started) (read-history h_v) init))
  (write-history h_started 1)
  (def inc (gswitch bstart (/ (- target v0) 12) (read-history h_inc)))
  (write-history h_inc inc)
  (def v (+ v0 (* called inc)))
  (write-history h_v v)
  v)

; stmlib HysteresisQuantizer2 (non-symmetric), state updated when en = 1.
(defmacro chip-hq (value n hyst en)
  (make-history h_q)
  (def qp (read-history h_q))
  (def v (- (* value n) 0.5))
  (def x (+ v (* (gswitch (gt v qp) -1 1) hyst) 0.5))
  (def q (gswitch en (clip (pl-trunc x) 0 (- n 1)) qp))
  (write-history h_q q)
  q)

; plaits SuperSquareOscillator (hard-synced square); state advances when en.
(defmacro chip-supersquare (frequency shape bstart en)
  (make-history h_mp)
  (make-history h_sp)
  (make-history h_next)
  (make-history h_high)
  (def mf_t (min frequency 0.25))
  (def sf_t (min (* frequency (gswitch (lt shape 0.5) (+ 0.51 (* 0.98 shape))
                                       (+ 1 (* 16 (- shape 0.5) (- shape 0.5)))))
                 0.25))
  (def mf (max (chip-pi mf_t bstart en 0) 0.0000001))
  (def sf (max (chip-pi sf_t bstart en 0.01) 0.0000001))
  (def high0 (read-history h_high))
  (def sp0 (read-history h_sp))
  (def mp1 (+ (read-history h_mp) mf))
  (def reset (gte mp1 1))
  (def mp (- mp1 reset))
  (def rt (/ mp mf))
  (def spr0 (+ sp0 (* (- 1 rt) sf)))
  (def wr (gte spr0 1))
  (def spr (- spr0 wr))
  (def tdr (max wr (* (- 1 high0) (gte spr 0.5))))
  (def rval (* reset (gte spr 0.5)))
  (def sp1 (+ sp0 sf))
  (def enter (max (- 1 reset) tdr))
  (def a_on (* enter (- 1 high0) (gte sp1 0.5)))
  (def ta (/ (- sp1 0.5) sf))
  (def high_a (max high0 a_on))
  (def b_on (* enter high_a (gte sp1 1)))
  (def sp2 (- sp1 b_on))
  (def tb (/ sp2 sf))
  (def high_b (* high_a (- 1 b_on)))
  (def sp (gswitch reset (* rt sf) sp2))
  (def high (* high_b (- 1 reset)))
  (def this_s (+ (read-history h_next)
                 (- (* rval (pl-this-blep rt)))
                 (* a_on (pl-this-blep ta))
                 (- (* b_on (pl-this-blep tb)))))
  (def next_s (+ (- (* rval (pl-next-blep rt)))
                 (* a_on (pl-next-blep ta))
                 (- (* b_on (pl-next-blep tb)))
                 (gte sp 0.5)))
  (write-history h_mp (gswitch en mp (read-history h_mp)))
  (write-history h_sp (gswitch en sp sp0))
  (write-history h_high (gswitch en high high0))
  (write-history h_next (gswitch en next_s (read-history h_next)))
  (- (* 2 this_s) 1))

; plaits NESTriangleOscillator<5> (32 steps).
(defmacro chip-nes-triangle (frequency bstart)
  (make-history h_ph)
  (make-history h_step)
  (make-history h_desc)   ; 1 - ascending_
  (make-history h_next)
  (def f (max (chip-pi (min frequency 0.25) bstart 1 0.001) 0.0000001))
  (def ph1 (+ (read-history h_ph) f))
  (def fade (clip (* (- f (/ 0.5 32)) 64) 0 1))
  (def nes_gain (- 1 fade))
  (def tri_gain (* fade 15))
  (def top (* (- 1 (read-history h_desc)) (gte ph1 0.5)))
  (def d_top (* 4 f tri_gain))
  (def t_top (/ (- ph1 0.5) f))
  (def ns0 (floor (* ph1 32)))
  (def changed (abs (sign (- ns0 (read-history h_step)))))
  (def wrap (* changed (gte ns0 32)))
  (def ph (- ph1 wrap))
  (def ns (- ns0 (* 32 wrap)))
  (def disc (* changed nes_gain (gswitch (lt ns 16) 1 -1)
               (abs (sign ns)) (abs (sign (- ns 16)))))
  (def t_step (/ (- (* ph 32) ns) (* f 32)))
  (def t_bot (/ ph f))
  (def this_s (+ (read-history h_next)
                 (- (* top d_top (pl-this-integrated-blep t_top)))
                 (* disc (pl-this-blep t_step))
                 (* wrap d_top (pl-this-integrated-blep t_bot))))
  (def next_s (+ (- (* top d_top (pl-next-integrated-blep t_top)))
                 (* disc (pl-next-blep t_step))
                 (* wrap d_top (pl-next-integrated-blep t_bot))
                 (* nes_gain (gswitch (lt ns 16) ns (- 31 ns)))
                 (* tri_gain (gswitch (lt ph 0.5) (* 2 ph) (- 2 (* 2 ph))))))
  (write-history h_ph ph)
  (write-history h_step ns)
  (write-history h_desc (gswitch wrap 0 (max (read-history h_desc) top)))
  (write-history h_next next_s)
  (- (* this_s (/ 4 30)) 1))

; One pass of the Arpeggiator::Clock "while (!done)" loop.
(defmacro chip-arp-pass (note oct dir done n range updown)
  (def act (- 1 done))
  (def nout (* act (max (gte note n) (lt note 0))))
  (def oct1 (+ oct (* nout dir)))
  (def note1 (gswitch nout (gswitch (gt dir 0) 0 (- n 1)) note))
  (def oout (* act (max (gte oct1 range) (lt oct1 0))))
  (def oct2 (gswitch oout (gswitch (gt dir 0) 0 (- range 1)) oct1))
  (def flip (* oout updown))
  (def dir2 (gswitch flip (- dir) dir))
  (def note2 (gswitch flip (gswitch (gt dir2 0) 1 (- n 2)) note1))
  (def oct3 (gswitch flip (gswitch (gt dir2 0) 0 (- range 1)) oct2))
  (tuple note2 oct3 dir2 (- 1 (* act flip))))

; plaits ChordBank::ComputeChordInversion contribution of chord note i to
; voice v: (tuple ratio amplitude).
(defmacro chip-inv-term (i v chord integral frac nrot rnote)
  (def base (peek chip_ratios (+ (* chord 4) i) 0))
  (def tr (* 0.25 (pow 2 (floor (/ (- (+ 3 integral) i) 4)))))
  (def val (* base tr))
  (def tgt (% (+ (- i nrot) 5) 5))
  (def prv (% (+ tgt 4) 5))
  (def is_r (eq i rnote))
  (def is_lt (lt i rnote))
  (def is_gt (gt i rnote))
  (def at_t (eq tgt v))
  (def at_p (eq prv v))
  (tuple (+ (* at_t (+ is_r is_gt) val) (* at_p (+ (* is_r 2 val) (* is_lt val))))
         (+ (* at_t (+ (* is_r 0.25 (- 1 frac)) (* is_gt 0.25)))
            (* at_p (+ (* is_r 0.25 frac) (* is_lt 0.25))))))

(defmacro chip-inv-voice (v chord integral frac nrot rnote)
  (def (r0 a0) (chip-inv-term 0 v chord integral frac nrot rnote))
  (def (r1 a1) (chip-inv-term 1 v chord integral frac nrot rnote))
  (def (r2 a2) (chip-inv-term 2 v chord integral frac nrot rnote))
  (def (r3 a3) (chip-inv-term 3 v chord integral frac nrot rnote))
  (tuple (+ r0 r1 r2 r3) (+ a0 a1 a2 a3)))

(defmacro plaits-chip (bstart bphase rise high patched note timbre morph harmonics accent env_shape)
  (def nz (noise))   ; per-sample uniform draw (identical (noise) nodes merge)
  (make-history h_note)
  (make-history h_oct)
  (make-history h_down)     ; direction_ = 1 - 2 * down
  (make-history h_sorted)   ; chord index at the last Sort()
  (make-history h_env)      ; envelope_state_
  (make-history h_auxamt)   ; aux_envelope_amount_
  (def f0 (pl-note-to-freq note))
  (def shape (* morph 0.995))
  (def clocked patched)
  (def clk (* bstart rise clocked))
  ; chord / pattern quantizers
  (def chord (chip-hq (* harmonics 1.02) 11 0.075 (gswitch clocked clk bstart)))
  (def pattern (chip-hq timbre 12 0.075 clk))
  (def mode (floor (/ pattern 3)))
  (def range (pow 2 (- pattern (* 3 mode))))
  (def n (peek chip_counts chord 0))
  (def sorted_chord (gswitch clk chord (read-history h_sorted)))
  (write-history h_sorted sorted_chord)
  ; arpeggiator clock
  (def note_p (read-history h_note))
  (def oct_p (read-history h_oct))
  (def dir_p (- 1 (* 2 (read-history h_down))))
  (def trivial (* (eq n 1) (eq range 1)))
  (def is_random (eq mode 3))
  (def dir_s (gswitch (eq mode 0) 1 (gswitch (eq mode 1) -1 dir_p)))
  (def (na oa da done_a) (chip-arp-pass (+ note_p dir_s) oct_p dir_s 0 n range (eq mode 2)))
  (def (nb ob db done_b) (chip-arp-pass na oa da done_a n range (eq mode 2)))
  ; random: uniform over the other (octave, note) pairs
  (def combos (* range n))
  (def cur (+ (* oct_p n) note_p))
  (def cur_ok (* (lt note_p n) (lt oct_p range)))
  (def u_r (pl-noise-tap nz))
  (def k_ok (floor (* u_r (- combos 1))))
  (def idx (gswitch cur_ok (+ k_ok (gte k_ok cur)) (floor (* u_r combos))))
  (def oct_r (floor (/ idx n)))
  (def note_r (- idx (* oct_r n)))
  (def note_c (gswitch trivial 0 (gswitch is_random note_r nb)))
  (def oct_c (gswitch trivial 0 (gswitch is_random oct_r ob)))
  (def dir_c (gswitch (+ trivial is_random) dir_p db))
  (def arp_note (gswitch clk note_c note_p))
  (def arp_oct (gswitch clk oct_c oct_p))
  (write-history h_note arp_note)
  (write-history h_oct arp_oct)
  (write-history h_down (gswitch clk (lt dir_c 0) (read-history h_down)))
  (def octave (pow 2 arp_oct))
  (def note_f0 (* f0 (peek chip_sorted (+ (* sorted_chord 4) (clip arp_note 0 3)) 0) octave))
  ; chord inversion (unclocked)
  (def inversion (* timbre 20))
  (def integral (floor inversion))
  (def frac (- inversion integral))
  (def nrot (floor (/ integral 4)))
  (def rnote (- integral (* 4 nrot)))
  (def (ir0 ia0) (chip-inv-voice 0 chord integral frac nrot rnote))
  (def (ir1 ia1) (chip-inv-voice 1 chord integral frac nrot rnote))
  (def (ir2 ia2) (chip-inv-voice 2 chord integral frac nrot rnote))
  (def (ir3 ia3) (chip-inv-voice 3 chord integral frac nrot rnote))
  (def (ir4 ia4) (chip-inv-voice 4 chord integral frac nrot rnote))
  (def unclocked (- 1 clocked))
  (def v0 (chip-supersquare (gswitch clocked note_f0 (* f0 ir0)) shape bstart 1))
  (def v1 (chip-supersquare (* f0 ir1) shape bstart unclocked))
  (def v2 (chip-supersquare (* f0 ir2) shape bstart unclocked))
  (def v3 (chip-supersquare (* f0 ir3) shape bstart unclocked))
  (def v4 (chip-supersquare (* f0 ir4) shape bstart unclocked))
  (def chord_out (+ (* v0 ia0) (- (* v1 ia1)) (* v2 ia2) (- (* v3 ia3)) (* v4 ia4)))
  (def out0 (gswitch clocked v0 chord_out))
  (def aux0 (chip-nes-triangle (* f0 0.5 (gswitch clocked octave 1)) bstart))
  ; built-in envelope
  (def has_env (gt (abs (- env_shape 2)) 0.0001))
  (def es (abs env_shape))
  (def decay (- 1 (* (/ 2 48000) (pl-semi-ratio (* 60 es)) es)))
  (def amt_t (clip (* env_shape 20) 0 1))
  (def amt (gswitch has_env (+ (read-history h_auxamt) (* 0.01 (- amt_t (read-history h_auxamt))))
                    (read-history h_auxamt)))
  (write-history h_auxamt amt)
  (def env_p (gswitch clk 1 (read-history h_env)))
  (def env (gswitch has_env (* env_p decay) env_p))
  (write-history h_env env)
  (def out (gswitch has_env (* out0 env) out0))
  (def aux (gswitch has_env (* aux0 (+ 1 (* amt (- env 1)))) aux0))
  (tuple out aux))

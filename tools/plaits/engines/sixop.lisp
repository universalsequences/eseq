;; ======================================================================
;; Six-op FM engine (plaits/dsp/engine2/six_op_engine.cc + plaits/dsp/fm/*):
;; DX7 patches from syx_bank_0..2 (Plaits engines 2, 3, 4 = bank 0, 1, 2).
;; GENERATED by tools/gen_sixop.py -- edit the generator, not this file.
;;
;; (plaits-sixop bstart bphase rise high patched note timbre morph harmonics
;;               accent bank)  -> (tuple out aux), out == aux.
;; Extra arg `bank` (0..2, block-latched, may change at runtime): a change
;; unloads both voices like SixOpEngine::LoadUserData (silence until the next
;; trigger when patched).
;;
;; Structure (faithful to the C++):
;; - two fm::Voice<6> instances; a rising edge moves to the other voice and
;;   loads the HARMONICS-selected patch into it (the previous note rings on
;;   through its release).
;; - staggered rendering: each block one voice renders 24 samples (its
;;   control state -- envelopes, operator levels, frequencies -- is updated
;;   every 24 samples, voices alternate blocks). A voice whose patch was just
;;   loaded spends its next render on Setup() and outputs nothing (0.5 ms).
;;   Only one voice updates its control state per block, so the control path
;;   below is computed once for the rendering voice `rv` and committed to
;;   that voice's histories.
;; - routing is generic: per operator source (none / bus1 / bus2 / feedback),
;;   destination (out / bus1 / bus2) and additive flag read from the patch
;;   tensor, operators evaluated in DX7 order 6..1 every sample.
;; Patch tensor: row 0 = never-loaded LFO defaults, row 1 + bank*32 + patch.
;; ======================================================================
(def sx_patch (tensor @shape [97 202] @file "sixop_patches.json"))
(def sx_cube_root (tensor @shape [18 1] @file "sixop_cube_root.json"))

; fm::Pow2Fast<1>: 2^floor(x) * (1 + frac(x)).
(defmacro sx-p2f1 (x)
  (def e (floor x))
  (* (exp (* 0.69314718 e)) (+ 1 (- x e))))

; fm::Pow2Fast<2>.
(defmacro sx-p2f2 (x)
  (def e (floor x))
  (def f (- x e))
  (* (exp (* 0.69314718 e)) (+ 1 (* f (+ 0.6565 (* f 0.3435))))))

; Envelope::value() segment, operator envelopes (reshaped ascending segments).
(defmacro sx-seg-op (from to phase)
  (def asc (lt from to))
  (def f (gswitch asc (max 6.7 from) from))
  (def t (gswitch asc (max 6.7 to) to))
  (def p (gswitch asc (* phase (- 2.5 phase) 0.666667) phase))
  (+ (* p (- t f)) f))

(defmacro sx-seg-pitch (from to phase)
  (+ (* phase (- to from)) from))

; Envelope::value(stage, phase, start); start < -50 = PREVIOUS_LEVEL.
(defmacro sx-val-op (stage phase start l0 l1 l2 l3)
  (def from (gswitch (lt start -50) (selector (+ stage 1) l3 l0 l1 l2) start))
  (sx-seg-op from (selector (+ stage 1) l0 l1 l2 l3) phase))
(defmacro sx-val-pitch (stage phase start l0 l1 l2 l3)
  (def from (gswitch (lt start -50) (selector (+ stage 1) l3 l0 l1 l2) start))
  (sx-seg-pitch from (selector (+ stage 1) l0 l1 l2 l3) phase))

; Envelope::Render(gate, rate, ad_scale, release_scale) -> (stage phase start value).
(defmacro sx-env-op (st ph sv l0 l1 l2 l3 i0 i1 i2 i3 gate rate ad rr)
  (def is3 (eq st 3))
  (def trans (gswitch gate is3 (- 1 is3)))
  (def sv1 (gswitch trans (sx-val-op st ph sv l0 l1 l2 l3) sv))
  (def st1 (gswitch trans (gswitch gate 0 3) st))
  (def ph1 (gswitch trans 0 ph))
  (def ph2 (+ ph1 (* (selector (+ st1 1) i0 i1 i2 i3) rate (gswitch (eq st1 3) rr ad))))
  (def over (gte ph2 1))
  (def ph3 (gswitch over (gte st1 2) ph2))
  (def st3 (+ st1 (* over (lt st1 2))))
  (def sv3 (gswitch over -100 sv1))
  (tuple st3 ph3 sv3 (sx-val-op st3 ph3 sv3 l0 l1 l2 l3)))
(defmacro sx-env-pitch (st ph sv l0 l1 l2 l3 i0 i1 i2 i3 gate rate ad rr)
  (def is3 (eq st 3))
  (def trans (gswitch gate is3 (- 1 is3)))
  (def sv1 (gswitch trans (sx-val-pitch st ph sv l0 l1 l2 l3) sv))
  (def st1 (gswitch trans (gswitch gate 0 3) st))
  (def ph1 (gswitch trans 0 ph))
  (def ph2 (+ ph1 (* (selector (+ st1 1) i0 i1 i2 i3) rate (gswitch (eq st1 3) rr ad))))
  (def over (gte ph2 1))
  (def ph3 (gswitch over (gte st1 2) ph2))
  (def st3 (+ st1 (* over (lt st1 2))))
  (def sv3 (gswitch over -100 sv1))
  (tuple st3 ph3 sv3 (sx-val-pitch st3 ph3 sv3 l0 l1 l2 l3)))

; Envelope::RenderAtSample(t, gate_duration) for 0 <= t <= gate_duration
; (always the case: t = gate_duration * morph).
(defmacro sx-ras-op (t l0 l1 l2 l3 i0 i1 i2 d0 d1 d2)
  (def t1 (- t d0))
  (def t2 (- t1 d1))
  (gswitch (lt t d0) (sx-seg-op l3 l0 (* t i0))
    (gswitch (lt t1 d1) (sx-seg-op l0 l1 (* t1 i1))
      (gswitch (lt (- t2 d2) 0) (sx-seg-op l1 l2 (* t2 i2)) l2))))
(defmacro sx-ras-pitch (t l0 l1 l2 l3 i0 i1 i2 d0 d1 d2)
  (def t1 (- t d0))
  (def t2 (- t1 d1))
  (gswitch (lt t d0) (sx-seg-pitch l3 l0 (* t i0))
    (gswitch (lt t1 d1) (sx-seg-pitch l0 l1 (* t1 i1))
      (gswitch (lt (- t2 d2) 0) (sx-seg-pitch l1 l2 (* t2 i2)) l2))))

; Unsigned bit field of a packed integer c: floor(c / 2^shift) mod m
; (inv = 2^-shift, m a power of 2; exact in float32).
(defmacro sx-fld (c inv m)
  (def q (floor (* c inv)))
  (- q (* m (floor (/ q m)))))

; fm::KeyboardScaling.
(defmacro sx-kbs (note bp ld rd lc rc)
  (def x (- note bp 15))
  (def pos (gt x 0))
  (def curve (gswitch pos rc lc))
  (def t (abs x))
  (def tc (min (* t 0.010467) 1))
  (def t2 (gswitch (* (gte curve 1) (lte curve 2)) (* tc tc tc 96) t))
  (* (gswitch (lt curve 2) (- 0 t2) t2) (gswitch pos rd ld) 0.02677))

; fm::NormalizeVelocity.
(defmacro sx-norm-vel (v)
  (def x (* (clip v 0 1) 16))
  (def i (floor x))
  (def a (peek sx_cube_root i 0))
  (def b (peek sx_cube_root (+ i 1) 0))
  (* 16 (- (+ a (* (- b a) (- x i))) 0.918)))

; fm::Lfo::value().
(defmacro sx-lfo-val (ph rnd wave)
  (selector (+ wave 1)
    (* 2 (gswitch (lt ph 0.5) (- 0.5 ph) (- ph 0.5)))
    (- 1 ph)
    ph
    (gte ph 0.5)
    (- 0.5 (* 0.5 (sin (* twopi ph))))
    rnd))

; fm::Lfo::Step(12) -> (phase delay_phase random value).
(defmacro sx-lfo-step (ph dp rnd row u)
  (def ph1 (+ ph (* 12 (peek sx_patch row 3))))
  (def wr (gte ph1 1))
  (def ph2 (- ph1 wr))
  (def rnd2 (gswitch wr u rnd))
  (def dp2 (min 1 (+ dp (* 12 (gswitch (lt dp 0.5) (peek sx_patch row 4) (peek sx_patch row 5))))))
  (tuple ph2 dp2 rnd2 (sx-lfo-val ph2 rnd2 (peek sx_patch row 6))))

; a0 * 0.25 * SemitonesToRatioSafe(semi) in cycles/sample (no clamping: the
; pitch envelope / LFO can push far beyond the pl-note-to-freq range).
(defmacro sx-semi-freq (semi)
  (def k (- (max 0 (ceil (/ (- semi 120) 120))) (max 0 (ceil (/ (- -120 semi) 120)))))
  (* (/ 13.75 samplerate) pl_ref_tune (exp (* 6.93147181 k)) (pl-semi-ratio (- semi (* 120 k)))))

(defmacro sx-lfo-ramp (dp)
  (gswitch (lt dp 0.5) 0 (* (- dp 0.5) 2)))

(defmacro plaits-sixop (bstart bphase rise high patched note timbre morph harmonics accent bank)
  ; ---- SixOpEngine::Render block logic (committed on bstart) ----
  (def sx_u (noise))  ; S&H LFO draws (stmlib::Random in the C++)
  (make-history h_rv)
  (def rv_o (read-history h_rv))
  (def rv (gswitch bstart (- 1 rv_o) rv_o))
  ; HysteresisQuantizer2(32, 0.005, false) on harmonics * 1.02
  (make-history h_q)
  (def q_o (read-history h_q))
  (def q_v (- (* harmonics 1.02 32) 0.5))
  (def q (gswitch bstart (clip (floor (+ q_v (gswitch (gt q_v q_o) -0.005 0.005) 0.5)) 0 31) q_o))
  (make-history h_bk)
  (def bk_o (read-history h_bk))
  (def bk_in (clip (floor (+ bank 0.5)) 0 2))
  (def bchg (* bstart (- 1 (eq bk_in bk_o))))
  (def bk (gswitch bstart bk_in bk_o))
  (def key (+ 1 (* bk 32) q))
  (def unp (- 1 patched))
  (make-history h_act)
  (def act_o (+ (read-history h_act) 1))
  (def act_p (gswitch rise (- 1 act_o) act_o))
  (def act (gswitch bstart (gswitch patched act_p act_o) act_o))
  (make-history h_ld0)
  (def ld0_o (read-history h_ld0))
  (make-history h_row0)
  (def row0_o (read-history h_row0))
  (make-history h_dl0)
  (def dl0_o (read-history h_dl0))
  (make-history h_nt0)
  (def nt0_o (+ (read-history h_nt0) 48))
  (make-history h_vl0)
  (def vl0_o (+ (read-history h_vl0) 0.5))
  (make-history h_ec0)
  (def ec0_o (+ (read-history h_ec0) 0.5))
  (make-history h_lph0)
  (def lph0_o (read-history h_lph0))
  (make-history h_ldp0)
  (def ldp0_o (read-history h_ldp0))
  (make-history h_lrn0)
  (def lrn0_o (read-history h_lrn0))
  (make-history h_lvl0)
  (def lvl0_o (read-history h_lvl0))
  (make-history h_ld1)
  (def ld1_o (read-history h_ld1))
  (make-history h_row1)
  (def row1_o (read-history h_row1))
  (make-history h_dl1)
  (def dl1_o (read-history h_dl1))
  (make-history h_nt1)
  (def nt1_o (+ (read-history h_nt1) 48))
  (make-history h_vl1)
  (def vl1_o (+ (read-history h_vl1) 0.5))
  (make-history h_ec1)
  (def ec1_o (+ (read-history h_ec1) 0.5))
  (make-history h_lph1)
  (def lph1_o (read-history h_lph1))
  (make-history h_ldp1)
  (def ldp1_o (read-history h_ldp1))
  (make-history h_lrn1)
  (def lrn1_o (read-history h_lrn1))
  (make-history h_lvl1)
  (def lvl1_o (read-history h_lvl1))
  (make-history h_lpi0)
  (def lpi0_o (read-history h_lpi0))
  (def ld0a (* ld0_o (- 1 bchg)))
  (def same0 (* ld0a (eq row0_o key)))
  (def load0 (* rise (eq act_p 0)))
  (def ldp_0 (gswitch patched (max ld0a load0) 1))
  (def rowp_0 (gswitch patched (gswitch load0 key row0_o) key))
  (def dlp_0 (max dl0_o (* (gswitch patched load0 1) (- 1 same0))))
  (def ld0 (gswitch bstart ldp_0 ld0_o))
  (def row0 (gswitch bstart rowp_0 row0_o))
  (def dll0 (gswitch bstart dlp_0 dl0_o))
  (def setp0 (* bstart (max unp (eq act 0))))
  (def nt0 (gswitch setp0 note nt0_o))
  (def vl0 (gswitch setp0 accent vl0_o))
  (def ec0 (gswitch setp0 morph ec0_o))
  (def ld1a (* ld1_o (- 1 bchg)))
  (def same1 (* ld1a (eq row1_o key)))
  (def load1 (* rise (eq act_p 1)))
  (def ldp_1 (gswitch patched (max ld1a load1) 1))
  (def rowp_1 (gswitch patched (gswitch load1 key row1_o) key))
  (def dlp_1 (max dl1_o (* (gswitch patched load1 1) (- 1 same1))))
  (def ld1 (gswitch bstart ldp_1 ld1_o))
  (def row1 (gswitch bstart rowp_1 row1_o))
  (def dll1 (gswitch bstart dlp_1 dl1_o))
  (def setp1 (* bstart (max unp (eq act 1))))
  (def nt1 (gswitch setp1 note nt1_o))
  (def vl1 (gswitch setp1 accent vl1_o))
  (def ec1 (gswitch setp1 morph ec1_o))
  ; LFOs. Patched: active voice resets on rise and steps; the other steps
  ; only when its patch differs. Unpatched: voice 0 LFO is scrubbed by MORPH.
  (def ld_a (gswitch act ld1 ld0))
  (def row_a (gswitch act row1 row0))
  (def samep0 (* (eq ld0 ld_a) (max (- 1 ld0) (eq row0 row_a))))
  (def stp0 (max (eq act 0) (- 1 samep0)))
  (def rsl0 (* load0 (peek sx_patch row0 7)))
  (def lph0r (gswitch rsl0 0 lph0_o))
  (def ldp0r (gswitch load0 0 ldp0_o))
  (def (lph0s ldp0s lrn0s lvl0s) (sx-lfo-step lph0r ldp0r lrn0_o row0 sx_u))
  (def lph0p (gswitch stp0 lph0s lph0r))
  (def ldp0p (gswitch stp0 ldp0s ldp0r))
  (def lrn0p (gswitch stp0 lrn0s lrn0_o))
  (def lvl0p (gswitch stp0 lvl0s lvl0_o))
  (def samep1 (* (eq ld1 ld_a) (max (- 1 ld1) (eq row1 row_a))))
  (def stp1 (max (eq act 1) (- 1 samep1)))
  (def rsl1 (* load1 (peek sx_patch row1 7)))
  (def lph1r (gswitch rsl1 0 lph1_o))
  (def ldp1r (gswitch load1 0 ldp1_o))
  (def (lph1s ldp1s lrn1s lvl1s) (sx-lfo-step lph1r ldp1r lrn1_o row1 (pl-noise-tap sx_u)))
  (def lph1p (gswitch stp1 lph1s lph1r))
  (def ldp1p (gswitch stp1 ldp1s ldp1r))
  (def lrn1p (gswitch stp1 lrn1s lrn1_o))
  (def lvl1p (gswitch stp1 lvl1s lvl1_o))
  ; Lfo::Scrub(2 * kCorrectedSampleRate * morph) with the pre-load patch
  (def scs (* 2 47872.34 morph))
  (def scph (* scs (peek sx_patch row0_o 3)))
  (def scpi (floor scph))
  (def scfr (- scph scpi))
  (def scnew (- 1 (eq scpi lpi0_o)))
  (def scrn (gswitch scnew sx_u lrn0_o))
  (def scdi0 (peek sx_patch row0_o 4))
  (def scdp0 (* scs scdi0))
  (def scdp (gswitch (gt scdp0 0.5) (min 1 (+ 0.5 (* (- scs (/ 0.5 (max scdi0 0.000000001))) (peek sx_patch row0_o 5)))) scdp0))
  (def scvl (sx-lfo-val scfr scrn (peek sx_patch row0_o 6)))
  (def sp0 (* bstart unp))
  (def lpi0 (gswitch sp0 scpi lpi0_o))
  (def lph0 (gswitch bstart (gswitch patched lph0p scfr) lph0_o))
  (def ldp0 (gswitch bstart (gswitch patched ldp0p scdp) ldp0_o))
  (def lrn0 (gswitch bstart (gswitch patched lrn0p scrn) lrn0_o))
  (def lvl0 (gswitch bstart (gswitch patched lvl0p scvl) lvl0_o))
  (def lph1 (gswitch bstart (gswitch patched lph1p lph1_o) lph1_o))
  (def ldp1 (gswitch bstart (gswitch patched ldp1p ldp1_o) ldp1_o))
  (def lrn1 (gswitch bstart (gswitch patched lrn1p lrn1_o) lrn1_o))
  (def lvl1 (gswitch bstart (gswitch patched lvl1p lvl1_o) lvl1_o))
  ; ---- control path for the rendering voice s = rv ----
  (def ld_s (gswitch rv ld1 ld0))
  (def dl_s (gswitch rv dll1 dll0))
  (def row_s (gswitch rv row1 row0))
  (def full (* ld_s (- 1 dl_s)))
  (def rs0 (* bstart (eq rv 0)))
  (def rs1 (* bstart (eq rv 1)))
  (def dl0 (* dll0 (- 1 (* rs0 ld0))))
  (def dl1 (* dll1 (- 1 (* rs1 ld1))))
  (def gate_s (* patched high (eq act rv)))
  (def sus_s (* unp (eq rv 0)))
  (def note_s (gswitch rv nt1 nt0))
  (def vel_s (gswitch rv vl1 vl0))
  (def ec_s (gswitch rv ec1 ec0))
  ; set_modulations: source LFO
  (def msrc (gswitch patched (gswitch (gswitch rv samep1 samep0) act rv) 0))
  (def m_val (gswitch msrc lvl1 lvl0))
  (def m_ramp (sx-lfo-ramp (gswitch msrc ldp1 ldp0)))
  (def m_row (gswitch msrc row1 row0))
  (def pm_s (* (- m_val 0.5) m_ramp (peek sx_patch m_row 9)))
  (def am_s (* (- 1 m_val) m_ramp (peek sx_patch m_row 8)))
  ; voice-internal state
  (make-history h_gi0)
  (def gi0_o (read-history h_gi0))
  (make-history h_ni0)
  (def ni0_o (+ (read-history h_ni0) 48))
  (make-history h_nv0)
  (def nv0_o (+ (read-history h_nv0) 10))
  (make-history h_pst0)
  (def pst0_o (+ (read-history h_pst0) 3))
  (make-history h_pph0)
  (def pph0_o (+ (read-history h_pph0) 1))
  (make-history h_psv0)
  (def psv0_o (read-history h_psv0))
  (make-history h_o0st0)
  (def o0st0_o (+ (read-history h_o0st0) 3))
  (make-history h_o0ph0)
  (def o0ph0_o (+ (read-history h_o0ph0) 1))
  (make-history h_o0sv0)
  (def o0sv0_o (read-history h_o0sv0))
  (make-history h_T0v0)
  (def T0v0_o (read-history h_T0v0))
  (make-history h_o1st0)
  (def o1st0_o (+ (read-history h_o1st0) 3))
  (make-history h_o1ph0)
  (def o1ph0_o (+ (read-history h_o1ph0) 1))
  (make-history h_o1sv0)
  (def o1sv0_o (read-history h_o1sv0))
  (make-history h_T1v0)
  (def T1v0_o (read-history h_T1v0))
  (make-history h_o2st0)
  (def o2st0_o (+ (read-history h_o2st0) 3))
  (make-history h_o2ph0)
  (def o2ph0_o (+ (read-history h_o2ph0) 1))
  (make-history h_o2sv0)
  (def o2sv0_o (read-history h_o2sv0))
  (make-history h_T2v0)
  (def T2v0_o (read-history h_T2v0))
  (make-history h_o3st0)
  (def o3st0_o (+ (read-history h_o3st0) 3))
  (make-history h_o3ph0)
  (def o3ph0_o (+ (read-history h_o3ph0) 1))
  (make-history h_o3sv0)
  (def o3sv0_o (read-history h_o3sv0))
  (make-history h_T3v0)
  (def T3v0_o (read-history h_T3v0))
  (make-history h_o4st0)
  (def o4st0_o (+ (read-history h_o4st0) 3))
  (make-history h_o4ph0)
  (def o4ph0_o (+ (read-history h_o4ph0) 1))
  (make-history h_o4sv0)
  (def o4sv0_o (read-history h_o4sv0))
  (make-history h_T4v0)
  (def T4v0_o (read-history h_T4v0))
  (make-history h_o5st0)
  (def o5st0_o (+ (read-history h_o5st0) 3))
  (make-history h_o5ph0)
  (def o5ph0_o (+ (read-history h_o5ph0) 1))
  (make-history h_o5sv0)
  (def o5sv0_o (read-history h_o5sv0))
  (make-history h_T5v0)
  (def T5v0_o (read-history h_T5v0))
  (make-history h_gi1)
  (def gi1_o (read-history h_gi1))
  (make-history h_ni1)
  (def ni1_o (+ (read-history h_ni1) 48))
  (make-history h_nv1)
  (def nv1_o (+ (read-history h_nv1) 10))
  (make-history h_pst1)
  (def pst1_o (+ (read-history h_pst1) 3))
  (make-history h_pph1)
  (def pph1_o (+ (read-history h_pph1) 1))
  (make-history h_psv1)
  (def psv1_o (read-history h_psv1))
  (make-history h_o0st1)
  (def o0st1_o (+ (read-history h_o0st1) 3))
  (make-history h_o0ph1)
  (def o0ph1_o (+ (read-history h_o0ph1) 1))
  (make-history h_o0sv1)
  (def o0sv1_o (read-history h_o0sv1))
  (make-history h_T0v1)
  (def T0v1_o (read-history h_T0v1))
  (make-history h_o1st1)
  (def o1st1_o (+ (read-history h_o1st1) 3))
  (make-history h_o1ph1)
  (def o1ph1_o (+ (read-history h_o1ph1) 1))
  (make-history h_o1sv1)
  (def o1sv1_o (read-history h_o1sv1))
  (make-history h_T1v1)
  (def T1v1_o (read-history h_T1v1))
  (make-history h_o2st1)
  (def o2st1_o (+ (read-history h_o2st1) 3))
  (make-history h_o2ph1)
  (def o2ph1_o (+ (read-history h_o2ph1) 1))
  (make-history h_o2sv1)
  (def o2sv1_o (read-history h_o2sv1))
  (make-history h_T2v1)
  (def T2v1_o (read-history h_T2v1))
  (make-history h_o3st1)
  (def o3st1_o (+ (read-history h_o3st1) 3))
  (make-history h_o3ph1)
  (def o3ph1_o (+ (read-history h_o3ph1) 1))
  (make-history h_o3sv1)
  (def o3sv1_o (read-history h_o3sv1))
  (make-history h_T3v1)
  (def T3v1_o (read-history h_T3v1))
  (make-history h_o4st1)
  (def o4st1_o (+ (read-history h_o4st1) 3))
  (make-history h_o4ph1)
  (def o4ph1_o (+ (read-history h_o4ph1) 1))
  (make-history h_o4sv1)
  (def o4sv1_o (read-history h_o4sv1))
  (make-history h_T4v1)
  (def T4v1_o (read-history h_T4v1))
  (make-history h_o5st1)
  (def o5st1_o (+ (read-history h_o5st1) 3))
  (make-history h_o5ph1)

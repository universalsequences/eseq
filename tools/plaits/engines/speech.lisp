; ======================================================================
; Speech engine (plaits/dsp/engine/speech_engine.cc): HARMONICS blends
; NaiveSpeechSynth (formant filters) -> SAMSpeechSynth -> LPCSpeechSynth
; vowels over the first third, then selects one of 5 LPC10 word banks
; (TI ROM words) for the remaining two thirds.
;   (plaits-speech ... accent prosody speed) -> (tuple out aux enveloped)
; `enveloped` is 1 when the C++ sets *already_enveloped (word bank selected
; and trigger patched).
; ======================================================================
(def speech_naive_tbl (tensor @shape [250 1] @file "speech_naive.json"))
(def speech_sam_tbl (tensor @shape [108 1] @file "speech_sam.json"))
(def speech_frames (tensor @shape [2527 12] @file "speech_frames.json"))
(def speech_words (tensor @shape [97 1] @file "speech_words.json"))
(def speech_pulse (tensor @shape [640 1] @file "lut_lpc_excitation_pulse.json"))

; Per-block size_t countdown: reloads to `n` when `set` (block-latched),
; then subtracts min(c, 12) at the block start. Returns the counter after
; the decrement.
(defmacro speech-countdown (bstart set n)
  (make-history h)
  (def c0 (gswitch set n (read-history h)))
  (def c (gswitch bstart (- c0 (min c0 12)) (read-history h)))
  (write-history h c)
  c)

; Value latched whenever `cond` is 1 (history starts at `init`).
(defmacro speech-latch (x cond init)
  (make-history h)
  (def v (gswitch cond x (+ (read-history h) init)))
  (write-history h (- v init))
  v)

; ----------------------------------------------------------------------
; NaiveSpeechSynth
; ----------------------------------------------------------------------

; Oscillator::Render<OSCILLATOR_SHAPE_IMPULSE_TRAIN> (phase_ starts at 0.5,
; lp_state_ at 1, frequency_ at 0.001).
(defmacro speech-impulse (freq bstart bphase)
  (def f (pl-interp (clip freq 0.000001 0.25) bstart bphase 0.001))
  (make-history h_ph)
  (make-history h_ns)
  (make-history h_lp)
  (make-history h_hp)
  (def pa (+ (read-history h_ph) 0.5 f))
  (def w (gte pa 1))
  (def p1 (- pa w))
  (def tt (/ p1 f))
  (def this (- (read-history h_ns) (* w (pl-this-blep tt))))
  (def nxt (- p1 (* w (pl-next-blep tt))))
  (def lp0 (+ (read-history h_lp) 1))
  (def lp (+ lp0 (* 0.25 (- (- (read-history h_hp) this) lp0))))
  (write-history h_ph (- p1 0.5))
  (write-history h_ns nxt)
  (write-history h_lp (- lp 1))
  (write-history h_hp this)
  (* 4 lp))

; One formant band-pass (index i) driven by `exc`; returns a * bp.
(defmacro speech-naive-formant (exc i p_i r_i p_f r_f click a0f)
  (def k00 (* 2 (+ (* (+ (* p_i 5) r_i) 5) i)))
  (def k01 (+ k00 10))
  (def k10 (+ k00 50))
  (def k11 (+ k00 60))
  (def f0r (+ (peek speech_naive_tbl k00 0) (* (- (peek speech_naive_tbl k01 0) (peek speech_naive_tbl k00 0)) r_f)))
  (def f1r (+ (peek speech_naive_tbl k10 0) (* (- (peek speech_naive_tbl k11 0) (peek speech_naive_tbl k10 0)) r_f)))
  (def a0r (+ (peek speech_naive_tbl (+ k00 1) 0) (* (- (peek speech_naive_tbl (+ k01 1) 0) (peek speech_naive_tbl (+ k00 1) 0)) r_f)))
  (def a1r (+ (peek speech_naive_tbl (+ k10 1) 0) (* (- (peek speech_naive_tbl (+ k11 1) 0) (peek speech_naive_tbl (+ k10 1) 0)) r_f)))
  (def fs (min (+ f0r (* (- f1r f0r) p_f)) 160))
  (def amp (/ (+ a0r (* (- a1r a0r) p_f)) 256))
  (def fc (* a0f (pl-semi-ratio (- fs 33)) (- 1 (* 0.5 click (eq i 0)))))
  (def (lp bp hp) (pl-svf exc (pl-tan-dirty fc) 0.05))
  (* amp bp))

; Returns (excitation output).
(defmacro speech-naive (bstart bphase click f0 phoneme reg)
  (def cd (speech-countdown bstart click 2400))
  (def ca (gt cd 0))
  (def freq (* f0 (- 1 (* 0.5 ca))))
  (def (clp cbp chp) (pl-svf (speech-impulse freq bstart bphase)
                              (pl-tan-dirty (/ 800 samplerate)) 2))
  (def exc (* 4 cbp))
  (def p (* phoneme 3.999))
  (def r (* reg 3.999))
  (def p_i (floor p))
  (def r_i (floor r))
  (def p_f (- p p_i))
  (def r_f (- r r_i))
  (def a0f (* (/ 55 samplerate) pl_ref_tune))
  (tuple exc
         (+ (speech-naive-formant exc 0 p_i r_i p_f r_f ca a0f)
            (speech-naive-formant exc 1 p_i r_i p_f r_f ca a0f)
            (speech-naive-formant exc 2 p_i r_i p_f r_f ca a0f)
            (speech-naive-formant exc 3 p_i r_i p_f r_f ca a0f)
            (speech-naive-formant exc 4 p_i r_i p_f r_f ca a0f))))

; ----------------------------------------------------------------------
; SAMSpeechSynth
; ----------------------------------------------------------------------

; Formant i of the phoneme interpolation: (frequency in cycles/sample, amp).
(defmacro speech-sam-formant (p_i p_f i fsh)
  (def k1 (* 2 (+ (* p_i 3) i)))
  (def k2 (+ k1 6))
  (def f1 (peek speech_sam_tbl k1 0))
  (def a1 (peek speech_sam_tbl (+ k1 1) 0))
  (tuple (* (+ f1 (* (- (peek speech_sam_tbl k2 0) f1) p_f)) fsh)
         (+ a1 (* (- (peek speech_sam_tbl (+ k2 1) 0) a1) p_f))))

; SineRaw: 512-entry lookup without interpolation.
(defmacro speech-sine-raw (phase)
  (sin (* twopi (/ (floor (* phase 512)) 512))))

; One formant phase: reset to tt * ff on a pulse wrap, else accumulate.
(defmacro speech-sam-phase (w tt ff)
  (make-history h)
  (def v (gswitch w (pl-wrap (* tt ff)) (pl-wrap (+ (read-history h) ff))))
  (write-history h v)
  v)

; Returns (excitation output).
(defmacro speech-sam (bstart bphase cons f0 vowel fshift)
  (def freq (min f0 0.0625))
  (def r (floor (* (+ vowel (* 3 freq) (* 7 fshift)) 8)))
  (def ci (speech-latch (% r 8) (* bstart cons) 0))
  (def cs (speech-countdown bstart cons 2400))
  (def ph (gswitch (gt cs 0) (+ ci 9) (* vowel 7.9999)))
  (def p_i (floor ph))
  (def p_f (- ph p_i))
  (def fsh (/ (* 8 (+ 1 (* fshift 2.5))) samplerate))
  (def (ff0 fa0) (speech-sam-formant p_i p_f 0 fsh))
  (def (ff1 fa1) (speech-sam-formant p_i p_f 1 fsh))
  (def (ff2 fa2) (speech-sam-formant p_i p_f 2 fsh))
  (def f (pl-interp freq bstart bphase 0))
  (make-history h_ph)
  (make-history h_ns)
  (make-history h_lp)
  (def pa (+ (read-history h_ph) f))
  (def w (gte pa 1))
  (def p1 (- pa w))
  (def tt (/ p1 (max f 0.000000001)))
  (def fp0 (speech-sam-phase w tt ff0))
  (def fp1 (speech-sam-phase w tt ff1))
  (def fp2 (speech-sam-phase w tt ff2))
  (def this (- (read-history h_ns) (* w (pl-this-blep tt))))
  (def nxt (- p1 (* w (pl-next-blep tt))))
  (def d (- this 0.5 (read-history h_lp)))
  (write-history h_lp (+ (read-history h_lp) (* (min (* 16 f) 1) d)))
  (write-history h_ph p1)
  (write-history h_ns nxt)
  (def s (+ (* (speech-sine-raw fp0) fa0) (* (speech-sine-raw fp1) fa1) (* (speech-sine-raw fp2) fa2)))
  (tuple d (* s (- 1 p1))))

; ----------------------------------------------------------------------
; LPCSpeechSynthController + LPCSpeechSynth
; ----------------------------------------------------------------------

; Frame column c of row `row` blended toward row+1.
(defmacro speech-fcol (row c blend)
  (def a (peek speech_frames row c))
  (+ a (* (- (peek speech_frames (+ row 1) c) a) blend)))

; Lattice stage: e_out = e_in - k * s.
(defmacro speech-lat-state (x upd)
  (make-history h)
  (def v (read-history h))
  (write-history h (gswitch upd x v))
  v)

; Returns (excitation output enveloped).
(defmacro speech-lpc (bstart bphase rise patched act wmode group f0 address fshift accent prosody speed)
  (def latch (* bstart act))
  ; --- word bank quantizer (HysteresisQuantizer2, 6 steps, 0.1, asym) ---
  (make-history h_q)
  (def qprev (read-history h_q))
  (def qv (- (* (- group 2) 0.275 6) 0.5))
  (def qsgn (gswitch (gt qv qprev) -1 1))
  (def qn (clip (pl-trunc (+ qv (* qsgn 0.1) 0.5)) 0 5))
  (def q (gswitch (* bstart wmode) qn qprev))
  (write-history h_q q)
  (def bank (gswitch wmode (- q 1) -1))
  (def bsel (+ bank 2))
  (def base (selector bsel 0 15 244 473 997 1601))
  (def nf (selector bsel 5 229 229 524 604 926))
  (def nw (selector bsel 0 7 11 26 26 22))
  (def wbo (selector bsel 0 0 8 20 47 74))
  ; --- controller state (stored offset so that it starts at -1) ---
  (make-history h_lb)
  (make-history h_pf)
  (make-history h_lpf)
  (make-history h_rem)
  (def lb (- (read-history h_lb) 1))
  (def pf0 (- (read-history h_pf) 1))
  (def lpf0 (- (read-history h_lpf) 1))
  (def rem0 (read-history h_rem))
  (def load (* (gte bank 0) (- 1 (eq bank lb))))
  (def lb1 (gswitch load bank lb))
  (def pf_a (gswitch load -1 pf0))
  (def lpf_a (gswitch load -1 lpf0))
  ; trigger
  (def trig (* rise act))
  (def rr (floor (* (+ address (* 3 fshift) (* 7 f0)) 8)))
  (def pf_c (+ (% rr 10) 5))
  (def word (min (floor (* address nw)) (- nw 1)))
  (def ws (peek speech_words (+ wbo word) 0))
  (def we (- (peek speech_words (+ wbo word 1) 0) 1))
  (def isw (gte bank 0))
  (def pf_b (gswitch trig (gswitch isw ws pf_c) pf_a))
  (def lpf_b (gswitch trig (gswitch isw we (+ pf_c 1)) lpf_a))
  (def rem_b (gswitch trig 0 rem0))
  ; scan / play
  (def rem_z (eq rem_b 0))
  (def scan (* (eq pf_b -1) rem_z))
  (def play (* (- 1 scan) rem_z))
  (def rate_ratio (pl-semi-ratio (* (- fshift 0.5) 36)))
  (def tstretch (pl-semi-ratio (+ (* speed -24)
                                  (gswitch (lt fshift 0.4) (* (- fshift 0.4) -45)
                                           (gswitch (gt fshift 0.6) (* (- fshift 0.6) -45) 0)))))
  (def sidx (* address (- nf 1.0001)))
  (def s_i (floor sidx))
  (def frow (+ base (gswitch scan s_i pf_b)))
  (def fblend (* scan (- sidx s_i)))
  (def rem_c (gswitch play (floor (* 1200 tstretch)) rem_b))
  (def pf_c2 (+ pf_b play))
  (def done (* play (gte pf_c2 lpf_b)))
  (def back (max (- 1 isw) (- 1 patched)))
  (def pf_d (gswitch done (gswitch back -1 lpf_b) pf_c2))
  (def rem_d (- rem_c (min 12 rem_c)))
  (write-history h_lb (+ (gswitch latch lb1 lb) 1))
  (write-history h_pf (+ (gswitch latch pf_d pf0) 1))
  (write-history h_lpf (+ (gswitch latch lpf_b lpf0) 1))
  (write-history h_rem (gswitch latch rem_d rem0))
  ; --- PlayFrame ---
  (def pfr (* latch (max scan play)))
  (def per1 (peek speech_frames frow 1))
  (def per2 (peek speech_frames (+ frow 1) 1))
  (def en1 (peek speech_frames frow 0))
  (def en2 (peek speech_frames (+ frow 1) 0))
  (make-history h_fq)
  (def fq_prev (+ (read-history h_fq) 0.0125))
  (def fr1 (gswitch (eq per1 0) fq_prev (/ 1 (max per1 1))))
  (def fr2 (gswitch (eq per2 0) fq_prev (/ 1 (max per2 1))))
  (def fq (gswitch pfr (+ fr1 (* (- fr2 fr1) fblend)) fq_prev))
  (write-history h_fq (- fq 0.0125))
  (def ne1 (* (eq per1 0) en1))
  (def ne2 (* (eq per2 0) en2))
  (def pe1 (* (- 1 (eq per1 0)) en1))
  (def pe2 (* (- 1 (eq per2 0)) en2))
  (def ne (speech-latch (+ ne1 (* (- ne2 ne1) fblend)) pfr 0))
  (def pe (speech-latch (+ pe1 (* (- pe2 pe1) fblend)) pfr 0))
  (def k0 (speech-latch (speech-fcol frow 2 fblend) pfr 0))
  (def k1 (speech-latch (speech-fcol frow 3 fblend) pfr 0))
  (def k2 (speech-latch (speech-fcol frow 4 fblend) pfr 0))
  (def k3 (speech-latch (speech-fcol frow 5 fblend) pfr 0))
  (def k4 (speech-latch (speech-fcol frow 6 fblend) pfr 0))
  (def k5 (speech-latch (speech-fcol frow 7 fblend) pfr 0))
  (def k6 (speech-latch (speech-fcol frow 8 fblend) pfr 0))
  (def k7 (speech-latch (speech-fcol frow 9 fblend) pfr 0))
  (def k8 (speech-latch (speech-fcol frow 10 fblend) pfr 0))
  (def k9 (speech-latch (speech-fcol frow 11 fblend) pfr 0))
  ; --- 8 kHz-ish clock driving one LPCSpeechSynth::Render(1) per tick ---
  (def rate (* act (/ (* rate_ratio 8000) samplerate)))
  (def pshift (/ (* f0 samplerate) (* rate_ratio 100 pl_ref_tune)))
  (make-history h_clk)
  (def ca (+ (read-history h_clk) rate))
  (def tick (gte ca 1))
  (def c1 (- ca tick))
  (write-history h_clk c1)
  (def crt (/ c1 (max rate 0.000000001)))
  ; synth step (state writes gated by tick)
  (def sf (clip (* (+ 0.0125 (* (- fq 0.0125) prosody)) pshift) 0 0.5))
  (make-history h_sph)
  (make-history h_sns)
  (make-history h_idx)
  (def spa (+ (read-history h_sph) sf))
  (def sw (gte spa 1))
  (def sp1 (- spa sw))
  (def srt (/ sp1 (max sf 0.000000001)))
  (def rs (floor (* 32 srt)))
  (def idx0 (read-history h_idx))
  (def inr (* sw (lt idx0 640)))
  (def idx1 (gswitch inr (- idx0 rs) idx0))
  (def disc (* inr (/ (peek speech_pulse (clip idx1 0 639) 0) 128) pe))
  (def sthis (- (read-history h_sns) (* disc (pl-this-blep srt))))
  (def idx2 (gswitch sw rs idx1))
  (def inr2 (lt idx2 640))
  (def snext (+ (- (* disc (pl-next-blep srt)))
                (* inr2 (/ (peek speech_pulse (clip idx2 0 639) 0) 128) pe)))
  (def idx3 (+ idx2 (* 32 inr2)))
  (write-history h_sph (gswitch tick sp1 (read-history h_sph)))
  (write-history h_sns (gswitch tick snext (read-history h_sns)))
  (write-history h_idx (gswitch tick idx3 idx0))
  (def e10 (* 1.5 (+ sthis (gswitch (gt (noise) 0.5) ne (- ne)))))
  (make-history h_s0)
  (make-history h_s1)
  (make-history h_s2)
  (make-history h_s3)
  (make-history h_s4)
  (make-history h_s5)
  (make-history h_s6)
  (make-history h_s7)
  (make-history h_s8)
  (make-history h_s9)
  (def s0 (read-history h_s0))
  (def s1 (read-history h_s1))
  (def s2 (read-history h_s2))
  (def s3 (read-history h_s3))
  (def s4 (read-history h_s4))
  (def s5 (read-history h_s5))
  (def s6 (read-history h_s6))
  (def s7 (read-history h_s7))
  (def s8 (read-history h_s8))
  (def s9 (read-history h_s9))
  (def e9 (- e10 (* k9 s9)))
  (def e8 (- e9 (* k8 s8)))
  (def e7 (- e8 (* k7 s7)))
  (def e6 (- e7 (* k6 s6)))
  (def e5 (- e6 (* k5 s5)))
  (def e4 (- e5 (* k4 s4)))
  (def e3 (- e4 (* k3 s3)))
  (def e2 (- e3 (* k2 s2)))
  (def e1 (- e2 (* k1 s1)))
  (def e0 (clip (- e1 (* k0 s0)) -2 2))
  (write-history h_s9 (gswitch tick (+ s8 (* k8 e8)) s9))
  (write-history h_s8 (gswitch tick (+ s7 (* k7 e7)) s8))
  (write-history h_s7 (gswitch tick (+ s6 (* k6 e6)) s7))
  (write-history h_s6 (gswitch tick (+ s5 (* k5 e5)) s6))
  (write-history h_s5 (gswitch tick (+ s4 (* k4 e4)) s5))
  (write-history h_s4 (gswitch tick (+ s3 (* k3 e3)) s4))
  (write-history h_s3 (gswitch tick (+ s2 (* k2 e2)) s3))
  (write-history h_s2 (gswitch tick (+ s1 (* k1 e1)) s2))
  (write-history h_s1 (gswitch tick (+ s0 (* k0 e0)) s1))
  (write-history h_s0 (gswitch tick e0 s0))
  ; --- sample-and-hold with BLEP at the clock ticks ---
  (make-history h_a)
  (make-history h_b)
  (make-history h_na)
  (make-history h_nb)
  (def sa (read-history h_a))
  (def sb (read-history h_b))
  (def da (* tick (- e10 sa)))
  (def db (* tick (- e0 sb)))
  (def ta (+ (read-history h_na) (* da (pl-this-blep crt))))
  (def tb (+ (read-history h_nb) (* db (pl-this-blep crt))))
  (def sa1 (gswitch tick e10 sa))
  (def sb1 (gswitch tick e0 sb))
  (write-history h_a sa1)
  (write-history h_b sb1)
  (write-history h_na (gswitch act (+ (* da (pl-next-blep crt)) sa1) (read-history h_na)))
  (write-history h_nb (gswitch act (+ (* db (pl-next-blep crt)) sb1) (read-history h_nb)))
  (def env (* wmode isw patched))
  (def g (pl-interp (gswitch env accent 1) bstart bphase 0))
  (tuple (* ta g) (* tb g) env))

(defmacro plaits-speech (bstart bphase rise high patched note timbre morph harmonics accent prosody speed)
  (def f0 (pl-note-to-freq note))
  (def group (* harmonics 6))
  (def lowmode (lte group 2))
  (def wmode (- 1 lowmode))
  (def naive_mode (lte group 1))
  ; SAM/naive get `trigger == TRIGGER_RISING_EDGE` (never true with HIGH set).
  (def click (* rise (- 1 high)))
  (def (n_exc n_out) (speech-naive bstart bphase click f0 morph timbre))
  (def (s_exc s_out) (speech-sam bstart bphase click f0 morph timbre))
  (def (l_exc l_out l_env)
    (speech-lpc bstart bphase rise patched (- 1 naive_mode) wmode group f0 morph timbre
                accent (* wmode prosody) (* wmode speed)))
  (def b0 (gswitch naive_mode group (- 2 group)))
  (def b1 (* b0 b0 (- 3 (* 2 b0))))
  (def blend (* b1 b1 (- 3 (* 2 b1))))
  (def a_aux (gswitch naive_mode n_exc l_exc))
  (def a_out (gswitch naive_mode n_out l_out))
  (tuple (gswitch lowmode (+ a_out (* (- s_out a_out) blend)) l_out)
         (gswitch lowmode (+ a_aux (* (- s_exc a_aux) blend)) l_exc)
         l_env))

; ======================================================================
; Wave terrain engine (plaits/dsp/engine2/wave_terrain_engine.cc).
; An elliptic path (magic-circle quadrature sine at f0, radius = TIMBRE)
; scans a 2-D terrain; MORPH offsets the path in x; HARMONICS crossfades
; between 8 terrains (5 analytic + 3 wavetable banks re-read as terrains).
; 2x oversampled (no decimation filter, plain average). OUT = terrain
; height, AUX = sin of (y + height). No user terrain (8 terrains).
; ======================================================================
(def terrain_waves (tensor @shape [132 192] @file "wav_integrated_waves.json"))

; plaits Sine() (positive phases).
(defmacro terrain-sine (x)
  (sin (* twopi x)))

(defmacro terrain-squash (x a)
  (def v (* x a))
  (/ v (+ 1 (abs v))))

; Analytic terrains 0..4 (wave_terrain_engine.cc Terrain()).
(defmacro terrain-t0 (x y)
  (* (- (terrain-squash (terrain-sine (+ 4 (* x 1.273))) 2)
        (terrain-sine (+ 4 (* y (+ x 1.571) 0.637))))
     0.57))
(defmacro terrain-t1 (x y)
  (def xy (* x y))
  (terrain-sine (+ 4 (* (/ (terrain-sine (+ 4 (* (+ x y) 0.637))) (+ 0.2 (* xy xy))) 0.159))))
(defmacro terrain-t2 (x y)
  (def xy (* x y))
  (terrain-sine (+ 4 (* (/ (terrain-sine (+ 4 (* 2.387 xy))) (+ 0.35 (* xy xy))) 0.159))))
(defmacro terrain-t3 (x y)
  (def xy (* x y))
  (def xys (* (- x 0.25) (+ y 0.25)))
  (terrain-sine (+ 4 (* (/ xy (+ 2 (abs (* 5 xys)))) 6.366))))
(defmacro terrain-t4 (x y)
  (terrain-sine (+ (/ 0.159 (+ 0.17 (abs (- y 0.25))))
                   (/ 0.477 (+ 0.35 (abs (* (+ x 0.5) (+ y 1.5)))))
                   4)))

; InterpolateIntegratedWave on wave `col` (differentiated on the fly).
(defmacro terrain-diff-wave (col si sf)
  (def a (peek terrain_waves si col))
  (def b (peek terrain_waves (+ si 1) col))
  (def c (peek terrain_waves (+ si 2) col))
  (+ (- b a) (* (- (+ c a) b b) sf)))

; TerrainLookupWT(x, y, bank).
(defmacro terrain-wt (x y bank)
  (def sample (* (* (+ y 1) 0.5) 128))
  (def wt (* (* (+ x 1) 0.5) 63))
  (def si (clip (pl-trunc sample) 0 129))
  (def sf (- sample si))
  (def wi (clip (pl-trunc wt) 0 63))
  (def wf (- wt wi))
  (def col (+ (* bank 64) wi))
  (def xy0 (terrain-diff-wave col si sf))
  (def xy1 (terrain-diff-wave (min (+ col 1) 191) si sf))
  (* (+ xy0 (* (- xy1 xy0) wf)) (/ 1 1024)))

; One oversampled point: interpolated terrain height between zi and zi+1.
(defmacro terrain-point (x y zi zf)
  (def t0 (terrain-t0 x y))
  (def t1 (terrain-t1 x y))
  (def t2 (terrain-t2 x y))
  (def t3 (terrain-t3 x y))
  (def t4 (terrain-t4 x y))
  (def wa (terrain-wt x y (clip (- 7 zi) 0 2)))
  (def wb (terrain-wt x y (clip (- 6 zi) 0 2)))
  (def z0 (selector (+ zi 1) t0 t1 t2 t3 t4 wa wa wa))
  (def z1 (selector (+ zi 2) t0 t1 t2 t3 t4 wb wb wb))
  (+ z0 (* (- z1 z0) zf)))

(defmacro plaits-terrain (bstart bphase rise high patched note timbre morph harmonics accent)
  (make-history h_x)
  (make-history h_y)
  (make-history h_eps)
  (make-history h_eps_inc)
  (make-history h_amp)
  (make-history h_amp_inc)
  (make-history h_started)
  (def f0 (pl-note-to-freq note))
  (def att (max (- 1 (* 8 f0)) 0))
  (def radius (+ 0.1 (* 0.9 timbre att (- 2 att))))
  ; FastSineOscillator::RenderQuadrature(f0 / 2, radius) over 24 sub-samples
  (def fp (* f0 0.5))
  (def fq (min fp 0.25))
  (def amp_t (gswitch (gte fp 0.25) 0 (* radius (- 1 (* fq 4)))))
  (def f_pi (* fq pi))
  (def eps_t (* f_pi (- 2 (* (/ (* 2 0.96) 6) f_pi f_pi))))
  (def started (read-history h_started))
  (write-history h_started 1)
  (def x_prev (gswitch started (read-history h_x) 1))
  (def y_prev (read-history h_y))
  (def norm (+ (* x_prev x_prev) (* y_prev y_prev)))
  (def renorm (* bstart (max (lte norm 0.5) (gte norm 2))))
  (def nscale (gswitch renorm (/ 1 (sqrt (max norm 0.000001))) 1))
  (def x0 (* x_prev nscale))
  (def y0 (* y_prev nscale))
  (def eps0 (read-history h_eps))
  (def eps_inc (gswitch bstart (/ (- eps_t eps0) 24) (read-history h_eps_inc)))
  (write-history h_eps_inc eps_inc)
  (def amp0 (read-history h_amp))
  (def amp_inc (gswitch bstart (/ (- amp_t amp0) 24) (read-history h_amp_inc)))
  (write-history h_amp_inc amp_inc)
  (def e1 (+ eps0 eps_inc))
  (def a1 (+ amp0 amp_inc))
  (def x1 (+ x0 (* e1 y0)))
  (def y1 (- y0 (* e1 x1)))
  (def e2 (+ e1 eps_inc))
  (def a2 (+ a1 amp_inc))
  (def x2 (+ x1 (* e2 y1)))
  (def y2 (- y1 (* e2 x2)))
  (write-history h_x x2)
  (write-history h_y y2)
  (write-history h_eps e2)
  (write-history h_amp a2)
  (def px1 (* x1 a1))
  (def py1 (* y1 a1))
  (def px2 (* x2 a2))
  (def py2 (* y2 a2))
  ; per-sample parameter interpolation (state starts at 0)
  (def x_offset (pl-interp (- (* 1.9 morph) 1) bstart bphase 0))
  (def z (pl-interp (* (min (* harmonics 1.05) 1) 6.9999) bstart bphase 0))
  (def zi (clip (floor z) 0 6))
  (def zf (- z zi))
  (def k (- 1 (abs x_offset)))
  (def zz1 (terrain-point (+ (* px1 k) x_offset) py1 zi zf))
  (def zz2 (terrain-point (+ (* px2 k) x_offset) py2 zi zf))
  (def out (* 0.5 (+ zz1 zz2)))
  (def aux (terrain-sine (+ 1 (* 0.25 (+ py1 zz1 py2 zz2)))))
  (tuple out aux))

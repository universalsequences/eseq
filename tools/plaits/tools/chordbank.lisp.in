; ======================================================================
; Shared by the chord and string machine engines (generated by
; tools/gen_chordbank_lisp.py from tools/chordbank.lisp.in; edit the .in).
; - ChordBank (plaits/dsp/chords/chord_bank.cc): 11 chords x 4 notes,
;   HysteresisQuantizer2 chord selection, ComputeChordInversion.
; - StringSynthOscillator (oscillator/string_synth_oscillator.h).
; - Block-rate / gated state helpers.
; ======================================================================

; SemitonesToRatio(chords_[c][n]) (exact LUT products), index c * 4 + n.
(def cb_ratios (tensor @shape [44 1] @data [@RATIOS@]))

; ComputeChordInversion voice map, index ii * 25 + voice * 5 + k with ii =
; inversion_integral (0..20); k: 0 chord note, 1 ratio multiplier,
; 2/3 amplitude = 0.25 * (a + b * inversion_fractional), 4 aux-mask bit.
(def cb_inv (tensor @shape [525 1] @data [@INV@]))

; ONE_POLE run once per block (on bstart); holds between blocks.
(defmacro cb-block-pole (in coef bstart)
  (make-history h)
  (def s (read-history h))
  (def v (gswitch bstart (+ s (* coef (- in s))) s))
  (write-history h v)
  v)

; ChordBank::set_chord(parameter): HysteresisQuantizer2(11, 0.075, false)
; on parameter * 1.02, once per block. Returns the chord index 0..10.
(defmacro cb-chord-index (harmonics bstart)
  (make-history h)
  (def q_old (read-history h))
  (def value (- (* harmonics 1.02 11) 0.5))
  (def hs (gswitch (gt value q_old) -1 1))
  (def q (clip (pl-trunc (+ value (* hs 0.075) 0.5)) 0 10))
  (def v (gswitch bstart q q_old))
  (write-history h v)
  v)

; ParameterInterpolator(&state, target, 12) emulated sample-exactly (the
; state accumulates value += increment like the C++, so a constant target
; reproduces the state bit-for-bit); `init` is the state's initial value.
; `run` = 1 on blocks where the owner renders (the C++ skips Render()
; otherwise, freezing the state).
(defmacro cb-ginterp (target bstart bphase init run)
  (make-history h_val)
  (make-history h_inc)
  (make-history h_ready)
  (def v_old (gswitch (read-history h_ready) (read-history h_val) init))
  (def inc (gswitch bstart (* run (/ (- target v_old) 12)) (read-history h_inc)))
  (def v (+ v_old inc))
  (write-history h_val v)
  (write-history h_inc inc)
  (write-history h_ready 1)
  v)

; ONE_POLE that only advances when `run` is 1.
(defmacro cb-gpole (in coef run)
  (make-history h)
  (def s (read-history h))
  (def v (gswitch run (+ s (* coef (- in s))) s))
  (write-history h v)
  v)

; StringSynthOscillator::Render(frequency, registration[7], gain) adding into
; its destination; `run` = 1 on blocks where the C++ calls Render. u0..u5 are
; the registration amplitudes (u6 is always 0 in Plaits). Returns the
; contribution (2 * this_sample).
(defmacro cb-string-synth (freq u0 u1 u2 u3 u4 u5 gain run bstart bphase)
  (def f8 (* freq 8))
  (def k (+ (gt f8 0.5) (gt f8 1) (gt f8 2) (gt f8 4)))
  (def live (* run (lt k 3.5)))
  (def fsh (* f8 (selector (+ k 1) 1 0.5 0.25 0.125 0.0625)))
  ; registration shifted by 2k slots
  (def g8t (* gain (selector (+ k 1) (+ u0 (* 2 u1)) 0 0 0 0)))
  (def g4t (* gain (selector (+ k 1) (+ (- u2 u1) (* 2 u3)) (+ u0 (* 2 u1)) 0 0 0)))
  (def g2t (* gain (selector (+ k 1) (+ (- u4 u3) (* 2 u5)) (+ (- u2 u1) (* 2 u3)) (+ u0 (* 2 u1)) 0 0)))
  (def g1t (* gain (selector (+ k 1) (- 0 u5) (- u4 u3) (- u2 u1) u0 0)))
  (def f (cb-ginterp fsh bstart bphase 0.001 live))
  (def g8 (cb-ginterp g8t bstart bphase 0 live))
  (def g4 (cb-ginterp g4t bstart bphase 0 live))
  (def g2 (cb-ginterp g2t bstart bphase 0 live))
  (def g1 (cb-ginterp g1t bstart bphase 0 live))
  (make-history h_ph)
  (make-history h_ns)
  (make-history h_seg)
  (def ph_old (read-history h_ph))
  (def this0 (read-history h_ns))
  (def seg_old (read-history h_seg))
  (def ph1 (+ ph_old f))
  (def ns0 (floor ph1))
  (def changed (- 1 (eq ns0 seg_old)))
  (def wrap8 (* changed (gte ns0 8)))
  (def ph (- ph1 (* 8 wrap8)))
  (def ns (- ns0 (* 8 wrap8)))
  (def seg4 (* 4 (floor (* ns 0.25))))
  (def seg6 (* 2 (floor (* ns 0.5))))
  (def disc (- 0 (* wrap8 g8)
               (* changed (+ (* (eq ns seg4) g4) (* (eq ns seg6) g2) g1))))
  (def t (clip (/ (- ph ns) (max f 0.0000001)) 0 1))
  (def u (- 1 t))
  (def this (+ this0 (* 0.5 t t disc)))
  (def next (+ (* -0.5 u u disc)
               (* (- ph 4) g8 0.125)
               (* (- ph seg4 2) g4 0.25)
               (* (- ph seg6 1) g2 0.5)
               (* (- ph ns 0.5) g1)))
  (write-history h_ph (gswitch live ph ph_old))
  (write-history h_ns (gswitch live next this0))
  (write-history h_seg (gswitch live ns seg_old))
  (* 2 this live))

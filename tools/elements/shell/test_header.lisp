; Test driver for the Elements port (tools/elh.py): replaces the host inputs
; with render-controlled params, a deterministic noise option and debug
; outputs matching ref/elref's channels.
(param seconds @default 2 @min 0 @max 600)
(param gate_s @default 1 @min -1 @max 600)
(param retrig @default 0 @min 0 @max 600)
(param t_note @default 48 @min -128 @max 200)
(param t_note_end @default -1000 @min -1000 @max 200)
(param t_strength @default 0.5 @min 0 @max 1)
(param t_model @default 0 @min 0 @max 3)
(param t_contour @default 1 @min 0 @max 1)
(param t_bow @default 0 @min 0 @max 1)
(param t_bow_timbre @default 0.5 @min 0 @max 1)
(param t_blow @default 0 @min 0 @max 1)
(param t_blow_meta @default 0.5 @min 0 @max 1)
(param t_blow_timbre @default 0.5 @min 0 @max 1)
(param t_strike @default 0.8 @min 0 @max 1)
(param t_strike_meta @default 0.5 @min 0 @max 1)
(param t_strike_timbre @default 0.5 @min 0 @max 1)
(param t_signature @default 0 @min 0 @max 1)
(param t_geometry @default 0.2 @min 0 @max 1)
(param t_geometry_end @default -1 @min -1 @max 1)
(param t_brightness @default 0.5 @min 0 @max 1)
(param t_brightness_end @default -1 @min -1 @max 1)
(param t_damping @default 0.25 @min 0 @max 1)
(param t_damping_end @default -1 @min -1 @max 1)
(param t_position @default 0.3 @min 0 @max 1)
(param t_position_end @default -1 @min -1 @max 1)
(param t_space @default 0.5 @min 0 @max 2)
(param t_rev_diffusion @default 0.625 @min 0 @max 1)
(param t_rev_lp @default 0.7 @min 0 @max 1)
(param det @default 0 @min 0 @max 1)
(param warm @default 0 @min 0 @max 1)
(param det_d @default 32 @min 0 @max 1000)
(param det_strike @default -1 @min -1 @max 1000)
(param det_str @default -1 @min -1 @max 1000)
(param det_nstr @default 1 @min 0 @max 5)

(def warm_start warm)
(make-history h_n)
(def n_now (read-history h_n))
(write-history h_n (+ n_now 1))
(def frac (/ n_now (* seconds samplerate)))
(defmacro sweep (a b) (gswitch (lt b -0.5) a (+ a (* (- b a) frac))))
(def t_s (/ n_now samplerate))
(def t_r (gswitch (gt retrig 0) (- t_s (* retrig (floor (/ t_s (max retrig 0.000001))))) t_s))
(def gate_now (* (gte gate_s 0) (lt t_r gate_s)))
(def trig_now 0)
; copies for the Ominous voice's gated cone (its own sample counter)
(make-history h_n2)
(def n_o (read-history h_n2))
(write-history h_n2 (+ n_o 1))
(def t_so (/ n_o samplerate))
(def t_ro (gswitch (gt retrig 0) (- t_so (* retrig (floor (/ t_so (max retrig 0.000001))))) t_so))
(def gate_o (* (gte gate_s 0) (lt t_ro gate_s)))
(def trig_o 0)
(def bfrac_o (/ (* 16 (floor (/ n_o 16))) (* seconds samplerate)))
(defmacro bsweep-o (a b) (gswitch (lt b -0.5) a (+ a (* (- b a) bfrac_o))))
(def midi_o (gswitch (lt t_note_end -999) t_note (+ t_note (* (- t_note_end t_note) bfrac_o))))
(def p_geometry_o (bsweep-o t_geometry t_geometry_end))
(def p_brightness_o (bsweep-o t_brightness t_brightness_end))
(def p_damping_o (bsweep-o t_damping t_damping_end))
(def p_position_o (bsweep-o t_position t_position_end))
; the reference updates per block: sweeps follow the 16-sample block start
(def bfrac (/ (* 16 (floor (/ n_now 16))) (* seconds samplerate)))
(defmacro bsweep (a b) (gswitch (lt b -0.5) a (+ a (* (- b a) bfrac))))
(def midi_now (gswitch (lt t_note_end -999) t_note (+ t_note (* (- t_note_end t_note) bfrac))))
(def strength_now t_strength)
(def model_now t_model)
(def space_now t_space)
(def p_contour t_contour)
(def p_bow t_bow)
(def p_bow_timbre t_bow_timbre)
(def p_blow t_blow)
(def p_blow_meta t_blow_meta)
(def p_blow_timbre t_blow_timbre)
(def p_strike t_strike)
(def p_strike_meta t_strike_meta)
(def p_strike_timbre t_strike_timbre)
(def p_signature t_signature)
(def p_geometry (bsweep t_geometry t_geometry_end))
(def p_brightness (bsweep t_brightness t_brightness_end))
(def p_damping (bsweep t_damping t_damping_end))
(def p_position (bsweep t_position t_position_end))
(def p_mod_freq (/ 0.5 32000))
(def p_mod_offset 0.1)
(def p_rev_diffusion t_rev_diffusion)
(def p_rev_lp t_rev_lp)

; Deterministic draws (ref/override random.h): the n-th draw of the run is
; Det(n) / 65536. Per block of 16 samples the module draws bow x16, blow x16,
; then the strike exciter (FLOW: x16, at det_strike) and the strings (x16
; each from det_str); det_d is the total per block.
(defmacro det-u (k)
  (def m (el-imod k 65536))
  (def x1 (el-imod (+ (* m 169) 7) 65536))
  (/ (el-imod (+ (* x1 181) (floor (/ x1 256))) 65536) 65536))
(def det_blk (floor (/ n_now 16)))
(def det_j (- n_now (* det_blk 16)))
(def det_base (+ (* det_blk det_d) det_j))
(def u0 (noise))
(def un1 (el-noise-tap u0))
(def un2 (el-noise-tap un1))
(def un3 (el-noise-tap un2))
(def un4 (el-noise-tap un3))
(def un5 (el-noise-tap un4))
(def un6 (el-noise-tap un5))
(def un7 (el-noise-tap un6))
(def un8 (el-noise-tap un7))
(def un9 (el-noise-tap un8))
(defmacro pick (k nz) (gswitch det (det-u (+ det_base k)) nz))
(def u_bow (pick 0 u0))
(def u_blow (pick 16 un1))
(def u_s1 (pick det_strike un2))
(def u_s2 un3)
(def u_s3 un4)
(def u_st0 (pick det_str un5))
(def u_st1 (pick (+ det_str 16) un6))
(def u_st2 (pick (+ det_str 32) un7))
(def u_st3 (pick (+ det_str 48) un8))
(def u_st4 (pick (+ det_str 64) un9))

; Instrument shell: host inputs and params, and the names voice.lisp expects.
(def gate (in 1 @name gate))
(def pitch (in 2 @name pitch))
(def velocity (in 3 @name velocity))
(def trigger (in 4 @name trigger))
(def mod1 (in 5 @name mod1 @modulator 1))
(def mod2 (in 6 @name mod2 @modulator 2))
(def mod3 (in 7 @name mod3 @modulator 3))
(def mod4 (in 8 @name mod4 @modulator 4))

(param model @default 0 @min 0 @max 3)
(param contour @default 1 @min 0 @max 1 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
(param bow @default 0 @min 0 @max 1 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
(param bow_timbre @default 0.5 @min 0 @max 1 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
(param blow @default 0 @min 0 @max 1 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
(param flow @default 0.5 @min 0 @max 1 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
(param blow_timbre @default 0.5 @min 0 @max 1 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
(param strike @default 0.8 @min 0 @max 1 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
(param mallet @default 0.5 @min 0 @max 1 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
(param strike_timbre @default 0.5 @min 0 @max 1 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
(param geometry @default 0.2 @min 0 @max 1 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
(param brightness @default 0.5 @min 0 @max 1 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
(param damping @default 0.25 @min 0 @max 1 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
(param position @default 0.3 @min 0 @max 1 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
(param space @default 0.7 @min 0 @max 1 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
(param freeze @default 0 @min 0 @max 1)
(param tune @default 0 @min -48 @max 48 @unit st @mod true @mod-mode additive @mod-depth-min -24 @mod-depth-max 24 @mod-unit st)
(param strength @default 0.5 @min 0 @max 1 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
(param vel_amt @default 0.5 @min 0 @max 1)
(param level_db @default -4 @min -36 @max 24 @unit dB @mod true @mod-mode additive @mod-depth-min -24 @mod-depth-max 24 @mod-unit dB)

; New notes start from settled smoothers, as on the running module.
(def warm_start 1)
(def gate_now gate)
(def trig_now trigger)
(def midi_now (+ 69 (* 17.312340491 (log (/ (max pitch 1) 440))) (mod tune)))
(def strength_now (- (mod strength) (* vel_amt (- 1 (clip velocity 0 1)))))
(def model_now model)
(def space_now (gswitch (gt freeze 0.5) 2 (mod space)))
(def p_contour (mod contour))
(def p_bow (mod bow))
(def p_bow_timbre (mod bow_timbre))
(def p_blow (mod blow))
(def p_blow_meta (mod flow))
(def p_blow_timbre (mod blow_timbre))
(def p_strike (mod strike))
(def p_strike_meta (mod mallet))
(def p_strike_timbre (mod strike_timbre))
(def p_signature 0)
(def p_geometry (mod geometry))
(def p_brightness (mod brightness))
(def p_damping (mod damping))
(def p_position (mod position))
(def p_mod_freq (/ 0.5 32000))
(def p_mod_offset 0.1)
(def p_rev_diffusion 0.625)
(def p_rev_lp 0.7)
; The Ominous voice's copies (no shared history in the instrument).
(def gate_o gate)
(def trig_o trigger)
(def midi_o midi_now)
(def p_geometry_o p_geometry)
(def p_brightness_o p_brightness)
(def p_damping_o p_damping)
(def p_position_o p_position)
; Independent uniform draws for the noise-driven exciters and strings.
(def u_bow (noise))
(def u_blow (el-noise-tap u_bow))
(def u_s1 (el-noise-tap u_blow))
(def u_s2 (el-noise-tap u_s1))
(def u_s3 (el-noise-tap u_s2))
(def u_st0 (el-noise-tap u_s3))
(def u_st1 (el-noise-tap u_st0))
(def u_st2 (el-noise-tap u_st1))
(def u_st3 (el-noise-tap u_st2))
(def u_st4 (el-noise-tap u_st3))

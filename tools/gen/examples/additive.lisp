;; An additive organ, generated by a function in this script: no modal code
;; and no Rust. The script's last value is an eseq.gen program; C-c C-c plays
;; it on a draft track, and `eseq generate` writes it as an instrument.
;;
;; Its partials are a tensor of harmonics: harmonic k sounds at
;; f0 * k^stretch, weighted k^(tilt / 6.02) (tilt dB per octave) and
;; bright^(k - 1); bright follows the played note (darker up high), and an
;; attack / release envelope opens the voice. Change :partials, :tilt or
;; the curve and evaluate again.
(import eseq.gen :as gen)
(import eseq.gen.modulate :as gm)
(import eseq.gen.panel :as gp)

;; The program's params, as eseq.gen param specs, in panel sections.
;;   p  the program
(def additive-sections (p)
  (list (dict :title "TONE" :tab "tone"
              :params (list (gen/pspec 'tone "tilt" (get p :tilt) -24 0 :title "Tilt")
                            (gen/pspec 'tone "bright" (get p :bright) 0 1 :title "Bright")
                            (gen/pspec 'tone "stretch" 1 0.98 1.04 :title "Stretch" :dec 3)))
        (dict :title "ENV" :tab "env"
              :params (list (gen/pspec 'env "attack" 8 1 2000 :unit 'ms :title "Attack" :taper :log)
                            (gen/pspec 'env "release" 400 5 5000 :unit 'ms :title "Release" :taper :log)))
        (dict :title "OUT" :tab "out"
              :params (list (gen/pspec 'out "gain" 0.4 0 1 :title "Gain")))))

;; The instrument's forms: the voice preamble, the params, the note-following
;; value, the partials, the envelope and the outputs.
;;   p       the program
;;   params  every param spec
(def additive-forms (p params)
  (let ((n (get p :partials)))
    (append (gen/preamble)
            (map gen/param-form params)
            (gen/by-note-forms params)
            (list `(def ks (+ 1 (iota ,n)))
                  '(def freqs (* f0 (pow ks tone_stretch)))
                  ;; tone_bright is the note-following value (by-note-forms);
                  ;; partials past 0.45 of the sample rate are silent
                  '(def weights (* (pow ks (/ tone_tilt 6.02)) (pow tone_bright (- ks 1))
                                   (lt freqs (* 0.45 samplerate))))
                  `(def partials (sum (* weights (sin (* twopi (phasor freqs))))))
                  '(make-history env)
                  '(def target (gt gate 0.5))
                  `(def env_pole (gswitch target ,(gen/pole-form '(* env_attack 0.001)) ,(gen/pole-form '(* env_release 0.001))))
                  '(def env_next (+ target (* (- (read-history env) target) env_pole)))
                  '(write-history env env_next)
                  '(def voice_out (tanh (* partials env_next out_gain 0.3)))
                  '(out voice_out 1 @name audio)
                  '(out (max env_next (lt age 0.05)) 2 @name amp @amp true)))))

;; The generator: the program's dsp.lisp and ui.lisp.
;;   p  the program
(def additive (p)
  (let ((secs (additive-sections p)))
    (let ((params (gen/concat-all (map (lambda (s) (get s :params)) secs))))
      (dict :name (get p :name)
            :dsp (str "; generated by tools/gen/examples/additive.lisp\n"
                      (pp-forms (gm/mod-pass (filter gen/modulatable? params) false (additive-forms p params))))
            :ui (str ";; generated by tools/gen/examples/additive.lisp\n"
                     (pp-forms (gp/sections-ui-forms (get p :name) secs)))))))

(gen/program additive :name "gen-additive" :partials 16 :tilt -6
             :bright (gen/by-note 65 1 523 0.7 2093 0.35))

;; $name / plucked nylon-string guitar identified from recorded plucks.
;; Generated by tools/pm-guitar/build.py; edit engine.lisp.in, then regenerate.
;; Reference coefficients only: no PCM, recorded phase or spectral frames.
;;
;; One voice is one string: $partials stiff-string partials (complex modal
;; rotations). A pluck sets each partial's displacement from the measured
;; pluck of the nearest recorded pitch:
;;   a_k = L sin(pi k beta) k^-alpha exp(-(f_k/fc)^2) exp(body h(f_k) + detail d_k)
;; beta (pluck position), alpha (finger contact tilt), fc (fingertip/nail
;; roll-off), L and d_k belong to a recorded take; h(f) is the measured
;; body/radiation EQ shared by every note. Loss: sigma = s0 + b f^2, saturating.
;; The string drives a small bank of measured body resonances (air ~100 Hz,
;; top ~200 Hz ...), and the finger's contact adds a short noise burst.

(def gate (in 1 @name gate))
(def pitch (in 2 @name pitch))
(def velocity (in 3 @name velocity))
(def trigger (in 4 @name trigger))
(def clock (in 5 @name clock))
(def mod1 (in 6 @name mod1 @modulator 1))
(def mod2 (in 7 @name mod2 @modulator 2))
(def mod3 (in 8 @name mod3 @modulator 3))
(def mod4 (in 9 @name mod4 @modulator 4))

(param take @group pluck @default 0.5 @min 0 @max 1 @mod true @mod-mode additive)
(param vel_take @group pluck @default 0.6 @min 0 @max 1)
(param humanize @group pluck @default 0.35 @min 0 @max 1)
(param hand_fixed @group pluck @default 1 @min 0 @max 1)
(param position @group pluck @default 0 @min -0.25 @max 0.25 @mod true @mod-mode additive)
(param finger @group pluck @default 0 @min -1 @max 1 @mod true @mod-mode additive)
(param vel_tone @group pluck @default 0.5 @min 0 @max 1)
(param detail @group pluck @default 1 @min 0 @max 1)
(param shimmer @group string @default 1 @min 0 @max 2 @mod true @mod-mode additive)
(param decay @group string @default 1 @min 0.2 @max 4 @mod true @mod-mode additive)
(param damping @group string @default 1 @min 0 @max 3 @mod true @mod-mode additive)
(param mute @group string @default 0 @min 0 @max 1 @mod true @mod-mode additive)
(param release @group string @default 0.8 @min 0.03 @max 6 @unit s @mod true @mod-mode additive)
(param stiffness @group string @default 1 @min 0 @max 4 @mod true @mod-mode additive)
(param tune @group string @default 0 @min -100 @max 100 @unit cents @mod true @mod-mode additive)
(param vibrato @group string @default 0 @min 0 @max 60 @unit cents @mod true @mod-mode additive)
(param vib_rate @group string @default 5.5 @min 0.5 @max 9 @unit Hz @mod true @mod-mode additive)
(param buzz @group fret @default $buzz_default @min 0 @max 1 @mod true @mod-mode additive)
(param relief @group fret @default $relief_default @min 0 @max 3 @mod true @mod-mode additive)
(param hardness @group fret @default $hardness_default @min 0.001 @max 1)
(param alpha @group fret @default $alpha_default @min 1 @max 2.5)
(param contact_loss @group fret @default $contact_loss_default @min 0 @max 1)
(param level @group fret @default 1 @min 0 @max 2 @mod true @mod-mode additive)
(param spread @group fret @default 0 @min 0 @max 1 @mod true @mod-mode additive)
(param upper_decay @group fret @default $upper_decay_default @min 0.25 @max 4)
(param wood @group body @default $wood_default @min 800 @max 16000 @unit Hz @mod true @mod-mode additive)
(param body @group body @default 1 @min 0 @max 2 @mod true @mod-mode additive)
(param resonance @group body @default 1 @min 0 @max 3 @mod true @mod-mode additive)
(param contact @group body @default 1 @min 0 @max 4 @mod true @mod-mode additive)
(param tone_hz @group output @default 14000 @min 800 @max 20000 @unit Hz @mod true @mod-mode additive)
(param gain @group output @default 1 @min 0 @max 4 @mod true @mod-mode additive)

$tables

(defmacro gtr-smooth (target ms)
  (make-history previous)
  (make-history ready)
  (def pole (exp (/ -1 (* 0.001 ms samplerate))))
  (def value (gswitch (read-history ready) (mix target (read-history previous) pole) target))
  (write-history previous value)
  (write-history ready 1)
  value)

;; Coefficients latch on every pluck as well as each periodic control tick;
;; a periodic-only hop would miss an off-grid pluck.
(def control_tick (eq (accum 1 0 0 16) 0))
(make-history last_gate)
(def held (gt gate 0.5))
(def onset (max (gt trigger 0.5) (* held (lte (read-history last_gate) 0.5))))
(write-history last_gate held)
(def update_tick (max control_tick onset))

(def hit_velocity (latch (clip velocity 0 1) onset))
(def key_note (+ 69 (* 12 (/ (log (/ (clip pitch 8.1758 12543.85) 440)) (log 2)))))
;; The nearest recorded pitch lends its plucks; velocity, Take and Humanize
;; choose which of its recorded plucks (ordered soft to strong).
(def key_group (peek group_table (clip (round key_note) 0 127)))
(def take_pos (clip (+ (clip (mod take) 0 1) (* vel_take (- (clip velocity 0 1) 0.6))
  (* humanize (- (noise) 0.5))) 0 1))
(def group (latch key_group onset))
(def row (latch (+ (peek start_table key_group)
  (round (* take_pos (- (peek count_table key_group) 1)))) onset))

(def ns (+ (iota $partials) 1))
(def row_indices (+ (iota $partials) (* (event-hold row update_tick) $partials)))

;; ---- string: tuning, stiffness, loss ----------------------------------
(def vib_phase (phasor (clip (mod vib_rate) 0.5 9)))
(def cents (+ (gtr-smooth (clip (mod tune) -100 100) 8)
  (* (gtr-smooth (clip (mod vibrato) 0 60) 8) (sin (* twopi vib_phase)))))
(def f0 (event-hold (* (clip pitch 20 4000) (pow 2 (/ cents 1200))) update_tick))
(def ref_hz (event-hold (peek ref_hz_table group) update_tick))
;; Stiffness B grows as the vibrating length shortens (B ~ f0^2 on one string).
(def stiff (event-hold (* (clip (mod stiffness) 0 4) (peek b_table group)
  (clip (pow (/ f0 ref_hz) 2) 0.25 4)) update_tick))
(def hz (* f0 ns (sqrt (/ (+ 1 (* stiff ns ns)) (+ 1 stiff)))))
(def omega (* twopi (/ (min hz (* 0.49 samplerate)) samplerate)))
(def bandlimit (clip (/ (- (* 0.47 samplerate) hz) (* 0.06 samplerate)) 0 1))

(def decay_v (event-hold (gtr-smooth (clip (mod decay) 0.2 4) 8) update_tick))
(def damping_v (event-hold (max 0.0001 (gtr-smooth (clip (mod damping) 0 3) 8)) update_tick))
(def mute_v (event-hold (gtr-smooth (clip (mod mute) 0 1) 8) update_tick))
(def release_v (event-hold (clip (mod release) 0.03 6) update_tick))
(def held_v (event-hold held update_tick))
(def s0 (event-hold (peek s0_table group) update_tick))
(def high_loss (* $loss_b2 damping_v hz hz))
;; Palm mute: a resting hand whose loss grows with frequency.
;; Calibrated per half-octave against the recorded plucks' band decays.
(def loss_x (clip (* 2 (/ (log (/ (max hz $eq_lo) $eq_lo)) (log 2))) 0 $eq_last))
(def loss_i (floor loss_x))
(def loss_w (- loss_x loss_i))
(def loss_trim (+ (* (- 1 loss_w) (gather loss_trim_table loss_i)) (* loss_w (gather loss_trim_table (min $eq_last_index (+ loss_i 1))))))
;; Directly identified plucks also carry their measured per-partial loss
;; (rate_detail, ln ratio to the law); 0 elsewhere.
(def rate (+ (* (max (/ 0.8 decay_v) (+ (/ s0 decay_v) loss_trim
  (/ high_loss (+ 1 (/ high_loss (* $loss_cap damping_v))))))
  (exp (gather rate_detail_table row_indices)))
  (* 60 mute_v mute_v (+ 0.4 (/ hz 1500)))
  (* (- 1 held_v) (/ 6.907755 release_v))))
(def radius (exp (/ (- rate) samplerate)))
(def rot_c (latch (* radius (cos omega)) update_tick))
(def rot_s (latch (* radius (sin omega)) update_tick))

;; ---- upper string partials ($hi_first..$hi_last) -----------------------
;; The pluck sets partials 1-$partials (a fingertip leaves almost nothing
;; above them on nylon). These upper partials start silent; only the fret
;; contact puts energy into them, taking it from the note below - the buzz
;; is the string's own stiff upper series, not added noise. Same stiffness
;; and nylon loss law as the plucked partials (Upper decay scales it).
(def hns (+ (iota $hi_count) $hi_first))
(def hhz (* f0 hns (sqrt (/ (+ 1 (* stiff hns hns)) (+ 1 stiff)))))
(def homega (* twopi (/ (min hhz (* 0.49 samplerate)) samplerate)))
(def hbandlimit (clip (/ (- (* 0.47 samplerate) hhz) (* 0.06 samplerate)) 0 1))
(def hhigh_loss (* $loss_b2 damping_v hhz hhz))
(def hloss_x (clip (* 2 (/ (log (/ (max hhz $eq_lo) $eq_lo)) (log 2))) 0 $eq_last))
(def hloss_i (floor hloss_x))
(def hloss_w (- hloss_x hloss_i))
(def hloss_trim (+ (* (- 1 hloss_w) (gather loss_trim_table hloss_i)) (* hloss_w (gather loss_trim_table (min $eq_last_index (+ hloss_i 1))))))
(def hrate (+ (* (event-hold (clip upper_decay 0.25 4) update_tick)
    (max (/ 0.8 decay_v) (+ (/ s0 decay_v) hloss_trim (/ hhigh_loss (+ 1 (/ hhigh_loss (* $loss_cap damping_v)))))))
  (* 60 mute_v mute_v (+ 0.4 (/ hhz 1500)))
  (* (- 1 held_v) (/ 6.907755 release_v))))
(def hradius (exp (/ (- hrate) samplerate)))
(def hrot_c (latch (* hradius (cos homega)) update_tick))
(def hrot_s (latch (* hradius (sin homega)) update_tick))
;; Radiation of the upper partials: they leave through the same bridge and
;; wooden body as the plucked ones - the measured body EQ - and the top and
;; back radiate less and less above a few kHz (Wood: Gaussian roll-off).
;; This shapes what is heard, not the string/fret physics.
(def heq_ln (+ (* (- 1 hloss_w) (gather eq_table (min $eq_last_index hloss_i)))
  (* hloss_w (gather eq_table (min $eq_last_index (+ hloss_i 1))))))
(def wood_hz (event-hold (clip (mod wood) 800 16000) update_tick))
;; Above ~2 kHz no plucked partial measured the body; the recorded buzz
;; does: buzz_eq (third-octave knots from 1 kHz, ln gain) is calibrated
;; from its spectrum (tools/pm-guitar/calibrate_buzz_eq.py).
(def beq_x (clip (* 3 (/ (log (/ (max hhz 1000) 1000)) (log 2))) 0 $beq_last))
(def beq_i (floor beq_x))
(def beq_w (- beq_x beq_i))
(def beq_ln (+ (* (- 1 beq_w) (gather buzz_eq_table beq_i)) (* beq_w (gather buzz_eq_table (min $beq_last_index (+ beq_i 1))))))
;; Level scales only what is heard of the buzz partials, not the contact.
(def buzz_level (event-hold (clip (mod level) 0 2) update_tick))
(def hread (latch (* buzz_level hbandlimit (exp (- (+ heq_ln beq_ln) (pow (/ hhz wood_hz) 2)))) update_tick))

;; ---- pluck: measured excitation of the chosen take ---------------------
;; Evaluated on the coefficient clock (which includes the pluck frame) and
;; latched into the string only on the pluck.
(def tone_shift (* (clip vel_tone 0 1) 1.5 (- hit_velocity 0.6)))
(def finger_v (clip (mod finger) -1 1))
;; The plucking hand stays at a fixed distance from the bridge while the
;; fretting hand shortens the string, so a higher note is plucked
;; relatively nearer its middle (rounder). Hand fixed 1 = that; 0 = the
;; recorded fraction at any pitch.
(def hand_ratio (event-hold (clip (pow (/ f0 ref_hz) (clip hand_fixed 0 1)) 0.25 4) update_tick))
(def row_beta (event-hold (clip (* (peek beta_table row) hand_ratio) 0.03 0.5) update_tick))
(def beta (event-hold (clip (+ row_beta (clip (mod position) -0.25 0.25)) 0.03 0.5) update_tick))
(def alpha (event-hold (clip (- (peek alpha_table row) (* 1.2 finger_v) tone_shift) -0.5 3) update_tick))
(def fc (event-hold (* (peek fc_table row) (pow 2 (+ (* 1.5 finger_v) tone_shift))) update_tick))
(def body_amt (event-hold (clip (mod body) 0 2) update_tick))
(def detail_amt (event-hold (clip detail 0 1) update_tick))
(def level (event-hold (* (exp (peek level_table row)) (pow (/ (max hit_velocity 0.02) 0.6) 0.8)) update_tick))
;; Body/radiation EQ: half-octave knots from $eq_lo Hz, linearly interpolated.
(def eq_x (clip (* 2 (/ (log (/ (max hz $eq_lo) $eq_lo)) (log 2))) 0 $eq_last))
(def eq_i (floor eq_x))
(def eq_w (- eq_x eq_i))
(def eq_ln (+ (* (- 1 eq_w) (gather eq_table eq_i)) (* eq_w (gather eq_table (min $eq_last_index (+ eq_i 1))))))
(def detail_ln (gather detail_table row_indices))
(def weight_raw (* bandlimit (sin (* pi ns beta))
  (exp (- (+ (* body_amt eq_ln) (* detail_amt detail_ln)) (+ (* alpha (log ns)) (pow (/ hz fc) 2))))))
;; Timbre controls (position, finger, velocity tone, body EQ, detail)
;; redistribute the recorded take's energy; they never add or remove it.
;; Squared amplitudes are the energy proxy (modal masses unknown).
(def row_alpha (event-hold (peek alpha_table row) update_tick))
(def row_fc (event-hold (peek fc_table row) update_tick))
(def ref_raw (* bandlimit (sin (* pi ns row_beta))
  (exp (- (+ eq_ln detail_ln) (+ (* row_alpha (log ns)) (pow (/ hz row_fc) 2))))))
(def energy_scale (clip (sqrt (/ (sum (* ref_raw ref_raw)) (max 0.00000000000000000001 (sum (* weight_raw weight_raw))))) 0.005 4))
(def weight (latch (* level energy_scale weight_raw) onset))

;; A new pluck replaces the string's state (the finger stops the old
;; vibration as it takes the string); note-off only adds loss. Partials
;; above the second start at spread phases: on the record the body and room
;; smear them (crest ~8 dB), where aligned sine starts stack into a spike.
(make-tensor-history str_r @shape [$partials])
(make-tensor-history str_i @shape [$partials])
(def sx (read-tensor-history str_r))
(def sy (read-tensor-history str_i))
;; ---- fret buzz: the string against the frets ---------------------------
;; $frets frets lie between the fretting finger and the bridge, at their real
;; spacing: fret j sits at 2^(-j/12) of the vibrating length from the
;; bridge. Each is a one-sided obstacle under the string at its own gap; the
;; string's height above the frets grows toward the bridge (gap_j from the
;; first pluck's measured swing at that point, scaled by Buzz; Relief bows
;; the neck so frets further from the finger sit lower).
;; Contact force is a power law with loss (Hunt-Crossley):
;;   F = k pen^alpha + c pen-rate (only while pressed in)
;; applied as a velocity kick to every partial at the fret (unit modal
;; masses) after each exact free rotation. The stiffness is held under the
;; kick scheme's stability limit (1.5 / (frets * sum phi^2)). Contact lasts
;; a fraction of a millisecond, so each slap is band-limited by the string
;; itself and feeds the string's own upper partials, which then decay with
;; ordinary nylon loss.
(def string_buzz (event-hold (+ (peek buzz_group_table group)
  (* (- 1 (peek buzz_group_table group)) (clip (mod spread) 0 1))) update_tick))
(def buzz_amt (gtr-smooth (* (clip (mod buzz) 0 1) (latch string_buzz update_tick)) 8))
(def relief_v (gtr-smooth (clip (mod relief) 0 3) 8))
(def contact_v_k (clip hardness 0.001 1))
(def alpha_m1 (- (clip alpha 1 2.5) 1))
(def closs (clip contact_loss 0 1))
(def omega_a (latch (max 0.0001 omega) update_tick))
(def homega_a (latch (max 0.0001 homega) update_tick))
;; Partials near Nyquist sit at the edge of the kick scheme's stability
;; (cos omega ~ -1): only partials below 0.40 fs take part in the contact.
(def contact_bl (clip (/ (- (* 0.40 samplerate) hz) (* 0.04 samplerate)) 0 1))
(def hcontact_bl (clip (/ (- (* 0.40 samplerate) hhz) (* 0.04 samplerate)) 0 1))
(make-tensor-history hi_r @shape [$hi_count])
(make-tensor-history hi_i @shape [$hi_count])
(def hx (read-tensor-history hi_r))
(def hy (read-tensor-history hi_i))
(def rx (- (* rot_c sx) (* rot_s sy)))
(def ry (+ (* rot_s sx) (* rot_c sy)))
(def hrx (- (* hrot_c hx) (* hrot_s hy)))
(def hry (+ (* hrot_s hx) (* hrot_c hy)))
;; One block per fret (generated): force from the rotated state; every
;; fret sees the same state.
$fret_calls
(def kick (+ $kick_sum))
(def hkick (+ $hkick_sum))
(def phase_c (latch (gather phase_cos_table row_indices) onset))
(def phase_s (latch (gather phase_sin_table row_indices) onset))
;; dv_k = sum_j F_j phi_jk; y_k changes by -dv_k / omega_k
(def ky (- ry (/ kick omega_a)))
(def khy (- hry (/ hkick homega_a)))
;; Safety net: a string can only lose energy after its pluck, and no
;; faster than nothing - but never slower than its least-damped partial.
;; The bound starts at the pluck's energy and decays at twice the smallest
;; loss rate of the banks (release included); every 16 samples any excess
;; over it is scaled away. The contact itself is semi-implicit and should
;; never reach this; it keeps a stray limit cycle from ringing on.
(def e_now (event-hold (+ (sum (* omega_a omega_a (+ (* rx rx) (* ky ky))))
  (sum (* homega_a homega_a (+ (* hrx hrx) (* khy khy))))) control_tick))
(def min_rate (event-hold (min (sum (* rate first_mask_table)) (sum (* hrate hfirst_mask_table))) control_tick))
(make-history e_bound_h)
(def e_bound (gswitch onset (* 1.05 (sum (* omega_a omega_a weight weight)))
  (* (read-history e_bound_h) (gswitch control_tick (exp (/ (* -32 min_rate) samplerate)) 1))))
(write-history e_bound_h e_bound)
(def e_scale (latch (min 1 (sqrt (/ (event-hold e_bound control_tick) (max 0.0000000000000000000001 e_now)))) control_tick))
(def nx (gswitch onset (* weight phase_c) (* e_scale rx)))
(def ny (gswitch onset (* weight phase_s) (* e_scale ky)))
(def nhx (gswitch onset 0 (* e_scale hrx)))
(def nhy (gswitch onset 0 (* e_scale khy)))
(write-tensor-history hi_r nhx)
(write-tensor-history hi_i nhy)
(write-tensor-history str_r nx)
(write-tensor-history str_i ny)

;; ---- second polarization ---------------------------------------------
;; Every partial has a measured partner pole a few Hz away with its own loss
;; (the other polarization, coupled to the body differently). Their beating
;; is what makes the ring-out breathe; a single damped pole per partial
;; decays as a dead-smooth exponential. Only the vertical polarization meets
;; the fret. Shimmer scales the partner's amplitude.
(def pol_hz (+ hz (gather pol_detune_table row_indices)))
(def pol_omega (* twopi (/ (min (max pol_hz 1) (* 0.49 samplerate)) samplerate)))
(def pol_radius (exp (/ (- (* rate (exp (gather pol_rate_table row_indices)))) samplerate)))
(def pol_c (latch (* pol_radius (cos pol_omega)) update_tick))
(def pol_s (latch (* pol_radius (sin pol_omega)) update_tick))
(def shimmer_v (latch (clip (mod shimmer) 0 2) onset))
;; partner start = main start x measured complex ratio
(def pol_re0 (latch (gather pol_re_table row_indices) onset))
(def pol_im0 (latch (gather pol_im_table row_indices) onset))
(def main_x0 (* weight phase_c))
(def main_y0 (* weight phase_s))
(make-tensor-history pol_r @shape [$partials])
(make-tensor-history pol_i @shape [$partials])
(def px (read-tensor-history pol_r))
(def py (read-tensor-history pol_i))
(def npx (gswitch onset (* shimmer_v (- (* main_x0 pol_re0) (* main_y0 pol_im0))) (- (* pol_c px) (* pol_s py))))
(def npy (gswitch onset (* shimmer_v (+ (* main_x0 pol_im0) (* main_y0 pol_re0))) (+ (* pol_s px) (* pol_c py))))
(write-tensor-history pol_r npx)
(write-tensor-history pol_i npy)
;; The finger releases the string over about a millisecond (shorter for a
;; nail, longer for flesh); it also hides the phase-spread start step.
(make-history release_ramp)
(def ramp_samples (latch (* 0.001 samplerate (clip (* $release_ms (pow 2 (- 0 (clip (mod finger) -1 1)))) 0.2 4)) onset))
(def ramp (gswitch onset 0 (min 1 (+ (read-history release_ramp) (/ 1 (max 1 ramp_samples))))))
(write-history release_ramp ramp)
;; Body coupling: beside partials 1 and 2 the record shows a second, fast
;; pole (the string pulling a body resonance). It starts with the measured
;; complex amplitude relative to its string partial.
(def cpl_idx (+ (iota 2) (* (event-hold row update_tick) 2)))
(def cpl_hz (* (gather cpl_ratio_table cpl_idx) (+ (iota 2) 1) f0))
(def cpl_radius (exp (/ (- (gather cpl_rate_table cpl_idx)) samplerate)))
(def cpl_omega (* twopi (/ (min cpl_hz (* 0.49 samplerate)) samplerate)))
(def cpl_c (latch (* cpl_radius (cos cpl_omega)) update_tick))
(def cpl_s (latch (* cpl_radius (sin cpl_omega)) update_tick))
(def cpl_eq_i (floor (clip (* 2 (/ (log (/ (max cpl_hz $eq_lo) $eq_lo)) (log 2))) 0 $eq_last)))
(def cpl_eq (gather eq_table (min $eq_last_index cpl_eq_i)))
;; Same energy budget as the partials they sit beside: the measured EQ at
;; its recorded amount, the take's own tilt.
(def cpl_w (latch (* level energy_scale (exp (- cpl_eq (* row_alpha (log (+ (iota 2) 1)))))) onset))
(def cpl_re0 (latch (gather cpl_re_table cpl_idx) onset))
(def cpl_im0 (latch (gather cpl_im_table cpl_idx) onset))
(make-tensor-history cpl_r @shape [2])
(make-tensor-history cpl_i @shape [2])
(def cx (read-tensor-history cpl_r))
(def cy (read-tensor-history cpl_i))
(def ncx (gswitch onset (* cpl_w cpl_re0) (- (* cpl_c cx) (* cpl_s cy))))
(def ncy (gswitch onset (* cpl_w cpl_im0) (+ (* cpl_s cx) (* cpl_c cy))))
(write-tensor-history cpl_r ncx)
(write-tensor-history cpl_i ncy)
(def string_out (* (- 0.5 (* 0.5 (cos (* pi ramp)))) (+ (sum ny) (sum (* nhy hread)) (sum npy) (* (event-hold (clip (mod resonance) 0 3) update_tick) (sum ncy)))))

;; ---- finger contact noise -----------------------------------------------
(make-history contact_env)
(def contact_pole (exp (/ -1 (* $contact_s samplerate))))
(def contact_kick (* onset (clip (mod contact) 0 4) $contact_level
  (exp (peek level_table row)) (pow (max (clip velocity 0 1) 0.02) 1.5)))
(def contact_e (+ (* (read-history contact_env) contact_pole) contact_kick))
(write-history contact_env contact_e)
(def contact_noise (svf (* (- (* 2 (noise)) 1) contact_e) (min $contact_hz (* 0.45 samplerate)) 0.8 1))

;; ---- body resonances driven by the bridge (string + contact) -------------
(def body_rot_c (* (exp (/ (- body_rate_table) samplerate)) (cos (* twopi (/ body_hz_table samplerate)))))
(def body_rot_s (* (exp (/ (- body_rate_table) samplerate)) (sin (* twopi (/ body_hz_table samplerate)))))
(def body_norm (- 1 (exp (/ (- body_rate_table) samplerate))))
(def bridge (+ string_out contact_noise))
(make-tensor-history body_r @shape [$body_modes])
(make-tensor-history body_i @shape [$body_modes])
(def bx (read-tensor-history body_r))
(def by (read-tensor-history body_i))
;; The pluck also knocks the body directly: its air and top modes ring under
;; treble notes that have no partial near them.
(def knock (* onset (clip (mod resonance) 0 3) (exp (peek level_table row)) (pow (max (clip velocity 0 1) 0.02) 1.2)))
(def bnx (+ (- (* body_rot_c bx) (* body_rot_s by)) (* body_norm bridge) (* knock body_knock_table)))
(def bny (+ (* body_rot_s bx) (* body_rot_c by)))
(write-tensor-history body_r bnx)
(write-tensor-history body_i bny)
(def body_out (* (gtr-smooth (clip (mod resonance) 0 3) 8) (sum (* body_gain_table bny))))

(def cutoff (min (gtr-smooth (clip (mod tone_hz) 800 20000) 8) (* samplerate 0.43)))
(def output_gain (gtr-smooth (clip (mod gain) 0 4) 8))
(def mono_out (* output_gain (svf (+ string_out contact_noise body_out) cutoff 0.707 0)))
;; The reference is close to mono; both channels carry the same signal.
(out mono_out 1 @name left)
(out mono_out 2 @name right)

;; END GENERATED CALIBRATION

(defmacro ride-smooth (target ms)
  (make-history previous)
  (make-history ready)
  (def pole (exp (/ -1 (* 0.001 ms samplerate))))
  (def value (gswitch (read-history ready) (mix target (read-history previous) pole) target))
  (write-history previous value)
  (write-history ready 1)
  value)

;; Coefficients latch on every strike as well as each periodic control tick;
;; a periodic-only hop would miss the start of an off-grid strike. 64 samples
;; (1.3 ms at 48 kHz) keeps Tune/Decay modulation smooth while recomputing
;; ~500 modes' rotations a quarter as often as a 16-sample tick.
(def control_tick (eq (accum 1 0 0 64) 0))
(defmacro ride-hold (value tick) (event-hold value tick))
(defmacro ride-audio (value tick) (latch value tick))

(make-history last_gate)
(def held (gt gate 0.5))
(def onset (max (gt trigger 0.5) (* held (lte (read-history last_gate) 0.5))))
(write-history last_gate held)
(def update_tick (max control_tick onset))

(def hit_velocity (latch (clip velocity 0 1) onset))
(def key_note (+ 69 (* 12 (/ (log (/ (clip pitch 8.1758 12543.85) 440)) (log 2)))))
;; The cymbal is chosen on the strike; a later Character change applies to
;; the next hit, never to a ringing plate.
(def row (latch (round (clip (mod character) 0 5)) onset))
(def key_shift (latch (* (clip tracking 0 1) (clip (- key_note 60) -36 36)) onset))
;; Vector coefficients only run on event clocks: every input they read is
;; event-held, so the scheduler evaluates them on the coefficient tick (or the
;; strike frame), never per sample.
(def mode_indices (iota 480))
(def strike_row (ride-hold row onset))
(def tick_row (ride-hold row update_tick))
(def strike_indices (+ mode_indices (* strike_row 480)))
(def tick_indices (+ mode_indices (* tick_row 480)))

;; Size scales the plate: frequencies fall and rings lengthen together (a
;; geometric scaling heuristic, not a re-identified cymbal). Tune and
;; Tracking transpose.
(def size_v (ride-smooth (clip (mod size) 0.7 1.4) 8))
(def transpose (/ (pow 2 (/ (+ key_shift (ride-smooth (clip (mod tune) -12 12) 8)) 12)) size_v))
(def tick_hz (gather frequency_table tick_indices))
(def frequencies (* tick_hz (ride-hold transpose update_tick)))
(def omega (* twopi (/ (min frequencies (* 0.48 samplerate)) samplerate)))
(def rotation_cos (cos omega))
(def rotation_sin (sin omega))

;; Stick contact. The identified residues are the modes' responses to the
;; recorded stick. A shorter or longer live contact (hardness, and softer
;; hits when Vel > timbre is up) multiplies each mode by the exact complex
;; response ratio of normalized two-pole contact forces, live/reference,
;; evaluated only on the strike frame.
(def strike_hz (* (gather frequency_table strike_indices) (ride-hold transpose onset)))
(def reference_pole (exp (/ -1 (* 0.00025 samplerate))))
(def contact_tau (* 0.00025
  (pow 2 (* 3 (- 0.5 (clip (mod hardness) 0 1))))
  (+ 1 (* 1.5 (clip dynamics 0 1) (- 1 hit_velocity)))))
(def live_pole (exp (/ -1 (* (ride-hold contact_tau onset) samplerate))))
(def strike_omega (* twopi (/ (min strike_hz (* 0.48 samplerate)) samplerate)))
(def strike_cos (cos strike_omega))
(def strike_sin (sin strike_omega))
(def ref_re (- 1 (* reference_pole strike_cos)))
(def ref_im (* reference_pole strike_sin))
(def live_re (- 1 (* live_pole strike_cos)))
(def live_im (* live_pole strike_sin))
;; (ref / live), then squared for the two poles; guarded as the scheduler
;; zeroes event inputs between events.
(def live_norm (max 0.00000000000000000001 (+ (* live_re live_re) (* live_im live_im))))
(def q_re (/ (+ (* ref_re live_re) (* ref_im live_im)) live_norm))
(def q_im (/ (- (* ref_im live_re) (* ref_re live_im)) live_norm))
(def dc_ratio (/ (* (- 1 live_pole) (- 1 live_pole)) (* (- 1 reference_pole) (- 1 reference_pole))))
(def contact_re (* dc_ratio (- (* q_re q_re) (* q_im q_im))))
(def contact_im (* dc_ratio 2 q_re q_im))
(def band (clip (/ (- (* samplerate 0.47) strike_hz) (* samplerate 0.07)) 0 1))
;; A finite energy budget: a harder stick redistributes, never manufactures,
;; modal energy (squared residues are the energy proxy; modal masses unknown).
(def reference_residue (* (gather magnitude_table strike_indices) band))
(def contact_gain (+ (* contact_re contact_re) (* contact_im contact_im)))
(def energy_scale (min 1 (sqrt (/ (sum (* reference_residue reference_residue))
  (max 0.00000000000000000001 (sum (* reference_residue reference_residue contact_gain)))))))
;; Each strike injects its measured complex residue once, on top of whatever
;; the plate is still ringing, so close modes keep their recorded relative
;; phase and beat as they did on the record.
;; Bell reweights the cymbal's own dominant partials (1 = as struck): a bell
;; or bow stroke excites the same modes with a different balance.
(def bell_weight (+ 1 (* (- (clip (mod bell) 0 3) 1) (gather bell_table strike_indices))))
(def event_sin (* (gather sine_table strike_indices) bell_weight))
(def event_cos (* (gather cosine_table strike_indices) bell_weight))
(def event_scale (* (ride-hold hit_velocity onset) band energy_scale))
(def inject_r (ride-audio (ride-hold (* event_scale (- (* event_sin contact_re) (* event_cos contact_im))) onset) onset))
(def inject_i (ride-audio (ride-hold (* event_scale (+ (* event_sin contact_im) (* event_cos contact_re))) onset) onset))

;; Measured loss per mode. Decay scales the natural ring; Muffle is tape or a
;; resting finger whose loss grows with frequency; Choke grabs the cymbal
;; when the key is released.
(def decay_scale (ride-hold (ride-smooth (clip (mod decay) 0.2 3) 8) update_tick))
(def hand_loss (ride-hold (* 40 (pow (ride-smooth (clip (mod muffle) 0 1) 4) 2)) update_tick))
(def choke_loss (ride-hold (* 120 (pow (clip (mod choke) 0 1) 2) (ride-smooth (- 1 held) 6)) update_tick))
(def size_scale (ride-hold size_v update_tick))
(def rate (+ (/ (gather rate_table tick_indices) (* decay_scale size_scale))
  (* (+ hand_loss choke_loss) (sqrt (/ tick_hz 1000.0)))))


;; Wash. White noise through a third-octave bank (one vector of two cascaded
;; TPT state-variable band-passes per band, so a strong band does not leak
;; into the steep top octave; normalized to unit output variance), each
;; band's power envelope charged by the stroke's measured power, filling in
;; over the band's measured build-up time and decaying at its measured rate.
;; Powers add, as incoherent dense modes do. Hardness reshapes it with the same contact ratio as the modes.
(def wash_indices (+ (iota 21) (* strike_row 21)))
(def wash_tick_indices (+ (iota 21) (* tick_row 21)))
(def wash_hz (* wash_hz_table (ride-hold transpose update_tick)))
(def wash_open (gt (* 0.45 samplerate) wash_hz))
(def wash_g (tan (* pi (/ (min wash_hz (* 0.45 samplerate)) samplerate))))
(def wash_a1 (ride-audio (/ 1 (+ 1 (* wash_g (+ wash_g (/ 1 3.0))))) update_tick))
(def wash_a2 (ride-audio (* wash_g (/ 1 (+ 1 (* wash_g (+ wash_g (/ 1 3.0)))))) update_tick))
(def wash_a3 (ride-audio (* wash_g wash_g (/ 1 (+ 1 (* wash_g (+ wash_g (/ 1 3.0)))))) update_tick))
;; Two unit-peak band-passes (k·v1 each) have noise bandwidth (π/4)(f/Q);
;; uniform noise in [-1, 1] has variance 1/3.
(def wash_norm (ride-audio (* wash_open
  (sqrt (/ (* 1.5 samplerate) (* 0.25 pi (/ (max wash_hz 1) 3.0))))) update_tick))
(def wash_strike_hz (* wash_hz_table (ride-hold transpose onset)))
(def wash_omega (* twopi (/ (min wash_strike_hz (* 0.48 samplerate)) samplerate)))
(def wash_live_re (- 1 (* live_pole (cos wash_omega))))
(def wash_live_im (* live_pole (sin wash_omega)))
(def wash_ref_re (- 1 (* reference_pole (cos wash_omega))))
(def wash_ref_im (* reference_pole (sin wash_omega)))
(def wash_ratio (/ (+ (* wash_ref_re wash_ref_re) (* wash_ref_im wash_ref_im))
  (max 0.00000000000000000001 (+ (* wash_live_re wash_live_re) (* wash_live_im wash_live_im)))))
(def wash_contact (* wash_ratio wash_ratio dc_ratio dc_ratio))
(def wash_level (ride-hold (* (clip (mod wash) 0 2) (clip (mod wash) 0 2)) update_tick))
(def wash_velocity (* (ride-hold hit_velocity onset) energy_scale))
(def wash_velocity_power (* wash_contact wash_velocity wash_velocity))
(def wash_settle (ride-audio (exp (/ (- 0 (gather wash_buildup_table wash_tick_indices)) samplerate)) update_tick))
(defmacro ride-wash-power (power_table rate_table)
  (def inject (ride-audio (ride-hold (* (gather power_table wash_indices) wash_velocity_power) onset) onset))
  (def rate (+ (/ (gather rate_table wash_tick_indices) (* decay_scale size_scale))
    (* (+ hand_loss choke_loss) (sqrt (/ wash_hz_table 1000.0)))))
  (def fall (ride-audio (exp (/ (* -2 rate) samplerate)) update_tick))
  (make-tensor-history charge @shape [21])
  (def charged (+ (* (read-tensor-history charge) wash_settle) (* onset inject)))
  (write-tensor-history charge charged)
  (make-tensor-history power @shape [21])
  (def now (+ (* (read-tensor-history power) fall) (* charged (- 1 wash_settle))))
  (write-tensor-history power now)
  now)
;; A fast component carries the hit's early fill; a slow one the dense
;; floor between the partials that rings on with the plate.
(def wash_now (+ (ride-wash-power wash_fast_power_table wash_fast_rate_table)
  (ride-wash-power wash_slow_power_table wash_slow_rate_table)))
(def wash_gain (* (sqrt wash_now) wash_norm wash_level))

(defmacro ride-wash-stage (source)
  (make-tensor-history band_1 @shape [21])
  (make-tensor-history band_2 @shape [21])
  (def ic1 (read-tensor-history band_1))
  (def ic2 (read-tensor-history band_2))
  (def v3 (- source ic2))
  (def v1 (+ (* wash_a1 ic1) (* wash_a2 v3)))
  (def v2 (+ ic2 (* wash_a2 ic1) (* wash_a3 v3)))
  (write-tensor-history band_1 (- (* 2 v1) ic1))
  (write-tensor-history band_2 (- (* 2 v2) ic2))
  (/ v1 3.0))
(defmacro ride-wash-bank (source)
  (sum (* (ride-wash-stage (ride-wash-stage source)) wash_gain)))

(defmacro ride-plate (rotation_cos rotation_sin rate event inject_r inject_i tick)
  (make-tensor-history plate_r @shape [480])
  (make-tensor-history plate_i @shape [480])
  (def x (read-tensor-history plate_r))
  (def y (read-tensor-history plate_i))
  (def radius (exp (/ (- rate) samplerate)))
  (def c (ride-audio (* radius rotation_cos) tick))
  (def s (ride-audio (* radius rotation_sin) tick))
  (def next_r (+ (- (* c x) (* s y)) (* event inject_r)))
  (def next_i (+ (* s x) (* c y) (* event inject_i)))
  (write-tensor-history plate_r next_r)
  (write-tensor-history plate_i next_i)
  next_i)

(def modes (ride-plate rotation_cos rotation_sin rate onset inject_r inject_i update_tick))

;; Width scatters the modes across the stereo field with a fixed per-mode
;; pan (the references are mono); 0 is the recorded mono cymbal.
;; Linear pan, mid/side: one extra weighted sum instead of one per channel,
;; scaled so the average mode keeps its power ((1 ± w p)², p uniform).
;; Latched to audio rate: arithmetic on an event-held value is scheduled on
;; the event clock, which would leave the output alive on control ticks only.
(def spread (ride-audio (ride-hold (ride-smooth (clip (mod width) 0 1) 8) update_tick) update_tick))
(def plate_mid (sum modes))
(def plate_side (* (sum (* modes pan_table)) spread))
(def pan_norm (/ 1 (sqrt (+ 1 (/ (* spread spread) 3)))))
(def plate_left (* (- plate_mid plate_side) pan_norm))
(def plate_right (* (+ plate_mid plate_side) pan_norm))
;; Two independent noise sources; Width rotates the right channel from the
;; left's wash toward the second (equal power, correlation cos θ).
(def wash_a (ride-wash-bank (- (* 2 (noise)) 1)))
(def wash_b (ride-wash-bank (- (* 2 (noise)) 1)))
(def wash_angle (* 0.5 pi spread))
(def wash_left wash_a)
(def wash_right (+ (* wash_a (cos wash_angle)) (* wash_b (sin wash_angle))))

;; Stick contact noise measured above the modes: a click that falls in a
;; millisecond or two, centred where the recording's residual burst was.
(def click_level (latch (clip (mod click) 0 3) onset))
(make-history click_state)
(def click_pole (ride-audio (exp (/ -1 (* (ride-hold (peek click_decay_table row) onset) samplerate))) onset))
(def click_env (+ (* (read-history click_state) click_pole) (* onset (peek click_table row) hit_velocity click_level)))
(write-history click_state click_env)
(def click_hz (latch (* (peek click_hz_table row) (pow 2 (* 1.5 (clip (mod click_tone) -1 1)))) onset))
(def click_noise (svf (* (- (* 2 (noise)) 1) click_env) (min click_hz (* 0.45 samplerate)) 1.5 1))

(def drive_v (ride-smooth (clip (mod drive) 0 1) 8))
(def cutoff (min (ride-smooth (clip (mod tone_hz) 1000 20000) 8) (* samplerate 0.43)))
(def output_gain (ride-smooth (clip (mod gain) 0 4) 8))
(defmacro ride-drive (signal drive_v)
  (mix signal (/ (tanh (* signal (+ 1 (* drive_v 8)))) (+ 1 (* drive_v 2))) drive_v))
(def left_out (* (svf (ride-drive (+ plate_left wash_left click_noise) drive_v) cutoff 0.707 0) output_gain))
(def right_out (* (svf (ride-drive (+ plate_right wash_right click_noise) drive_v) cutoff 0.707 0) output_gain))
(out left_out 1 @name left)
(out right_out 2 @name right)

;; PM Ride (release 2) / six measured ride cymbals, one shared modal plate each.
;; Generated by tools/pm-ride2/build.py; edit engine.lisp.in, then regenerate.
;; Reference coefficients only: no PCM, recorded phase, or spectral frames.
;; Character chooses one of 6 measured cymbals (see ATTRIBUTION.md); it
;; never blends two. Each runs 448 of its own ring modes and 32 fast
;; attack modes with the measured complex residues of its stick strike; its
;; ~5200 weaker modes ring on as a band-limited wash with their measured
;; level, build-up and decay in 21 third-octave bands. In the default
;; one-cymbal voicing every hit lands on the same ringing plate. Every key
;; plays the cymbal; Tracking follows the key from MIDI 60.

(def gate (in 1 @name gate))
(def pitch (in 2 @name pitch))
(def velocity (in 3 @name velocity))
(def trigger (in 4 @name trigger))
(def clock (in 5 @name clock))
(def mod1 (in 6 @name mod1 @modulator 1))
(def mod2 (in 7 @name mod2 @modulator 2))
(def mod3 (in 8 @name mod3 @modulator 3))
(def mod4 (in 9 @name mod4 @modulator 4))

(param character @group cymbal @default 2 @min 0 @max 5 @mod true @mod-mode additive)
(param bell @group cymbal @default 1 @min 0 @max 3 @mod true @mod-mode additive)
(param size @group cymbal @default 1 @min 0.7 @max 1.4 @mod true @mod-mode additive)
(param tune @group cymbal @default 0 @min -12 @max 12 @unit st @mod true @mod-mode additive)
(param tracking @group cymbal @default 0 @min 0 @max 1)
(param hardness @group stick @default 0.5 @min 0 @max 1 @mod true @mod-mode additive)
(param dynamics @group stick @default 0.5 @min 0 @max 1)
(param click @group stick @default 1 @min 0 @max 3 @mod true @mod-mode additive)
(param click_tone @group stick @default 0 @min -1 @max 1 @mod true @mod-mode additive)
(param decay @group ring @default 1 @min 0.2 @max 3 @mod true @mod-mode additive)
(param muffle @group ring @default 0 @min 0 @max 1 @mod true @mod-mode additive)
(param wash @group ring @default 1 @min 0 @max 2 @mod true @mod-mode additive)
(param choke @group ring @default 0 @min 0 @max 1 @mod true @mod-mode additive)
(param width @group output @default 0.3 @min 0 @max 1 @mod true @mod-mode additive)
(param drive @group output @default 0 @min 0 @max 1 @mod true @mod-mode additive)
(param tone_hz @group output @default 20000 @min 1000 @max 20000 @unit Hz @mod true @mod-mode additive)
(param gain @group output @default 1 @min 0 @max 4 @mod true @mod-mode additive)
;; Host voice mode (instrument.json voice_controls): 1 = one cymbal.
(param voice_mode @default 1 @min 0 @max 3)


;; PM Milagre Brass — a valveless lip-reed horn identified from the opening
;; phrase of "Bodas (Ao Vivo)" (Milton Nascimento, Milagre Dos Peixes).
;; Generated by tools/pm-milagre-brass/build.py from fit.json; edit the
;; template (engine.lisp.in), not this file.
;;
;; Driven lip valve + modal bore. The player's lip tension sets the buzz
;; frequency, so the note is exactly in tune. The Bernoulli flow through the
;; lip opening is solved in closed form against the bore's input impedance:
;; ${modes} resonances whose frequency ratios and peak heights were identified
;; from the recording (they are not an ideal harmonic series: that is why the
;; pedal A2 has a weak fundamental and strong 3rd and 6th harmonics), plus the
;; characteristic impedance above the bell cutoff. Blowing harder opens the
;; lips further, so the tone brightens with breath. The horn is valveless: a
;; note sounds as the nearest partial of the Horn key (the reference plays
;; partials 1, 3, 5 and 6 of a 112 Hz horn) and the bore is scaled so that
;; partial lands exactly on the played pitch.

(def mod1 (in 6 @name mod1 @modulator 1))
(def mod2 (in 7 @name mod2 @modulator 2))
(def mod3 (in 8 @name mod3 @modulator 3))
(def mod4 (in 9 @name mod4 @modulator 4))

(defmacro mb-smooth (target ms)
  (make-history previous)
  (make-history ready)
  (def coefficient (exp (/ -1 (* 0.001 (max ms 0.1) samplerate))))
  (def value (gswitch (read-history ready) (mix target (read-history previous) coefficient) target))
  (write-history previous value)
  (write-history ready 1)
  value)

(defmacro mb-glide (target ms reset)
  (make-history previous)
  (make-history ready)
  (def coefficient (exp (/ -1 (* 0.001 (max ms 0.1) samplerate))))
  (def jump (max (gt reset 0.5) (lt (read-history ready) 0.5)))
  (def value (gswitch jump target (mix target (read-history previous) coefficient)))
  (write-history previous value)
  (write-history ready 1)
  value)

;; RBJ peaking section; the fitted body gain is scaled by `amount`.
(defmacro mb-peak (input hz q db amount)
  (make-history x1)
  (make-history x2)
  (make-history y1)
  (make-history y2)
  (def w0 (/ (* twopi (min hz (* 0.45 samplerate))) samplerate))
  (def alpha (/ (sin w0) (* 2 q)))
  (def big_a (pow 10 (/ (* db amount) 40)))
  (def a0 (+ 1 (/ alpha big_a)))
  (def b0 (/ (+ 1 (* alpha big_a)) a0))
  (def b1 (/ (* -2 (cos w0)) a0))
  (def b2 (/ (- 1 (* alpha big_a)) a0))
  (def a2 (/ (- 1 (/ alpha big_a)) a0))
  (def y (- (+ (* b0 input) (* b1 (read-history x1)) (* b2 (read-history x2)))
            (* b1 (read-history y1)) (* a2 (read-history y2))))
  (write-history x2 (read-history x1))
  (write-history x1 input)
  (write-history y2 (read-history y1))
  (write-history y1 y)
  y)

(defmacro mb-comb (input ms feedback damp)
  (make-history fb)
  (make-history lp)
  (def d (delay (+ input (* feedback (read-history lp))) (* 0.001 ms samplerate)))
  (def l (mix d (read-history lp) damp))
  (write-history fb d)
  (write-history lp l)
  d)

(defmacro mb-allpass (input ms g)
  (make-history h)
  (def d (delay (read-history h) (* 0.001 ms samplerate)))
  (def v (+ input (* g d)))
  (write-history h v)
  (- d (* g v)))

;; The hall the reference was recorded in: four damped combs and two
;; allpasses; `decay` is the hall's T60 in seconds.
(defmacro mb-hall (input decay damp)
  (def t60 (max decay 0.05))
  (def c1 (mb-comb input 37.1 (pow 0.001 (/ 0.0371 t60)) damp))
  (def c2 (mb-comb input 41.3 (pow 0.001 (/ 0.0413 t60)) damp))
  (def c3 (mb-comb input 47.9 (pow 0.001 (/ 0.0479 t60)) damp))
  (def c4 (mb-comb input 53.3 (pow 0.001 (/ 0.0533 t60)) damp))
  (mb-allpass (mb-allpass (* 0.25 (+ c1 c2 c3 c4)) 5.1 0.6) 1.7 0.6))

(param voice_mode @default 1 @min 0 @max 3)
(param breath @group blow @default ${breath} @min 0 @max 3 @mod true @mod-mode additive)
(param breath_ms @group blow @default ${breath_ms} @min 1 @max 300 @unit ms)
(param vel_breath @group blow @default 0.5 @min 0 @max 1)
(param pressure @group blow @default ${pressure} @min 0 @max 20 @mod true @mod-mode additive)
(param reg_breath @group blow @default ${kappa} @min 0 @max 3 @mod true @mod-mode additive)
(param air @group blow @default ${air} @min 0 @max 0.5 @mod true @mod-mode additive)
(param buzz @group lips @default ${buzz} @min 0 @max 8 @mod true @mod-mode additive)
(param buzz_curve @group lips @default ${buzz_curve} @min 0.2 @max 3)
(param register @group lips @default ${register} @min -1 @max 2.5 @mod true @mod-mode additive)
(param lips @group lips @default ${lips} @min -1.5 @max 1.5 @mod true @mod-mode additive)
(param horn @group bore @default 45 @min 24 @max 72 @unit st)
(param impedance @group bore @default 1 @min 0.1 @max 4 @mod true @mod-mode multiplicative)
(param bore_q @group bore @default 1 @min 0.2 @max 4 @mod true @mod-mode multiplicative)
(param bell_hz @group bore @default ${bell_hz} @min 300 @max 8000 @unit Hz @mod true @mod-mode additive)
(param tune @group pitch @default ${tune} @min -100 @max 100 @unit cents @mod true @mod-mode additive)
(param slide @group pitch @default ${slide} @min 0 @max 300 @unit ms)
(param vib_cent @group pitch @default ${vib_cent} @min 0 @max 50 @unit cents @mod true @mod-mode additive)
(param vib_hz @group pitch @default ${vib_hz} @min 0.1 @max 8 @unit Hz @mod true @mod-mode additive)
(param attack @group amp @env amp-env @role attack @default ${attack} @min 1 @max 1000 @unit ms)
(param decay @group amp @env amp-env @role decay @default 100 @min 1 @max 2000 @unit ms)
(param sustain @group amp @env amp-env @role sustain @default 1 @min 0 @max 1)
(param release @group amp @env amp-env @role release @default ${release} @min 1 @max 3000 @unit ms)
(param body @group room @default 1 @min 0 @max 1.5 @mod true @mod-mode additive)
(param hall @group room @default ${hall} @min 0 @max 1 @mod true @mod-mode additive)
(param hall_s @group room @default ${hall_s} @min 0.2 @max 6 @unit s)
(param gain @default 0.5 @min 0 @max 1 @mod true @mod-mode additive)

(def gate (in 1 @name gate))
(def pitch (in 2 @name pitch))
(def velocity (in 3 @name velocity))
(def trigger (in 4 @name trigger))
(def clock (in 5 @name clock))

(def detune (pow 2 (/ (clip (mod tune) -100 100) 1200)))
(def vibrato (pow 2 (/ (* (clip (mod vib_cent) 0 50) (sin (* twopi (phasor (clip (mod vib_hz) 0.1 8))))) 1200)))
(def aim (* pitch detune))
;; Slurs glide in log frequency; a tongued (retriggered) note starts on pitch.
(def played (exp (mb-glide (log aim) slide trigger)))
(def horn_hz (* 440 detune (pow 2 (/ (- horn 69) 12))))
;; The partial follows the note, not the gliding lips: a slur on a natural
;; horn changes the lip tension while the bore stays put.
(def partial (max 1 (floor (+ 0.5 (/ aim horn_hz)))))

(def env (adsr gate trigger attack decay sustain release))
(def blow (mb-smooth (* (clip (mod breath) 0 3) (mix 1 (clip velocity 0 1) vel_breath)) breath_ms))
(def b (* env blow))
;; Register law: a higher partial speaks with proportionally less breath, so
;; the same Breath gives the same dynamic on every note.
(def register_breath (mb-smooth (pow (/ aim horn_hz) (- (clip (mod reg_breath) 0 3))) slide))
(def be (* b ${breath_scale} register_breath))
${horn_chain}

(def amount (clip (mod body) 0 1.5))
${body_chain}
(def dry (* ${trim} bodied))
(def wet (mb-hall dry hall_s 0.35))
(def mixed (+ dry (* (clip (mod hall) 0 1) wet)))
;; Transparent at playing levels (under 0.5 dB at the reference phrase's loudest peak), bounded at extremes.
(out (* 2 (tanh (* mixed (clip (mod gain) 0 1)))) 1 @name audio)

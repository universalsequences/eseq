  ; ---- dispersion path (enable_dispersion, string 0 in models 2 and 5)
  (make-history h_dn)
  (make-history h_cb)
  (make-history h_ca)
  (make-history h_dcx)
  (make-history h_dcy)
  (def (dv dv_before) (rg-tick-interp dispersion tick bstart active 0))
  (def noise (/ (- (* 2 u) 1) (+ 0.2 nfilt)))
  (def dn_prev (read-history h_dn))
  (def dn (+ dn_prev (* nfilt (- noise dn_prev))))
  (def stretch_point (gswitch (lte dv 0) 0 (* dv (- 2 dv) 0.475)))
  (def na0 (gswitch (gt dv 0.75) (* 4 (- dv 0.75)) 0))
  (def noise_amount (* na0 na0 0.025))
  (def bc0 (gswitch (lt dv 0) (- dv) 0))
  (def bridge_curving (* bc0 bc0 0.01))
  (def ap_gain (/ (* -0.618 dv) (+ 0.15 (abs dv))))
  (def cb_prev (read-history h_cb))
  (def dl_fm (* dl (- (+ 1 (* dn noise_amount)) (* cb_prev bridge_curving))))
  (def ap_delay (* dl_fm stretch_point))
  (def main_delay (- dl_fm ap_delay))
  (def use_ap (* disp (gte ap_delay 4) (gte main_delay 4)))
  (def ca (read-history h_ca))
  (def s_main (rg-hermite line c (gswitch disp (gswitch use_ap main_delay dl_fm) dl)))
  (def ap_read (rg-tap ap ca (floor ap_delay)))
  (def ap_write (+ s_main (* ap_gain ap_read)))
  (def s_ap (gswitch use_ap (+ (* (- ap_write) ap_gain) ap_read) s_main))
  ; String::dc_blocker_ (1 - 20 / 48000), on the dispersion path only
  (def dcy (+ (* (read-history h_dcy) (- 1 (/ 20 samplerate))) s_ap (- (read-history h_dcx))))
  (def s_bl (+ s_ap (* bc0 (- dcy s_ap))))
  (def bv (- (abs s_bl) 0.025))
  (def cb_new (* (+ (abs bv) bv) (gswitch (gt s_bl 0) 1 -1.5)))
  (def drun (* tick active disp))
  (write-history h_dn (gswitch drun dn (* active dn_prev)))
  (write-history h_cb (gswitch drun cb_new (* active cb_prev)))
  (write-history h_dcx (gswitch drun s_ap (* active (read-history h_dcx))))
  (write-history h_dcy (gswitch drun dcy (* active (read-history h_dcy))))
  (def s_read (seq (poke ap ca (* active ap_write))
                   (gswitch disp s_bl s_main)))
  (write-history h_ca (% (+ ca (* tick (max use_ap (- 1 active)))) 1024))

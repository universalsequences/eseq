; One String (string.cc ProcessInternal per-sample body) with its delay
; memory `line`.@DOC@ Ungated: with `active` = 0 it ticks every sample, writes
; zeros and clears its state. Returns (out aux): the string output and the
; comb-filter pickup read.
(defmacro @NAME@ (line @APARG@exc @UARG@bstart active @DISPARG@src_full src_ratio
                  dly cpos dcoef bright g h dcomp @NFARG@)
  (make-history h_ph)
  (make-history h_x1)
  (make-history h_x2)
  (make-history h_s1)
  (make-history h_s2)
  (make-history h_c)
  (make-history h_o0)
  (make-history h_o1)
  (make-history h_a0)
  (make-history h_a1)
  ; linear-interpolation SRC below 48000 / 2044 Hz
  (def ph1 (+ (gswitch src_full 1 (read-history h_ph)) src_ratio))
  (def tick (max (gt ph1 1) (- 1 active)))
  (def ph (- ph1 (gt ph1 1)))
  ; interpolated parameters (String::Init: delay_ = 1 / (220 / 48000))
  (def (d0 d_before) (rg-tick-interp dly tick bstart active 218.18182))
  (def (pos pos_before) (rg-tick-interp cpos tick bstart active 0))
  (def (dc dc_before) (rg-tick-interp dcomp tick bstart active 0))
  (def (fir_damp_next fir_damp) (rg-tick-interp dcoef tick bstart active 0))
  (def (fir_br_next fir_br) (rg-tick-interp bright tick bstart active 0))
  (def comb_delay (* d0 pos))
  (def dl (- (* d0 dc) 1))
  (def c (read-history h_c))
@DISP@
  ; ---- input, FIR damping (DampingFilter), IIR damping (Svf LP, q 0.5)
  (def s1 (clip (+ s_read exc) -20 20))
  (def x1 (read-history h_x1))
  (def x2 (read-history h_x2))
  (def fir (* fir_damp (+ (* (+ 1 fir_br) 0.5 x1) (* (- 1 fir_br) 0.25 (+ s1 x2)))))
  (def st1 (read-history h_s1))
  (def st2 (read-history h_s2))
  (def fhp (* (- fir (* 2 st1) (* g st1) st2) h))
  (def fbp (+ (* g fhp) st1))
  (def flp (* active (+ (* g fbp) st2)))
  ; aux: DelayLine::Read(comb_delay) right after the write (the write is
  ; sequenced first; d = 1 is the sample just written, d = 0 the oldest)
  (def aux_new (* active (seq (poke line c flp) (rg-tap line (+ c 1) comb_delay))))
  (def o0_prev (read-history h_o0))
  (def o1_prev (read-history h_o1))
  (def a0_prev (read-history h_a0))
  (def a1_prev (read-history h_a1))
  (def o0 (* active (gswitch tick flp o0_prev)))
  (def o1 (* active (gswitch tick o0_prev o1_prev)))
  (def a0 (* active (gswitch tick aux_new a0_prev)))
  (def a1 (* active (gswitch tick a0_prev a1_prev)))
  (def run (* tick active))
  (def out_s (+ o1 (* (- o0 o1) ph)))
  (def aux_s (+ a1 (* (- a0 a1) ph)))
  (write-history h_ph (* active ph))
  (write-history h_c (% (+ c tick) 2048))
  (write-history h_x1 (gswitch run s1 (* active x1)))
  (write-history h_x2 (gswitch run x1 (* active x2)))
  (write-history h_s1 (gswitch run (+ (* g fhp) fbp) (* active st1)))
  (write-history h_s2 (gswitch run (+ (* g fbp) flp) (* active st2)))
  (write-history h_o0 o0)
  (write-history h_o1 o1)
  (write-history h_a0 a0)
  (write-history h_a1 a1)
  (tuple out_s aux_s))

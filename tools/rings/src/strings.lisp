  (def lo8 (* lo4 lo4))
  (def hi (- 2 (* 2 x)))
  (def hi2 (* hi hi))
  (def hi4 (* hi2 hi2))
  (def hi8 (* hi4 hi4))
  (gswitch (lt x 0.5) (* 0.5 lo8 lo8) (- 1 (* 0.5 hi8 hi8))))


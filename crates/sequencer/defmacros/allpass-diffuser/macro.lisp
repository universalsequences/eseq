(defmacro allpass-diffuser (in_l in_r gain size)
  (make-history hl1)
  (make-history hl2)
  (make-history hl3)
  (make-history hl4)
  (make-history hr1)
  (make-history hr2)
  (make-history hr3)
  (make-history hr4)
  (def g (clip gain 0.0 0.95))
  (def n149 149.0)
  (def n173 173.0)
  (def n313 313.0)
  (def n347 347.0)
  (def n571 571.0)
  (def n607 607.0)
  (def n887 887.0)
  (def n911 911.0)
  (def s (max size 0.05))
  (def mul-0 (* n149 s))
  (def dl1 (delay (read-history hl1) mul-0))
  (def mul-1 (* g dl1))
  (def mul-12 (* n173 s))
  (def dr1 (delay (read-history hr1) mul-12))
  (def mul-13 (* g dr1))
  (def mul-15 (* n313 s))
  (def dr2 (delay (read-history hr2) mul-15))
  (def mul-16 (* g dr2))
  (def mul-18 (* n607 s))
  (def dr3 (delay (read-history hr3) mul-18))
  (def mul-19 (* g dr3))
  (def mul-21 (* n911 s))
  (def dr4 (delay (read-history hr4) mul-21))
  (def mul-22 (* g dr4))
  (def mul-3 (* n347 s))
  (def dl2 (delay (read-history hl2) mul-3))
  (def mul-4 (* g dl2))
  (def mul-6 (* n571 s))
  (def dl3 (delay (read-history hl3) mul-6))
  (def mul-7 (* g dl3))
  (def mul-9 (* n887 s))
  (def dl4 (delay (read-history hl4) mul-9))
  (def mul-10 (* g dl4))
  (def wl1 (+ in_l mul-1))
  (def mul-2 (* g wl1))
  (def out_l1 (- dl1 mul-2))
  (def wl2 (+ out_l1 mul-4))
  (def mul-5 (* g wl2))
  (def out_l2 (- dl2 mul-5))
  (def wl3 (+ out_l2 mul-7))
  (def mul-8 (* g wl3))
  (def out_l3 (- dl3 mul-8))
  (def wl4 (+ out_l3 mul-10))
  (def mul-11 (* g wl4))
  (def out_l4 (- dl4 mul-11))
  (def wr1 (+ in_r mul-13))
  (def mul-14 (* g wr1))
  (def out_r1 (- dr1 mul-14))
  (def wr2 (+ out_r1 mul-16))
  (def mul-17 (* g wr2))
  (def out_r2 (- dr2 mul-17))
  (def wr3 (+ out_r2 mul-19))
  (def mul-20 (* g wr3))
  (def out_r3 (- dr3 mul-20))
  (def wr4 (+ out_r3 mul-22))
  (def mul-23 (* g wr4))
  (def out_r4 (- dr4 mul-23))
  (write-history hl1 wl1)
  (write-history hl2 wl2)
  (write-history hl3 wl3)
  (write-history hl4 wl4)
  (write-history hr1 wr1)
  (write-history hr2 wr2)
  (write-history hr3 wr3)
  (write-history hr4 wr4)
  (tuple out_l4 out_r4))

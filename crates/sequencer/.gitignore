# Rust build output
/target/

# OS and editor state
.DS_Store
/.claude/
/.eseqlisp-scratch
**/__pycache__/
*.pyc

# Local sequencer data
/samples/
/samples.backup.*/
/sample-assets/
/samples.db
/recordings/
/projects/
/projects.backup.*/
/instruments-backup/

# Native build and DGenLisp output
/audiograph/*.o
/audiograph/tests/test_*
!/audiograph/tests/*.c
/patch.c
/patch.dylib
/patch.json
/tools/*.bak-*
# Staged hermetic dgen toolchain (~147 MB): vendored by rebuild_dgenlisp_tool.sh,
# recorded by the committed tools/dgen-toolchain.lock — never committed itself.
/tools/dgen-toolchain/
/tools/dgen-toolchain.staging.*/

# Diagnostics and accidental temporary output
/sequencer-crash.log
/sequencer-profile
/$TMP_PLACEHOLDER

# Local configuration
.env

# Rust build output
/target/

# OS and editor state
.DS_Store
/.claude/
/.eseqlisp-scratch
**/__pycache__/
*.pyc

# Generated crate-local output (runtime user data lives in the repo's .local/).
/filter-tables/
/instruments-backup/

# Native build and DGenLisp output
/audiograph/*.o
/audiograph/tests/test_*
!/audiograph/tests/*.c
/patch.c
/patch.dylib
/patch.json
/tools/*.bak-*
# Staged hermetic dgen toolchain (~147 MB): vendored by rebuild_dgenlisp_tool.sh,
# recorded by the committed content/dgen-toolchain.lock — never committed itself.
/tools/dgen-toolchain/
/tools/dgen-toolchain.staging.*/
# DGenLisp compiler distributions: not tracked; scripts/fetch_dgenlisp.sh at the
# repo root installs the release pinned in the committed content/dgenlisp.lock.
/tools/DGenLisp-*

# Diagnostics and accidental temporary output
/sequencer-crash.log
/sequencer-profile
/$TMP_PLACEHOLDER

# Local configuration
.env

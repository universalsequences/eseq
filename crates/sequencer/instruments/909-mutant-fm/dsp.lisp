; 909 Dropdown Drum Synth
; TR-909-inspired selectable drum voice: one synth engine, dropdown-per-instrument.
; Voices: kick, snare, low/mid/high tom, rim, clap, closed/open hat, ride, crash.
; FM/ratio controls now touch every voice family, including clap and metallic cymbals.

(def gate (in 1 @name gate))
(def pitch (in 2 @name pitch))
(def velocity (in 3 @name velocity))
(def trigger (in 4 @name trigger))
(def mod1 (in 5 @name mod1 @modulator 1))
(def mod2 (in 6 @name mod2 @modulator 2))
(def mod3 (in 7 @name mod3 @modulator 3))
(def mod4 (in 8 @name mod4 @modulator 4))
(def mod5 (in 9 @name mod5 @modulator 5))
(def mod6 (in 10 @name mod6 @modulator 6))
(def ext1 (in 11 @name ext1 @modulator 7))
(def ext2 (in 12 @name ext2 @modulator 8))
(def ext3 (in 13 @name ext3 @modulator 9))
(def ext4 (in 14 @name ext4 @modulator 10))

(defmacro sq (freq)
  (- (* (lt (phasor freq) 0.5) 2) 1))

(defmacro tri (phase)
  (- (* 4 (abs (- phase 0.5))) 1))

(defmacro oscshape (phase freq shape width)
  (selector shape
    (sin (* phase twopi))
    (polyblep_saw phase freq)
    (polyblep_pulse phase width freq)
    (tri phase)))

(param voice @default 1 @min 1 @max 11)
(param body_wave @default 0 @min 0 @max 3)
(param filter_mode @default 0 @min 0 @max 5)

(param amp_attack @default 0.6 @min 0.1 @max 60 @unit ms)
(param decay @default 520 @min 12 @max 4500 @unit ms @mod true @mod-mode additive)
(param amp_release @default 18 @min 2 @max 1200 @unit ms)

(param tune @default 0 @min -36 @max 36 @mod true @mod-mode additive)
(param keytrack @default 0.40 @min 0 @max 1)
(param pitch_sweep @default 32 @min -72 @max 96 @mod true @mod-mode additive)
(param sweep_decay @default 36 @min 2 @max 700 @unit ms)
(param sweep_curve @default 1.25 @min 0.25 @max 5.0)
(param punch @default 0.68 @min 0 @max 1 @mod true @mod-mode additive)

(param body_level @default 0.92 @min 0 @max 1.7 @mod true @mod-mode additive)
(param sub_level @default 0.42 @min 0 @max 1.7 @mod true @mod-mode additive)
(param noise_level @default 0.54 @min 0 @max 1.7 @mod true @mod-mode additive)
(param metal_level @default 0.60 @min 0 @max 1.7 @mod true @mod-mode additive)
(param click_level @default 0.58 @min 0 @max 1.7 @mod true @mod-mode additive)
(param snap @default 0.64 @min 0 @max 1 @mod true @mod-mode additive)

(param body_ratio @default 1.00 @min 0.25 @max 8.0 @mod true @mod-mode additive)
(param partial_spread @default 0.72 @min 0 @max 2.5 @mod true @mod-mode additive)
(param membrane_fm @default 0.18 @min 0 @max 8 @mod true @mod-mode additive)
(param cross_ring @default 0.12 @min 0 @max 1 @mod true @mod-mode additive)
(param pulse_width @default 0.50 @min 0.05 @max 0.95 @mod true @mod-mode additive)

(param noise_color @default 0.72 @min 0 @max 1 @mod true @mod-mode additive)
(param noise_res @default 1.15 @min 0.5 @max 6.0 @mod true @mod-mode additive)
(param metal_tune @default 1.00 @min 0.20 @max 4.5 @mod true @mod-mode additive)
(param metal_spread @default 0.82 @min 0 @max 2.5 @mod true @mod-mode additive)
(param hats_decay @default 210 @min 8 @max 2600 @unit ms @mod true @mod-mode additive)

(param tone @default 0.70 @min 0 @max 1 @mod true @mod-mode additive)
(param resonance @default 0.78 @min 0.5 @max 5.5 @mod true @mod-mode additive)
(param drive @default 1.85 @min 0.2 @max 14 @mod true @mod-mode additive)
(param fold @default 0.08 @min 0 @max 1 @mod true @mod-mode additive)
(param crush @default 0.04 @min 0 @max 1 @mod true @mod-mode additive)
(param gain @default 0.38 @min 0 @max 1 @mod true @mod-mode additive)

(def v (clip (floor voice) 1 11))
(def wave (clip (floor body_wave) 0 3))
(def fmode (clip (floor filter_mode) 0 5))

(def dec (clip (mod decay) 12 4500))
(def hatdec (clip (mod hats_decay) 8 2600))
(def tune_mul (pow 2 (/ (clip (mod tune) -36 36) 12)))
(def key_mul (pow (clip (/ pitch 261.6256) 0.125 8.0) keytrack))
(def pmul (* tune_mul key_mul))
(def bratio (clip (mod body_ratio) 0.25 8.0))
(def spread (clip (mod partial_spread) 0 2.5))
(def pw (clip (mod pulse_width) 0.05 0.95))
(def snapv (clip (mod snap) 0 1))
(def punchv (clip (mod punch) 0 1))
(def bodyv (clip (mod body_level) 0 1.7))
(def subv (clip (mod sub_level) 0 1.7))
(def noisev (clip (mod noise_level) 0 1.7))
(def metalv (clip (mod metal_level) 0 1.7))
(def clickv (clip (mod click_level) 0 1.7))
(def nc (clip (mod noise_color) 0 1))
(def nq (clip (mod noise_res) 0.5 6.0))
(def mtune (clip (mod metal_tune) 0.20 4.5))
(def mspread (clip (mod metal_spread) 0 2.5))
(def xring (clip (mod cross_ring) 0 1))
(def fmamt (clip (mod membrane_fm) 0 8))

(def amp_env (adsr gate trigger amp_attack dec 0 amp_release))
(def fast_env (adsr gate trigger 0.15 (clip (* dec 0.055) 3 220) 0 4))
(def snap_env (adsr gate trigger 0.12 (clip (* dec (+ 0.025 (* 0.20 snapv))) 3 520) 0 4))
(def sweep_env_raw (adsr gate trigger 0.2 sweep_decay 0 4))
(def sweep_env (pow (clip sweep_env_raw 0 1) sweep_curve))
(def sweep_mul (pow 2 (/ (* (clip (mod pitch_sweep) -72 96) sweep_env) 12)))

; Global ratio/FM operators used as coloration in non-membrane voices too.
(def ratio_base (clip (* 185 pmul bratio) 28 6200))
(def ratio_mod_a (sin (* (phasor (* ratio_base (+ 1.19 (* spread 0.31)))) twopi)))
(def ratio_mod_b (sin (* (phasor (* ratio_base (+ 2.03 (* spread 0.57)))) twopi)))
(def ratio_pm (* fmamt (+ 0.10 (* 0.52 fast_env)) (+ (* 0.72 ratio_mod_a) (* 0.36 ratio_mod_b))))
(def ratio_car_a (sin (+ (* (phasor ratio_base) twopi) ratio_pm)))
(def ratio_car_b (sin (+ (* (phasor (* ratio_base (+ 1.62 (* spread 0.44)))) twopi) (* 0.72 ratio_pm))))
(def ratio_fm_mix (+ (* 0.62 ratio_car_a) (* 0.38 ratio_car_b) (* xring 0.32 ratio_car_a ratio_mod_a)))
(def ratio_air (svf ratio_fm_mix (+ 1600 (* nc 7600)) (+ 0.7 (* nq 0.18)) 2))
(def ratio_mid (svf ratio_fm_mix (+ 520 (* nc 2400)) (+ 0.9 (* nq 0.28)) 1))

(def n (noise))
(def n_bp (svf n (+ 520 (* nc 9800)) nq 1))
(def n_lp (svf n (+ 650 (* nc 12500)) (+ 0.6 (* nq 0.22)) 0))
(def n_hp (svf n (+ 1300 (* nc 14500)) (+ 0.6 (* nq 0.20)) 2))
(def n_bright (svf n (+ 3800 (* nc 10800)) (+ 0.7 (* nq 0.18)) 2))
(def n_mix (+ (* (- 1 nc) n_lp) (* nc n_hp) (* 0.55 n_bp) (* xring 0.06 ratio_mid)))

; 909-ish metal oscillator bank: six detuned square VCOs plus a ratio/FM layer
; so BODY RATIO / SPREAD / MEMBRANE FM also bend hats, rides, and crashes.
(def metal_bank_raw
  (+ (* 0.20 (sq (* 204 mtune (+ 1 (* 0.08 mspread)) pmul bratio)))
     (* 0.18 (sq (* 298 mtune (+ 1 (* 0.23 mspread)) pmul (+ 0.85 (* 0.15 bratio)))))
     (* 0.16 (sq (* 366 mtune (+ 1 (* 0.41 mspread)) pmul (+ 0.70 (* 0.30 bratio)))))
     (* 0.15 (sq (* 515 mtune (+ 1 (* 0.69 mspread)) pmul (+ 0.55 (* 0.45 bratio)))))
     (* 0.13 (sq (* 754 mtune (+ 1 (* 1.04 mspread)) pmul (+ 0.45 (* 0.55 bratio)))))
     (* 0.10 (sq (* 1018 mtune (+ 1 (* 1.62 mspread)) pmul (+ 0.35 (* 0.65 bratio)))))))
(def metal_fm_base (clip (* 310 mtune pmul bratio) 80 9000))
(def metal_fm_mod (sin (* (phasor (* metal_fm_base (+ 1.37 (* spread 0.37) (* mspread 0.22)))) twopi)))
(def metal_fm_a (sin (+ (* (phasor metal_fm_base) twopi) (* fmamt 0.24 (+ 0.30 fast_env) metal_fm_mod))))
(def metal_fm_b (sin (+ (* (phasor (* metal_fm_base (+ 2.11 (* spread 0.52)))) twopi) (* fmamt 0.18 metal_fm_a))))
(def metal_fm_layer (+ (* 0.52 metal_fm_a) (* 0.31 metal_fm_b) (* xring 0.42 metal_fm_a metal_fm_mod)))
(def metal_bank (+ metal_bank_raw (* 0.34 metal_fm_layer)))
(def metal_hp (svf metal_bank (+ 2200 (* nc 10400)) (+ 0.75 (* nq 0.25)) 2))
(def metal_bp (svf metal_bank (+ 1300 (* nc 8200)) (+ 0.85 (* nq 0.35)) 1))

; KICK: punchy swept sine with short click and soft overdrive.
(def kick_f (clip (* 50 pmul bratio sweep_mul) 18 1100))
(def kick_phase (phasor kick_f))
(def kick_click_env (adsr gate trigger 0.08 (clip (+ 5 (* 45 punchv)) 5 55) 0 3))
(def kick_body (* amp_env (sin (+ (* kick_phase twopi) (* fmamt fast_env (sin (* (phasor (* kick_f (+ 1.70 (* spread 0.31)))) twopi)))))))
(def kick_sub (* amp_env (sin (* (phasor (clip (* kick_f 0.50) 12 260)) twopi))))
(def kick_punch (* punchv fast_env (sin (+ (* (phasor (* kick_f (+ 2.00 (* spread 0.22)))) twopi) (* 0.20 ratio_pm)))))
(def kick_click (* kick_click_env (+ (* 0.72 n_bright) (* 0.28 metal_hp) (* 0.10 ratio_air))))
(def kick (+ (* bodyv 1.35 kick_body) (* subv 0.76 kick_sub) (* bodyv 0.36 kick_punch) (* clickv snapv 0.48 kick_click)))

; SNARE: two tuned shells plus bright filtered noise.
(def sn_env (adsr gate trigger 0.25 (clip (* dec 0.66) 25 1900) 0 amp_release))
(def sn_noise_env (adsr gate trigger 0.20 (clip (* dec 0.52) 20 1400) 0 6))
(def sn_f1 (clip (* 184 pmul bratio (pow 2 (/ (* 0.12 (clip (mod pitch_sweep) -72 96) sweep_env) 12))) 70 2300))
(def sn_f2 (* sn_f1 (+ 1.47 (* spread 0.42))))
(def snp1 (sin (* (phasor sn_f1) twopi)))
(def snp2 (sin (+ (* (phasor sn_f2) twopi) (* fmamt 0.22 sn_env snp1))))
(def sn_body (* sn_env (+ (* 0.62 snp1) (* 0.43 snp2) (* xring 0.30 snp1 snp2))))
(def snare (+ (* bodyv 0.78 sn_body) (* noisev (+ 0.35 (* 1.05 snapv)) (+ n_mix (* 0.08 ratio_air)) sn_noise_env) (* clickv 0.22 snapv (+ n_bright (* 0.20 ratio_air)) snap_env)))

; TOMS: pitched decaying sine/triangle drums with light attack noise.
(def lot_env (adsr gate trigger 0.35 (clip (* dec 0.98) 60 2600) 0 amp_release))
(def mid_env (adsr gate trigger 0.30 (clip (* dec 0.82) 45 2300) 0 amp_release))
(def hit_env (adsr gate trigger 0.24 (clip (* dec 0.66) 35 1900) 0 amp_release))
(def lot_f (clip (* 106 pmul bratio (pow 2 (/ (* 0.32 (clip (mod pitch_sweep) -72 96) sweep_env) 12))) 34 1300))
(def mid_f (clip (* 144 pmul bratio (pow 2 (/ (* 0.28 (clip (mod pitch_sweep) -72 96) sweep_env) 12))) 45 1600))
(def hit_f (clip (* 196 pmul bratio (pow 2 (/ (* 0.24 (clip (mod pitch_sweep) -72 96) sweep_env) 12))) 55 2100))
(def lot_body (* lot_env (sin (+ (* (phasor lot_f) twopi) (* fmamt 0.42 lot_env (sin (* (phasor (* lot_f (+ 1.45 (* spread 0.50)))) twopi)))))))
(def mid_body (* mid_env (sin (+ (* (phasor mid_f) twopi) (* fmamt 0.36 mid_env (sin (* (phasor (* mid_f (+ 1.50 (* spread 0.58)))) twopi)))))))
(def hit_body (* hit_env (sin (+ (* (phasor hit_f) twopi) (* fmamt 0.30 hit_env (sin (* (phasor (* hit_f (+ 1.58 (* spread 0.68)))) twopi)))))))
(def lotom (+ (* bodyv 1.08 lot_body) (* subv 0.28 lot_env (sin (* (phasor (* lot_f 0.5)) twopi))) (* noisev 0.16 snapv (+ n_bp (* 0.12 ratio_mid)) snap_env)))
(def midtom (+ (* bodyv 1.02 mid_body) (* subv 0.18 mid_env (sin (* (phasor (* mid_f 0.5)) twopi))) (* noisev 0.15 snapv (+ n_bp (* 0.12 ratio_mid)) snap_env)))
(def hitom (+ (* bodyv 0.98 hit_body) (* noisev 0.17 snapv (+ n_bp (* 0.14 ratio_air)) snap_env) (* xring 0.18 hit_body metal_bp)))

; RIM and CLAP.
(def rim_env (adsr gate trigger 0.08 (clip (* dec 0.10) 5 260) 0 3))
(def rim_f (* 525 pmul bratio))
(def rim_a (oscshape (phasor rim_f) rim_f wave pw))
(def rim_b (sin (+ (* (phasor (* rim_f (+ 1.82 (* spread 0.65)))) twopi) (* fmamt 0.18 rim_env rim_a))))
(def rim_c (sin (* (phasor (* rim_f (+ 3.18 (* spread 1.20)))) twopi)))
(def rim (+ (* bodyv rim_env (+ (* 0.58 rim_a) (* 0.30 rim_b) (* 0.18 rim_c))) (* noisev snapv 0.26 (+ n_bright (* 0.16 ratio_air)) rim_env) (* xring 0.40 rim_a rim_b rim_env)))

; 909 handclap: staggered noise bursts, airy diffuse tail, and a new subtle
; ratio/FM slap layer. BODY RATIO moves the cupped-hand formants, SPREAD sets
; the second/third partial spacing, MEMBRANE FM adds pitched grit, and RING
; folds those partials into the noise bursts without turning it into a tom.
(def clap_hit_env (adsr gate trigger 0.04 (clip (+ 10 (* 32 snapv)) 8 44) 0 2))
(def clap_hit_1 clap_hit_env)
(def clap_hit_2 (delay clap_hit_env 315))
(def clap_hit_3 (delay clap_hit_env 640))
(def clap_hit_4 (delay clap_hit_env 995))
(def clap_hit_5 (delay clap_hit_env 1370))
(def clap_flams (+ (* 1.00 clap_hit_1) (* 0.92 clap_hit_2) (* 0.76 clap_hit_3) (* 0.56 clap_hit_4) (* 0.34 snapv clap_hit_5)))
(def clap_tail_env (delay (adsr gate trigger 1.8 (clip (* dec (+ 0.30 (* 0.34 snapv))) 80 1280) 0 30) 820))
(def clap_ratio (clip (+ 0.70 (* bratio 0.30)) 0.78 2.90))
(def clap_body_cf (clip (* (+ 880 (* nc 520)) clap_ratio) 520 3600))
(def clap_knock_cf (clip (* (+ 1180 (* nc 760)) (+ 0.82 (* 0.18 bratio) (* 0.08 spread))) 620 5200))
(def clap_presence_cf (clip (* (+ 1760 (* nc 1700)) (+ 0.72 (* 0.16 bratio) (* 0.11 spread))) 900 7600))
(def clap_body_bp (svf n clap_body_cf (+ 1.45 (* nq 0.32)) 1))
(def clap_knock_bp (svf n clap_knock_cf (+ 1.15 (* nq 0.25)) 1))
(def clap_presence_bp (svf n clap_presence_cf (+ 1.05 (* nq 0.22)) 1))
(def clap_air_hp (svf n (+ 4200 (* nc 6200) (* 120 spread)) (+ 0.72 (* nq 0.16)) 2))
(def clap_fm_base (clip (* 690 pmul bratio) 180 5400))
(def clap_fm_mod (sin (* (phasor (* clap_fm_base (+ 1.31 (* spread 0.38)))) twopi)))
(def clap_fm_a (sin (+ (* (phasor clap_fm_base) twopi) (* fmamt 0.18 (+ clap_flams (* 0.35 clap_tail_env)) clap_fm_mod))))
(def clap_fm_b (sin (+ (* (phasor (* clap_fm_base (+ 1.76 (* spread 0.54)))) twopi) (* fmamt 0.12 clap_fm_a))))
(def clap_fm_raw (+ (* 0.55 clap_fm_a) (* 0.30 clap_fm_b) (* xring 0.38 clap_fm_a clap_fm_mod)))
(def clap_fm_bp (svf clap_fm_raw (clip (* clap_presence_cf (+ 0.82 (* 0.12 spread))) 800 7800) (+ 0.85 (* nq 0.20)) 1))
(def clap_burst_src (+ (* 0.47 clap_body_bp) (* 0.32 clap_knock_bp) (* 0.21 clap_presence_bp) (* 0.13 clap_air_hp) (* 0.12 fmamt clap_fm_bp)))
(def clap_tail_src (+ (* 0.40 (delay clap_body_bp 210)) (* 0.30 (delay clap_presence_bp 470)) (* 0.21 (delay clap_air_hp 760)) (* 0.14 (delay n_bright 1180)) (* 0.08 fmamt (delay clap_fm_bp 530))))
(def clap_body (* noisev (+ 0.94 (* 0.42 snapv)) clap_burst_src clap_flams))
(def clap_tail (* noisev (+ 0.55 (* 0.35 snapv)) clap_tail_src clap_tail_env))
(def clap_slap (* clickv (+ 0.18 (* 0.34 snapv)) (+ (* 0.58 clap_air_hp) (* 0.18 metal_hp) (* 0.14 n_bright) (* 0.14 fmamt ratio_air)) (+ clap_hit_1 (* 0.55 clap_hit_2))))
(def clap (+ clap_body clap_tail clap_slap (* bodyv 0.065 fmamt clap_fm_bp (+ clap_flams (* 0.45 clap_tail_env)))))

; HATS and CYMBALS.
(def ch_env (adsr gate trigger 0.05 (clip (* hatdec 0.42) 8 420) 0 3))
(def oh_env (adsr gate trigger 0.18 (clip (* hatdec 1.75) 75 3200) 0 28))
(def ride_env (adsr gate trigger 0.45 (clip (* dec 2.20) 220 4500) 0 90))
(def crash_env (adsr gate trigger 0.55 (clip (* dec 2.70) 260 4500) 0 120))
(def hat_src (+ (* 0.78 metal_hp) (* 0.32 n_bright) (* 0.22 fmamt ratio_air)))
(def chat (+ (* metalv 1.08 hat_src ch_env) (* noisev snapv 0.42 (+ n_bright (* 0.12 ratio_air)) ch_env) (* clickv 0.18 snap_env (+ n_bright (* 0.16 metal_fm_layer)))))
(def ohat (+ (* metalv 1.02 hat_src oh_env) (* noisev 0.34 (+ n_bright (* 0.10 ratio_air)) oh_env) (* xring 0.13 metal_bp n_bright oh_env)))
(def ride_tone (+ (* 0.70 (svf metal_bank (+ 2600 (* nc 5400)) (+ 1.0 (* nq 0.25)) 1)) (* 0.22 metal_hp) (* 0.16 fmamt ratio_air)))
(def ride_bell (* (adsr gate trigger 0.3 (clip (* dec 1.1) 120 2600) 0 80) (sin (+ (* (phasor (* 620 mtune pmul bratio)) twopi) (* fmamt 0.12 ratio_mod_a)))))
(def ride (+ (* metalv 0.90 ride_tone ride_env) (* bodyv 0.28 ride_bell) (* noisev 0.20 (+ n_bright (* 0.08 ratio_air)) ride_env)))
(def crash (+ (* metalv 1.05 (+ metal_hp (* 0.45 metal_bp) (* 0.14 fmamt ratio_air)) crash_env) (* noisev 0.42 (+ n_bright (* 0.08 ratio_mid)) crash_env) (* xring 0.18 n_mix metal_bank crash_env)))

(def selected (selector v kick snare lotom midtom hitom rim clap chat ohat ride crash))
(def foldv (clip (mod fold) 0 1))
(def pre_drive (+ selected (* foldv (sin (* selected (+ 4 (* 22 foldv)))))))
(def driven (tanh (* (clip (mod drive) 0.2 14) pre_drive)))
(def steps (+ 8 (* (- 1 (clip (mod crush) 0 1)) 248)))
(def crushed (/ (floor (* driven steps)) steps))
(def tonev (clip (mod tone) 0 1))
(def filt_cut (+ 180 (* tonev 15200)))
(def filtered (svf crushed filt_cut (clip (mod resonance) 0.5 5.5) fmode))
(def signal (* filtered velocity (clip (mod gain) 0 1)))
(out signal 1 @name audio)

(defmacro wavefolder (input drive bias dry_wet)
  (def x (+ (* input drive) bias))
  (def fold1 (sin x))
  (def fold2 (sin (* fold1 1.5)))
  (mix input fold2 dry_wet))
(defmacro spinz_808 (trig pitch decay punch distortion)
  (def d_coeff (- 1.0 (/ 0.0001 (max 0.01 decay))))
  (def p_coeff (- 1.0 (/ 0.001 (max 0.01 punch))))
  (def k_coeff (- 1.0 (/ 0.01 (max 0.01 punch))))
  (make-history amp_h)
  (def amp_env (* (+ (read-history amp_h) trig) d_coeff))
  (write-history amp_h amp_env)
  (make-history pit_h)
  (def pit_env (* (+ (read-history pit_h) trig) p_coeff))
  (write-history pit_h pit_env)
  (make-history knock_h)
  (def knock_env (* (+ (read-history knock_h) trig) k_coeff))
  (write-history knock_h knock_env)
  (def transient_sweep (* knock_env 750.0))
  (def body_sweep (* pit_env 150.0))
  (def freq (+ pitch body_sweep transient_sweep))
  (def osc (sin (* (phasor freq) twopi)))
  (def transient_noise (* (noise) knock_env 0.08))
  (def drive_gain (+ 1.0 (* distortion 7.0)))
  (def dry_sig (+ osc (* knock_env 0.4) transient_noise))
  (def pre_amp (* dry_sig drive_gain))
  (def sat_raw (tanh (+ pre_amp 0.15)))
  (def sat_clean (- sat_raw 0.148))
  (def lp_freq (clip (+ 900.0 (* (- 1.0 distortion) 3000.0)) 150.0 16000.0))
  (def lpf (svf sat_clean lp_freq 0.55 0.0))
  (def hpf (svf lpf 30.0 0.7 2.0))
  (* hpf (clip amp_env 0.0 1.0)))
(def value2 1.0)
(def value1 0.9999999)
(param bias)
(param drive @min 0.5 @max 4.0)
(param punch @max 8.0)
(param wet)
(def gate (in 1 @name gate))
(def pitch (in 2 @name pitch))
(def velocity (in 3 @name velocity))
(def trigger (in 4 @name trigger))
(def spinz_8081 (spinz_808 trigger pitch value1 punch value2))
(def wavefolder1 (wavefolder spinz_8081 drive bias wet))
(def mod1 (in 5 @name mod1 @modulator 1))
(def mod2 (in 6 @name mod2 @modulator 2))
(def mod3 (in 7 @name mod3 @modulator 3))
(def mod4 (in 8 @name mod4 @modulator 4))
(param attack @default 5.0 @min 0.0 @max 1000.0 @unit ms)
(param decay @default 120.0 @min 1.0 @max 2000.0 @unit ms)
(param sustain @default 0.8 @min 0.0 @max 1.0)
(param release @default 180.0 @min 1.0 @max 5000.0 @unit ms)
(param gain @default 0.5 @min 0.0 @max 1.0 @mod true @mod-mode additive)
(def env (adsr gate trigger attack decay sustain release))
(out (* wavefolder1 env velocity (mod gain)) 1 @name audio)
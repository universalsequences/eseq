(defmacro flute-jet-waveguide (freq breath embouchure noise_amt feedback)
  (make-history bore_fb)
  (make-history breath_h)
  (make-history dc_x1)
  (make-history dc_y1)
  (make-history lp_h)
  (def clip-0 (clip breath 0 1.5))
  (def breath_s (mix clip-0 (read-history breath_h) 0.995))
  (def clip-0-2 (clip embouchure 0.1 0.9))
  (def clip-1-2 (clip feedback 0 0.999))
  (def max-0 (max breath_s 0))
  (def max-0-2 (max freq 20))
  (def max-1 (max breath_s 0))
  (def mul-0 (* max-0-2 2))
  (def clip-1 (clip mul-0 200 8000))
  (def mul-0-2 (* (read-history bore_fb) 0.5))
  (def mul-1 (* max-0-2 6))
  (def clip-2 (clip mul-1 400 9000))
  (def mul-2-2 (* (read-history bore_fb) clip-1-2))
  (def n0-15 0.15)
  (def n0-995 0.995)
  (def mul-3 (* n0-995 (read-history dc_y1)))
  (def noise-0 (noise))
  (def air_noise (svf noise-0 clip-1 1.5 1))
  (def sqrt-0 (sqrt max-0))
  (def sqrt-1 (sqrt max-1))
  (def air_out (* air_noise n0-15 sqrt-1))
  (def bore_len (/ samplerate max-0-2))
  (def jet_len (* bore_len clip-0-2))
  (def turb (* air_noise noise_amt sqrt-0))
  (def excitation (+ breath_s turb))
  (def add-0-2 (+ excitation mul-0-2))
  (def jet (delay add-0-2 jet_len))
  (def jx (clip jet -1 1))
  (def mul-1-2 (* jx jx jx))
  (def jet_nl (- jx mul-1-2))
  (def bore_in (+ jet_nl mul-2-2))
  (def lp (mix bore_in (read-history lp_h) 0.5))
  (def bore_out (delay lp bore_len))
  (def sub-0 (- bore_out (read-history dc_x1)))
  (def dc (+ sub-0 mul-3))
  (def tone (svf dc clip-2 0.7 0))
  (def mul-2 (* tone 0.7))
  (def add-0 (+ mul-2 air_out))
  (def return (tanh add-0))
  (write-history bore_fb bore_out)
  (write-history breath_h breath_s)
  (write-history dc_x1 bore_out)
  (write-history dc_y1 dc)
  (write-history lp_h lp)
  return)


(defmacro acoustic-guitar (freq sample_rate gate trigger velocity damping brightness)
  (make-history damp_state)
  (make-history dc_in)
  (make-history dc_out)
  (make-history string_state)
  (def clip-0 (clip brightness 0.25 12))
  (def env (adsr gate trigger 0.5 12 0 40))
  (def feedback (clip damping 0.5 0.996))
  (def n0-5 0.5)
  (def n0-995 0.995)
  (def mul-1 (* n0-995 (read-history dc_out)))
  (def noise-0 (noise))
  (def pitch (clip freq 20 2000))
  (def div-0 (/ sample_rate pitch))
  (def mul-2 (* pitch clip-0))
  (def cutoff (clip mul-2 200 12000))
  (def pluck (* velocity noise-0 env))
  (def sub-0 (- div-0 1.5))
  (def delay_samples (clip sub-0 2 4096))
  (def delayed (delay (read-history string_state) delay_samples))
  (def add-0 (+ delayed (read-history damp_state)))
  (def averaged (* n0-5 add-0))
  (def mul-0 (* feedback averaged))
  (def loop_sig (+ pluck mul-0))
  (def limited (clip loop_sig -2 2))
  (def sub-1 (- limited (read-history dc_in)))
  (def dc_y (+ sub-1 mul-1))
  (def shaped (svf dc_y cutoff 0.7 0))
  (def return (tanh shaped))
  (write-history damp_state delayed)
  (write-history dc_in limited)
  (write-history dc_out dc_y)
  (write-history string_state limited)
  return)


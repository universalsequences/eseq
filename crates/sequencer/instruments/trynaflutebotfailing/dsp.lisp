(defmacro flute_waveguide (breath bore_delay feedback embouchure turbulence)
  (make-history fb_h)
  (def breath_p (clip breath 0 1))
  (def clip-0 (clip feedback 0 0.995))
  (def delay_len (max bore_delay 1))
  (def emb (clip embouchure 0 1))
  (def fb_gain (* clip-0 0.78))
  (def n0-08 0.08)
  (def n0-18 0.18)
  (def mix-1 (mix n0-08 n0-18 emb))
  (def n1200 1200)
  (def n1800 1800)
  (def n3000 3000)
  (def cutoff (mix n1200 n3000 emb))
  (def fb_tone (svf (read-history fb_h) cutoff 1.4 1))
  (def mul-0 (* fb_tone fb_gain))
  (def n3600 3600)
  (def mix-0 (mix n1800 n3600 emb))
  (def noise-0 (noise))
  (def breath_noise (svf noise-0 mix-0 0.8 0))
  (def turb (clip turbulence 0 1))
  (def jet_amt (* breath_p turb mix-1))
  (def jet (* breath_noise jet_amt))
  (def excitation (+ jet mul-0))
  (def bore (delay excitation delay_len))
  (def body (svf bore cutoff 0.9 0))
  (def mul-1 (* body 0.9))
  (def return (tanh mul-1))
  (write-history fb_h body)
  return)

(defmacro hz_to_delay_samples (freq sr)
  (def div-0 (/ sr freq))
  (def n1 1)
  (def round-0 (round div-0))
  (def return (max n1 round-0))
  return)

(param attack @group amp @env amp-env @role attack @default 5 @min 0 @max 1000 @unit ms)
(param decay @group amp @env amp-env @role decay @default 120 @min 1 @max 2000 @unit ms)
(param gain @default 0.5 @min 0 @max 1 @mod true @mod-mode additive)
(param release @group amp @env amp-env @role release @default 180 @min 1 @max 5000 @unit ms)
(param sustain @group amp @env amp-env @role sustain @default 0.8 @min 0 @max 1)

(def gate (in 1 @name gate))
(def pitch (in 2 @name pitch))
(def velocity (in 3 @name velocity))
(def trigger (in 4 @name trigger))
(def clock (in 5 @name clock))

(def env (adsr gate trigger attack decay sustain release))
(def phase (phasor pitch))
(def mul-0 (* phase env velocity (mod gain)))
(def value 48000)
(def hz_to_delay_samples-2 (hz_to_delay_samples pitch value))
(def value-2 0.98)
(def value-3 0.44)
(def value-4 0.1)
(def flute_waveguide-2 (flute_waveguide env hz_to_delay_samples-2 value-2 value-3 value-4))
(def compressor-2 (compressor flute_waveguide-2 20 -13 5 0.01 0.01))

(out compressor-2 1 @name audio)

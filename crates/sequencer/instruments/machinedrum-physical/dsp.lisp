; Machinedrum P-I inspired physical drum voice.
; One struck resonator model: membrane, shell, cavity, nonlinear coupling, and track drive.

(def gate (in 1 @name gate))
(def pitch (in 2 @name pitch))
(def velocity (in 3 @name velocity))
(def trigger (in 4 @name trigger))
(def mod1 (in 5 @name mod1 @modulator 1))
(def mod2 (in 6 @name mod2 @modulator 2))
(def mod3 (in 7 @name mod3 @modulator 3))
(def mod4 (in 8 @name mod4 @modulator 4))
(def mod5 (in 9 @name mod5 @modulator 5))
(def mod6 (in 10 @name mod6 @modulator 6))

(param amp_attack @default 1 @min 1 @max 80 @unit ms)
(param amp_decay @default 760 @min 40 @max 3800 @unit ms @mod true @mod-mode additive)
(param amp_sustain @default 0 @min 0 @max 0.25)
(param amp_release @default 90 @min 5 @max 1500 @unit ms)

(param tune @default -15 @min -36 @max 24 @mod true @mod-mode additive)
(param pitch_sweep @default 38 @min -36 @max 96 @mod true @mod-mode additive)
(param sweep_decay @default 46 @min 4 @max 420 @unit ms)
(param bend @default 0.32 @min 0 @max 1 @mod true @mod-mode additive)

(param material @default 0.48 @min 0 @max 1 @mod true @mod-mode additive)
(param tension @default 0.44 @min 0 @max 1 @mod true @mod-mode additive)
(param damping @default 0.30 @min 0 @max 1 @mod true @mod-mode additive)
(param strike_pos @default 0.37 @min 0 @max 1 @mod true @mod-mode additive)
(param coupling @default 0.56 @min 0 @max 1 @mod true @mod-mode additive)

(param mallet @default 0.66 @min 0 @max 1 @mod true @mod-mode additive)
(param click_level @default 0.34 @min 0 @max 1)
(param skin_level @default 0.92 @min 0 @max 1.5)
(param shell_level @default 0.55 @min 0 @max 1.5)
(param cavity_level @default 0.48 @min 0 @max 1.5)
(param air_level @default 0.26 @min 0 @max 1)

(param hp @default 35 @min 20 @max 2800 @unit Hz)
(param tone @default 0.66 @min 0 @max 1 @mod true @mod-mode additive)
(param drive @default 2.55 @min 0.4 @max 9)
(param dirt @default 0.18 @min 0 @max 1 @mod true @mod-mode additive)
(param gain @default 0.50 @min 0 @max 1 @mod true @mod-mode additive)

(def vel (clip velocity 0 1))
(def mat (clip (mod material) 0 1))
(def tens (clip (mod tension) 0 1))
(def damp (clip (mod damping) 0 1))
(def pos (clip (mod strike_pos) 0 1))
(def coup (clip (mod coupling) 0 1))
(def hard (clip (mod mallet) 0 1))
(def decay_time (clip (mod amp_decay) 40 3800))

(def tune_mul (pow 2 (/ (clip (mod tune) -36 24) 12)))
(def base_freq (clip (* pitch tune_mul (+ 0.54 (* tens 1.06))) 20 820))
(def sweep_env (adsr gate trigger 1 sweep_decay 0 5))
(def sweep_mul (pow 2 (/ (* (clip (mod pitch_sweep) -36 96) sweep_env) 12)))
(def strike_bend (* (clip (mod bend) 0 1) sweep_env (+ 0.10 (* hard 0.45))))
(def f0 (clip (* base_freq sweep_mul (+ 1.0 strike_bend)) 20 2200))

(def amp_env (adsr gate trigger amp_attack decay_time amp_sustain amp_release))
(def strike_env (adsr gate trigger 1 (+ 4 (* (- 1 hard) 34)) 0 5))
(def body_scale (+ 0.22 (* (- 1 damp) 1.55)))
(def shell_scale (+ 0.10 (* (- 1 damp) 1.05) (* mat 0.85)))

(make-history membrane_fb)
(def fb (tanh (* (read-history membrane_fb) 2.4)))
(def strain (* fb coup (+ 0.10 (* mat 0.34)) amp_env))

(def pos_a (sin (* (+ 0.10 (* pos 0.78)) pi)))
(def pos_b (sin (* (+ 0.10 (* pos 0.78)) pi 2.0)))
(def pos_c (sin (* (+ 0.10 (* pos 0.78)) pi 3.0)))
(def pos_d (sin (* (+ 0.10 (* pos 0.78)) pi 4.0)))
(def edge (+ 0.20 (* pos 0.80)))

(def r1 (+ 1.00 (* strain 0.018)))
(def r2 (+ 1.46 (* tens 0.20) (* mat 0.15) (* strain -0.025)))
(def r3 (+ 1.92 (* tens 0.36) (* mat 0.32) (* strain 0.034)))
(def r4 (+ 2.54 (* tens 0.30) (* mat 0.78) (* edge 0.18) (* strain -0.041)))
(def r5 (+ 3.38 (* tens 0.52) (* mat 1.25) (* edge 0.42) (* strain 0.050)))

(def e1 (adsr gate trigger 1 (* decay_time body_scale 1.18) 0 amp_release))
(def e2 (adsr gate trigger 1 (* decay_time body_scale 0.86) 0 (* amp_release 0.72)))
(def e3 (adsr gate trigger 1 (* decay_time body_scale 0.62) 0 (* amp_release 0.55)))
(def e4 (adsr gate trigger 1 (* decay_time shell_scale 0.58) 0 (* amp_release 0.50)))
(def e5 (adsr gate trigger 1 (* decay_time shell_scale 0.38) 0 (* amp_release 0.40)))

(def p1 (phasor (clip (* f0 r1) 20 7000) trigger))
(def p2 (phasor (clip (* f0 r2) 32 9000) trigger))
(def p3 (phasor (clip (* f0 r3) 42 11000) trigger))
(def p4 (phasor (clip (* f0 r4) 68 13500) trigger))
(def p5 (phasor (clip (* f0 r5) 96 15000) trigger))

(def phmod (* coup fb (+ 0.24 (* hard 0.52)) strike_env))
(def m1 (* (sin (+ (* p1 twopi) (* phmod 0.65))) e1 (+ 0.76 (* pos_a 0.28))))
(def m2 (* (sin (+ (* p2 twopi) 0.47 (* phmod -0.42))) e2 (+ 0.32 (* (abs pos_b) 0.34))))
(def m3 (* (sin (+ (* p3 twopi) 1.62 (* phmod 0.58))) e3 (+ 0.22 (* (abs pos_c) 0.32))))
(def m4 (* (sin (+ (* p4 twopi) 3.10 (* phmod -0.76))) e4 (+ 0.12 (* (abs pos_d) 0.28)) mat))
(def m5 (* (sin (+ (* p5 twopi) 4.84 (* phmod 0.91))) e5 (+ 0.08 (* edge 0.22)) mat))

(def membrane (* skin_level (+ m1 m2 m3)))
(def shell (* shell_level (+ m4 m5 (* m3 mat 0.24))))
(write-history membrane_fb (+ membrane shell))

(def raw_noise (noise))
(def click_tone (clip (+ 1700 (* hard 10500) (* mat 2600)) 900 15000))
(def click_noise (svf raw_noise click_tone (+ 0.75 (* hard 1.8)) 2))
(def click_osc (sin (* (phasor (clip (* f0 (+ 9 (* hard 26) (* mat 18))) 800 15000) trigger) twopi)))
(def click (* (+ (* click_noise 0.72) (* click_osc 0.38)) strike_env click_level))

(def skin_noise (svf raw_noise (clip (* f0 (+ 2.2 (* tens 4.8) (* hard 5.6))) 180 9800) (+ 0.9 (* mat 1.4)) 1))
(def air (* skin_noise (adsr gate trigger 1 (+ 18 (* (- 1 hard) 80)) 0 20) air_level))

(def cavity_env (adsr gate trigger 2 (* decay_time (+ 0.55 (* (- 1 damp) 1.30))) 0 amp_release))
(def cavity_freq (clip (* f0 (+ 0.78 (* tens 0.62) (* mat 0.22))) 42 1700))
(def cavity_q (+ 0.7 (* (- 1 damp) 2.8)))
(def cavity (* (svf (+ membrane (* shell 0.45) (* air 0.20)) cavity_freq cavity_q 1) cavity_env cavity_level))

(def excited (+ membrane shell cavity click air))
(def hp_stage (svf excited (clip hp 20 2800) 0.72 2))
(def tonev (clip (mod tone) 0 1))
(def tone_stage (svf hp_stage (clip (+ 650 (* tonev 12500)) 500 14500) (+ 0.55 (* (- 1 damp) 0.80)) 0))

(def dirtv (clip (mod dirt) 0 1))
(def quant_levels (+ 16 (* (- 1 dirtv) 700)))
(def quantized (/ (round (* tone_stage quant_levels)) quant_levels))
(def dirty (mix tone_stage quantized dirtv))
(def driven (tanh (* dirty drive (+ 0.86 (* hard 0.82)))))

(def signal (* driven amp_env vel (clip (mod gain) 0 1) 0.90))
(out signal 1 @name audio)

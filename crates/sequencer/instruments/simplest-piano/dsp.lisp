  (def pitch-transpose-2-2 (pitch-transpose freq value))
  (def karplus-strong-3 (karplus-strong pitch-transpose-2-2 trig-2 scale-2))
  (def add (+ karplus-strong-3 karplus-strong-2-2))
  (def add-2 (+ add karplus-strong-2))
  (def mul (* add-2 0.3333))
  (def schroeder-allpass-2 (schroeder-allpass mul 125 0.74))
  (def schroeder-allpass-3 (schroeder-allpass schroeder-allpass-2 356 0.85))
  (def schroeder-allpass-4 (schroeder-allpass schroeder-allpass-3 93 0.83))
  schroeder-allpass-4)

(defmacro tape-delay (input delay_samples feedback damping drive mix_amt)
  (make-history fb_loop)
  (def filtered (svf (read-history fb_loop) damping 0.707 0))
  (def mul-0 (* filtered drive))
  (def saturated (tanh mul-0))
  (def mul-1 (* saturated feedback))
  (def active_sig (+ input mul-1))
  (def delayed (delay active_sig delay_samples))
  (def return (mix input delayed mix_amt))
  (write-history fb_loop delayed)
  return)


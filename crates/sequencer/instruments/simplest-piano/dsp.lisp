(defmacro karplus-strong (freq trig decay)
  (make-history env_h)
  (make-history fb_h)
  (make-history lp_h)
  (def clip-0 (clip decay 0 0.999))
  (def mul-0 (* (read-history env_h) 0.96))
  (def env (max trig mul-0))
  (def n0-5 0.5)
  (def n44100 44100)
  (def div-0 (/ n44100 freq))
  (def delay_samples (clip div-0 2 4000))
  (def noise-0 (noise))
  (def excitation (* env noise-0))
  (def delay_in (+ excitation (read-history fb_h)))
  (def delay_out (delay delay_in delay_samples))
  (def add-0 (+ delay_out (read-history lp_h)))
  (def lp_out (* n0-5 add-0))
  (def mul-1 (* lp_out clip-0))
  (write-history env_h env)
  (write-history fb_h mul-1)
  (write-history lp_h delay_out)
  lp_out)


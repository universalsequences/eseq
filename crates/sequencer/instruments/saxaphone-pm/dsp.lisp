(defmacro sax-bore (freq breath stiffness brightness noise_amt)
  (make-history bore)
  (make-history dc_x)
  (make-history dc_y)
  (make-history refl_lp)
  (def clip-0 (clip stiffness 0.1 1.2))
  (def max-0 (max freq 20))
  (def n0-7 0.7)
  (def n0-8 0.8)
  (def n0-85 0.85)
  (def n0-95 -0.95)
  (def n0-995 0.995)
  (def mul-2 (* n0-995 (read-history dc_y)))
  (def n1 1)
  (def n1-1 1)
  (def n1-2 1)
  (def n44100 44100)
  (def div-0 (/ n44100 max-0))
  (def noise-0 (noise))
  (def sub-0 (- n1 brightness))
  (def damp (clip sub-0 0.05 0.95))
  (def sub-1 (- n1-1 damp))
  (def lp_phase_delay (/ damp sub-1))
  (def sub-2 (- div-0 n1-2 lp_phase_delay))
  (def delay_samps (clip sub-2 2 4000))
  (def delayed (delay (read-history bore) delay_samps))
  (def lp (mix delayed (read-history refl_lp) damp))
  (def refl (* n0-95 lp))
  (def turb (* noise-0 noise_amt breath))
  (def add-0 (+ n0-85 turb))
  (def mouth (* breath add-0))
  (def pdiff (- mouth refl))
  (def mul-0 (* clip-0 pdiff))
  (def sub-3 (- n0-7 mul-0))
  (def reed (clip sub-3 -1 1))
  (def mul-1 (* pdiff reed))
  (def bore_in (+ refl mul-1))
  (def sub-4 (- bore_in (read-history dc_x)))
  (def dcb (+ sub-4 mul-2))
  (def mul-3 (* n0-8 dcb))
  (def return (tanh mul-3))
  (write-history bore bore_in)
  (write-history dc_x bore_in)
  (write-history dc_y dcb)
  (write-history refl_lp lp)
  return)

(defmacro sax-mini-verb (input decay damp_hz mix_amt)
  (make-history ap)
  (make-history c1)
  (make-history c2)
  (make-history c3)
  (make-history c4)
  (def clip-0 (clip mix_amt 0 1))
  (def cut (clip damp_hz 400 12000))
  (def g (clip decay 0 0.92))
  (def mul-0 (* (read-history c1) g))
  (def add-0 (+ input mul-0))
  (def d1 (delay add-0 1123))
  (def mul-1 (* (read-history c2) g))
  (def add-1 (+ input mul-1))
  (def d2 (delay add-1 1499))
  (def mul-2 (* (read-history c3) g))
  (def add-2 (+ input mul-2))
  (def d3 (delay add-2 1801))
  (def mul-3 (* (read-history c4) g))
  (def add-3 (+ input mul-3))
  (def d4 (delay add-3 2251))
  (def add-4 (+ d1 d2 d3 d4))
  (def mul-4 (* (read-history ap) 0.5))
  (def n0-25 0.25)
  (def combsum (* n0-25 add-4))
  (def ap_in (+ combsum mul-4))
  (def ap_del (delay ap_in 347))
  (def mul-5 (* ap_in -0.5))
  (def add-5 (+ mul-5 ap_del))
  (def mul-6 (* combsum 0))
  (def svf-0 (svf d1 cut 0.7 0))
  (def svf-1 (svf d2 cut 0.7 0))
  (def svf-2 (svf d3 cut 0.7 0))
  (def svf-3 (svf d4 cut 0.7 0))
  (def wet (svf add-5 220 0.7 1))
  (def wet_hp (- wet 0))
  (def add-6 (+ wet_hp mul-6))
  (def verb (- add-6 0))
  (def tanh-0 (tanh verb))
  (def return (mix input tanh-0 clip-0))
  (write-history ap ap_del)
  (write-history c1 svf-0)
  (write-history c2 svf-1)
  (write-history c3 svf-2)
  (write-history c4 svf-3)
  return)

(param attack @group amp @env amp-env @role attack @default 5 @min 0 @max 1000 @unit ms)
(param stiffness @min 0 @max 1 @default 0.8 @mod true @mod-mode additive)
(param brightness @min 0 @max 1 @mod-mode additive @mod true)
(param brnoise @min 0 @max 1 @mod-mode additive @mod true)
(param decay @group amp @env amp-env @role decay @default 120 @min 1 @max 2000 @unit ms)
(param gain @default 0.5 @min 0 @max 1 @mod true @mod-mode additive)
(param release @group amp @env amp-env @role release @default 180 @min 1 @max 5000 @unit ms)

(def value1 50.0)
(def gate (in 1 @name gate))
(def scale2 (scale gate 0.0 1.0 1.0 4.0))
(def pitch (in 2 @name pitch))
(def velocity (in 3 @name velocity))
(def scale3 (scale velocity 0.0 1.0 1.0 8.0))
(def trigger (in 4 @name trigger))
(make-history history1)
(def phasor1 (phasor value1 trigger))
(def clock (in 5 @name clock))
(def mul1 (* clock scale2))
(def mul3 (* mul1 2.0))
(def triangle1 (triangle (wrap mul1 0.0 1.0) 0.003))
(def scale4 (scale triangle1 0.0 1.0 1000.0 4000.0))
(def scale1 (scale triangle1 0.0 1.0 0.2 1.2))
(def wrap1 (wrap mul3 0.0 1.0))
(def mul5 (* (read-history history1) scale1))
(def triangle3 (triangle phasor1 triangle1))
(def triangle2 (triangle wrap1 0.0003))
(def mul4 (* triangle3 twopi))
(def pow1 (pow triangle2 4.0))
(def add1 (+ mul4 mul5))
(def cos1 (cos add1))
(def svf1 (svf cos1 scale4 2.0 1.0))
(def mul2 (* svf1 pow1))
(def mod1 (in 6 @name mod1 @modulator 1))
(def mod2 (in 7 @name mod2 @modulator 2))
(def mod3 (in 8 @name mod3 @modulator 3))
(def mod4 (in 9 @name mod4 @modulator 4))
(param attack @group amp @env amp-env @role attack @default 5.0 @min 0.0 @max 1000.0 @unit ms)
(param decay @group amp @env amp-env @role decay @default 120.0 @min 1.0 @max 2000.0 @unit ms)
(param sustain @group amp @env amp-env @role sustain @default 0.8 @min 0.0 @max 1.0)
(param release @group amp @env amp-env @role release @default 180.0 @min 1.0 @max 5000.0 @unit ms)
(param gain @default 0.5 @min 0.0 @max 1.0 @mod true @mod-mode additive)
(def env (adsr gate trigger attack decay sustain release))
(def phase (phasor pitch))
(out mul2 1 @name audio)
(out triangle1 2 @name mod @modulator 1)
(write-history history1 cos1)
(defmacro feedback_delay_damp (input delay_time feedback damp_freq dry_wet)
  (make-history dc_in_hist)
  (make-history dc_out_hist)
  (make-history fb_hist)
  (def mul-0 (* (read-history fb_hist) feedback))
  (def delay_in (+ input mul-0))
  (def delayed_sig (delay delay_in delay_time))
  (def dampened (svf delayed_sig damp_freq 0.707 0))
  (def n0-995 0.995)
  (def mul-1 (* n0-995 (read-history dc_out_hist)))
  (def add-0 (+ dampened mul-1))
  (def dc_blocked (- add-0 (read-history dc_in_hist)))
  (def mixed (mix input dc_blocked dry_wet))
  (write-history dc_in_hist dampened)
  (write-history dc_out_hist dc_blocked)
  (write-history fb_hist dc_blocked)
  (tuple mixed dc_blocked))


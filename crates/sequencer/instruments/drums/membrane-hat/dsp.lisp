; ── Feedback state ─────────────────────────────────────────────────────────
(make-tensor-history ty1 @shape [8 8])   ; top plate modal outputs (t)
(make-tensor-history ty2 @shape [8 8])   ; top plate modal outputs (t-1)
(make-tensor-history by1 @shape [8 8])   ; bottom plate (t)
(make-tensor-history by2 @shape [8 8])   ; bottom plate (t-1)
(make-history stickx)                    ; striker position
(make-history stickv)                    ; striker velocity
; output-filter states (hand-rolled biquads, family convention)
(make-history dcx1)
(make-history dcy1)
(make-history b1x1) (make-history b1x2) (make-history b1y1) (make-history b1y2)
(make-history b2x1) (make-history b2x2) (make-history b2y1) (make-history b2y2)

; ── Mode frequencies / per-mode decay ───────────────────────────────────────
(def f0-top (clip (* host_pitch (exp (/ (* (log 2) tune-v) 12))) 20 2000))
(def f0-bot (clip (* f0-top plate-ratio-v) 20 2000))
; per-mode clamp happens in the w domain against float bounds: clip is
; signal-only and min(signalTensor, signal) is unsupported, but
; min(signalTensor, float) exists. 2.83 rad ~= 0.45 * 2pi (just under
; Nyquist); above-Nyquist modes would only arise at extreme tune settings.
(def f-top (max (* top-ratios f0-top) 30))
(def f-bot (max (* bot-ratios f0-bot) 30))
(def w-top (min (* twopi (/ f-top samplerate)) 2.83))
(def w-bot (min (* twopi (/ f-bot samplerate)) 2.83))
; T60 per mode: high-frequency tilt (ratio^-tilt) TIMES a mount shape
; r/(r+3) — the clutch clamps the plate at the center, so the low rocking
; modes are heavily damped and the LONGEST-ringing modes are the mids (the
; "ping"). Without this the low modes ring ~1s and the open hat reads as a
; 900Hz clank instead of metal (measured). Floor keeps r finite.
(def mount-top (/ top-ratios (+ top-ratios 3)))
(def mount-bot (/ bot-ratios (+ bot-ratios 3)))
(def t60-top (max (* decay-v 0.0022 mount-top (pow top-ratios (* tilt-v -1))) 0.002))
(def t60-bot (max (* decay-v 0.0018 mount-bot (pow bot-ratios (* tilt-v -1))) 0.002))
(def r-top (exp (/ -6.9077553 (* samplerate t60-top))))
(def r-bot (exp (/ -6.9077553 (* samplerate t60-bot))))

; ── Read state (each history read EXACTLY once) ─────────────────────────────
(def ty1v (read-tensor-history ty1))
(def ty2v (read-tensor-history ty2))
(def by1v (read-tensor-history by1))
(def by2v (read-tensor-history by2))

; ── Striker: lumped mass in Hertz contact (family machinery, stiffer tip) ───
(def stick-x (gswitch trigger 0.0001 (read-history stickx)))
(def stick-v (gswitch trigger (* -1 (* stick-speed-v vel-gain))
                      (read-history stickv)))
(def stick-pen (max (* stick-x -1) 0))
(def stick-f (min (* stick-hard-v stick-pen (sqrt stick-pen)) 0.01))
(def stick-v-next (+ stick-v stick-f))
(def stick-x-next (+ stick-x stick-v-next))
(write-history stickx stick-x-next)
(write-history stickv stick-v-next)
(def strike-force (* stick-f -1 (+ 1 (* scrape-v (noise))) 3))
(def strike-mask-m (+ (* bell-mask (- 1 strike-v)) (* edge-strike-mask strike-v)))

; ── Plate-to-plate contact at the edge circle ───────────────────────────────
; COMPILER CONSTRAINT (measured, scratchpad thist-test): a sum() reduce of a
; tensor-history read feeding back into that same tensor's write silently
; KILLS the feedback — the banks go dead. Same family as membrane-snare's
; "no tensor reduce feeds dynamics" rule. So the collision runs on SCALAR
; edge proxies: 3 low modes per plate (the rocking modes that dominate real
; plate contact) as scalar 2-poles. The proxies collide; the big tensor banks
; only RECEIVE the contact force one-way (scalar -> tensor is fine) and
; radiate the rattle spectrum.
(defmacro edgemode (x f t60s dmv y1h y2h)
  (def w0 (min (* twopi (/ (max f 20) samplerate)) 2.83))
  (def rr (exp (/ -6.9077553 (* samplerate (max t60s 0.002)))))
  (def y1v (* (read-history y1h) dmv))
  (def y2v (* (read-history y2h) dmv))
  (def y (+ (* 2 rr (cos w0) y1v) (* -1 rr rr y2v) x))
  (write-history y2h y1v)
  (write-history y1h y)
  y)
(make-history ep1a) (make-history ep1b)   ; top plate edge proxies
(make-history ep2a) (make-history ep2b)
(make-history ep3a) (make-history ep3b)
(make-history eq1a) (make-history eq1b)   ; bottom plate edge proxies
(make-history eq2a) (make-history eq2b)
(make-history eq3a) (make-history eq3b)
; contact force from LAST sample (scalar history breaks the algebraic loop).
; The impulse does NOT feed back into the proxies: an injected (non-
; conservative) kick can phase-lock and PUMP the proxies into a rattle that
; never dies (measured: sustained ~1kHz tail at open=1). The proxies are
; purely decaying linear systems + contact LOSS — the overlap pattern then
; dies with the plate motion by construction.
(make-history cfh)
(def contact-prev (read-history cfh))
(def t60-p (max (* decay-v 0.001) 0.002))
(def px-in (* strike-force 1.5))
(def qx-in (* strike-force 0.15))
; proxy damping uses last-sample contact (same scalar-history seam): the
; press/choke terms are current, only the contact indicator is one sample old
(def ind-prev (min (* contact-prev 2500) 1))
(def loss-prev (clip (+ (* ind-prev contact-loss-v)
                        (* (- 1 open-v) (- 1 open-v) 0.002)
                        (* (- 1 gate) choke-v 0.03))
                     0 0.25))
(def dm-p (- 1 loss-prev))
(def zp1 (edgemode px-in f0-top t60-p dm-p ep1a ep1b))
(def zp2 (edgemode px-in (* f0-top 2.53) (* t60-p 0.6) dm-p ep2a ep2b))
(def zp3 (edgemode px-in (* f0-top 6.18) (* t60-p 0.35) dm-p ep3a ep3b))
(def zq1 (edgemode qx-in f0-bot t60-p dm-p eq1a eq1b))
(def zq2 (edgemode qx-in (* f0-bot 2.65) (* t60-p 0.6) dm-p eq2a eq2b))
(def zq3 (edgemode qx-in (* f0-bot 5.9) (* t60-p 0.35) dm-p eq3a eq3b))
(def z-top (+ zp1 (* zp2 0.5) (* zp3 0.3)))
(def z-bot (+ zq1 (* zq2 0.5) (* zq3 0.3)))
; pedal gap: tight when closed, plates never meet when fully open. The floor
; keeps a loose metal-on-metal rattle even at open=0 (a real closed hat still
; sizzles). Scale tuned against measured proxy edge amplitudes.
(def pedal-gap (+ 0.02 (* open-v open-v 2.5)))
; overlap -> IMPULSIVE separating force: proportional to the overlap
; INCREASE (approach velocity), not the overlap itself. A sustained penalty
; force follows the low proxy cycle and drives the banks' low modes
; resonantly (measured: 900Hz centroid, clanky); impulses at each new
; penetration are broadband bounces — the Sekiguchi Model 2 insight in force
; form. Clipped BEFORE scaling.
(make-history ovh)
(def overlap (max (- (- z-top z-bot) pedal-gap) 0))
(def overlap-prev (read-history ovh))
(write-history ovh overlap)
(def approach (max (- overlap overlap-prev) 0))
(def contact-f (* (min approach 0.02) rattle-v))
(write-history cfh contact-f)
; high-pass the force before it reaches the banks: a one-sided impulse train
; carries strong LOW harmonics of the bounce rate, and the ~28 bloom-band
; 2-poles pass those as forced response with summed gain ~1 (measured:
; 415Hz-comb tail). THIRD-order HP (~2.2kHz): first-order was measurably not
; enough — the leak sat only ~8dB under the resonant ring.
(defmacro hp1 (x hist)
  (def lpv (read-history hist))
  (def lpn (+ lpv (* 0.25 (- x lpv))))
  (write-history hist lpn)
  (- x lpn))
(make-history cfl1) (make-history cfl2) (make-history cfl3)
(def contact-hp (hp1 (hp1 (hp1 contact-f cfl1) cfl2) cfl3))
; the LOSS indicator fires on bounce EVENTS (approach), not sustained
; overlap: Sekiguchi's pseudo-loss acts at collision instants. Sustained
; overlap-driven loss wiped the whole open-hat tail (measured: -80dB at
; 300ms), because a slow proxy swell held the indicator on for entire half
; cycles. Closed hats still decay fast emergently — constant re-collision =
; a dense stream of loss events.
(def contact-ind (min (* approach 250) 1))

; ── Pseudo-loss (Sekiguchi Model 2) + pedal press + choke ───────────────────
; all "extra damping" folds into one per-sample state shrink — multiplying
; the stored states is dissipative BY CONSTRUCTION, it cannot add energy
(def loss-total (clip (+ (* contact-ind contact-loss-v)
                         (* (- 1 open-v) (- 1 open-v) 0.002)
                         (* (- 1 gate) choke-v 0.03))
                      0 0.25))

; ── Nonlinear bloom (wash): clipped quadratic of top-plate edge motion ──────
(def bloom-x (clip (* z-top 4) -1 1))
(def bloom-inj (* bloom-x bloom-x wash-v 0.003))

; ── Modal bank updates (2-pole per mode: y = 2r cos(w) y1 - r² y2 + x) ──────
; contact injection drives ONLY the high modes (bloom-mask band): the bounce
; train is quasi-periodic at the proxy fundamental, and any energy it puts
; into low bank modes rings as a ~1kHz clank (measured, twice). The plate's
; low modes ARE the proxies here — they carry the collision, they don't
; radiate. The bounce periodicity survives as amplitude modulation of the
; high-frequency wash, which is exactly what a real hat's sizzle is.
(def x-top (+ (* strike-force strike-mask-m)
              (* contact-hp -1 bloom-mask)
              (* bloom-inj bloom-mask)))
(def x-bot (+ (* contact-hp 1 bloom-mask)
              ; bottom plate hears a little of the strike through the stand
              (* strike-force bell-mask 0.1)))
; loss is frequency-TILTED: Sekiguchi measured contact attenuation largest
; at low frequencies (big slow overlaps swallow the rocking modes first)
(def loss-tilt-top (pow top-ratios -0.4))
(def loss-tilt-bot (pow bot-ratios -0.4))
(def dm-top (max (- 1 (* loss-total loss-tilt-top)) 0.75))
(def dm-bot (max (- 1 (* loss-total loss-tilt-bot)) 0.75))
(def ty1d (* ty1v dm-top))
(def ty2d (* ty2v dm-top))
(def by1d (* by1v dm-bot))
(def by2d (* by2v dm-bot))
(def ty-next (+ (* 2 r-top (cos w-top) ty1d) (* -1 r-top r-top ty2d) x-top))
(def by-next (+ (* 2 r-bot (cos w-bot) by1d) (* -1 r-bot r-bot by2d) x-bot))
; NaN-safety clamps only; modal amplitudes live well under these
(def ty-nextc (max (min ty-next 3) -3))
(def by-nextc (max (min by-next 3) -3))

; ── Output taps (computed before the history writes) ────────────────────────
; radiation tilt: a small plate radiates low modes poorly (rises ~f below
; coincidence), and this is where a hat's 5-20kHz identity comes from. The
; tilt is OUTPUT-only voicing — the low modes still ring internally and keep
; driving the contact dynamics. Normalized so the top mode weight is ~1.
(def rad-top (* (pow top-ratios 0.7) 0.085))
(def rad-bot (* (pow bot-ratios 0.7) 0.083))
(def mic-t (sum (* ty-nextc mic-top rad-top)))
(def mic-b (sum (* by-nextc mic-bot rad-bot)))
(def mic-sizzle (* contact-hp 10))
(def mixdown (+ mic-t (* mic-b bottom-mix-v) (* mic-sizzle sizzle-v)))

; ── Write feedback ──────────────────────────────────────────────────────────
(write-tensor-history ty2 ty1d)
(write-tensor-history ty1 ty-nextc)
(write-tensor-history by2 by1d)
(write-tensor-history by1 by-nextc)

; ── Body EQ + DC block (hand-rolled scalar-history filters) ─────────────────
(defmacro bpf (x f q x1h x2h y1h y2h)
  (def w0 (* twopi (/ (clip f 20 20000) samplerate)))
  (def alpha (/ (sin w0) (* 2 q)))
  (def a0 (+ 1 alpha))
  (def x1v (read-history x1h))
  (def x2v (read-history x2h))
  (def y1v (read-history y1h))
  (def y2v (read-history y2h))
  (def y (/ (+ (* alpha x) (* -1 alpha x2v)
               (* 2 (cos w0) y1v) (* -1 (- 1 alpha) y2v))
            a0))
  (write-history x2h x1v)
  (write-history x1h x)
  (write-history y2h y1v)
  (write-history y1h y)
  y)

(def bq1 (bpf mixdown body1-freq-v 2 b1x1 b1x2 b1y1 b1y2))
(def bq2 (bpf mixdown body2-freq-v 1.5 b2x1 b2x2 b2y1 b2y2))
(def bodied (+ mixdown (* bq1 body1-gain-v) (* bq2 body2-gain-v)))
; one-pole-zero DC blocker
(def dcin bodied)
(def dcy (+ (- dcin (read-history dcx1)) (* 0.998 (read-history dcy1))))
(write-history dcx1 dcin)
(write-history dcy1 dcy)
(out (* dcy level-v vel-gain 3) 1 @name audio)

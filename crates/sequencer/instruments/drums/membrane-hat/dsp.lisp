; Membrane Hat — fully synthesized hi-hat, sibling of drums/membrane-snare-rim.
; Two cymbals as 64-mode modal banks (8x8 tensors of 2-pole resonators) that
; COLLIDE at the edge circle. The literature drove every structural choice
; (papers archived in docs/references/):
;   - Sekiguchi & Samejima 2023 tested spring contact vs velocity-exchange
;     contact between the two plates: the projection-style contact with a
;     pseudo-LOSS coefficient was measurably closer to a real hat, and the
;     hat's signature "rattle" is broadband noise BETWEEN the mode lines,
;     generated by the collisions themselves. So: `open` sets the edge gap,
;     contact applies a rectified clipped separating force AND removes energy
;     (per-sample state shrink) while touching — closed hats decay fast
;     because they collide constantly, not because we fake a short envelope.
;   - Skare & Abel (DAFx-19): real cymbal highs EMERGE after the attack (the
;     bloom); a linear modal bank cannot do it. `wash` injects a clipped
;     QUADRATIC of the top-plate edge motion into the top third of the modes
;     (von Kármán caricature) — clip-then-scale, energy-bounded.
; Stability story differs from the membrane family: every mode is a 2-pole
; with |pole| = r < 1, unconditionally stable — no Verlet energy bound to
; respect. The only loops are contact (rectified + clipped + lossy) and bloom
; (clipped before scaling); both are bounded injections into decaying filters.
;
; ARCHITECTURE NOTE: the collision runs on 3 SCALAR edge-proxy modes per
; plate, not on the tensor banks, because a sum() reduce of a tensor-history
; read feeding back into that tensor's write silently kills the feedback
; (measured compiler bug, minimal repro in the git history of this file's
; build session). The banks receive the contact force one-way. Block-size
; equivalence: MF128 vs MF1 differ by ~2.6e-6 (-104dB, float reassociation in
; the fused coefficient tensors) — membrane-snare-rim is bit-exact; benign.
;
; Mode tables are baked literals (log-spaced 1..~34 with near-degenerate
; split pairs + per-plate jitter — free-shell spectra are inharmonic and
; dense; exact Chladni ratios matter less than density and non-overlap
; between the plates). Generated by scratchpad gen_hat_tables.py, seeds 11/47.

; ── Host I/O ────────────────────────────────────────────────────────────────
(def gate (in 1 @name gate))
(def host_pitch (in 2 @name pitch))
(def velocity (in 3 @name velocity))
(def trigger (in 4 @name trigger))
(def clock (in 5 @name clock))
(def mod1 (in 6 @name mod1 @modulator 1))
(def mod2 (in 7 @name mod2 @modulator 2))
(def mod3 (in 8 @name mod3 @modulator 3))
(def mod4 (in 9 @name mod4 @modulator 4))
(def vel (clip velocity 0 1))
(def vel-gain (sqrt vel))

; ── Params ─────────────────────────────────────────────────────────────────
; THE param: 0 = pedal tight, 1 = fully open. Modulate/p-lock this per step.
(param open @default 0.25 @min 0 @max 1 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
; gate-off pedal choke (909-style OH/CH feel): 0 = ring free, 1 = hard choke
(param choke @default 0.35 @min 0 @max 1 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
; T60 of the lowest mode when fully open (contact loss shortens it as the
; pedal closes — decay is EMERGENT below open=1)
(param decay @default 900 @min 60 @max 6000 @unit ms @mod true @mod-mode additive @mod-depth-min -2000 @mod-depth-max 2000 @mod-unit ms)
; freq-dependent decay tilt: T60_n = decay * ratio^-tilt (highs die faster;
; Sekiguchi: frequency-dependent damping is essential)
(param tilt @default 0.55 @min 0 @max 1.5 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
; tune offsets host pitch; A4/440 default puts the top-plate fundamental ~415
(param tune @default -1 @min -36 @max 24 @unit st @mod true @mod-mode additive @mod-depth-min -24 @mod-depth-max 24 @mod-unit st)
; bottom plate fundamental vs top (bottom hats are heavier/stiffer)
(param plate_ratio @default 1.32 @min 0.5 @max 3 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
; strike position: 0 = bell (dark, pitched), 1 = edge (bright, trashy).
; Sekiguchi measured brightness rising monotonically toward the edge.
(param strike @default 0.7 @min 0 @max 1 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
; striker (lumped mass, Hertz contact — verbatim family machinery)
(param stick_hard @default 0.015 @min 0.0005 @max 0.05 @mod true @mod-mode additive @mod-depth-min -0.02 @mod-depth-max 0.02)
(param stick_speed @default 0.03 @min 0.002 @max 0.2 @mod true @mod-mode additive @mod-depth-min -0.05 @mod-depth-max 0.05)
(param scrape @default 0.4 @min 0 @max 1 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
; plate-to-plate contact: stiffness of the separating reaction and the
; pseudo-loss (energy removed per sample while touching — Sekiguchi Model 2)
(param rattle @default 1 @min 0 @max 4 @mod true @mod-mode additive @mod-depth-min -2 @mod-depth-max 2)
(param contact_loss @default 0.012 @min 0 @max 0.08 @mod true @mod-mode additive @mod-depth-min -0.04 @mod-depth-max 0.04)
; direct contact mic on the collision force (buzz presence, like snares)
(param sizzle @default 0.8 @min 0 @max 4 @mod true @mod-mode additive @mod-depth-min -2 @mod-depth-max 2)
; nonlinear bloom: quadratic energy transfer into the high modes
(param wash @default 0.5 @min 0 @max 2 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
(param bottom_mix @default 0.7 @min 0 @max 2 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)
; output body resonators (parallel band-pass peaks, hand-rolled) + level
(param body1_freq @default 3800 @min 200 @max 12000 @unit Hz @mod true @mod-mode additive @mod-depth-min -4000 @mod-depth-max 4000 @mod-unit Hz)
(param body1_gain @default 0.8 @min 0 @max 8 @mod true @mod-mode additive @mod-depth-min -4 @mod-depth-max 4)
(param body2_freq @default 8200 @min 400 @max 16000 @unit Hz @mod true @mod-mode additive @mod-depth-min -6000 @mod-depth-max 6000 @mod-unit Hz)
(param body2_gain @default 0.6 @min 0 @max 8 @mod true @mod-mode additive @mod-depth-min -4 @mod-depth-max 4)
(param level @default 0.5 @min 0 @max 2 @mod true @mod-mode additive @mod-depth-min -1 @mod-depth-max 1)

; Clipped modulation targets — active modulation can never exceed the bounds
; the loss/contact math was tuned for.
(def open-v (clip (mod open) 0 1))
(def choke-v (clip (mod choke) 0 1))
(def decay-v (clip (mod decay) 60 6000))
(def tilt-v (clip (mod tilt) 0 1.5))
(def tune-v (clip (mod tune) -36 24))
(def plate-ratio-v (clip (mod plate_ratio) 0.5 3))
(def strike-v (clip (mod strike) 0 1))
(def stick-hard-v (clip (mod stick_hard) 0.0005 0.05))
(def stick-speed-v (clip (mod stick_speed) 0.002 0.2))
(def scrape-v (clip (mod scrape) 0 1))
(def rattle-v (clip (mod rattle) 0 4))
(def contact-loss-v (clip (mod contact_loss) 0 0.08))
(def sizzle-v (clip (mod sizzle) 0 4))
(def wash-v (clip (mod wash) 0 2))
(def bottom-mix-v (clip (mod bottom_mix) 0 2))
(def body1-freq-v (clip (mod body1_freq) 200 12000))
(def body1-gain-v (clip (mod body1_gain) 0 8))
(def body2-freq-v (clip (mod body2_freq) 400 16000))
(def body2-gain-v (clip (mod body2_gain) 0 8))
(def level-v (clip (mod level) 0 2))


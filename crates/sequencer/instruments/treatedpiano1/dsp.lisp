  (def lfo_phase (* phasor-0 twopi))
  (def add-0 (+ lfo_phase div-0))
  (def q_base (+ n80 mul-1))
  (def mul-3 (* q_base 0.6))
  (def mul-5 (* q_base 0.3))
  (def sin-0 (sin lfo_phase))
  (def mul-10 (* trem_depth sin-0))
  (def lfo_l (+ n1 mul-10))

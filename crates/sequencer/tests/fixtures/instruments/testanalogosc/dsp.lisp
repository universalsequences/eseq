(defmacro analog-osc (freq drift_amt pw wave_blend sub_gain cutoff res drive)
  (make-history drift_h)
  (def drift_noise (noise))
  (def drift_val (mix drift_noise (read-history drift_h) 0.9995))
  (def n0-008 0.008)
  (def mul-0 (* drift_val n0-008 drift_amt))
  (def n0-5 0.5)
  (def n1 1)
  (def add-0 (+ n1 mul-0))
  (def drifted_freq (* freq add-0))
  (def mul-1 (* drifted_freq 0.5))
  (def mul-2 (* drifted_freq 0.5))
  (def ph (phasor drifted_freq))
  (def pulse_sig (polyblep_pulse ph pw drifted_freq))
  (def saw_sig (polyblep_saw ph drifted_freq))
  (def osc_mix (mix saw_sig pulse_sig wave_blend))
  (def sub_ph (phasor mul-1))
  (def sub_sig (polyblep_pulse sub_ph n0-5 mul-2))
  (def mul-3 (* sub_sig sub_gain))
  (def mixed_osc (+ osc_mix mul-3))
  (def return (ladder mixed_osc cutoff res drive))
  (write-history drift_h drift_val)
  return)


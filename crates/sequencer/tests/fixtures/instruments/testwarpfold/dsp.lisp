(defmacro warp-fold-osc (freq warp fold_amt chaos)
  (make-history fb)
  (def clip-1 (clip warp 0.2 5))
  (def mul-0 (* (read-history fb) freq chaos))
  (def add-0 (+ freq mul-0))
  (def mul-3 (* fold_amt 8))
  (def n1 1)
  (def add-1 (+ n1 mul-3))
  (def ph (phasor add-0))
  (def clip-0 (clip ph 0.0001 1))
  (def twopi-2 twopi)
  (def warped (pow clip-0 clip-1))
  (def mul-1 (* twopi-2 warped))
  (def raw (sin mul-1))
  (def mul-2 (* raw add-1))
  (def folded (sin mul-2))
  (write-history fb folded)
  folded)

(param attack @group amp @env amp-env @role attack @default 5 @min 0 @max 1000 @unit ms)
(param decay @group amp @env amp-env @role decay @default 120 @min 1 @max 2000 @unit ms)
(param gain @default 0.5 @min 0 @max 1 @mod true @mod-mode additive)
(param release @group amp @env amp-env @role release @default 180 @min 1 @max 5000 @unit ms)
(param sustain @group amp @env amp-env @role sustain @default 0.8 @min 0 @max 1)

(def gate (in 1 @name gate))
(def pitch (in 2 @name pitch))
(def velocity (in 3 @name velocity))
(def trigger (in 4 @name trigger))
(def clock (in 5 @name clock))

(def env (adsr gate trigger attack decay sustain release))
(def phase (phasor pitch))
(def value 1)
(def phasor-2 (phasor value trigger))
(def n1 1)
(def warp-fold-osc-2 (warp-fold-osc pitch n1 phasor-2 0))
(def mul-0 (* warp-fold-osc-2 env velocity (mod gain)))

(out mul-0 1 @name audio)

(defmacro marimba (gate freq hardness decay)
  (make-history history1)
  (param smot)
  (def scale1 (scale smot 0.0 1.0 0.99 0.99999))
  (def mix1 (mix freq (read-history history1) scale1))
  (make-history h_gate)
  (make-history h_env)
  (def prev_gate (read-history h_gate))
  (def trig (> (- gate prev_gate) 0.1))
  (def dummy_gate (write-history h_gate gate))
  (def strike_decay (- 0.997 (* (clip hardness 0.0 1.0) 0.005)))
  (def env_prev (read-history h_env))
  (def env_next (+ trig (* (- 1.0 trig) (* env_prev strike_decay))))
  (def dummy_env (write-history h_env env_next))
  (def strike_noise (* (noise) env_next))
  (def strike_cutoff (clip (* mix1 (+ 1.5 (* hardness 6.0))) 100.0 16000.0))
  (def strike_filtered (svf strike_noise strike_cutoff 1.2 1.0))
  (def q1 (clip (* 80.0 decay) 2.0 400.0))
  (def q2 (* q1 0.35))
  (def q3 (* q1 0.15))
  (def res1 (svf strike_filtered mix1 q1 1.0))
  (def res2 (svf strike_filtered (clip (* mix1 4.0) 20.0 19000.0) q2 1.0))
  (def res3 (svf strike_filtered (clip (* mix1 10.0) 20.0 19000.0) q3 1.0))
  (def mixed (+ res1 (* res2 0.5) (* res3 0.2)))
  (write-history history1 mix1)
  (tanh (* 3.0 (+ mixed (* strike_filtered 0.1)))))
(defmacro vibraphone (trigger freq decay hardness trem_speed trem_depth)
  (def f1 freq)
  (def f2 (* freq 3.98))
  (def f3 (* freq 8.02))
  (def q1 (clip (* decay freq 1.42) 20.0 8000.0))
  (def q2 (clip (* decay freq 0.71) 15.0 4000.0))
  (def q3 (clip (* decay freq 0.28) 10.0 2000.0))
  (def strike_env (svf trigger (* 120.0 (+ 1.0 (* hardness 9.0))) 0.5 0.0))
  (def strike_noise (* trigger (noise)))
  (def clack (svf strike_noise (* 2500.0 (+ 1.0 (* hardness 3.0))) 1.5 1.0))
  (def exc (+ strike_env (* clack (* hardness 0.2))))
  (def m1 (svf exc f1 q1 1.0))
  (def m2 (svf exc f2 q2 1.0))
  (def m3 (svf exc f3 q3 1.0))
  (def lfo (+ 0.5 (* 0.5 (sin (* (phasor trem_speed) twopi)))))
  (def trem_amp (- 1.0 (* trem_depth lfo)))
  (def m1_mod (* m1 trem_amp))
  (tanh (* 2.5 (+ m1_mod (* m2 0.35) (* m3 0.12) (* clack (* hardness 0.05))))))
(defmacro tr707-kick (trig accent pitch decay tone)
  (make-history h_eb)
  (make-history h_ek)
  (make-history h_ec)
  (def eb_coeff (- 0.9997 (* 0.002 (- 1.0 decay))))
  (def eb (clip (+ (* (read-history h_eb) eb_coeff) trig) 0.0 1.0))
  (write-history h_eb eb)
  (def ek (clip (+ (* (read-history h_ek) 0.993) trig) 0.0 1.0))
  (write-history h_ek ek)
  (def ec (clip (+ (* (read-history h_ec) 0.975) trig) 0.0 1.0))
  (write-history h_ec ec)
  (def p_bend (+ 1.0 (* 1.8 ec)))
  (def f_body (* 54.0 pitch p_bend))
  (def f_knock (* 118.0 pitch p_bend))
  (def click_noise (noise))
  (def click_filt (svf click_noise 2800.0 1.8 1.0))
  (def click_sig (* click_filt ec 0.45))
  (def q_body (+ 12.0 (* decay 28.0)))
  (def body_exc (* trig 2.5))
  (def body_res (svf body_exc f_body q_body 1.0))
  (def body_out (* body_res eb))
  (def knock_exc (+ (* trig 1.5) (* click_noise ec 0.2)))
  (def knock_res (svf knock_exc f_knock 6.0 1.0))
  (def knock_out (* knock_res ek))
  (def out_mix (+ (* body_out 1.2) (* knock_out tone 0.8) (* click_sig (+ 0.2 (* tone 0.9)))))
  (def amp (+ 0.3 (* 0.7 accent)))
  (tanh (* out_mix amp 1.6)))
(use-defmacro pitch-transpose)
(param marimba-semi @min -12.0 @max 12.0)
(param marimbamix)
(def value8 1.0)
(def sub1 (- value8 marimbamix))
(def gate (in 1 @name gate))
(def pitch (in 2 @name pitch))
(def pitch-transpose1 (pitch-transpose pitch marimba-semi))
(def marimba1 (marimba gate pitch-transpose1 0.99 0.99999))
(def mul1 (* marimbamix marimba1))
(def div2 (/ pitch 16.0))
(def velocity (in 3 @name velocity))
(def trigger (in 4 @name trigger))
(def vibraphone1 (vibraphone trigger pitch 0.999 0.83 3.0 value8))
(def tr707-kick1 (tr707-kick trigger 0.2 div2 16.0 100.0))
(def mix1 (mix vibraphone1 tr707-kick1 0.5))
(def mul2 (* sub1 mix1))
(def add1 (+ mul2 mul1))
(def mod1 (in 5 @name mod1 @modulator 1))
(def mod2 (in 6 @name mod2 @modulator 2))
(def mod3 (in 7 @name mod3 @modulator 3))
(def mod4 (in 8 @name mod4 @modulator 4))
(param attack @default 5.0 @min 0.0 @max 1000.0 @unit ms)
(param decay @default 120.0 @min 1.0 @max 2000.0 @unit ms)
(param sustain @default 0.8 @min 0.0 @max 1.0)
(param release @default 180.0 @min 1.0 @max 5000.0 @unit ms)
(param gain @default 0.5 @min 0.0 @max 1.0 @mod true @mod-mode additive)
(def env (adsr gate trigger attack decay sustain release))
(out (* add1 env velocity (mod gain)) 1 @name audio)